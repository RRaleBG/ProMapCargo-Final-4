@page
@{
    ViewData["Title"] = "Vozila · ProMap Cargo";
}

<div class="pm-page pm-vehicles-page" data-module="vehicles">

    

    <div class="pm-vehicles-content">

        <header class="pm-vehicles-header">

            <div class="pm-vehicles-heading">

                <div class="pm-vehicles-kicker">
                    <span class="pm-vehicles-kicker-dot"></span>
                    Fleet · Vozila
                </div>

                <h1 class="pm-vehicles-title">
                    Vozila
                </h1>

                <p class="pm-vehicles-subtitle">
                    Pregled kompletnog voznog parka, statusa vozila, dodeljenih vozača,
                    aktivnih tura i GPS aktivnosti.
                </p>

            </div>

            <div class="pm-vehicles-header-actions">

                <button type="button" class="pm-vehicles-btn" id="refreshVehicles">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                        <path d="M3 4v6h6"></path>
                        <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                        <path d="M21 20v-6h-6"></path>
                    </svg>

                    Osveži

                </button>

                <button type="button" class="pm-vehicles-btn primary" id="addVehicle">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>

                    Novo vozilo

                </button>

            </div>

        </header>

        <section class="pm-vehicles-kpis" aria-label="Statistika vozila">

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">Ukupno vozila</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M3 17h3"></path>
                            <path d="M18 17h3"></path>
                            <path d="M5 17V9h10l4 4v4"></path>
                            <circle cx="8" cy="17" r="2"></circle>
                            <circle cx="17" cy="17" r="2"></circle>
                            <path d="M15 9v4h4"></path>
                        </svg>
                    </span>
                </div>

                <div class="pm-vehicle-kpi-value" id="kpiTotal">—</div>
                <div class="pm-vehicle-kpi-note">registrovanih vozila</div>

            </article>

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">Aktivna</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    </span>
                </div>

                <div class="pm-vehicle-kpi-value" id="kpiActive">—</div>
                <div class="pm-vehicle-kpi-note">u operativnom statusu</div>

            </article>

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">Na turi</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M3 17h3"></path>
                            <path d="M18 17h3"></path>
                            <path d="M5 17V9h10l4 4v4"></path>
                            <circle cx="8" cy="17" r="2"></circle>
                            <circle cx="17" cy="17" r="2"></circle>
                            <path d="M15 9v4h4"></path>
                        </svg>
                    </span>
                </div>

                <div class="pm-vehicle-kpi-value" id="kpiTrips">—</div>
                <div class="pm-vehicle-kpi-note">dodeljeno aktivnim turama</div>

            </article>

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">GPS online</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M12 2v4"></path>
                            <path d="M12 18v4"></path>
                            <path d="M2 12h4"></path>
                            <path d="M18 12h4"></path>
                            <circle cx="12" cy="12" r="4"></circle>
                        </svg>
                    </span>
                </div>

                <div class="pm-vehicle-kpi-value" id="kpiGps">—</div>
                <div class="pm-vehicle-kpi-note">signal u poslednja 2 min</div>

            </article>

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">Servis</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M14.7 6.3a4.5 4.5 0 0 0-5.9 5.9L3 18a2.1 2.1 0 0 0 3 3l5.8-5.8a4.5 4.5 0 0 0 5.9-5.9l-2.8 2.8-2.9-2.9 2.7-2.9Z"></path>
                        </svg>
                    </span>
                </div>

                <div class="pm-vehicle-kpi-value" id="kpiMaintenance">—</div>
                <div class="pm-vehicle-kpi-note">trenutno u servisu</div>

            </article>

        </section>

        <section class="pm-vehicles-toolbar" aria-label="Filteri vozila">

            <div class="pm-vehicle-search">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-4-4"></path>
                </svg>

                <input
                    id="vehicleSearch"
                    class="pm-vehicle-input"
                    type="search"
                    autocomplete="off"
                    placeholder="Pretraži registraciju, marku, model ili VIN..." />

            </div>

            <select id="vehicleStatusFilter" class="pm-vehicle-select" aria-label="Status vozila">
                <option value="">Svi statusi</option>
                <option value="Active">Aktivno</option>
                <option value="Available">Dostupno</option>
                <option value="Maintenance">Servis</option>
                <option value="Inactive">Neaktivno</option>
            </select>

            <select id="vehicleGpsFilter" class="pm-vehicle-select" aria-label="GPS status">
                <option value="">Svi GPS statusi</option>
                <option value="online">GPS online</option>
                <option value="stale">GPS zastareo</option>
                <option value="offline">GPS offline</option>
            </select>

            <div class="pm-vehicle-results" id="vehicleResults">
                Učitavanje...
            </div>

        </section>

        <section class="pm-vehicles-workspace">

            <div class="pm-vehicles-card">

                <div class="pm-vehicles-card-head">

                    <div class="pm-vehicles-card-title-wrap">

                        <h2 class="pm-vehicles-card-title">
                            Operativni spisak vozila
                        </h2>

                        <p class="pm-vehicles-card-subtitle">
                            Fleet podaci · status · vozač · tura · GPS
                        </p>

                    </div>

                    <button
                        type="button"
                        class="pm-vehicles-refresh"
                        id="refreshVehiclesSmall"
                        title="Osveži podatke"
                        aria-label="Osveži podatke">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                            <path d="M3 4v6h6"></path>
                            <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                            <path d="M21 20v-6h-6"></path>
                        </svg>

                    </button>

                </div>

                <div class="pm-vehicles-table-wrap">

                    <table class="pm-vehicles-table">

                        <thead>
                            <tr>
                                <th>Vozilo</th>
                                <th>Status</th>
                                <th>Tip</th>
                                <th>Vozač</th>
                                <th>Tura</th>
                                <th>GPS</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody id="vehiclesTableBody">

                            <tr>
                                <td colspan="7">

                                    <div class="pm-vehicle-loading">

                                        <div class="pm-vehicle-state-icon">

                                            <svg
                                                class="pm-vehicle-spin"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.8"
                                                aria-hidden="true">

                                                <path d="M12 3a9 9 0 1 0 9 9"></path>

                                            </svg>

                                        </div>

                                        <div class="pm-vehicle-state-title">
                                            Učitavanje vozila
                                        </div>

                                        <div class="pm-vehicle-state-text">
                                            Preuzimanje podataka iz ProMap Cargo Fleet API-ja.
                                        </div>

                                    </div>

                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <aside class="pm-vehicles-card pm-vehicle-details" id="vehicleDetails">

                <div class="pm-vehicle-profile">

                    <div class="pm-vehicle-profile-top">

                        <div class="pm-vehicle-profile-icon">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M3 17h3"></path>
                                <path d="M18 17h3"></path>
                                <path d="M5 17V9h10l4 4v4"></path>
                                <circle cx="8" cy="17" r="2"></circle>
                                <circle cx="17" cy="17" r="2"></circle>
                                <path d="M15 9v4h4"></path>
                            </svg>

                        </div>

                        <div>

                            <h2
                                class="pm-vehicle-profile-registration"
                                id="detailRegistration">
                                Izaberite vozilo
                            </h2>

                            <div
                                class="pm-vehicle-profile-meta"
                                id="detailVehicleName">
                                Detalji vozila će biti prikazani ovde.
                            </div>

                            <div
                                class="pm-vehicle-profile-status"
                                id="detailStatus">
                            </div>

                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <h3 class="pm-vehicle-detail-heading">
                        Identifikacija
                    </h3>

                    <div class="pm-vehicle-detail-grid">

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Registracija</div>
                            <div class="pm-vehicle-detail-value" id="detailRegistrationValue">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">VIN</div>
                            <div class="pm-vehicle-detail-value" id="detailVin">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Marka</div>
                            <div class="pm-vehicle-detail-value" id="detailMake">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Model</div>
                            <div class="pm-vehicle-detail-value" id="detailModel">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <h3 class="pm-vehicle-detail-heading">
                        Operativni status
                    </h3>

                    <div class="pm-vehicle-operational">

                        <div class="pm-vehicle-operation-row">

                            <div class="pm-vehicle-operation-label">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <circle cx="12" cy="7" r="4"></circle>
                                    <path d="M4 21a8 8 0 0 1 16 0"></path>
                                </svg>

                                Vozač

                            </div>

                            <div
                                class="pm-vehicle-operation-value"
                                id="detailDriver">
                                —
                            </div>

                        </div>

                        <div class="pm-vehicle-operation-row">

                            <div class="pm-vehicle-operation-label">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M5 4h14v16H5z"></path>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h8"></path>
                                    <path d="M8 16h5"></path>
                                </svg>

                                Aktivna tura

                            </div>

                            <div
                                class="pm-vehicle-operation-value"
                                id="detailTrip">
                                —
                            </div>

                        </div>

                        <div class="pm-vehicle-operation-row">

                            <div class="pm-vehicle-operation-label">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M12 2v4"></path>
                                    <path d="M12 18v4"></path>
                                    <path d="M2 12h4"></path>
                                    <path d="M18 12h4"></path>
                                    <circle cx="12" cy="12" r="4"></circle>
                                </svg>

                                GPS stanje

                            </div>

                            <div
                                class="pm-vehicle-operation-value"
                                id="detailGpsStatus">
                                —
                            </div>

                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <h3 class="pm-vehicle-detail-heading">
                        Tehnički podaci
                    </h3>

                    <div class="pm-vehicle-detail-grid">

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Godina</div>
                            <div class="pm-vehicle-detail-value" id="detailYear">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Tip</div>
                            <div class="pm-vehicle-detail-value" id="detailType">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Težina</div>
                            <div class="pm-vehicle-detail-value" id="detailWeight">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Poslednji GPS</div>
                            <div class="pm-vehicle-detail-value" id="detailGpsTime">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <div class="pm-vehicle-detail-actions">

                        <button
                            type="button"
                            class="pm-vehicle-detail-action"
                            id="showVehicleTrip">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="6" cy="18" r="2"></circle>
                                <circle cx="18" cy="6" r="2"></circle>
                                <path d="M8 18c5 0 3-8 8-12"></path>
                            </svg>

                            Otvori turu

                        </button>

                        <button
                            type="button"
                            class="pm-vehicle-detail-action"
                            id="showVehicleNavigation">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="m12 19 7-14-14 7 6 1 1 6Z"></path>
                            </svg>

                            Navigacija

                        </button>

                    </div>

                </div>

            </aside>

        </section>

        <div class="pm-vehicles-footer-info">

            <span>
                <strong id="lastRefreshLabel">
                    Podaci još nisu osveženi
                </strong>
            </span>

            <span>
                ProMap Cargo · Fleet Management
            </span>

        </div>

    </div>

</div>


