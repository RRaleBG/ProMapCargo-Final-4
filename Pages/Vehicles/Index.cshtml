@page
@{
    ViewData["Title"] = "ProMap Cargo · Vozila";
}

<!-- Page Content -->
<div class="pm-page" data-module="vehicles">
          
    <!-- Page Header -->
    <header class="pm-header">
        <div class="pm-heading">
            <div class="pm-page-kicker">
                <span class="pm-kicker-dot"></span>
                Fleet · Vozila
            </div>
            <p class="pm-page-subtitle">
                Pregled kompletnog voznog parka, statusa vozila, dodeljenih vozača,  aktivnih tura i GPS aktivnosti.
            </p>
        </div>
        <div class="pm-header-actions">
            <button class="pm-btn" type="button" id="refreshVehicles">
                <span> <i data-lucide="refresh-cw" class="compliance-kpi-icon" width="18" height="18"></i> </span>
                <small>Osveži</small>
            </button>
            <button class="pm-btn pm-btn-secondary" type="button" id="addVehicle">
                <span> <i data-lucide="plus" class="compliance-kpi-icon" width="18" height="18"></i> </span>
                <small>Novo vozilo</small>
            </button>
        </div>
    </header>

    <!-- KPI Grid -->
    <section class="moderation-kpi-grid pm-kpi-grid" aria-label="Statistika vozila">

        <article class="compliance-kpi compliance-kpi-total">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Total</span>               
                <i data-lucide="truck" class="compliance-kpi-icon" stroke-width="0"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiTotal">-</strong>
            <span class="compliance-kpi-meta"> registered  </span>
        </article>

        <article class="compliance-kpi compliance-kpi-good">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Active</span>            
                <i data-lucide="check-check" class="compliance-kpi-icon" stroke-width="0"></i>
            </div>
            <strong class="compliance-kpi-value" id="activeVehicles">-</strong>
            <span class="compliance-kpi-meta"> no critical issues   </span>
        </article>

        <article class="compliance-kpi compliance-kpi-warning">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Expiring Soon</span>
                <i data-lucide="triangle-alert" class="compliance-kpi-icon" stroke-width="0"></i>
            </div>
            <strong class="compliance-kpi-value" id="expiringVehicles">-</strong>
            <span class="compliance-kpi-meta">  documents in the next 30 days   </span>
        </article>

        <article class="compliance-kpi compliance-kpi-danger">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Inactive</span>
                <i data-lucide="shield-x" class="compliance-kpi-icon" stroke-width="0"></i>
            </div>
            <strong class="compliance-kpi-value" id="inactiveVehicles">-</strong>
            <span class="compliance-kpi-meta"> inactive vehicles   </span>
        </article>

        <article class="compliance-kpi compliance-kpi-info">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Trailers</span>
                <i data-lucide="trailer" class="compliance-kpi-icon" stroke-width="3"></i>
            </div>
            <strong class="compliance-kpi-value">-</strong>
            <span class="compliance-kpi-meta">  registered trailers    </span>
        </article>

        <article class="compliance-kpi compliance-kpi-neutral">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Service</span>
                <i data-lucide="wrench" class="compliance-kpi-icon" stroke-width="2"></i>    
            </div>

            <strong class="compliance-kpi-value">-</strong>

            <span class="compliance-kpi-meta">  on service  </span>
        </article>

    </section>


    <!-- FILTER TOOLBAR -->
    <section class="moderation-toolbar pm-card pm-toolbar">
        <div class="moderation-search">          
            <span>  
                <i data-lucide="search" class="moderation-search-icon" width="20" height="20" aria-hidden="true"></i>
            </span>
            <input id="vehicleSearch" class="pm-search-input" type="search" placeholder="Pretraži registraciju, marku, model ili VIN..." autocomplete="off" />
        </div>

        <select id="vehicleStatusFilter" class="moderation-select pm-select" aria-label="Status vozila">
            <option value="">Svi statusi</option>
            <option value="Active">Aktivno</option>
            <option value="Available">Dostupno</option>
            <option value="Maintenance">Servis</option>
            <option value="Inactive">Neaktivno</option>
        </select>

        <select id="vehicleGpsFilter" class="moderation-select pm-select" aria-label="GPS status">
            <option value="">Svi GPS statusi</option>
            <option value="online">GPS online</option>
            <option value="stale">GPS zastareo</option>
            <option value="offline">GPS offline</option>
        </select>
   
        <p class="pm-vehicle-results" id="vehicleResults">
            Učitavanje...
        </p>
    </section>
       
   
    <section class="pm-vehicles-workspace">
            <div class="pm-vehicles-card pm-panel">
                <div class="pm-vehicles-card-head pm-panel-heading">
                    <div class="pm-vehicles-card-title-wrap">
                        <h2 class="pm-vehicles-card-title">
                            Operativni spisak vozila
                        </h2>
                        <p class="pm-vehicles-card-subtitle">
                            Fleet podaci · status · vozač · tura · GPS
                        </p>
                    </div>
                    <button type="button" class="pm-vehicles-refresh" id="refreshVehiclesSmall" title="Osveži podatke" aria-label="Osveži podatke">
                         <span> <i data-lucide="refresh-cw" height="20" width="20" ></i> </span>
                    </button>

                </div>

                <div class="pm-vehicles-table-wrap">

                    <table class="pm-vehicles-table">

                        <thead>
                            <tr>
                                <th>Vozilo</th>
                                <th>Status</th>
                                <th>Tip</th>
                                <th>Vozač</th>
                                <th>Tura</th>
                                <th>GPS</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody id="vehiclesTableBody">

                            <tr>
                                <td colspan="7">

                                    <div class="pm-vehicle-loading">

                                        <div class="pm-vehicle-state-icon">

                                            <svg class="pm-vehicle-spin" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.8" aria-hidden="true">

                                                <path d="M12 3a9 9 0 1 0 9 9"></path>

                                            </svg>

                                        </div>

                                        <div class="pm-vehicle-state-title">
                                            Učitavanje vozila
                                        </div>

                                        <div class="pm-vehicle-state-text">
                                            Preuzimanje podataka iz ProMap Cargo Fleet API-ja.
                                        </div>

                                    </div>

                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <aside class="pm-vehicles-card pm-vehicle-details pm-panel" id="vehicleDetails">

                <div class="pm-vehicle-profile">

                    <div class="pm-vehicle-profile-top">

                        <div class="pm-vehicle-profile-icon">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <path d="M3 17h3"></path>
                                <path d="M18 17h3"></path>
                                <path d="M5 17V9h10l4 4v4"></path>
                                <circle cx="8" cy="17" r="2"></circle>
                                <circle cx="17" cy="17" r="2"></circle>
                                <path d="M15 9v4h4"></path>
                            </svg>

                        </div>

                        <div>

                            <h2 class="pm-vehicle-profile-registration" id="detailRegistration">
                                Izaberite vozilo
                            </h2>

                            <div class="pm-vehicle-profile-meta" id="detailVehicleName">
                                Detalji vozila će biti prikazani ovde.
                            </div>

                            <div class="pm-vehicle-profile-status" id="detailStatus">
                            </div>

                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <h3 class="pm-vehicle-detail-heading">
                        Identifikacija
                    </h3>

                    <div class="pm-vehicle-detail-grid">

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Registracija</div>
                            <div class="pm-vehicle-detail-value" id="detailRegistrationValue">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">VIN</div>
                            <div class="pm-vehicle-detail-value" id="detailVin">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Marka</div>
                            <div class="pm-vehicle-detail-value" id="detailMake">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Model</div>
                            <div class="pm-vehicle-detail-value" id="detailModel">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <h3 class="pm-vehicle-detail-heading">
                        Operativni status
                    </h3>

                    <div class="pm-vehicle-operational">

                        <div class="pm-vehicle-operation-row">

                            <div class="pm-vehicle-operation-label">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <circle cx="12" cy="7" r="4"></circle>
                                    <path d="M4 21a8 8 0 0 1 16 0"></path>
                                </svg>

                                Vozač

                            </div>

                            <div class="pm-vehicle-operation-value" id="detailDriver">
                                —
                            </div>

                        </div>

                        <div class="pm-vehicle-operation-row">

                            <div class="pm-vehicle-operation-label">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="M5 4h14v16H5z"></path>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h8"></path>
                                    <path d="M8 16h5"></path>
                                </svg>

                                Aktivna tura

                            </div>

                            <div class="pm-vehicle-operation-value" id="detailTrip">
                                —
                            </div>

                        </div>

                        <div class="pm-vehicle-operation-row">

                            <div class="pm-vehicle-operation-label">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="M12 2v4"></path>
                                    <path d="M12 18v4"></path>
                                    <path d="M2 12h4"></path>
                                    <path d="M18 12h4"></path>
                                    <circle cx="12" cy="12" r="4"></circle>
                                </svg>

                                GPS stanje

                            </div>

                            <div class="pm-vehicle-operation-value" id="detailGpsStatus">
                                —
                            </div>

                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <h3 class="pm-vehicle-detail-heading">
                        Tehnički podaci
                    </h3>

                    <div class="pm-vehicle-detail-grid">

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Godina</div>
                            <div class="pm-vehicle-detail-value" id="detailYear">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Tip</div>
                            <div class="pm-vehicle-detail-value" id="detailType">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Težina</div>
                            <div class="pm-vehicle-detail-value" id="detailWeight">—</div>
                        </div>

                        <div class="pm-vehicle-detail-item">
                            <div class="pm-vehicle-detail-label">Poslednji GPS</div>
                            <div class="pm-vehicle-detail-value" id="detailGpsTime">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-vehicle-detail-section">

                    <div class="pm-vehicle-detail-actions">

                        <button type="button" class="pm-vehicle-detail-action" id="showVehicleTrip">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <circle cx="6" cy="18" r="2"></circle>
                                <circle cx="18" cy="6" r="2"></circle>
                                <path d="M8 18c5 0 3-8 8-12"></path>
                            </svg>

                            Otvori turu

                        </button>

                        <button type="button" class="pm-vehicle-detail-action" id="showVehicleNavigation">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <path d="m12 19 7-14-14 7 6 1 1 6Z"></path>
                            </svg>

                            Navigacija

                        </button>

                    </div>

                </div>

            </aside>

        </section>


</div>


