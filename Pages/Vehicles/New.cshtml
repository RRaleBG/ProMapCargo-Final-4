@page "/vehicles/new"
@{
    ViewData["Title"] = "Novo vozilo · ProMap Cargo";
}

<div class="pm-page pm-vehicle-new-page" data-module="vehicle-new">

    <header class="vehicle-new-header">
        <div class="vehicle-new-heading">
            <div class="vehicle-new-kicker">
                <span class="vehicle-new-kicker-dot"></span>
                FLEET · NOVO VOZILO
            </div>

            <h1>Novo vozilo</h1>

            <p>
                Unesite osnovne podatke o vozilu, tehničke karakteristike,
                registraciju i operativni status.
            </p>
        </div>

        <div class="vehicle-new-header-actions">
            <a href="/vehicles" class="vehicle-new-btn vehicle-new-btn-secondary">
                <span>←</span>
                Nazad na vozila
            </a>

            <button type="button"
                    class="vehicle-new-btn vehicle-new-btn-primary"
                    id="saveVehicleTop">
                <span>✓</span>
                Sačuvaj vozilo
            </button>
        </div>
    </header>


    <div id="vehicleFormMessage" class="vehicle-form-message" hidden></div>


    <form id="vehicleForm" novalidate>

        <div class="vehicle-new-layout">

            <main class="vehicle-new-main">

                <!-- OSNOVNI PODACI -->
                <section class="vehicle-card">

                    <div class="vehicle-card-header">
                        <div>
                            <div class="vehicle-card-eyebrow">IDENTITET VOZILA</div>
                            <h2>Osnovni podaci</h2>
                            <p>Osnovne informacije koje identifikuju vozilo u floti.</p>
                        </div>

                        <div class="vehicle-card-icon">
                            🚛
                        </div>
                    </div>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-field vehicle-field-wide">
                            <label for="vehicleName">
                                Naziv vozila
                                <span>*</span>
                            </label>

                            <input id="vehicleName"
                                   name="vehicleName"
                                   type="text"
                                   placeholder="npr. Mercedes Actros 1845"
                                   autocomplete="off"
                                   required />

                            <small>
                                Interni naziv vozila koji se prikazuje u sistemu.
                            </small>
                        </div>

                        <div class="vehicle-field">
                            <label for="registrationNumber">
                                Registarska oznaka
                                <span>*</span>
                            </label>

                            <input id="registrationNumber"
                                   name="registrationNumber"
                                   type="text"
                                   placeholder="BG 123-AA"
                                   autocomplete="off"
                                   required />
                        </div>

                        <div class="vehicle-field">
                            <label for="fleetNumber">
                                Fleet broj
                            </label>

                            <input id="fleetNumber"
                                   name="fleetNumber"
                                   type="text"
                                   placeholder="TRK-001"
                                   autocomplete="off" />
                        </div>

                        <div class="vehicle-field">
                            <label for="vin">
                                VIN / broj šasije
                                <span>*</span>
                            </label>

                            <input id="vin"
                                   name="vin"
                                   type="text"
                                   maxlength="17"
                                   placeholder="WDBxxxxxxxxxxxxxx"
                                   autocomplete="off"
                                   required />

                            <small>17 karaktera za standardni VIN.</small>
                        </div>

                        <div class="vehicle-field">
                            <label for="vehicleType">
                                Tip vozila
                                <span>*</span>
                            </label>

                            <select id="vehicleType"
                                    name="vehicleType"
                                    required>
                                <option value="">Izaberite tip</option>
                                <option value="truck">Kamion</option>
                                <option value="tractor">Tegljač</option>
                                <option value="rigid">Teretno vozilo</option>
                                <option value="van">Lako teretno vozilo</option>
                                <option value="special">Specijalno vozilo</option>
                            </select>
                        </div>

                        <div class="vehicle-field">
                            <label for="manufacturer">
                                Proizvođač
                            </label>

                            <input id="manufacturer"
                                   name="manufacturer"
                                   type="text"
                                   placeholder="Mercedes-Benz"
                                   autocomplete="off" />
                        </div>

                        <div class="vehicle-field">
                            <label for="model">
                                Model
                            </label>

                            <input id="model"
                                   name="model"
                                   type="text"
                                   placeholder="Actros 1845"
                                   autocomplete="off" />
                        </div>

                        <div class="vehicle-field">
                            <label for="productionYear">
                                Godina proizvodnje
                            </label>

                            <input id="productionYear"
                                   name="productionYear"
                                   type="number"
                                   min="1950"
                                   max="2100"
                                   placeholder="2024" />
                        </div>

                    </div>
                </section>


                <!-- REGISTRACIJA -->
                <section class="vehicle-card">

                    <div class="vehicle-card-header">
                        <div>
                            <div class="vehicle-card-eyebrow">REGISTRACIJA</div>
                            <h2>Registracioni podaci</h2>
                            <p>Podaci potrebni za praćenje registracije i dokumentacije.</p>
                        </div>

                        <div class="vehicle-status-badge vehicle-status-neutral">
                            NOVO
                        </div>
                    </div>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-field">
                            <label for="registrationDate">
                                Datum registracije
                            </label>

                            <input id="registrationDate"
                                   name="registrationDate"
                                   type="date" />
                        </div>

                        <div class="vehicle-field">
                            <label for="registrationExpiry">
                                Registracija važi do
                                <span>*</span>
                            </label>

                            <input id="registrationExpiry"
                                   name="registrationExpiry"
                                   type="date"
                                   required />
                        </div>

                        <div class="vehicle-field">
                            <label for="registrationOffice">
                                Mesto registracije
                            </label>

                            <input id="registrationOffice"
                                   name="registrationOffice"
                                   type="text"
                                   placeholder="Beograd" />
                        </div>

                        <div class="vehicle-field">
                            <label for="registrationDocument">
                                Broj saobraćajne dozvole
                            </label>

                            <input id="registrationDocument"
                                   name="registrationDocument"
                                   type="text"
                                   placeholder="Broj dokumenta" />
                        </div>

                    </div>
                </section>


                <!-- TEHNICKI PODACI -->
                <section class="vehicle-card">

                    <div class="vehicle-card-header">
                        <div>
                            <div class="vehicle-card-eyebrow">TEHNIKA</div>
                            <h2>Tehničke karakteristike</h2>
                            <p>Parametri koji se koriste za fleet management i truck routing.</p>
                        </div>

                        <div class="vehicle-card-icon">
                            ⚙
                        </div>
                    </div>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-field">
                            <label for="engine">
                                Motor
                            </label>

                            <input id="engine"
                                   name="engine"
                                   type="text"
                                   placeholder="12.8 L Diesel" />
                        </div>

                        <div class="vehicle-field">
                            <label for="enginePower">
                                Snaga motora
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="enginePower"
                                       name="enginePower"
                                       type="number"
                                       min="0"
                                       placeholder="450" />
                                <span>kW</span>
                            </div>
                        </div>

                        <div class="vehicle-field">
                            <label for="emissionClass">
                                Emisiona norma
                            </label>

                            <select id="emissionClass"
                                    name="emissionClass">
                                <option value="">Izaberite</option>
                                <option value="euro3">Euro 3</option>
                                <option value="euro4">Euro 4</option>
                                <option value="euro5">Euro 5</option>
                                <option value="euro6">Euro 6</option>
                                <option value="other">Drugo</option>
                            </select>
                        </div>

                        <div class="vehicle-field">
                            <label for="fuelType">
                                Gorivo
                            </label>

                            <select id="fuelType"
                                    name="fuelType">
                                <option value="">Izaberite</option>
                                <option value="diesel">Dizel</option>
                                <option value="lng">LNG</option>
                                <option value="cng">CNG</option>
                                <option value="electric">Električno</option>
                                <option value="hybrid">Hibrid</option>
                                <option value="other">Drugo</option>
                            </select>
                        </div>

                        <div class="vehicle-field">
                            <label for="grossWeight">
                                Najveća dozvoljena masa
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="grossWeight"
                                       name="grossWeight"
                                       type="number"
                                       min="0"
                                       step="0.1"
                                       placeholder="40" />
                                <span>t</span>
                            </div>
                        </div>

                        <div class="vehicle-field">
                            <label for="emptyWeight">
                                Masa praznog vozila
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="emptyWeight"
                                       name="emptyWeight"
                                       type="number"
                                       min="0"
                                       step="0.1"
                                       placeholder="8.5" />
                                <span>t</span>
                            </div>
                        </div>

                        <div class="vehicle-field">
                            <label for="vehicleHeight">
                                Visina
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="vehicleHeight"
                                       name="vehicleHeight"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       placeholder="4.00" />
                                <span>m</span>
                            </div>
                        </div>

                        <div class="vehicle-field">
                            <label for="vehicleWidth">
                                Širina
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="vehicleWidth"
                                       name="vehicleWidth"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       placeholder="2.55" />
                                <span>m</span>
                            </div>
                        </div>

                        <div class="vehicle-field">
                            <label for="vehicleLength">
                                Dužina
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="vehicleLength"
                                       name="vehicleLength"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       placeholder="16.50" />
                                <span>m</span>
                            </div>
                        </div>

                        <div class="vehicle-field">
                            <label for="axleLoad">
                                Osovinsko opterećenje
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="axleLoad"
                                       name="axleLoad"
                                       type="number"
                                       min="0"
                                       step="0.1"
                                       placeholder="10" />
                                <span>t</span>
                            </div>
                        </div>

                        <div class="vehicle-field">
                            <label for="axles">
                                Broj osovina
                            </label>

                            <input id="axles"
                                   name="axles"
                                   type="number"
                                   min="1"
                                   max="20"
                                   placeholder="5" />
                        </div>

                        <div class="vehicle-field">
                            <label for="maxSpeed">
                                Maksimalna brzina
                            </label>

                            <div class="vehicle-input-unit">
                                <input id="maxSpeed"
                                       name="maxSpeed"
                                       type="number"
                                       min="0"
                                       max="200"
                                       placeholder="90" />
                                <span>km/h</span>
                            </div>
                        </div>

                    </div>
                </section>


                <!-- OPERATIVNI PODACI -->
                <section class="vehicle-card">

                    <div class="vehicle-card-header">
                        <div>
                            <div class="vehicle-card-eyebrow">OPERACIJE</div>
                            <h2>Operativni podaci</h2>
                            <p>Podaci koji određuju kako se vozilo koristi u floti.</p>
                        </div>
                    </div>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-field">
                            <label for="vehicleStatus">
                                Status
                            </label>

                            <select id="vehicleStatus"
                                    name="vehicleStatus">
                                <option value="active">Aktivno</option>
                                <option value="maintenance">Na održavanju</option>
                                <option value="inactive">Neaktivno</option>
                                <option value="blocked">Blokirano</option>
                            </select>
                        </div>

                        <div class="vehicle-field">
                            <label for="department">
                                Organizacija / sektor
                            </label>

                            <input id="department"
                                   name="department"
                                   type="text"
                                   placeholder="Transport" />
                        </div>

                        <div class="vehicle-field">
                            <label for="assignedDriver">
                                Trenutni vozač
                            </label>

                            <select id="assignedDriver"
                                    name="assignedDriver">
                                <option value="">Nije dodeljen</option>
                                <option value="driver-001">Marko Petrović</option>
                                <option value="driver-002">Nikola Jovanović</option>
                                <option value="driver-003">Milan Stojanović</option>
                            </select>
                        </div>

                        <div class="vehicle-field">
                            <label for="fuelCard">
                                Primarna fuel kartica
                            </label>

                            <input id="fuelCard"
                                   name="fuelCard"
                                   type="text"
                                   placeholder="FC-0001" />
                        </div>

                        <div class="vehicle-field vehicle-field-wide">
                            <label for="vehicleNotes">
                                Napomena
                            </label>

                            <textarea id="vehicleNotes"
                                      name="vehicleNotes"
                                      rows="4"
                                      placeholder="Interna napomena o vozilu..."></textarea>
                        </div>

                    </div>

                </section>


                <!-- TRAILER RELACIJA -->
                <section class="vehicle-card">

                    <div class="vehicle-card-header">
                        <div>
                            <div class="vehicle-card-eyebrow">TRAILER / PRIKOLICA</div>
                            <h2>Veza sa prikolicom</h2>
                            <p>
                                Vozilo može biti povezano sa konkretnom prikolicom ili poluprikolicom.
                                Veza se kasnije može menjati iz Fleet/Compliance modula.
                            </p>
                        </div>

                        <div class="vehicle-card-icon">
                            🔗
                        </div>
                    </div>

                    <div class="vehicle-trailer-box">

                        <div class="vehicle-trailer-status">
                            <span class="vehicle-trailer-dot"></span>
                            <div>
                                <strong>Prikolica nije povezana</strong>
                                <small>
                                    Vozilo trenutno nema aktivnu vezu sa prikolicom.
                                </small>
                            </div>
                        </div>

                        <select id="assignedTrailer"
                                name="assignedTrailer">
                            <option value="">Bez prikolice</option>
                            <option value="TRL-001">BG-TR-001 · Schmitz Cargobull</option>
                            <option value="TRL-002">BG-TR-002 · Krone</option>
                            <option value="TRL-003">BG-TR-003 · Kögel</option>
                        </select>

                    </div>

                </section>


                <!-- DOKUMENTACIJA -->
                <section class="vehicle-card">

                    <div class="vehicle-card-header">
                        <div>
                            <div class="vehicle-card-eyebrow">COMPLIANCE</div>
                            <h2>Dokumentacija</h2>
                            <p>
                                Osnovni datumi za compliance. Detaljni dokumenti se kasnije
                                vode kroz Compliance modul.
                            </p>
                        </div>

                        <div class="vehicle-compliance-badge">
                            Compliance
                        </div>
                    </div>

                    <div class="vehicle-form-grid">

                        <div class="vehicle-field">
                            <label for="technicalInspection">
                                Tehnički pregled važi do
                            </label>

                            <input id="technicalInspection"
                                   name="technicalInspection"
                                   type="date" />
                        </div>

                        <div class="vehicle-field">
                            <label for="tirExpiry">
                                TIR važi do
                            </label>

                            <input id="tirExpiry"
                                   name="tirExpiry"
                                   type="date" />
                        </div>

                        <div class="vehicle-field">
                            <label for="euroConfirmation">
                                Euro potvrda važi do
                            </label>

                            <input id="euroConfirmation"
                                   name="euroConfirmation"
                                   type="date" />
                        </div>

                        <div class="vehicle-field">
                            <label for="tachographCalibration">
                                Tahograf — kontrola/kalibracija
                            </label>

                            <input id="tachographCalibration"
                                   name="tachographCalibration"
                                   type="date" />
                        </div>

                    </div>

                    <div class="vehicle-info-panel">
                        <span class="vehicle-info-icon">i</span>

                        <div>
                            <strong>Compliance dokumenti</strong>

                            <p>
                                Nakon kreiranja vozila, Compliance modul može sadržati
                                kompletnu dokumentaciju vozila: saobraćajnu dozvolu,
                                Euro potvrdu, tehnički pregled, TIR, licence/dozvole,
                                tahograf, PP aparate, servise, popravke, kvarove i beleške.
                            </p>
                        </div>
                    </div>

                </section>


                <!-- AKCIJE -->
                <section class="vehicle-actions-card">

                    <div>
                        <strong>Spremno za kreiranje?</strong>

                        <span>
                            Proverite obavezna polja pre čuvanja vozila.
                        </span>
                    </div>

                    <div class="vehicle-actions">

                        <a href="/vehicles"
                           class="vehicle-new-btn vehicle-new-btn-secondary">
                            Otkaži
                        </a>

                        <button type="submit"
                                class="vehicle-new-btn vehicle-new-btn-primary"
                                id="saveVehicle">
                            <span>✓</span>
                            Kreiraj vozilo
                        </button>

                    </div>

                </section>

            </main>


            <!-- DESNI PANEL -->
            <aside class="vehicle-new-sidebar">

                <section class="vehicle-side-card vehicle-preview-card">

                    <div class="vehicle-side-label">
                        LIVE PREVIEW
                    </div>

                    <div class="vehicle-preview-icon">
                        🚛
                    </div>

                    <div class="vehicle-preview-name"
                         id="previewName">
                        Novo vozilo
                    </div>

                    <div class="vehicle-preview-registration"
                         id="previewRegistration">
                        REGISTRACIJA
                    </div>

                    <div class="vehicle-preview-divider"></div>

                    <div class="vehicle-preview-grid">

                        <div>
                            <span>TIP</span>
                            <strong id="previewType">—</strong>
                        </div>

                        <div>
                            <span>MASA</span>
                            <strong id="previewWeight">—</strong>
                        </div>

                        <div>
                            <span>VISINA</span>
                            <strong id="previewHeight">—</strong>
                        </div>

                        <div>
                            <span>EURO</span>
                            <strong id="previewEuro">—</strong>
                        </div>

                    </div>

                    <div class="vehicle-preview-status">
                        <span></span>
                        DRAFT · NIJE SAČUVANO
                    </div>

                </section>


                <section class="vehicle-side-card">

                    <div class="vehicle-side-header">
                        <div>
                            <span class="vehicle-side-label">CHECKLIST</span>
                            <h3>Podaci vozila</h3>
                        </div>
                    </div>

                    <div class="vehicle-checklist">

                        <div class="vehicle-check-item" id="checkName">
                            <span>✓</span>
                            <div>
                                <strong>Identitet</strong>
                                <small>Naziv i registracija</small>
                            </div>
                        </div>

                        <div class="vehicle-check-item" id="checkVin">
                            <span>✓</span>
                            <div>
                                <strong>VIN</strong>
                                <small>Broj šasije</small>
                            </div>
                        </div>

                        <div class="vehicle-check-item" id="checkType">
                            <span>✓</span>
                            <div>
                                <strong>Tip vozila</strong>
                                <small>Kategorija vozila</small>
                            </div>
                        </div>

                        <div class="vehicle-check-item" id="checkRegistration">
                            <span>✓</span>
                            <div>
                                <strong>Registracija</strong>
                                <small>Datum isteka</small>
                            </div>
                        </div>

                    </div>

                </section>


                <section class="vehicle-side-card">

                    <div class="vehicle-side-label">
                        FLEET FLOW
                    </div>

                    <div class="vehicle-flow">

                        <div class="vehicle-flow-item active">
                            <span>01</span>
                            <div>
                                <strong>Novo vozilo</strong>
                                <small>Unos podataka</small>
                            </div>
                        </div>

                        <div class="vehicle-flow-line"></div>

                        <div class="vehicle-flow-item">
                            <span>02</span>
                            <div>
                                <strong>Compliance</strong>
                                <small>Dokumentacija</small>
                            </div>
                        </div>

                        <div class="vehicle-flow-line"></div>

                        <div class="vehicle-flow-item">
                            <span>03</span>
                            <div>
                                <strong>Operacije</strong>
                                <small>Vozač / ture</small>
                            </div>
                        </div>

                        <div class="vehicle-flow-line"></div>

                        <div class="vehicle-flow-item">
                            <span>04</span>
                            <div>
                                <strong>Routing</strong>
                                <small>Truck profil</small>
                            </div>
                        </div>

                    </div>

                </section>

            </aside>

        </div>

    </form>

</div>





<script>

(function () {

    "use strict";

    const form = document.getElementById("vehicleForm");

    if (!form) {
        return;
    }

    const message = document.getElementById("vehicleFormMessage");

    const nameInput = document.getElementById("vehicleName");
    const registrationInput = document.getElementById("registrationNumber");
    const vinInput = document.getElementById("vin");
    const typeInput = document.getElementById("vehicleType");
    const registrationExpiryInput = document.getElementById("registrationExpiry");

    const previewName = document.getElementById("previewName");
    const previewRegistration = document.getElementById("previewRegistration");
    const previewType = document.getElementById("previewType");
    const previewWeight = document.getElementById("previewWeight");
    const previewHeight = document.getElementById("previewHeight");
    const previewEuro = document.getElementById("previewEuro");

    const grossWeight = document.getElementById("grossWeight");
    const vehicleHeight = document.getElementById("vehicleHeight");
    const emissionClass = document.getElementById("emissionClass");

    const saveButton = document.getElementById("saveVehicle");
    const saveTopButton = document.getElementById("saveVehicleTop");


    function normalize(value) {
        return (value || "").trim();
    }


    function updatePreview() {

        const name = normalize(nameInput.value);
        const registration = normalize(registrationInput.value);
        const type = typeInput.options[typeInput.selectedIndex]?.text || "";
        const weight = normalize(grossWeight.value);
        const height = normalize(vehicleHeight.value);
        const euro = emissionClass.options[emissionClass.selectedIndex]?.text || "";

        previewName.textContent = name || "Novo vozilo";
        previewRegistration.textContent =
            registration
                ? registration.toUpperCase()
                : "REGISTRACIJA";

        previewType.textContent =
            type && type !== "Izaberite tip"
                ? type
                : "—";

        previewWeight.textContent =
            weight
                ? weight + " t"
                : "—";

        previewHeight.textContent =
            height
                ? height + " m"
                : "—";

        previewEuro.textContent =
            euro && euro !== "Izaberite"
                ? euro
                : "—";
    }


    function updateChecklist() {

        const checks = [
            {
                id: "checkName",
                valid:
                    normalize(nameInput.value).length > 0 &&
                    normalize(registrationInput.value).length > 0
            },
            {
                id: "checkVin",
                valid:
                    normalize(vinInput.value).length === 17
            },
            {
                id: "checkType",
                valid:
                    normalize(typeInput.value).length > 0
            },
            {
                id: "checkRegistration",
                valid:
                    normalize(registrationExpiryInput.value).length > 0
            }
        ];

        checks.forEach(function (check) {

            const element = document.getElementById(check.id);

            if (!element) {
                return;
            }

            element.classList.toggle("complete", check.valid);

        });
    }


    function validateField(input) {

        if (!input) {
            return true;
        }

        const value = normalize(input.value);

        let valid = true;

        if (input.hasAttribute("required") && !value) {
            valid = false;
        }

        if (input === vinInput && value && value.length !== 17) {
            valid = false;
        }

        input.classList.toggle("invalid", !valid);

        return valid;
    }


    function validateForm() {

        const fields = [
            nameInput,
            registrationInput,
            vinInput,
            typeInput,
            registrationExpiryInput
        ];

        let valid = true;

        fields.forEach(function (field) {

            if (!validateField(field)) {
                valid = false;
            }

        });

        return valid;
    }


    function showMessage(text, isError) {

        message.hidden = false;
        message.textContent = text;
        message.classList.toggle("error", !!isError);

        message.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });
    }


    function setSavingState(saving) {

        [saveButton, saveTopButton].forEach(function (button) {

            if (!button) {
                return;
            }

            button.disabled = saving;

            if (saving) {

                button.dataset.originalText =
                    button.innerHTML;

                button.innerHTML =
                    "<span>…</span> Čuvanje...";

            } else {

                button.innerHTML =
                    button.dataset.originalText ||
                    "<span>✓</span> Sačuvaj vozilo";

            }

        });

    }


    function saveVehicle() {

        if (!validateForm()) {

            showMessage(
                "Popunite sva obavezna polja. VIN mora sadržati tačno 17 karaktera.",
                true
            );

            return;
        }

        setSavingState(true);

        /*
         * UI ONLY.
         *
         * Backend model, Entity Framework persistence,
         * Identity permissions i Compliance veze biće
         * povezani kasnije.
         */

        window.setTimeout(function () {

            setSavingState(false);

            showMessage(
                "Vozilo je validirano i spremno za čuvanje. Backend persistence će biti povezan kada budu uvedeni modeli.",
                false
            );

        }, 700);
    }


    form.addEventListener("submit", function (event) {

        event.preventDefault();

        saveVehicle();

    });


    if (saveTopButton) {

        saveTopButton.addEventListener("click", function () {

            saveVehicle();

        });

    }


    [
        nameInput,
        registrationInput,
        vinInput,
        typeInput,
        registrationExpiryInput,
        grossWeight,
        vehicleHeight,
        emissionClass
    ].forEach(function (input) {

        if (!input) {
            return;
        }

        input.addEventListener("input", function () {

            updatePreview();
            updateChecklist();

        });

        input.addEventListener("change", function () {

            updatePreview();
            updateChecklist();

        });

    });


    vinInput.addEventListener("input", function () {

        this.value =
            this.value
                .toUpperCase()
                .replace(/[^A-Z0-9]/g, "")
                .slice(0, 17);

        updateChecklist();

    });


    registrationInput.addEventListener("input", function () {

        this.value =
            this.value
                .toUpperCase();

        updatePreview();
        updateChecklist();

    });


    [
        nameInput,
        registrationInput,
        vinInput,
        typeInput,
        registrationExpiryInput
    ].forEach(function (input) {

        input.addEventListener("blur", function () {

            validateField(input);

        });

    });


    updatePreview();
    updateChecklist();

})();

</script>
