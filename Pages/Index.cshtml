@page "/"
@{
    Layout = null;
    ViewData["Title"] = "ProMap Cargo · Truck Intelligence Platform";
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ProMap Cargo · Truck Intelligence Platform</title>
    <meta name="description" content="ProMap Cargo — truck-aware routing, fleet operations, live GPS navigation and intelligent transport management." />
    <meta name="theme-color" content="#021512" />

    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/index.css" asp-append-version="true" />
</head>

<body>
    <div class="pm-public-page">

        <div class="pm-bg-grid"></div>
        <div class="pm-bg-glow pm-bg-glow-one"></div>
        <div class="pm-bg-glow pm-bg-glow-two"></div>
        <div class="pm-bg-glow pm-bg-glow-three"></div>

        <!-- =====================================================
             PUBLIC HEADER
             ===================================================== -->

        <header class="pm-public-header" id="publicHeader">
            <div class="pm-public-header-inner">

                <a href="/" class="pm-public-brand" aria-label="ProMap Cargo">
                    <span class="pm-public-brand-mark"></span>

                    <span class="pm-public-brand-name">
                        ProMap <span>Cargo</span>
                    </span>
                </a>

                <nav class="pm-public-nav">
                    <a class="pm-public-nav-link" href="#platform">Platform</a>
                    <a class="pm-public-nav-link" href="#routing">Truck Routing</a>
                    <a class="pm-public-nav-link" href="#operations">Operations</a>
                    <a class="pm-public-nav-link" href="#infrastructure">Infrastructure</a>
                </nav>

                <div class="pm-public-header-actions">
                    <a class="pm-header-link" href="/navigation">
                        Navigation
                    </a>

                    <a class="pm-header-link pm-header-link-primary" href="/dispatch">
                        Open Platform
                    </a>

                    <button
                        type="button"
                        class="pm-mobile-menu"
                        id="mobileMenuButton"
                        aria-label="Otvori meni"
                        aria-expanded="false">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>

            </div>
        </header>

        <nav class="pm-mobile-nav" id="mobileNav">
            <a href="#platform">Platform</a>
            <a href="#routing">Truck Routing</a>
            <a href="#operations">Operations</a>
            <a href="#infrastructure">Infrastructure</a>
            <a href="/navigation">Navigation</a>
            <a href="/dispatch">Open Platform</a>
        </nav>

        <!-- =====================================================
             HERO
             ===================================================== -->

        <main>

            <section class="pm-hero">
                <div class="pm-hero-inner">

                    <div class="pm-hero-copy">

                        <div class="pm-eyebrow">
                            <span class="pm-eyebrow-dot"></span>
                            Truck Intelligence Platform
                        </div>

                        <h1 class="pm-hero-title">
                            <span class="pm-hero-title-line">Move smarter.</span>
                            <span class="pm-hero-title-line pm-hero-title-accent">
                                Route precisely.
                            </span>
                            <span class="pm-hero-title-line">Operate better.</span>
                        </h1>

                        <p class="pm-hero-description">
                            ProMap Cargo povezuje truck-aware routing, fleet operations,
                            live GPS navigaciju i transportnu infrastrukturu u jednu
                            operativnu platformu.
                        </p>

                        <div class="pm-hero-actions">
                            <a class="pm-hero-btn pm-hero-btn-primary" href="/navigation">
                                Explore Navigation

                                <span class="pm-btn-arrow">→</span>
                            </a>

                            <a class="pm-hero-btn pm-hero-btn-secondary" href="#platform">
                                Discover Platform
                            </a>
                        </div>

                        <div class="pm-hero-proof">

                            <div class="pm-proof-item">
                                <span class="pm-proof-icon">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z"></path>
                                        <circle cx="12" cy="9" r="2.5"></circle>
                                    </svg>
                                </span>
                                OSM routing
                            </div>

                            <div class="pm-proof-item">
                                <span class="pm-proof-icon">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <ellipse cx="12" cy="5" rx="7" ry="3"></ellipse>
                                        <path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5"></path>
                                        <path d="M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7"></path>
                                    </svg>
                                </span>
                                PostGIS graph
                            </div>

                            <div class="pm-proof-item">
                                <span class="pm-proof-icon">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M5 17a7 7 0 0 1 14 0"></path>
                                        <path d="M8 17a4 4 0 0 1 8 0"></path>
                                        <path d="M12 17h.01"></path>
                                    </svg>
                                </span>
                                Live GPS
                            </div>

                        </div>
                    </div>

                    <!-- Animated route visualization -->

                    <div class="pm-hero-visual">

                        <div class="pm-routing-orbit"></div>

                        <div class="pm-routing-panel">

                            <div class="pm-route-topbar">

                                <div class="pm-route-top-title">
                                    <span class="pm-route-top-icon">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 12h18"></path>
                                            <path d="M13 6l6 6-6 6"></path>
                                        </svg>
                                    </span>

                                    Truck Route Intelligence
                                </div>

                                <div class="pm-route-live">
                                    <span class="pm-route-live-dot"></span>
                                    LIVE ENGINE
                                </div>

                            </div>

                            <div class="pm-route-map">

                                <div class="pm-route-map-grid"></div>

                                <div class="pm-route-river"></div>
                                <div class="pm-route-river pm-route-river-two"></div>

                                <div class="pm-route-road pm-route-road-1"></div>
                                <div class="pm-route-road pm-route-road-2"></div>
                                <div class="pm-route-road pm-route-road-3"></div>
                                <div class="pm-route-road pm-route-road-4"></div>

                                <svg
                                    class="pm-route-svg"
                                    viewBox="0 0 610 480"
                                    preserveAspectRatio="none">

                                    <defs>
                                        <linearGradient id="pmRouteGradient" x1="0%" y1="100%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#10b981"></stop>
                                            <stop offset="55%" stop-color="#2dd4bf"></stop>
                                            <stop offset="100%" stop-color="#22d3ee"></stop>
                                        </linearGradient>
                                    </defs>

                                    <path
                                        class="pm-route-shadow"
                                        d="M72 366 C145 350 154 318 216 315 C280 312 280 248 333 232 C384 217 389 173 437 145 C474 124 513 100 552 71">
                                    </path>

                                    <path
                                        class="pm-route-line"
                                        d="M72 366 C145 350 154 318 216 315 C280 312 280 248 333 232 C384 217 389 173 437 145 C474 124 513 100 552 71">
                                    </path>

                                    <circle
                                        class="pm-route-node-glow"
                                        cx="72"
                                        cy="366"
                                        r="15">
                                    </circle>

                                    <circle
                                        class="pm-route-node"
                                        cx="72"
                                        cy="366"
                                        r="6">
                                    </circle>

                                    <circle
                                        class="pm-route-node-glow"
                                        cx="216"
                                        cy="315"
                                        r="13">
                                    </circle>

                                    <circle
                                        class="pm-route-node"
                                        cx="216"
                                        cy="315"
                                        r="5">
                                    </circle>

                                    <circle
                                        class="pm-route-node-glow"
                                        cx="333"
                                        cy="232"
                                        r="14">
                                    </circle>

                                    <circle
                                        class="pm-route-node"
                                        cx="333"
                                        cy="232"
                                        r="5">
                                    </circle>

                                    <circle
                                        class="pm-route-node-glow"
                                        cx="437"
                                        cy="145"
                                        r="13">
                                    </circle>

                                    <circle
                                        class="pm-route-node"
                                        cx="437"
                                        cy="145"
                                        r="5">
                                    </circle>

                                    <circle
                                        class="pm-route-node-glow"
                                        cx="552"
                                        cy="71"
                                        r="15">
                                    </circle>

                                    <circle
                                        class="pm-route-node"
                                        cx="552"
                                        cy="71"
                                        r="6">
                                    </circle>

                                </svg>

                                <span class="pm-map-pin pm-map-pin-start"></span>
                                <span class="pm-map-pin pm-map-pin-end"></span>

                                <span class="pm-route-label pm-route-label-start">
                                    BEOGRAD
                                </span>

                                <span class="pm-route-label pm-route-label-end">
                                    NOVI SAD
                                </span>

                                <div class="pm-truck">
                                    <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                                        <path d="M3 6h11v10H3z"></path>
                                        <path d="M14 10h4l3 3v3h-7"></path>
                                        <circle cx="7" cy="18" r="2"></circle>
                                        <circle cx="18" cy="18" r="2"></circle>
                                    </svg>
                                </div>

                                <div class="pm-route-bottom">

                                    <div class="pm-route-metric">
                                        <div class="pm-route-metric-label">
                                            Distance
                                        </div>

                                        <div class="pm-route-metric-value">
                                            94.2 <span>km</span>
                                        </div>
                                    </div>

                                    <div class="pm-route-metric">
                                        <div class="pm-route-metric-label">
                                            ETA
                                        </div>

                                        <div class="pm-route-metric-value">
                                            01:10 <span>h</span>
                                        </div>
                                    </div>

                                    <div class="pm-route-metric">
                                        <div class="pm-route-metric-label">
                                            Vehicle
                                        </div>

                                        <div class="pm-route-metric-value">
                                            40t <span>truck</span>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </section>

            <!-- =================================================
                 PLATFORM
                 ================================================= -->

            <section class="pm-section pm-platform" id="platform">

                <div class="pm-section-header pm-reveal">
                    <div class="pm-section-kicker">
                        One operational platform
                    </div>

                    <h2 class="pm-section-title">
                        Sve što transportna operacija treba.
                    </h2>

                    <p class="pm-section-description">
                        Od planiranja rute do live GPS navigacije i fleet kontrole —
                        ProMap Cargo objedinjuje ključne operacije na jednom mestu.
                    </p>
                </div>

                <div class="pm-platform-grid">

                    <article class="pm-feature-card pm-reveal">
                        <span class="pm-feature-number">01</span>

                        <div class="pm-feature-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <path d="M4 19V5"></path>
                                <path d="M4 19h16"></path>
                                <path d="M7 15l4-5 3 2 5-7"></path>
                                <circle cx="7" cy="15" r="1.5"></circle>
                                <circle cx="11" cy="10" r="1.5"></circle>
                                <circle cx="14" cy="12" r="1.5"></circle>
                                <circle cx="19" cy="5" r="1.5"></circle>
                            </svg>
                        </div>

                        <h3 class="pm-feature-title">
                            Truck-aware Routing
                        </h3>

                        <p class="pm-feature-text">
                            Rute uzimaju u obzir dimenzije, masu, osovinsko opterećenje,
                            ADR parametre i aktivna ograničenja za vozilo.
                        </p>

                        <div class="pm-feature-footer">
                            <span class="pm-feature-footer-dot"></span>
                            OSM · PostGIS · OSRM fallback
                        </div>
                    </article>

                    <article class="pm-feature-card pm-reveal">
                        <span class="pm-feature-number">02</span>

                        <div class="pm-feature-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <rect x="3" y="6" width="18" height="13" rx="2"></rect>
                                <path d="M7 6V4h10v2"></path>
                                <circle cx="8" cy="19" r="1.5"></circle>
                                <circle cx="16" cy="19" r="1.5"></circle>
                                <path d="M7 11h10"></path>
                            </svg>
                        </div>

                        <h3 class="pm-feature-title">
                            Fleet Operations
                        </h3>

                        <p class="pm-feature-text">
                            Vozila, vozači, ture, transportni nalozi, statusi,
                            upozorenja i operativna kontrola povezani su u jednu celinu.
                        </p>

                        <div class="pm-feature-footer">
                            <span class="pm-feature-footer-dot"></span>
                            Vehicles · Drivers · Trips
                        </div>
                    </article>

                    <article class="pm-feature-card pm-reveal">
                        <span class="pm-feature-number">03</span>

                        <div class="pm-feature-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <path d="M12 21a9 9 0 1 0-9-9"></path>
                                <path d="M3 12h4"></path>
                                <path d="M12 3v4"></path>
                                <path d="M12 12l5-3"></path>
                                <circle cx="12" cy="12" r="1.7"></circle>
                            </svg>
                        </div>

                        <h3 class="pm-feature-title">
                            Live Navigation
                        </h3>

                        <p class="pm-feature-text">
                            GPS pozicija, napredak rute, sledeći manevar, off-route
                            detekcija i ponovno rutiranje tokom vožnje.
                        </p>

                        <div class="pm-feature-footer">
                            <span class="pm-feature-footer-dot"></span>
                            GPS · ETA · Turn-by-turn
                        </div>
                    </article>

                    <article class="pm-feature-card pm-reveal">
                        <span class="pm-feature-number">04</span>

                        <div class="pm-feature-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <path d="M12 3l8 4v5c0 4.6-3.4 7.9-8 9-4.6-1.1-8-4.4-8-9V7l8-4Z"></path>
                                <path d="M9 12l2 2 4-4"></path>
                            </svg>
                        </div>

                        <h3 class="pm-feature-title">
                            Control & Compliance
                        </h3>

                        <p class="pm-feature-text">
                            Restrikcije, alerts, audit, compliance i sistemska
                            dijagnostika dostupni su operativnom timu.
                        </p>

                        <div class="pm-feature-footer">
                            <span class="pm-feature-footer-dot"></span>
                            Alerts · Audit · Compliance
                        </div>
                    </article>

                </div>
            </section>

            <!-- =================================================
                 ROUTING ENGINE
                 ================================================= -->

            <section class="pm-section pm-engine-section" id="routing">

                <div class="pm-section-header pm-reveal">
                    <div class="pm-section-kicker">
                        Routing architecture
                    </div>

                    <h2 class="pm-section-title">
                        Od OpenStreetMap podataka do rute.
                    </h2>

                    <p class="pm-section-description">
                        Routing sloj je projektovan kao pipeline u kome se
                        geografski podaci, truck ograničenja i routing engine
                        spajaju u rezultat koji navigacija može da koristi.
                    </p>
                </div>

                <div class="pm-engine pm-reveal">

                    <div class="pm-engine-pipeline">

                        <div class="pm-engine-node active">
                            <div class="pm-engine-icon">
                                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                    <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z"></path>
                                    <path d="M9 3v15"></path>
                                    <path d="M15 6v15"></path>
                                </svg>
                            </div>

                            <div class="pm-engine-node-title">
                                OSM
                            </div>

                            <div class="pm-engine-node-text">
                                Road network<br />
                                geographic data
                            </div>
                        </div>

                        <div class="pm-engine-arrow"></div>

                        <div class="pm-engine-node">
                            <div class="pm-engine-icon">
                                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                    <ellipse cx="12" cy="5" rx="7" ry="3"></ellipse>
                                    <path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5"></path>
                                    <path d="M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7"></path>
                                </svg>
                            </div>

                            <div class="pm-engine-node-title">
                                PostGIS
                            </div>

                            <div class="pm-engine-node-text">
                                Spatial database<br />
                                routing graph
                            </div>
                        </div>

                        <div class="pm-engine-arrow"></div>

                        <div class="pm-engine-node">
                            <div class="pm-engine-icon">
                                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                    <path d="M4 19h16"></path>
                                    <path d="M5 16l4-5 3 2 5-7"></path>
                                    <circle cx="5" cy="16" r="1.5"></circle>
                                    <circle cx="9" cy="11" r="1.5"></circle>
                                    <circle cx="12" cy="13" r="1.5"></circle>
                                    <circle cx="17" cy="6" r="1.5"></circle>
                                </svg>
                            </div>

                            <div class="pm-engine-node-title">
                                Routing
                            </div>

                            <div class="pm-engine-node-text">
                                Truck profile<br />
                                restrictions & analysis
                            </div>
                        </div>

                        <div class="pm-engine-arrow"></div>

                        <div class="pm-engine-node">
                            <div class="pm-engine-icon">
                                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                    <path d="M3 6h11v10H3z"></path>
                                    <path d="M14 10h4l3 3v3h-7"></path>
                                    <circle cx="7" cy="18" r="2"></circle>
                                    <circle cx="18" cy="18" r="2"></circle>
                                </svg>
                            </div>

                            <div class="pm-engine-node-title">
                                Navigation
                            </div>

                            <div class="pm-engine-node-text">
                                Route geometry<br />
                                ETA & maneuvers
                            </div>
                        </div>

                    </div>

                    <div class="pm-engine-caption">
                        <span>
                            Routing path:
                            <strong>OSM → PostGIS → Truck Analysis → Navigation</strong>
                        </span>

                        <span>
                            Fallback:
                            <strong>OSRM</strong>
                        </span>
                    </div>

                </div>
            </section>

            <!-- =================================================
                 OPERATIONS
                 ================================================= -->

            <section class="pm-section" id="operations">

                <div class="pm-section-header pm-reveal">
                    <div class="pm-section-kicker">
                        Fleet operations
                    </div>

                    <h2 class="pm-section-title">
                        Jedan pogled na celu operaciju.
                    </h2>

                    <p class="pm-section-description">
                        Operativni sistem povezuje vozila, rute i teretne operacije
                        kako bi informacije bile dostupne tamo gde su potrebne.
                    </p>
                </div>

                <div class="pm-operations-grid">

                    <div class="pm-ops-panel pm-ops-map pm-reveal">

                        <div class="pm-ops-map-badge">
                            NETWORK STATUS
                            <span> · ONLINE</span>
                        </div>

                        <div class="pm-ops-map-route"></div>
                        <div class="pm-ops-map-line"></div>

                        <span class="pm-ops-map-point pm-ops-map-point-1"></span>
                        <span class="pm-ops-map-point pm-ops-map-point-2"></span>
                        <span class="pm-ops-map-point pm-ops-map-point-3"></span>

                    </div>

                    <div class="pm-ops-side">

                        <article class="pm-ops-stat pm-reveal">
                            <div class="pm-ops-stat-top">
                                <div class="pm-ops-stat-label">
                                    Fleet Control
                                </div>

                                <div class="pm-ops-stat-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="3" y="6" width="18" height="13" rx="2"></rect>
                                        <circle cx="8" cy="19" r="1.5"></circle>
                                        <circle cx="16" cy="19" r="1.5"></circle>
                                    </svg>
                                </div>
                            </div>

                            <div class="pm-ops-stat-value">
                                24/7
                            </div>

                            <div class="pm-ops-stat-meta">
                                Operativna kontrola <strong>flote</strong>
                            </div>
                        </article>

                        <article class="pm-ops-stat pm-reveal">
                            <div class="pm-ops-stat-top">
                                <div class="pm-ops-stat-label">
                                    Navigation
                                </div>

                                <div class="pm-ops-stat-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <circle cx="12" cy="12" r="8"></circle>
                                        <path d="M12 7v5l3 2"></path>
                                    </svg>
                                </div>
                            </div>

                            <div class="pm-ops-stat-value">
                                LIVE
                            </div>

                            <div class="pm-ops-stat-meta">
                                GPS · ETA · <strong>rerouting</strong>
                            </div>
                        </article>

                        <article class="pm-ops-stat pm-reveal">
                            <div class="pm-ops-stat-top">
                                <div class="pm-ops-stat-label">
                                    Routing
                                </div>

                                <div class="pm-ops-stat-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M5 19c5-1 8-4 8-9 0-2 1-4 5-5"></path>
                                        <circle cx="5" cy="19" r="2"></circle>
                                        <circle cx="18" cy="5" r="2"></circle>
                                    </svg>
                                </div>
                            </div>

                            <div class="pm-ops-stat-value">
                                OSM
                            </div>

                            <div class="pm-ops-stat-meta">
                                Truck-aware <strong>routing engine</strong>
                            </div>
                        </article>

                    </div>

                </div>
            </section>

            <!-- =================================================
                 INFRASTRUCTURE
                 ================================================= -->

            <section class="pm-section" id="infrastructure">

                <div class="pm-section-header pm-reveal">
                    <div class="pm-section-kicker">
                        Platform capabilities
                    </div>

                    <h2 class="pm-section-title">
                        Built for real transport operations.
                    </h2>

                    <p class="pm-section-description">
                        Sistem je organizovan oko operativnih komponenti koje mogu
                        da rade zajedno: routing, fleet, navigation, compliance,
                        monitoring i transportni procesi.
                    </p>
                </div>

                <div class="pm-capabilities">

                    <article class="pm-capability pm-reveal">
                        <div class="pm-capability-index">01</div>
                        <div class="pm-capability-title">Transport Orders</div>
