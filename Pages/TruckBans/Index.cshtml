@page "/truck-bans"
@model ProMapCargo.Api.Pages.TruckBans.IndexModel
@{
    ViewData["Title"] = "Zabrane vožnje · ProMap Cargo";
}

<div class="pm-page" data-module="truck-bans">
    <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--3" aria-label="Zabrane vožnje pregled">
        <article class="compliance-kpi compliance-kpi-warning">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Čeka potvrdu</span>
                <i data-lucide="shield-alert" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value">@Model.ForReview.Count</strong>
            <span class="compliance-kpi-meta">ne koristi se dok se ne potvrdi</span>
        </article>

        <article class="compliance-kpi compliance-kpi-danger">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Aktivne narednih 14 dana</span>
                <i data-lucide="calendar-x" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value">@Model.Upcoming.Count</strong>
            <span class="compliance-kpi-meta">potvrđene zabrane</span>
        </article>

        <article class="compliance-kpi compliance-kpi-info">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Poslednje preuzimanje</span>
                <i data-lucide="refresh-cw" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value">@(Model.LastSyncUtc?.ToLocalTime().ToString("dd.MM. HH:mm") ?? "—")</strong>
            <span class="compliance-kpi-meta">@(Model.LastSync is null ? "truckban.eu, jednom dnevno" : Model.LastSync.Error ?? $"{Model.LastSync.Bans} zabrana, {Model.LastSync.Days} dana")</span>
        </article>
    </section>

    <section class="pm-card pm-panel">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Čeka potvrdu</h2>
                <p class="pm-card-subtitle">Nove ili izmenjene zabrane, i potvrđene zabrane koje je izvor uklonio. Na mapu, u rutiranje i na telefone ide samo potvrđeno.</p>
            </div>
            <form method="post" asp-page-handler="Sync">
                <button type="submit" class="pm-btn pm-btn-secondary">Preuzmi sada</button>
            </form>
        </header>

        @if (Model.ForReview.Count == 0)
        {
            <p class="pm-card-subtitle">Nema zabrana koje čekaju potvrdu.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Review">
                <div class="pm-table-wrap">
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th><input type="checkbox" onclick="document.querySelectorAll('input[name=ids]').forEach(c => c.checked = this.checked)" aria-label="Izaberi sve" /></th>
                                <th>Datum</th>
                                <th>Država</th>
                                <th>Vreme (lokalno)</th>
                                <th>Važi za</th>
                                <th>Stanje</th>
                                <th>Putevi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ban in Model.ForReview)
                            {
                                <tr>
                                    <td><input type="checkbox" name="ids" value="@ban.Id" /></td>
                                    <td>@ban.BanDate.ToString("ddd dd.MM.yyyy")</td>
                                    <td>@ban.CountryName (@ban.CountryCode)</td>
                                    <td>@IndexModel.Clock(ban.StartMinute) – @IndexModel.Clock(ban.EndMinute)</td>
                                    <td>@(ban.Regional ? "deo puteva" : "cela država")</td>
                                    <td>@(ban.RemovedAtSource is null ? "nova" : "uklonjena na izvoru")</td>
                                    <td style="white-space: pre-line; max-width: 32rem;">@ban.Info</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pm-toolbar">
                    <button type="submit" name="approve" value="true" class="pm-btn">Potvrdi izabrane</button>
                    <button type="submit" name="approve" value="false" class="pm-btn pm-btn-secondary">Odbij izabrane / potvrdi uklanjanje</button>
                </div>
            </form>
        }
    </section>

    <section class="pm-card pm-panel">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Na koje kamione se odnosi</h2>
                <p class="pm-card-subtitle">Granica ukupne mase po državi, iz teksta izvora. Dok nije uneta, zabrana važi za sve kamione.</p>
            </div>
        </header>
        <div class="pm-table-wrap">
            <table class="pm-table">
                <thead>
                    <tr><th>Država</th><th>Tekst izvora</th><th>Preko (t)</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var country in Model.Countries)
                    {
                        <tr>
                            <td>@country.CountryName (@country.CountryCode)@(country.NeedsReview ? " · proveriti" : "")</td>
                            <td style="max-width: 36rem;">@country.VehiclesText</td>
                            <td colspan="2">
                                <form method="post" asp-page-handler="Weight" class="pm-toolbar">
                                    <input type="hidden" name="countryCode" value="@country.CountryCode" />
                                    <input type="number" name="minWeightT" value="@country.MinWeightT" step="0.5" min="0" max="60" class="pm-input" style="width: 6rem;" />
                                    <button type="submit" class="pm-btn pm-btn-secondary">Sačuvaj</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="pm-card pm-panel">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Potvrđene, narednih 14 dana</h2>
            </div>
        </header>
        <div class="pm-table-wrap">
            <table class="pm-table">
                <thead>
                    <tr><th>Datum</th><th>Država</th><th>Vreme (lokalno)</th><th>Važi za</th><th>Potvrdio</th></tr>
                </thead>
                <tbody>
                    @foreach (var ban in Model.Upcoming)
                    {
                        <tr>
                            <td>@ban.BanDate.ToString("ddd dd.MM.yyyy")</td>
                            <td>@ban.CountryName</td>
                            <td>@IndexModel.Clock(ban.StartMinute) – @IndexModel.Clock(ban.EndMinute)</td>
                            <td>@(ban.Regional ? "deo puteva" : "cela država")</td>
                            <td>@ban.ReviewedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
