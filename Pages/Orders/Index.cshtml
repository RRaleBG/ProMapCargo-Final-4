                </div>

                <button type="button"
                        class="pm-orders-filter-reset"
                        id="resetFilters">
                    Resetuj filtere
                </button>

            </div>

            <div class="pm-orders-filters">

                <div class="pm-orders-field">

                    <label class="pm-orders-label"
                           for="orderSearch">
                        Pretraga
                    </label>

                    <input id="orderSearch"
                           class="pm-orders-input"
                           type="search"
                           placeholder="ID naloga, kupac, referenca..."
                           autocomplete="off" />

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label"
                           for="orderCustomer">
                        Kupac
                    </label>

                    <select id="orderCustomer"
                            class="pm-orders-select">

                        <option value="">Svi kupci</option>
                        <option value="ACME Logistics">ACME Logistics</option>
                        <option value="Delta Trade">Delta Trade</option>
                        <option value="EuroCargo">EuroCargo</option>
                        <option value="Trans Balkan">Trans Balkan</option>
                        <option value="Nord Cargo">Nord Cargo</option>

                    </select>

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label"
                           for="orderPickup">
                        Pickup
                    </label>

                    <select id="orderPickup"
                            class="pm-orders-select">

                        <option value="">Sve lokacije</option>
                        <option value="Beograd">Beograd</option>
                        <option value="Novi Sad">Novi Sad</option>
                        <option value="Niš">Niš</option>
                        <option value="Subotica">Subotica</option>
                        <option value="Kragujevac">Kragujevac</option>

                    </select>

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label"
                           for="orderStatus">
                        Status
                    </label>

                    <select id="orderStatus"
                            class="pm-orders-select">

                        <option value="">Svi statusi</option>
                        <option value="in-transit">In Transit</option>
                        <option value="loading">Loading</option>
                        <option value="planned">Planned</option>
                        <option value="delivered">Delivered</option>
                        <option value="delayed">Delayed</option>

                    </select>

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label"
                           for="orderDate">
                        Datum
                    </label>

                    <select id="orderDate"
                            class="pm-orders-select">

                        <option value="">Svi datumi</option>
                        <option value="today">Danas</option>
                        <option value="tomorrow">Sutra</option>
                        <option value="week">Ove nedelje</option>

                    </select>

                </div>

                <button type="button"
                        class="pm-orders-btn primary pm-orders-filter-action"
                        id="applyFilters">

                    Primeni

                </button>

            </div>

            <div class="pm-orders-status-row">

                <button type="button"
                        class="pm-orders-status-chip active"
