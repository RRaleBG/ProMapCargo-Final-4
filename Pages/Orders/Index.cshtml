            </article>

        </section>

        <section class="pm-orders-filter-card">

            <div class="pm-orders-filter-head">

                <div>

                    <div class="pm-orders-filter-title">
                        Pretraga i filteri
                    </div>

                    <div class="pm-orders-filter-subtitle">
                        Filtriraj naloge prema kupcu, relaciji, statusu i datumu
