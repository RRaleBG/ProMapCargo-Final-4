@page "/orders"
@{
    ViewData["Title"] = "Transportni nalozi · ProMap Cargo";
}

<div class="pm-orders-page" data-module="orders">

    

    <main class="pm-orders-content">

        <header class="pm-orders-header">

            <div class="pm-orders-heading">

                <div class="pm-orders-kicker">
                    Operations · Cargo Management
                </div>

                <h1 class="pm-orders-title">
                    Transportni nalozi
                </h1>

                <div class="pm-orders-subtitle">
                    Planiranje pickup/delivery naloga, cargo statusa i izvršenja transporta
                </div>

            </div>

            <div class="pm-orders-header-actions">

                <button type="button"
                        class="pm-orders-btn"
                        id="ordersRefresh">

                    <span class="pm-orders-btn-icon">
                        ↻
                    </span>

                    Osveži

                </button>

                <a href="/dispatch"
                   class="pm-orders-btn">

                    <span class="pm-orders-btn-icon">
                        ◈
                    </span>

                    Command Center

                </a>

                <button type="button"
                        class="pm-orders-btn primary"
                        id="newOrderButton">

                    <span class="pm-orders-btn-icon">
                        +
                    </span>

                    Novi nalog

                </button>

            </div>

        </header>

        <section class="pm-orders-kpis">

            <article class="pm-orders-kpi">

                <div class="pm-orders-kpi-head">

                    <div class="pm-orders-kpi-label">
                        Ukupno naloga
                    </div>

                    <div class="pm-orders-kpi-icon">
                        ▤
                    </div>

                </div>

                <div class="pm-orders-kpi-value">
                    128
                </div>

                <div class="pm-orders-kpi-meta">
                    aktivni operativni period
                </div>

            </article>

            <article class="pm-orders-kpi">

                <div class="pm-orders-kpi-head">

                    <div class="pm-orders-kpi-label">
                        U transportu
                    </div>

                    <div class="pm-orders-kpi-icon">
                        ↗
                    </div>

                </div>

                <div class="pm-orders-kpi-value">
                    37
                </div>

                <div class="pm-orders-kpi-meta green">
                    trenutno izvršenje
                </div>

            </article>

            <article class="pm-orders-kpi">

                <div class="pm-orders-kpi-head">

                    <div class="pm-orders-kpi-label">
                        Planirano
                    </div>

                    <div class="pm-orders-kpi-icon">
                        ◷
                    </div>

                </div>

                <div class="pm-orders-kpi-value">
                    52
                </div>

                <div class="pm-orders-kpi-meta blue">
                    čeka dodelu ture
                </div>

            </article>

            <article class="pm-orders-kpi">

                <div class="pm-orders-kpi-head">

                    <div class="pm-orders-kpi-label">
                        Kašnjenja
                    </div>

                    <div class="pm-orders-kpi-icon">
                        !
                    </div>

                </div>

                <div class="pm-orders-kpi-value">
                    8
                </div>

                <div class="pm-orders-kpi-meta yellow">
                    zahteva pažnju
                </div>

            </article>

            <article class="pm-orders-kpi">

                <div class="pm-orders-kpi-head">

                    <div class="pm-orders-kpi-label">
                        Isporuke danas
                    </div>

                    <div class="pm-orders-kpi-icon">
                        ✓
                    </div>

                </div>

                <div class="pm-orders-kpi-value">
                    31
                </div>

                <div class="pm-orders-kpi-meta green">
                    27 uspešno završeno
