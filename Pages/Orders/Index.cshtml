@page "/orders"
@{
    ViewData["Title"] = "Transportni nalozi · ProMap Cargo";
}

<div class="pm-page" data-module="orders">   


    <!-- Page Header -->
    <header class="pm-header">
        <div class="pm-heading">
            <div class="pm-page-kicker">
                <span class="pm-kicker-dot"></span>
                Nalozi
            </div>
            <p class="pm-page-subtitle">
                Planiranje pickup/delivery naloga, cargo statusa i izvršenja transporta
            </p>
        </div>
        <div class="pm-header-actions">

            <button class="pm-btn" type="button" id="ordersRefresh">
                <span> <i data-lucide="refresh-cw" class="compliance-kpi-icon"></i> </span>
                <small>Osveži</small>
            </button>

            <a class="pm-btn pm-btn-primary" href="/orders/new" id="newOrder">
                <span> <i data-lucide="plus" class="compliance-kpi-icon"></i> </span>
                <small>Novi nalog</small>
            </a>
        </div>
    </header>


       
    <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--5" aria-label="Statistika naloga">
        <article class="compliance-kpi compliance-kpi-total">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Ukupno naloga</span>
                <i data-lucide="clipboard-list" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiTotal">—</strong>
            <span class="compliance-kpi-meta">aktivni operativni period</span>
        </article>

        <article class="compliance-kpi compliance-kpi-info">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">U transportu</span>
                <i data-lucide="truck" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiTransit">—</strong>
            <span class="compliance-kpi-meta">trenutno izvršenje</span>
        </article>

        <article class="compliance-kpi compliance-kpi-neutral">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Planirano</span>
                <i data-lucide="calendar-clock" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiPlanned">—</strong>
            <span class="compliance-kpi-meta">čeka dodelu ture</span>
        </article>

        <article class="compliance-kpi compliance-kpi-warning">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Kašnjenja</span>
                <i data-lucide="clock-alert" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiDelayed">—</strong>
            <span class="compliance-kpi-meta">zahteva pažnju</span>
        </article>

        <article class="compliance-kpi compliance-kpi-good">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Isporuke danas</span>
                <i data-lucide="package-check" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiDeliveredToday">—</strong>
            <span class="compliance-kpi-meta"><span id="kpiDeliveredMeta">—</span></span>
        </article>
    </section>

    <section class="pm-orders-filter-card pm-panel">

            <div class="pm-orders-filter-head pm-toolbar">

                <div>

                    <div class="pm-orders-filter-title pm-panel-title">
                        Pretraga i filteri
                    </div>

                    <div class="pm-orders-filter-subtitle pm-panel-subtitle">
                        Filtriraj naloge prema kupcu, relaciji, statusu i datumu
                    </div>

                </div>

                <button type="button" class="pm-orders-filter-reset pm-btn pm-btn-ghost" id="resetFilters">
                    Resetuj filtere
                </button>

            </div>

            <div class="pm-orders-filters">

                <div class="pm-orders-field">

                    <label class="pm-orders-label pm-label" for="orderSearch">
                        Pretraga
                    </label>

                    <input id="orderSearch" class="pm-orders-input pm-input" type="search"
                           placeholder="ID naloga, kupac, referenca..." autocomplete="off" />

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label pm-label" for="orderCustomer">
                        Kupac
                    </label>

                    <select id="orderCustomer" class="pm-orders-select pm-select">
                    <option value="">Svi kupci</option>
                </select>

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label pm-label" for="orderPickup">
                        Pickup
                    </label>

                    <select id="orderPickup" class="pm-orders-select pm-select">
                    <option value="">Sve lokacije</option>
                </select>

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label pm-label" for="orderStatus">
                        Status
                    </label>

                    <select id="orderStatus" class="pm-orders-select pm-select">

                        <option value="">Svi statusi</option>
                        <option value="in-transit">In Transit</option>
                        <option value="loading">Loading</option>
                        <option value="planned">Planned</option>
                        <option value="delivered">Delivered</option>
                        <option value="delayed">Delayed</option>

                    </select>

                </div>

                <div class="pm-orders-field">

                    <label class="pm-orders-label pm-label" for="orderDate">
                        Datum
                    </label>

                    <select id="orderDate" class="pm-orders-select pm-select">

                        <option value="">Svi datumi</option>
                        <option value="today">Danas</option>
                        <option value="tomorrow">Sutra</option>
                        <option value="week">Ove nedelje</option>

                    </select>

                </div>

                <button type="button" class="pm-orders-filter-action pm-btn pm-btn-primary" id="applyFilters">

                    Primeni

                </button>

            </div>

            <div class="pm-orders-status-row pm-filter-group">

                <button type="button" class="pm-orders-status-chip pm-filter-btn active" data-status="all">

                    Svi

                    <span class="count">
                        128
                    </span>

                </button>

                <button type="button" class="pm-orders-status-chip pm-filter-btn" data-status="planned">

                    Planned

                    <span class="count">
                        52
                    </span>

                </button>

                <button type="button" class="pm-orders-status-chip pm-filter-btn" data-status="loading">

                    Loading

                    <span class="count">
                        18
                    </span>

                </button>

                <button type="button" class="pm-orders-status-chip pm-filter-btn" data-status="in-transit">

                    In Transit

                    <span class="count">
                        37
                    </span>

                </button>

                <button type="button" class="pm-orders-status-chip pm-filter-btn" data-status="delivered">

                    Delivered

                    <span class="count">
                        13
                    </span>

                </button>

                <button type="button" class="pm-orders-status-chip pm-filter-btn" data-status="delayed">

                    Delayed

                    <span class="count">
                        8
                    </span>

                </button>

            </div>

        </section>

    <section class="pm-orders-main-grid">

            <article class="pm-orders-table-card pm-panel">

                <div class="pm-orders-table-head pm-panel-heading">

                    <div>

                        <div class="pm-orders-table-title">
                            Lista transportnih naloga
                        </div>

                        <div class="pm-orders-table-subtitle">
                            Operativni pregled pickup / delivery zahteva
                        </div>

                    </div>

                    <div class="pm-orders-result-count">
                        Prikazano:
                        <strong id="visibleOrderCount">
                            5
                        </strong>
                        naloga
                    </div>

                </div>

                <div class="pm-orders-table-scroll pm-panel-body">

                    <table class="pm-orders-table">

                        <thead>

                            <tr>

                                <th style="width:125px;">
                                    Order
                                </th>

                                <th style="width:125px;">
                                    Kupac
                                </th>

                                <th style="width:185px;">
                                    Pickup / Delivery
                                </th>

                                <th style="width:105px;">
                                    Cargo
                                </th>

                                <th style="width:70px;">
                                    Težina
                                </th>

                                <th style="width:90px;">
                                    Termin
                                </th>

                                <th style="width:90px;">
                                    Status
                                </th>

                                <th style="width:75px;">
                                    Prioritet
                                </th>

                                <th style="width:80px;">
                                    Akcije
                                </th>

                            </tr>

                        </thead>

                        <tbody id="ordersTableBody">

                        </tbody>

                    </table>

                    <div class="pm-orders-empty" id="ordersEmpty">
                        Nema naloga koji odgovaraju izabranim filterima.
                    </div>

                </div>

                <div class="pm-orders-pagination pm-toolbar">

                    <div class="pm-orders-pagination-info" id="ordersPaginationInfo">
                        —
                    </div>

                    <div class="pm-orders-pagination-actions pm-filter-group" id="ordersPagination">
                    </div>

                </div>

            </article>

            <aside class="pm-orders-detail-card pm-panel">

                <div class="pm-orders-detail-head pm-panel-heading">

                    <div class="pm-orders-detail-kicker">
                        Selected order
                    </div>

                    <div class="pm-orders-detail-title" id="detailOrderId">
                        ORD-2026-00128
                    </div>

                    <div class="pm-orders-detail-customer" id="detailCustomer">
                        ACME Logistics · REF-ACM-8841
                    </div>

                    <div class="pm-orders-detail-status">

                        <span class="pm-orders-badge green" id="detailStatus">—</span>

                    </div>

                </div>

                <div class="pm-orders-detail-body pm-panel-body">

                    <section class="pm-orders-detail-section">

                        <div class="pm-orders-detail-section-title pm-panel-title">
                            Transport route
                        </div>

                        <div class="pm-orders-detail-route">

                            <div class="pm-orders-route-line"></div>

                            <div class="pm-orders-detail-point">

                                <span class="pm-orders-detail-point-dot"></span>

                                <div class="pm-orders-detail-point-label" id="detailPickupLabel">
                                    Pickup
                                </div>

                                <div class="pm-orders-detail-point-place" id="detailPickupPlace">
                                    Beograd, Srbija
                                </div>

                                <div class="pm-orders-detail-point-time" id="detailPickupTime">
                                    18.09.2026 · 08:00–10:00
                                </div>

                            </div>

                            <div class="pm-orders-detail-point">

                                <span class="pm-orders-detail-point-dot delivery"></span>

                                <div class="pm-orders-detail-point-label" id="detailDeliveryLabel">
                                    Delivery
                                </div>

                                <div class="pm-orders-detail-point-place" id="detailDeliveryPlace">
                                    München, Germany
                                </div>

                                <div class="pm-orders-detail-point-time" id="detailDeliveryTime">
                                    18.09.2026 · ETA 18:40
                                </div>

                            </div>

                        </div>

                    </section>

                    <section class="pm-orders-detail-section">

                        <div class="pm-orders-detail-section-title pm-panel-title">
                            Cargo
                        </div>

                        <div class="pm-orders-detail-grid">

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Tip
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailCargo">
                                    Industrijska roba
                                </div>

                            </div>

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Operacija
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailOperation">
                                    FTL
                                </div>

                            </div>

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Težina
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailWeight">
                                    18 t
                                </div>

                            </div>

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Palete
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailPallets">
                                    14
                                </div>

                            </div>

                        </div>

                    </section>

                    <section class="pm-orders-detail-section">

                        <div class="pm-orders-detail-section-title pm-panel-title">
                            Execution
                        </div>

                        <div class="pm-orders-detail-grid">

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Tura
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailTrip">
                                    TRP-8841
                                </div>

                            </div>

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Vozilo
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailVehicle">
                                    BG-241-AA
                                </div>

                            </div>

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Vozač
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailDriver">
                                    M. Petrović
                                </div>

                            </div>

                            <div class="pm-orders-detail-stat">

                                <div class="pm-orders-detail-stat-label">
                                    Napredak
                                </div>

                                <div class="pm-orders-detail-stat-value" id="detailProgress">
                                    68%
                                </div>

                            </div>

                        </div>

                    </section>

                    <section class="pm-orders-detail-section">

                        <div class="pm-orders-detail-section-title pm-panel-title">
                            Actions
                        </div>

                        <div class="pm-orders-detail-actions pm-card-actions pm-filter-group">

                            <a href="/trips" class="pm-orders-btn primary" id="detailTripLink">
                                Otvori turu
                            </a>

                            <a href="/navigation" class="pm-orders-btn">
                                Navigacija
                            </a>

                            <button type="button" class="pm-orders-btn" id="editOrderButton">
                                Izmeni
                            </button>

                            <button type="button" class="pm-orders-btn" id="orderMoreButton">
                                Više
                            </button>

                        </div>

                    </section>

                </div>

            </aside>

        </section>

</div>

