@page "/orders/new"
@{
    ViewData["Title"] = "Novi transportni nalog · ProMap Cargo";
}

<div class="pm-page" data-module="orders/new">

    <header class="pm-header">
        <div class="pm-heading">
            <div class="pm-page-kicker">
                <span class="pm-kicker-dot"></span>
                Novi nalog
            </div>
            <p class="pm-page-subtitle">
                Kreiranje transportnog naloga i njegovih transportnih tačaka
            </p>
        </div>

        <div class="pm-header-actions">
            <a class="pm-btn" href="/orders">
                <i data-lucide="arrow-left" width="18" height="18" aria-hidden="true"></i>
                <small>Nalozi</small>
            </a>
        </div>
    </header>

    <form id="orderForm" class="pm-card" novalidate>

        <div class="pm-card-head">
            <div>
                <strong>Osnovni podaci</strong>
                <small>Podaci o nalogu i teretu</small>
            </div>
        </div>

        <div class="pm-grid pm-grid-3">

            <div class="pm-field">
                <label class="pm-label" for="orderNumber">Broj naloga *</label>
                <input id="orderNumber" class="pm-input" maxlength="100" autocomplete="off" required />
            </div>

            <div class="pm-field">
                <label class="pm-label" for="customerName">Kupac *</label>
                <input id="customerName" class="pm-input" maxlength="200" autocomplete="organization" required />
            </div>

            <div class="pm-field">
                <label class="pm-label" for="priority">Prioritet</label>
                <select id="priority" class="pm-select">
                    <option value="Low">Nizak</option>
                    <option value="Normal" selected>Normalan</option>
                    <option value="High">Visok</option>
                    <option value="Critical">Kritičan</option>
                </select>
            </div>

        </div>

        <div class="pm-grid pm-grid-4">

            <div class="pm-field">
                <label class="pm-label" for="cargoDescription">Opis tereta</label>
                <input id="cargoDescription" class="pm-input" maxlength="1000" autocomplete="off" />
            </div>

            <div class="pm-field">
                <label class="pm-label" for="cargoWeightTons">Težina (t)</label>
                <input id="cargoWeightTons" class="pm-input" type="number" min="0" step="0.01" />
            </div>

            <div class="pm-field">
                <label class="pm-label" for="cargoVolumeM3">Zapremina (m³)</label>
                <input id="cargoVolumeM3" class="pm-input" type="number" min="0" step="0.01" />
            </div>

            <div class="pm-field">
                <label class="pm-label" for="pallets">Palete</label>
                <input id="pallets" class="pm-input" type="number" min="0" step="1" />
            </div>

        </div>

        <div class="pm-field">
            <label class="pm-check">
                <input id="hazmat" type="checkbox" />
                <span>ADR / opasan teret</span>
            </label>
        </div>

        <section class="pm-card">
            <div class="pm-card-head">
                <div>
                    <strong>Transportne tačke</strong>
                    <small>Utovar, istovar i ostale operativne tačke</small>
                </div>

                <button id="addStop" class="pm-btn" type="button">
                    <i data-lucide="plus" width="18" height="18" aria-hidden="true"></i>
                    <small>Dodaj tačku</small>
                </button>
            </div>

            <div id="stops"></div>
        </section>

        <div id="formMessage" class="pm-form-message" hidden aria-live="polite"></div>

        <div class="pm-header-actions">
            <a class="pm-btn" href="/orders">Otkaži</a>
            <button id="saveOrder" class="pm-btn primary" type="submit">
                <i data-lucide="save" width="18" height="18" aria-hidden="true"></i>
                <small>Sačuvaj nalog</small>
            </button>
        </div>

    </form>

</div>
