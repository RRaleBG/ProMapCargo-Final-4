@page "/orders/new"

@{
    ViewData["Title"] = "Novi transportni nalog · ProMap Cargo";
}

<div class="pm-page pm-page--orders/new" data-module="orders/new">

    <header class="pm-page-header pm-header">
        <div class="pm-page-heading">
            <div class="pm-page-kicker">Transportni nalozi · Kreiranje</div>
            <h1 class="pm-page-title">Novi transportni nalog</h1>
            <p class="pm-page-subtitle">
                Kreirajte nalog kroz četiri koraka: osnovni podaci, teret, transportna ruta i završna provera.
            </p>
        </div>

        <div class="pm-page-actions">
            <a class="pm-btn pm-btn-secondary" href="/orders">
                <i data-lucide="arrow-left" aria-hidden="true"></i>
                Nazad na naloge
            </a>
        </div>
    </header>

    <form id="orderForm" novalidate>
        <section class="pm-card">

            <header class="pm-card-header">
                <div class="pm-page-heading">
                    <div class="pm-page-kicker">Novi nalog</div>
                    <h2 class="pm-card-title">Kreiranje transportnog naloga</h2>
                    <p class="pm-card-subtitle">
                        Podaci se proveravaju pre slanja na server. Obavezna polja su označena zvezdicom.
                    </p>
                </div>

                <div class="pm-page-actions">
                    <span class="pm-help" id="orderStepStatus">Korak 1 od 4</span>
                </div>
            </header>

            <nav class="pm-tabs" role="tablist" aria-label="Koraci transportnog naloga">
                <button type="button" class="pm-tab is-active" role="tab"
                        aria-selected="true" tabindex="0"
                        data-order-tab="basic"
                        aria-controls="order-panel-basic">
                    <span>1</span>
                    Osnovno
                </button>

                <button type="button" class="pm-tab" role="tab"
                        aria-selected="false" tabindex="-1"
                        data-order-tab="cargo"
                        aria-controls="order-panel-cargo">
                    <span>2</span>
                    Teret
                </button>

                <button type="button" class="pm-tab" role="tab"
                        aria-selected="false" tabindex="-1"
                        data-order-tab="stops"
                        aria-controls="order-panel-stops">
                    <span>3</span>
                    Ruta
                </button>

                <button type="button" class="pm-tab" role="tab"
                        aria-selected="false" tabindex="-1"
                        data-order-tab="review"
                        aria-controls="order-panel-review">
                    <span>4</span>
                    Pregled
                </button>
            </nav>

            <section id="order-panel-basic"
                     class="pm-tab-panel is-active"
                     data-order-panel="basic"
                     role="tabpanel"
                     aria-labelledby="order-tab-basic">
                <div class="pm-card-header">
                    <div>
                        <h2 class="pm-card-title">Osnovni podaci</h2>
                        <p class="pm-card-subtitle">Identifikacija transportnog naloga i kupca.</p>
                    </div>
                </div>

                <div class="pm-card-body">
                    <div class="pm-form-grid pm-form-grid-3">
                        <div class="pm-field">
                            <label class="pm-label" for="orderNumber">Broj naloga *</label>
                            <input id="orderNumber" class="pm-input"
                                   maxlength="100" autocomplete="off" required />
                            <div id="orderNumber-error" class="pm-error" hidden></div>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="customerName">Kupac *</label>
                            <input id="customerName" class="pm-input"
                                   maxlength="200" autocomplete="organization" required />
                            <div id="customerName-error" class="pm-error" hidden></div>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="priority">Prioritet</label>
                            <select id="priority" class="pm-select">
                                <option value="Low">Nizak</option>
                                <option value="Normal" selected>Normalan</option>
                                <option value="High">Visok</option>
                                <option value="Critical">Kritičan</option>
                            </select>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="driverId">Vozač</label>
                            <select id="driverId" class="pm-select">
                                <option value="">Bez vozača (dodeliti kasnije)</option>
                            </select>
                            <div class="pm-help" id="driverVehicleHint">Kamion i prikolica idu uz vozača (dodela na strani Vozila).</div>
                        </div>
                    </div>

                    <h3 class="pm-card-title pm-order-finance-title">Cena i akontacija</h3>
                    <div class="pm-form-grid pm-form-grid-4 pm-order-finance-grid">
                        <div class="pm-field">
                            <label class="pm-label" for="transportPrice">Cena transporta</label>
                            <input id="transportPrice" class="pm-input" type="number" min="0" step="0.01" inputmode="decimal" />
                            <div id="transportPrice-error" class="pm-error" hidden></div>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="currency">Valuta</label>
                            <select id="currency" class="pm-select">
                                <option value="EUR" selected>EUR</option>
                                <option value="RSD">RSD</option>
                            </select>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="driverEarningPercent">Zarada vozača (%)</label>
                            <input id="driverEarningPercent" class="pm-input" type="number" min="0" max="100" step="0.1" inputmode="decimal" />
                            <div id="driverEarningPercent-error" class="pm-error" hidden></div>
                            <div class="pm-help" id="driverEarningAmount">Zarada: —</div>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="advanceAmount">Akontacija vozaču</label>
                            <input id="advanceAmount" class="pm-input" type="number" min="0" step="0.01" inputmode="decimal" />
                            <div id="advanceAmount-error" class="pm-error" hidden></div>
                            <div class="pm-help">Za putne troškove; vozač je opravdava poslovnim troškovima u aplikaciji.</div>
                        </div>
                    </div>
                </div>

                <footer class="pm-card-footer">
                    <div class="pm-page-actions">
                        <button type="button" class="pm-btn pm-btn-primary" data-order-next="cargo">
                            Nastavi
                            <i data-lucide="arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </footer>
            </section>

            <section id="order-panel-cargo"
                     class="pm-tab-panel"
                     data-order-panel="cargo"
                     role="tabpanel"
                     hidden>
                <div class="pm-card-header">
                    <div>
                        <h2 class="pm-card-title">Podaci o teretu</h2>
                        <p class="pm-card-subtitle">Težina, zapremina, palete i ADR status.</p>
                    </div>
                </div>

                <div class="pm-card-body">
                    <div class="pm-form-grid pm-form-grid-3">
                        <div class="pm-field">
                            <label class="pm-label" for="cargoDescription">Opis tereta</label>
                            <textarea id="cargoDescription" class="pm-textarea"
                                      rows="4" maxlength="1000"></textarea>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="cargoWeightTons">Težina (t)</label>
                            <input id="cargoWeightTons" class="pm-input"
                                   type="number" min="0" step="0.01" />
                            <div id="cargoWeightTons-error" class="pm-error" hidden></div>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="cargoVolumeM3">Zapremina (m³)</label>
                            <input id="cargoVolumeM3" class="pm-input"
                                   type="number" min="0" step="0.01" />
                            <div id="cargoVolumeM3-error" class="pm-error" hidden></div>
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="pallets">Palete</label>
                            <input id="pallets" class="pm-input"
                                   type="number" min="0" step="1" />
                            <div id="pallets-error" class="pm-error" hidden></div>
                        </div>

                        <div class="pm-field">
                            <span class="pm-label">Bezbednost</span>
                            <label class="pm-check" for="hazmat">
                                <input id="hazmat" type="checkbox" />
                                <span>ADR / opasan teret</span>
                            </label>
                        </div>
                    </div>
                </div>

                <footer class="pm-card-footer">
                    <div class="pm-page-actions">
                        <button type="button" class="pm-btn pm-btn-secondary" data-order-prev="basic">
                            <i data-lucide="arrow-left" aria-hidden="true"></i>
                            Nazad
                        </button>
                        <button type="button" class="pm-btn pm-btn-primary" data-order-next="stops">
                            Ruta
                            <i data-lucide="arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </footer>
            </section>

            <section id="order-panel-stops"
                     class="pm-tab-panel"
                     data-order-panel="stops"
                     role="tabpanel"
                     hidden>
                <div class="pm-card-header">
                    <div>
                        <h2 class="pm-card-title">Transportna ruta</h2>
                        <p class="pm-card-subtitle">
                            Potrebna je najmanje jedna utovarna i jedna istovarna tačka.
                        </p>
                    </div>

                    <div class="pm-card-actions">
                        <button id="addStop" type="button" class="pm-btn pm-btn-secondary">
                            <i data-lucide="plus" aria-hidden="true"></i>
                            Dodaj tačku
                        </button>
                    </div>
                </div>

                <div id="stops" class="pm-card-body"></div>

                <footer class="pm-card-footer">
                    <div class="pm-page-actions">
                        <button type="button" class="pm-btn pm-btn-secondary" data-order-prev="cargo">
                            <i data-lucide="arrow-left" aria-hidden="true"></i>
                            Nazad
                        </button>
                        <button type="button" class="pm-btn pm-btn-primary" data-order-next="review">
                            Pregled
                            <i data-lucide="arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </footer>
            </section>

            <section id="order-panel-review"
                     class="pm-tab-panel"
                     data-order-panel="review"
                     role="tabpanel"
                     hidden>
                <div class="pm-card-header">
                    <div>
                        <h2 class="pm-card-title">Pregled naloga</h2>
                        <p class="pm-card-subtitle">Proverite podatke pre kreiranja naloga.</p>
                    </div>
                </div>

                <div class="pm-card-body">
                    <div class="pm-form-grid pm-form-grid-3">
                        <div class="pm-field">
                            <label class="pm-label" for="reviewOrderNumber">Broj naloga</label>
                            <input id="reviewOrderNumber" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewCustomerName">Kupac</label>
                            <input id="reviewCustomerName" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewPriority">Prioritet</label>
                            <input id="reviewPriority" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewWeight">Težina</label>
                            <input id="reviewWeight" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewVolume">Zapremina</label>
                            <input id="reviewVolume" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewPallets">Palete</label>
                            <input id="reviewPallets" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewHazmat">ADR</label>
                            <input id="reviewHazmat" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewDriver">Vozač / vozilo</label>
                            <input id="reviewDriver" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewPrice">Cena / zarada vozača</label>
                            <input id="reviewPrice" class="pm-input" readonly />
                        </div>

                        <div class="pm-field">
                            <label class="pm-label" for="reviewAdvance">Akontacija</label>
                            <input id="reviewAdvance" class="pm-input" readonly />
                        </div>
                    </div>

                    <div class="pm-mt-4">
                        <div class="pm-label">Transportne tačke</div>
                        <div id="reviewStops" class="pm-form-grid"></div>
                    </div>
                </div>

                <footer class="pm-card-footer">
                    <div class="pm-page-actions">
                        <button type="button" class="pm-btn pm-btn-secondary" data-order-prev="stops">
                            <i data-lucide="arrow-left" aria-hidden="true"></i>
                            Nazad
                        </button>
                        <button id="saveOrder" class="pm-btn pm-btn-primary" type="submit">
                            <i data-lucide="save" aria-hidden="true"></i>
                            Sačuvaj nalog
                        </button>
                    </div>
                </footer>
            </section>

        </section>
    </form>
</div>
