@page "/compliance"
@model ProMapCargo.Api.Pages.Compliance.IndexModel
@{
    ViewData["Title"] = "Compliance · ProMap Cargo";
}

<div class="pm-page pm-page--compliance" data-module="compliance">

    <header class="pm-header pm-page-header">

        <div class="pm-heading">
            <div class="pm-page-kicker">
                <span class="pm-kicker-dot"></span>
                Compliance
            </div>
            <p class="pm-page-subtitle">
                Pregled i upravljanje dokumentacijom vozila, prikolica i opreme. Obezbedite da sva vozila u floti budu u skladu sa zakonskim propisima i bez kritičnih problema.
            </p>
        </div>

        <div class="pm-header-actions">
            <button class="pm-btn pm-btn-secondary" type="button" id="refreshCompliance">
                <span>↻</span>
                Osveži
            </button>

            <button class="pm-btn pm-btn-secondary" type="button" id="addDocumentTop">
                <span>＋</span>
                Novi dokument
            </button>
        </div>
    </header>


    <!-- GLOBAL CRITICAL ALERT -->

    <section class="compliance-critical-banner" id="criticalBanner">
        <div class="critical-banner-icon">!</div>

        <div class="critical-banner-content">
            <strong id="criticalBannerTitle">
                Učitavanje…
            </strong>

            <span id="criticalBannerText">
                Postoje istekli ili nedostajući obavezni dokumenti.
                Vozila sa kritičnim problemima mogu biti blokirana za operativnu upotrebu.
            </span>
        </div>

        <button type="button" class="critical-banner-action" id="showBlockedVehicles">
            Prikaži blokirana vozila
        </button>
    </section>


    <!-- FLEET STATUS -->

    <section class="moderation-kpi-grid pm-kpi-grid" aria-label="Usklađenost pregled">
        <article class="compliance-kpi compliance-kpi-total pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Ukupno vozila</span>
                <i data-lucide="truck" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="totalVehicles">—</strong>
            <span class="compliance-kpi-meta">aktivna flota</span>
        </article>

        <article class="compliance-kpi compliance-kpi-good pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Ispravna</span>
                <i data-lucide="circle-check" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="compliantVehicles">—</strong>
            <span class="compliance-kpi-meta">bez kritičnih problema</span>
        </article>

        <article class="compliance-kpi compliance-kpi-warning pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Ističe uskoro</span>
                <i data-lucide="triangle-alert" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="expiringVehicles">—</strong>
            <span class="compliance-kpi-meta">dokumenti u narednih 30 dana</span>
        </article>

        <article class="compliance-kpi compliance-kpi-danger pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Blokirano</span>
                <i data-lucide="shield-x" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="blockedVehicles">—</strong>
            <span class="compliance-kpi-meta">zahtevaju važeći dokument</span>
        </article>

        <article class="compliance-kpi compliance-kpi-info pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Prikolice</span>
                <i data-lucide="trailer" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="trailerCount">—</strong>
            <span class="compliance-kpi-meta">registrovane prikolice</span>
        </article>

        <article class="compliance-kpi compliance-kpi-neutral pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Dokumenti</span>
                <i data-lucide="file-text" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="documentCount">—</strong>
            <span class="compliance-kpi-meta">evidentiranih zapisa</span>
        </article>
    </section>


    <!-- SEARCH / FILTER -->

    <section class="compliance-toolbar pm-toolbar">

        <div class="compliance-search">
            <span class="compliance-search-icon"><i data-lucide="search" class="pm-icon" aria-hidden="true"></i></span>

            <input
                class="pm-search-input"
                type="search"
                id="vehicleSearch"
                placeholder="Pretraži registraciju, VIN, model ili prikolicu..."
                autocomplete="off" />
        </div>

        <div class="compliance-filter-group pm-filter-group">

            <button
                type="button"
                class="compliance-filter pm-filter-btn active pm-btn"
                data-status-filter="all">
                Sva vozila
                <span>42</span>
            </button>

            <button
                type="button"
                class="compliance-filter pm-filter-btn pm-btn"
                data-status-filter="compliant">
                Compliant
                <span>31</span>
            </button>

            <button
                type="button"
                class="compliance-filter pm-filter-btn pm-btn"
                data-status-filter="expiring">
                Ističe
                <span>7</span>
            </button>

            <button
                type="button"
                class="compliance-filter pm-filter-btn pm-btn"
                data-status-filter="blocked">
                Blokirana
                <span>4</span>
            </button>

        </div>

        <select class="compliance-select pm-select" id="vehicleTypeFilter">
            <option value="all">Sva vozila</option>
            <option value="truck">Kamioni</option>
            <option value="trailer">Prikolice</option>
        </select>

    </section>


    <!-- MAIN WORKSPACE -->

    <section class="compliance-workspace pm-workspace-split">

        <!-- VEHICLE LIST -->

        <div class="vehicle-list-panel pm-panel">

            <div class="panel-heading pm-panel-heading">
                <div>
                    <span class="panel-kicker pm-page-kicker">FLEET</span>
                    <h2>Vozila</h2>
                </div>

                <span class="vehicle-count" id="visibleVehicleCount">—</span>
            </div>

            <div class="vehicle-list" id="vehicleList">

            </div>

        </div>


        <!-- DETAIL PANEL -->

        <div class="vehicle-detail-panel" id="vehicleDetailPanel">

            <div class="detail-header">

                <div class="detail-vehicle">

                    <div class="detail-vehicle-icon" id="detailVehicleIcon">
                        🚛
                    </div>

                    <div>
                        <span class="detail-kicker">SELECTED VEHICLE</span>
                        <h2 id="detailVehicleTitle">—</h2>
                        <p id="detailVehicleSubtitle">
                            Izaberite vozilo
                        </p>
                    </div>

                </div>

                <div class="detail-header-status" id="detailStatus"></div>

            </div>


            <!-- COMPLIANCE LOCK -->

            <section class="compliance-lock" id="complianceLock" hidden>

                <div class="lock-icon">
                    !
                </div>

                <div class="lock-content">
                    <strong>COMPLIANCE BLOKADA</strong>

                    <span>
                        Ovo vozilo trenutno nije odobreno za operativnu upotrebu
                        zbog kritičnog dokumenta.
                    </span>

                    <small id="complianceLockText"></small>
                </div>

                <button type="button" class="lock-action" id="repairCompliance">
                    Unesi važeći dokument
                </button>

            </section>


            <!-- TABS -->

            <nav class="detail-tabs" aria-label="Compliance detalji">

                <button type="button" class="detail-tab active" data-tab="documents">
                    Dokumenti
                    <span data-tab-count="documents">0</span>
                </button>

                <button type="button" class="detail-tab" data-tab="trailer">
                    Prikolica
                    <span data-tab-count="trailer">0</span>
                </button>

                <button type="button" class="detail-tab" data-tab="service">
                    Servis
                    <span data-tab-count="service">0</span>
                </button>

                <button type="button" class="detail-tab" data-tab="repairs">
                    Popravke
                    <span data-tab-count="repairs">0</span>
                </button>

                <button type="button" class="detail-tab" data-tab="faults">
                    Greške
                    <span data-tab-count="faults">0</span>
                </button>

                <button type="button" class="detail-tab" data-tab="notes">
                    Napomene
                    <span data-tab-count="notes">0</span>
                </button>

                <button type="button" class="detail-tab" data-tab="history">
                    Istorija
                </button>

            </nav>


            <!-- DOCUMENTS -->

            <section class="detail-tab-content active" data-content="documents">

                <div class="detail-section-header">

                    <div>
                        <span class="detail-section-kicker">DOCUMENT CONTROL</span>
                        <h3>Dokumenti vozila</h3>
                        <p>
                            Svi obavezni dokumenti, licence i potvrde za vozilo.
                        </p>
                    </div>

                    <button type="button" class="compliance-btn compliance-btn-primary pm-btn" id="addDocument">
                        ＋ Dodaj dokument
                    </button>

                </div>

                <div class="document-list" id="documentList"></div>

            </section>


            <section class="detail-tab-content" data-content="trailer">

                <div class="detail-section-header">

                    <div>
                        <span class="detail-section-kicker">TRUCK → TRAILER</span>
                        <h3>Povezana prikolica</h3>
                        <p>
                            Veza između kamiona i konkretne prikolice ili poluprikolice.
                        </p>
                    </div>

                    <button type="button" class="compliance-btn compliance-btn-primary pm-btn" id="changeTrailer">
                        Promeni prikolicu
                    </button>

                </div>

                <div id="trailerContent"></div>

            </section>


            <section class="detail-tab-content" data-content="service">

                <div class="detail-section-header">

                    <div>
                        <span class="detail-section-kicker">MAINTENANCE</span>
                        <h3>Servis</h3>
                        <p>
                            Mali i veliki servisi, kilometraža, radionica i troškovi.
                        </p>
                    </div>

                    <button type="button" class="compliance-btn compliance-btn-primary pm-btn" id="addService">
                        ＋ Novi servis
                    </button>

                </div>

                <div class="service-summary-grid" id="serviceSummary"></div>

                <div class="service-list" id="serviceList"></div>

            </section>


            <section class="detail-tab-content" data-content="repairs">

                <div class="detail-section-header">

                    <div>
                        <span class="detail-section-kicker">REPAIRS</span>
                        <h3>Popravke</h3>
                        <p>
                            Istorija i status svih popravki na vozilu.
                        </p>
                    </div>

                    <button type="button" class="compliance-btn compliance-btn-primary pm-btn" id="addRepair">
                        ＋ Nova popravka
                    </button>

                </div>

                <div class="repair-list" id="repairList"></div>

            </section>


            <section class="detail-tab-content" data-content="faults">

                <div class="detail-section-header">

                    <div>
                        <span class="detail-section-kicker">FAULT MONITORING</span>
                        <h3>Greške</h3>
                        <p>
                            Prijavljene greške, upozorenja i njihovo rešavanje.
                        </p>
                    </div>

                    <button type="button" class="compliance-btn compliance-btn-primary pm-btn" id="addFault">
                        ＋ Prijavi grešku
                    </button>

                </div>

                <div class="fault-list" id="faultList"></div>

            </section>


            <section class="detail-tab-content" data-content="notes">

                <div class="detail-section-header">

                    <div>
                        <span class="detail-section-kicker">NOTES</span>
                        <h3>Napomene</h3>
                        <p>
                            Operativne i administrativne napomene vezane za vozilo.
                        </p>
                    </div>

                    <button type="button" class="compliance-btn compliance-btn-primary pm-btn" id="addNote">
                        ＋ Nova napomena
                    </button>

                </div>

                <div class="notes-list" id="notesList"></div>

            </section>


            <section class="detail-tab-content" data-content="history">

                <div class="detail-section-header">

                    <div>
                        <span class="detail-section-kicker">AUDIT TRAIL</span>
                        <h3>Istorija</h3>
                        <p>
                            Promene dokumentacije i compliance statusa vozila.
                        </p>
                    </div>

                </div>

                <div class="audit-timeline" id="auditTimeline"></div>

            </section>

        </div>

    </section>

</div>


<!-- DOCUMENT MODAL -->

<div class="compliance-modal" id="documentModal" aria-hidden="true">

    <div class="compliance-modal-backdrop" data-close-modal></div>

    <div class="compliance-modal-dialog">

        <div class="compliance-modal-header">

            <div>
                <span class="modal-kicker">DOCUMENT MANAGEMENT</span>
                <h2 id="documentModalTitle">Novi dokument</h2>
            </div>

            <button type="button" class="modal-close" data-close-modal>
                ×
            </button>

        </div>


        <form id="documentForm" class="compliance-form">

            <div class="form-grid">

                <label class="form-field form-field-full">
                    <span>Tip dokumenta</span>

                    <select id="documentType" required>
                        <option value="">Izaberi dokument</option>
                        <option value="registration">Saobraćajna dozvola</option>
                        <option value="euro-truck">Euro 6 potvrda · kamion</option>
                        <option value="euro-trailer">Euro potvrda · prikolica</option>
                        <option value="technical">Tehnički pregled</option>
                        <option value="tir">TIR sertifikat</option>
                        <option value="license">Licenca / dozvola Republike Srbije</option>
                        <option value="tachograph">Tahograf</option>
                        <option value="fire">PP aparat / sertifikat</option>
                    </select>
                </label>


                <label class="form-field">
                    <span>Broj dokumenta</span>
                    <input id="documentNumber" type="text" placeholder="npr. TIR-2026-001" />
                </label>


                <label class="form-field">
                    <span>Datum izdavanja</span>
                    <input id="documentIssueDate" type="date" />
                </label>


                <label class="form-field">
                    <span>Datum važenja</span>
                    <input id="documentExpiryDate" type="date" required />
                </label>


                <label class="form-field">
                    <span>Organ / izdavalac</span>
                    <input id="documentIssuer" type="text" placeholder="Naziv organa ili organizacije" />
                </label>


                <label class="form-field form-field-full">
                    <span>Dokument</span>

                    <div class="file-upload">

                        <input
                            id="documentFile"
                            type="file"
                            accept=".pdf,.jpg,.jpeg,.png" />

                        <div class="file-upload-content">
                            <strong>Dodaj dokument</strong>
                            <span>PDF, JPG ili PNG</span>
                        </div>

                    </div>
                </label>


                <label class="form-field form-field-full">
                    <span>Napomena</span>
                    <textarea
                        id="documentNote"
                        rows="4"
                        placeholder="Dodatne informacije..."></textarea>
                </label>

            </div>


            <div class="form-compliance-notice">

                <span>i</span>

                <div>
                    <strong>Status se računa automatski.</strong>

                    <p>
                        Sistem će na osnovu datuma važenja odrediti da li je dokument
                        validan, pred istekom ili istekao.
                    </p>
                </div>

            </div>


            <div class="compliance-modal-actions">

                <button
                    type="button"
                    class="compliance-btn compliance-btn-secondary pm-btn"
                    data-close-modal>
                    Otkaži
                </button>

                <button
                    type="submit"
                    class="compliance-btn compliance-btn-primary pm-btn">
                    Sačuvaj dokument
                </button>

            </div>

        </form>

    </div>

</div>


<!-- VEHICLE LOG MODAL (service, repair, fault, note) -->

<div class="compliance-modal" id="logModal" aria-hidden="true">

    <div class="compliance-modal-backdrop" data-close-modal></div>

    <div class="compliance-modal-dialog">

        <div class="compliance-modal-header">

            <div>
                <span class="modal-kicker" id="logModalKicker">MAINTENANCE</span>
                <h2 id="logModalTitle">Novi servis</h2>
            </div>

            <button type="button" class="modal-close" data-close-modal>
                ×
            </button>

        </div>

        <form id="logForm" class="compliance-form">

            <div class="form-grid">

                <label class="form-field" id="logKindField">
                    <span>Vrsta servisa</span>
                    <select id="logKind">
                        <option value="ServiceMinor">Mali servis</option>
                        <option value="ServiceMajor">Veliki servis</option>
                    </select>
                </label>

                <label class="form-field" id="logSeverityField">
                    <span>Ozbiljnost</span>
                    <select id="logSeverity">
                        <option value="Warning">Upozorenje</option>
                        <option value="Critical">Kritično</option>
                    </select>
                </label>

                <label class="form-field form-field-full">
                    <span>Naslov</span>
                    <input id="logTitle" type="text" required placeholder="npr. Zamena pločica" />
                </label>

                <label class="form-field">
                    <span>Datum</span>
                    <input id="logDate" type="datetime-local" />
                </label>

                <label class="form-field" id="logOdometerField">
                    <span>Kilometraža</span>
                    <input id="logOdometer" type="number" min="0" placeholder="km" />
                </label>

                <label class="form-field" id="logCostField">
                    <span>Trošak (EUR)</span>
                    <input id="logCost" type="number" min="0" step="0.01" placeholder="0.00" />
                </label>

                <label class="form-field" id="logWorkshopField">
                    <span>Radionica</span>
                    <input id="logWorkshop" type="text" placeholder="Naziv servisa" />
                </label>

                <label class="form-field form-field-full" id="logCompletedField">
                    <span>Status</span>
                    <select id="logCompleted">
                        <option value="false">Otvoreno</option>
                        <option value="true">Završeno</option>
                    </select>
                </label>

                <label class="form-field form-field-full">
                    <span>Opis</span>
                    <textarea id="logDescription" rows="3" placeholder="Detalji..."></textarea>
                </label>

            </div>

            <div class="compliance-modal-actions">

                <button type="button" class="compliance-btn compliance-btn-secondary pm-btn" data-close-modal>
                    Otkaži
                </button>

                <button type="submit" class="compliance-btn compliance-btn-primary pm-btn">
                    Sačuvaj
                </button>

            </div>

        </form>

    </div>

</div>


<!-- TRAILER MODAL -->

<div class="compliance-modal" id="trailerModal" aria-hidden="true">

    <div class="compliance-modal-backdrop" data-close-modal></div>

    <div class="compliance-modal-dialog">

        <div class="compliance-modal-header">

            <div>
                <span class="modal-kicker">TRUCK → TRAILER</span>
                <h2>Promena prikolice</h2>
            </div>

            <button type="button" class="modal-close" data-close-modal>
                ×
            </button>

        </div>

        <form id="trailerForm" class="compliance-form">

            <div class="form-grid">
                <label class="form-field form-field-full">
                    <span>Prikolica</span>
                    <select id="trailerSelect">
                        <option value="">Bez prikolice</option>
                    </select>
                </label>
            </div>

            <div class="compliance-modal-actions">

                <button type="button" class="compliance-btn compliance-btn-secondary pm-btn" data-close-modal>
                    Otkaži
                </button>

                <button type="submit" class="compliance-btn compliance-btn-primary pm-btn">
                    Sačuvaj
                </button>

            </div>

        </form>

    </div>

</div>


<!-- TOAST -->

<div class="compliance-toast" id="complianceToast">

    <div class="toast-icon">✓</div>

    <div>
        <strong id="toastTitle">Sačuvano</strong>
        <span id="toastText">Promena je uspešno evidentirana.</span>
    </div>

</div>
