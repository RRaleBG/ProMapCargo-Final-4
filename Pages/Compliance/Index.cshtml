@page "/compliance"
@{
    ViewData["Title"] = "Compliance · ProMap Cargo";
}

<div class="pm-page pm-compliance-page" data-module="compliance">

    <header class="compliance-header">
        <div class="compliance-heading">
            <div class="compliance-kicker">
                <span class="compliance-kicker-dot"></span>
                FLEET COMPLIANCE CENTER
            </div>

            <h1>Compliance</h1>

            <p>
                Centralni pregled dokumentacije, tehničke ispravnosti,
                licenci, prikolica i operativne spremnosti vozila.
            </p>
        </div>

        <div class="compliance-header-actions">
            <button class="compliance-btn compliance-btn-secondary" type="button" id="refreshCompliance">
                <span>↻</span>
                Osveži
            </button>

            <button class="compliance-btn compliance-btn-primary" type="button" id="addDocumentTop">
                <span>＋</span>
                Novi dokument
            </button>
        </div>
    </header>


    <!-- GLOBAL CRITICAL ALERT -->

    <section class="compliance-critical-banner" id="criticalBanner">
        <div class="critical-banner-icon">!</div>

        <div class="critical-banner-content">
            <strong id="criticalBannerTitle">
                4 vozila zahtevaju intervenciju
            </strong>

            <span id="criticalBannerText">
                Postoje istekli ili nedostajući obavezni dokumenti.
                Vozila sa kritičnim problemima mogu biti blokirana za operativnu upotrebu.
            </span>
        </div>

        <button type="button" class="critical-banner-action" id="showBlockedVehicles">
            Prikaži blokirana vozila
        </button>
    </section>


    <!-- FLEET STATUS -->

    <section class="compliance-kpi-grid">

        <article class="compliance-kpi compliance-kpi-total">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Ukupno vozila</span>
                <span class="compliance-kpi-icon">🚛</span>
            </div>

            <strong class="compliance-kpi-value" id="totalVehicles">42</strong>

            <span class="compliance-kpi-meta">
                aktivna flota
            </span>
        </article>


        <article class="compliance-kpi compliance-kpi-good">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Compliant</span>
                <span class="compliance-kpi-icon">✓</span>
            </div>

            <strong class="compliance-kpi-value" id="compliantVehicles">31</strong>

            <span class="compliance-kpi-meta">
                bez kritičnih problema
            </span>
        </article>


        <article class="compliance-kpi compliance-kpi-warning">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Ističe uskoro</span>
                <span class="compliance-kpi-icon">!</span>
            </div>

            <strong class="compliance-kpi-value" id="expiringVehicles">7</strong>

            <span class="compliance-kpi-meta">
                dokumenti u narednih 30 dana
            </span>
        </article>


        <article class="compliance-kpi compliance-kpi-danger">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Blokirano</span>
                <span class="compliance-kpi-icon">×</span>
            </div>

            <strong class="compliance-kpi-value" id="blockedVehicles">4</strong>

            <span class="compliance-kpi-meta">
                zahtevaju važeći dokument
            </span>
        </article>


        <article class="compliance-kpi compliance-kpi-info">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Prikolice</span>
                <span class="compliance-kpi-icon">▣</span>
            </div>

            <strong class="compliance-kpi-value">36</strong>

            <span class="compliance-kpi-meta">
                registrovane prikolice
            </span>
        </article>


        <article class="compliance-kpi compliance-kpi-neutral">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Dokumenti</span>
                <span class="compliance-kpi-icon">▤</span>
            </div>

            <strong class="compliance-kpi-value">318</strong>

            <span class="compliance-kpi-meta">
                evidentiranih zapisa
            </span>
        </article>

    </section>


    <!-- SEARCH / FILTER -->

    <section class="compliance-toolbar">

        <div class="compliance-search">
            <span class="compliance-search-icon">⌕</span>

            <input
                type="search"
                id="vehicleSearch"
                placeholder="Pretraži registraciju, VIN, model ili prikolicu..."
                autocomplete="off" />
        </div>

        <div class="compliance-filter-group">

            <button
                type="button"
                class="compliance-filter active"
                data-status-filter="all">
                Sva vozila
                <span>42</span>
            </button>

            <button
                type="button"
                class="compliance-filter"
                data-status-filter="compliant">
                Compliant
                <span>31</span>
            </button>

            <button
                type="button"
                class="compliance-filter"
                data-status-filter="expiring">
                Ističe
                <span>7</span>
            </button>

            <button
                type="button"
                class="compliance-filter"
                data-status-filter="blocked">
                Blokirana
                <span>4</span>
            </button>

        </div>

        <select class="compliance-select" id="vehicleTypeFilter">
            <option value="all">Sva vozila</option>
            <option value="truck">Kamioni</option>
            <option value="trailer">Prikolice</option>
        </select>

    </section>


