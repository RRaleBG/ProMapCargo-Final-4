@page "/driver"
@model ProMapCargo.Api.Pages.Driver.IndexModel
@{
    ViewData["Title"] = "Vozački portal · ProMap Cargo";
}

<div class="pm-page pm-page--driver" data-module="driver">
    <header class="pm-page-header pm-header">
        <div class="pm-page-heading">
            <div class="pm-page-kicker">Flota</div>
            <h1 class="pm-page-title">Vozački portal</h1>
            <p class="pm-page-subtitle" id="driverSubtitle">Aktivna tura, sledeća stanica, uputstva i akcije vozača.</p>
        </div>
        <div class="pm-page-actions">
            <a class="pm-btn pm-btn-secondary" asp-page="/Dispatch/Index">Dispečerski centar</a>
            <a class="pm-btn pm-btn-ghost" asp-page="/Account/Manage/Index">Profil</a>
        </div>
    </header>

    <div class="pm-card pm-card-body" id="driverMessage" hidden></div>

    <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--3" aria-label="Trenutni status vozača">
        <article class="compliance-kpi compliance-kpi-total pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Aktivna tura</span>
                <i data-lucide="route" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="driverTrip">—</strong>
            <span class="compliance-kpi-meta"><span id="driverRoute">—</span></span>
        </article>

        <article class="compliance-kpi compliance-kpi-info pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Sledeća stanica</span>
                <i data-lucide="map-pin" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="driverNextStop">—</strong>
            <span class="compliance-kpi-meta"><span id="driverNextStopInfo">—</span></span>
        </article>

        <article class="compliance-kpi compliance-kpi-good pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Status vožnje</span>
                <i data-lucide="activity" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="driverState">—</strong>
            <span class="compliance-kpi-meta"><span id="driverStateInfo">—</span></span>
        </article>
    </section>

    <section class="pm-grid pm-grid-2">
        <article class="pm-card">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Uputstva za rutu</h2>
                    <p class="pm-card-subtitle">Planirane stanice i isporuka</p>
                </div>
            </header>
            <div class="pm-card-body pm-list" id="driverStops">
                <div class="pm-list-row"><div><strong>Učitavanje…</strong></div></div>
            </div>
        </article>

        <article class="pm-card">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Akcije vozača</h2>
                    <p class="pm-card-subtitle">Ažuriraj status ture ili prijavi događaj</p>
                </div>
            </header>
            <div class="pm-card-body pm-page-actions">
                <button class="pm-btn pm-btn-primary" type="button" id="driverStopAction" disabled>Stigao na stanicu</button>
                <button class="pm-btn pm-btn-secondary" type="button" id="driverPause" disabled>Započni pauzu</button>
                <button class="pm-btn pm-btn-danger" type="button" id="driverIncident" disabled>Prijavi incident</button>
                <a class="pm-btn pm-btn-ghost" id="driverCall" href="#" aria-disabled="true">Pozovi dispečera</a>
            </div>
            <form class="pm-card-body" id="incidentForm" hidden>
                <label class="pm-field">
                    <span class="pm-label">Opis incidenta</span>
                    <textarea class="pm-input" id="incidentMessage" rows="3" required placeholder="Šta se dogodilo i gde?"></textarea>
                </label>
                <label class="pm-field">
                    <span class="pm-label">Ozbiljnost</span>
                    <select class="pm-select" id="incidentSeverity">
                        <option value="Critical">Kritično</option>
                        <option value="Warning">Upozorenje</option>
                    </select>
                </label>
                <div class="pm-page-actions pm-mt-3">
                    <button class="pm-btn pm-btn-danger" type="submit">Pošalji dispečeru</button>
                    <button class="pm-btn pm-btn-ghost" type="button" id="incidentCancel">Otkaži</button>
                </div>
            </form>
        </article>
    </section>
</div>
