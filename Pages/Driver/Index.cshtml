@page "/driver"
@{
    ViewData["Title"] = "Vozački portal · ProMap Cargo";
}

<div class="pm-page" data-module="driver">
    <header class="pm-page-header">
        <div class="pm-page-heading">
            <div class="pm-page-kicker">Flota</div>
            <h1 class="pm-page-title">Vozački portal</h1>
            <p class="pm-page-subtitle">Aktivna tura, sledeća stanica, uputstva i akcije vozača.</p>
        </div>
        <div class="pm-page-actions">
            <a class="pm-btn pm-btn-secondary" asp-page="/Dispatch/Index">Dispečerski centar</a>
            <a class="pm-btn pm-btn-ghost" asp-page="/Account/Manage/Index">Profil</a>
        </div>
    </header>

    <section class="pm-grid pm-grid-3" aria-label="Trenutni status vozača">
        <article class="pm-card pm-card-body">
            <div class="pm-kpi-label">Aktivna tura</div>
            <div class="pm-kpi-value">TRP-8841</div>
            <div class="pm-kpi-footer">Beograd → München</div>
        </article>
        <article class="pm-card pm-card-body">
            <div class="pm-kpi-label">Sledeća stanica</div>
            <div class="pm-kpi-value">Horgoš</div>
            <div class="pm-kpi-footer">Granični prelaz · ETA 17:12</div>
        </article>
        <article class="pm-card pm-card-body">
            <div class="pm-kpi-label">Status vožnje</div>
            <div class="pm-kpi-value">Na dužnosti</div>
            <div class="pm-kpi-footer">Odmor dostupan za 02:14</div>
        </article>
    </section>

    <section class="pm-grid pm-grid-2">
        <article class="pm-card">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Uputstva za rutu</h2>
                    <p class="pm-card-subtitle">Planirane stanice i isporuka</p>
                </div>
            </header>
            <div class="pm-card-body pm-list">
                <div class="pm-list-row">
                    <div><strong>1 · Beograd</strong>
                        <div class="pm-text-muted">Polazak iz utovarnog terminala</div>
                    </div><span class="pm-badge">Polazak</span>
                </div>
                <div class="pm-list-row">
                    <div><strong>2 · Horgoš</strong>
                        <div class="pm-text-muted">Granična i dokumentaciona kontrola</div>
                    </div><span class="pm-badge pm-badge--warning">Granica</span>
                </div>
                <div class="pm-list-row">
                    <div><strong>3 · Budimpešta</strong>
                        <div class="pm-text-muted">Nastavak planiranom rutom</div>
                    </div><span class="pm-badge">Stanica</span>
                </div>
                <div class="pm-list-row">
                    <div><strong>4 · München</strong>
                        <div class="pm-text-muted">Prozor isporuke 18:00–20:00</div>
                    </div><span class="pm-badge pm-badge--success">Odredište</span>
                </div>
            </div>
        </article>

        <article class="pm-card">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Akcije vozača</h2>
                    <p class="pm-card-subtitle">Ažuriraj status ture ili prijavi događaj</p>
                </div>
            </header>
            <div class="pm-card-body pm-page-actions">
                <button class="pm-btn pm-btn-primary" type="button">Stigao na stanicu</button>
                <button class="pm-btn pm-btn-secondary" type="button">Započni pauzu</button>
                <button class="pm-btn pm-btn-danger" type="button">Prijavi incident</button>
                <button class="pm-btn pm-btn-ghost" type="button">Pozovi dispečera</button>
            </div>
        </article>
    </section>
</div>
