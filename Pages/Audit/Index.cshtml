@page "/audit"
@{
    ViewData["Title"] = "Audit · ProMap Cargo";
}

<div class="pm-page" data-module="audit">

    <header class="pm-header">
        <div class="pm-heading">
            <div class="pm-page-kicker">Kontrola</div>
            <p class="pm-page-subtitle">Bezbednosni događaji, operativne izmene i sledljivost.</p>
        </div>
        <div class="pm-header-actions">
            <button class="pm-btn pm-btn-secondary" type="button" id="auditExport">Izvezi CSV</button>
        </div>
    </header>

    <section class="pm-card">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Filteri</h2>
                <p class="pm-card-subtitle">Suzi evidenciju po korisniku, akciji ili periodu.</p>
            </div>
        </header>
        <div class="pm-card-body">
            <form id="auditFilters" class="pm-form-grid pm-form-grid-4">
                <label class="pm-field"><span class="pm-label">Korisnik</span><input class="pm-input" type="search" id="auditUser" placeholder="E-mail ili sistem" /></label>
                <label class="pm-field"><span class="pm-label">Akcija</span><input class="pm-input" type="search" id="auditAction" placeholder="Vrsta događaja" /></label>
                <label class="pm-field"><span class="pm-label">Entitet</span><input class="pm-input" type="search" id="auditEntity" placeholder="ID ili tip entiteta" /></label>
                <label class="pm-field"><span class="pm-label">Od datuma</span><input class="pm-input" type="date" id="auditFrom" /></label>
            </form>
            <div class="pm-page-actions pm-mt-3">
                <button class="pm-btn pm-btn-primary" type="submit" form="auditFilters">Pretraži audit</button>
                <button class="pm-btn pm-btn-ghost" type="button" id="auditClear">Očisti filtere</button>
            </div>
        </div>
    </section>

    <section class="pm-card">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Operativni događaji</h2>
                <p class="pm-card-subtitle" id="auditSummary">Najnovije promene zabeležene u sistemu</p>
            </div>
        </header>
        <div class="pm-table-wrap">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Vreme</th>
                        <th scope="col">Korisnik</th>
                        <th scope="col">Akcija</th>
                        <th scope="col">Entitet</th>
                        <th scope="col">Rezultat</th>
                    </tr>
                </thead>
                <tbody id="auditRows">
                    <tr><td colspan="5">Učitavanje…</td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>
