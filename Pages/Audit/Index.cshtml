@page "/audit" 
@{
    ViewData["Title"] = "Audit · ProMap Cargo";
}

<div id="app" style="display:none"></div>
<div class="pm-page" data-module="audit">
  <header class="pm-header">
    <div>
      <div class="pm-brand">ProMap <span>Cargo</span></div>
      <div class="pm-kicker">Audit</div>
      <div class="pm-subtitle">Security events, operational changes and traceability</div>
    </div>
    <div class="pm-header-actions">
      <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
      <a class="pm-btn" href="/profile">Profil</a>
    </div>
  </header>
  <div class="pm-layout">
    <aside class="pm-sidebar">
      <div class="pm-nav-title">OPERATIONS</div>
      <nav class="pm-nav"><a class="" href="/dashboard">Dashboard</a><a class="" href="/dispatch">Command Center</a><a class="" href="/orders">Transportni nalozi</a><a class="" href="/trips">Ture</a><a class="" href="/vehicles">Vozila</a><a class="" href="/drivers">Vozači</a><a class="" href="/navigation">Navigacija</a><a class="" href="/alerts">Alerts</a><a class="" href="/moderation">Moderacija</a><a class="active" href="/audit">Audit</a><a class="" href="/compliance">Compliance</a><a class="" href="/monitoring">Monitoring</a><a class="" href="/finance">Finansije</a><a class="" href="/reports">Izveštaji</a><a class="" href="/settings">Podešavanja</a><a class="" href="/profile">Profil</a><a class="" href="/admin">Administracija</a></nav>
      <div class="pm-sidebar-footer"><b>Routing engine</b><br>PostGIS · OSM · Truck-aware<br><span>Graph protected</span></div>
    </aside>
    <main class="pm-content">
      <div class="pm-title">Audit</div><div class="pm-muted" style="margin:5px 0 14px">Immutable operational trail for security and compliance.</div><div class="pm-card pm-card-body"><div class="pm-grid pm-grid-4"><div><label class="pm-label">Actor</label><input class="pm-field" placeholder="email / system"></div><div><label class="pm-label">Action</label><input class="pm-field" placeholder="Event type"></div><div><label class="pm-label">Entity</label><input class="pm-field" placeholder="ID"></div><div><label class="pm-label">From</label><input class="pm-field" placeholder="date/time"></div></div><div class="pm-actions" style="margin-top:12px"><button class="pm-btn pm-btn-primary">Pretraži audit</button><button class="pm-btn">Export CSV</button></div></div><div style="height:14px"></div><div class="pm-card" style="overflow:auto"><table class="pm-table"><thead><tr><th>Timestamp</th><th>Actor</th><th>Action</th><th>Entity</th><th>Result</th></tr></thead><tbody><tr><td>2026-09-12 15:21</td><td>operator@promap.local</td><td>RouteCalculated</td><td>TRP-8841</td><td><span class="pm-badge ">Success</span></td></tr><tr><td>2026-09-12 15:18</td><td>dispatcher@promap.local</td><td>TripUpdated</td><td>TRP-8842</td><td><span class="pm-badge ">Success</span></td></tr><tr><td>2026-09-12 15:11</td><td>admin@promap.local</td><td>RestrictionChanged</td><td>RS-HEIGHT-04</td><td><span class="pm-badge ">Success</span></td></tr><tr><td>2026-09-12 14:59</td><td>system</td><td>GpsLost</td><td>NI-401-TT</td><td><span class="pm-badge warn">Warning</span></td></tr></tbody></table></div>
    </main>
  </div>
</div>


<script>
// Pages are server-rendered and must remain independent from the legacy SPA renderer.
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.pm-page a[href]').forEach(a=>a.addEventListener('click',e=>{
    if(a.origin===location.origin){ e.stopPropagation(); }
  },true));
});
</script>

