@page "/audit"
@{
    ViewData["Title"] = "Audit · ProMap Cargo";
}

<div class="pm-page" data-module="audit">

    <header class="pm-header">
        <div class="pm-heading">
            <div class="pm-page-kicker">Kontrola</div>
            <p class="pm-page-subtitle">Bezbednosni događaji, operativne izmene i sledljivost.</p>
        </div>
        <div class="pm-header-actions">
            <button class="pm-btn pm-btn-secondary" type="button">Izvezi CSV</button>
        </div>
    </header>

    <section class="pm-card">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Filteri</h2>
                <p class="pm-card-subtitle">Suzi evidenciju po korisniku, akciji ili periodu.</p>
            </div>
        </header>
        <div class="pm-card-body">
            <div class="pm-form-grid pm-form-grid-4">
                <label class="pm-field"><span class="pm-label">Korisnik</span><input class="pm-input" type="search"
                                                                                         placeholder="E-mail ili sistem" /></label>
                    <label class="pm-field"><span class="pm-label">Akcija</span><input class="pm-input" type="search"
                                                                                           placeholder="Vrsta događaja" /></label>
                        <label class="pm-field"><span class="pm-label">Entitet</span><input class="pm-input" type="search"
                                                                                                placeholder="ID entiteta" /></label>
                            <label class="pm-field"><span class="pm-label">Od datuma</span><input class="pm-input"
                                                                                                      type="date" /></label>
                            </div>
                            <div class="pm-page-actions pm-mt-3">
                                <button class="pm-btn pm-btn-primary" type="button">Pretraži audit</button>
                                <button class="pm-btn pm-btn-ghost" type="button">Očisti filtere</button>
                            </div>
                        </div>
                    </section>

                    <section class="pm-card">
                        <header class="pm-card-header">
                            <div>
                                <h2 class="pm-card-title">Operativni događaji</h2>
                                <p class="pm-card-subtitle">Najnovije promene zabeležene u sistemu</p>
                            </div>
                        </header>
                        <div class="pm-table-wrap">
                            <table class="pm-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Vreme</th>
                                        <th scope="col">Korisnik</th>
                                        <th scope="col">Akcija</th>
                                        <th scope="col">Entitet</th>
                                        <th scope="col">Rezultat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>2026-09-12 15:21</td>
                                        <td>operator@promap.local</td>
                                        <td>RouteCalculated</td>
                                        <td>TRP-8841</td>
                                        <td><span class="pm-badge pm-badge--success">Uspešno</span></td>
                                    </tr>
                                    <tr>
                                        <td>2026-09-12 15:18</td>
                                        <td>dispatcher@promap.local</td>
                                        <td>TripUpdated</td>
                                        <td>TRP-8842</td>
                                        <td><span class="pm-badge pm-badge--success">Uspešno</span></td>
                                    </tr>
                                    <tr>
                                        <td>2026-09-12 15:11</td>
                                        <td>admin@promap.local</td>
                                        <td>RestrictionChanged</td>
                                        <td>RS-HEIGHT-04</td>
                                        <td><span class="pm-badge pm-badge--success">Uspešno</span></td>
                                    </tr>
                                    <tr>
                                        <td>2026-09-12 14:59</td>
                                        <td>system</td>
                                        <td>GpsLost</td>
                                        <td>NI-401-TT</td>
                                        <td><span class="pm-badge pm-badge--warning">Upozorenje</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
