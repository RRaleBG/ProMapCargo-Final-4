<script>

(() =>
{
    "use strict";

    const root =
        document.querySelector(".pm-profile-page");

    if (!root)
    {
        return;
    }


    const toast =
        root.querySelector("#profileToast");

    const toastText =
        root.querySelector("#profileToastText");

    let toastTimer = null;


    function showToast(message)
    {
        if (!toast || !toastText)
        {
            return;
        }

        toastText.textContent = message;

        toast.classList.add("show");

        window.clearTimeout(toastTimer);

        toastTimer =
            window.setTimeout(
                () =>
                {
                    toast.classList.remove("show");
                },
                2400
            );
    }


    /* =====================================================
       AVATAR
       ===================================================== */

    const avatarUpload =
        root.querySelector("#avatarUpload");

    const avatarImage =
        root.querySelector("#avatarImage");

    const avatarInitials =
        root.querySelector("#avatarInitials");


    if (avatarUpload)
    {
        avatarUpload.addEventListener(
            "change",
            event =>
            {
                const file =
                    event.target.files?.[0];

                if (!file)
                {
                    return;
                }

                if (!file.type.startsWith("image/"))
                {
                    showToast(
                        "Izabrani fajl nije validna slika."
                    );

                    return;
                }

                const reader =
                    new FileReader();

                reader.onload =
                    loadEvent =>
                    {
                        avatarImage.src =
                            loadEvent.target.result;

                        avatarImage.hidden =
                            false;

                        avatarInitials.hidden =
                            true;

                        showToast(
                            "Nova fotografija je spremna za čuvanje."
                        );
                    };

                reader.readAsDataURL(file);
            }
        );
    }


    /* =====================================================
       PROFILE NAME PREVIEW
       ===================================================== */

    const displayName =
        root.querySelector("#displayName");

    const profileNamePreview =
        root.querySelector("#profileNamePreview");

    const username =
        root.querySelector("#username");

    const usernameElement =
        root.querySelector(".pm-profile-username");


    if (displayName && profileNamePreview)
    {
        displayName.addEventListener(
            "input",
            () =>
            {
                profileNamePreview.textContent =
                    displayName.value.trim() ||
                    "Novi korisnik";

                updateInitials(
                    displayName.value
                );
            }
        );
    }


    if (username && usernameElement)
    {
        username.addEventListener(
            "input",
            () =>
            {
                const value =
                    username.value
                        .trim()
                        .replace(/^@@+/, "");

                usernameElement.textContent =
                    value
                        ? `${value}`
                        : `${username}`;
            }
        );
    }


    function updateInitials(name)
    {
        if (!avatarInitials)
        {
            return;
        }

        const parts =
            name
                .trim()
                .split(/\s+/)
                .filter(Boolean);

        if (!parts.length)
        {
            avatarInitials.textContent =
                "PM";

            return;
        }

        const initials =
            parts
                .slice(0, 2)
                .map(part => part[0])
                .join("")
                .toUpperCase();

        avatarInitials.textContent =
            initials;
    }


    /* =====================================================
       SAVE
       ===================================================== */

    const saveButton =
        root.querySelector(
            '[data-action="save"]'
        );


    if (saveButton)
    {
        saveButton.addEventListener(
            "click",
            () =>
            {
                saveButton.disabled =
                    true;

                const originalText =
                    saveButton.textContent;

                saveButton.textContent =
                    "Čuvanje...";


                window.setTimeout(
                    () =>
                    {
                        saveButton.disabled =
                            false;

                        saveButton.textContent =
                            originalText;

                        showToast(
                            "Profil je spreman za Identity čuvanje."
                        );
                    },
                    650
                );
            }
        );
    }


    /* =====================================================
       DISCARD
       ===================================================== */

    const discardButton =
        root.querySelector(
            '[data-action="discard"]'
        );


    if (discardButton)
    {
        discardButton.addEventListener(
            "click",
            () =>
            {
                const name =
                    root.querySelector("#displayName");

                const email =
                    root.querySelector("#email");

                const phone =
                    root.querySelector("#phone");

                if (name)
                {
                    name.value =
                        "Marko Petrović";

                    name.dispatchEvent(
                        new Event(
                            "input",
                            {
                                bubbles: true
                            }
                        )
                    );
                }

                if (email)
                {
                    email.value =
                        "marko.petrovic@promapcargo.local";
                }

                if (phone)
                {
                    phone.value =
                        "+381 64 123 4567";
                }

                showToast(
                    "Izmene su poništene."
                );
            }
        );
    }


    /* =====================================================
       COPY ID
       ===================================================== */

    root.querySelectorAll(
        "[data-copy]"
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                async () =>
                {
                    const value =
                        button.dataset.copy;

                    try
                    {
                        await navigator.clipboard.writeText(
                            value
                        );

                        showToast(
                            "User ID je kopiran."
                        );
                    }
                    catch
                    {
                        showToast(
                            "Kopiranje nije dostupno."
                        );
                    }
                }
            );
        }
    );


    /* =====================================================
       MODAL
       ===================================================== */

    const passwordModal =
        root.querySelector(
            "#passwordModal"
        );


    function openPasswordModal()
    {
        if (!passwordModal)
        {
            return;
        }

        passwordModal.hidden =
            false;

        document.body.classList.add(
            "pm-profile-modal-open"
        );
    }


    function closePasswordModal()
    {
        if (!passwordModal)
        {
            return;
        }

        passwordModal.hidden =
            true;

        document.body.classList.remove(
            "pm-profile-modal-open"
        );
    }


    root.querySelectorAll(
        '[data-action="password"]'
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                openPasswordModal
            );
        }
    );


    root.querySelectorAll(
        "[data-close-modal]"
    ).forEach(
        element =>
        {
            element.addEventListener(
                "click",
                closePasswordModal
            );
        }
    );


    document.addEventListener(
        "keydown",
        event =>
        {
            if (
                event.key === "Escape" &&
                passwordModal &&
                !passwordModal.hidden
            )
            {
                closePasswordModal();
            }
        }
    );


    /* =====================================================
       IDENTITY SECURITY ACTIONS
       ===================================================== */

    root.querySelectorAll(
        '[data-action="twofa"]'
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                () =>
                {
                    showToast(
                        "2FA management UI je spreman za Identity integraciju."
                    );
                }
            );
        }
    );


    root.querySelectorAll(
        '[data-action="recovery"]'
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                () =>
                {
                    showToast(
                        "Recovery codes UI je spreman za Identity integraciju."
                    );
                }
            );
        }
    );


    root.querySelectorAll(
        '[data-action="change-password"]'
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                () =>
                {
                    closePasswordModal();

                    showToast(
                        "Password change UI je spreman za Identity."
                    );
                }
            );
        }
    );


    /* =====================================================
       OTHER SESSIONS
       ===================================================== */

    root.querySelectorAll(
        ".pm-profile-session-close"
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                () =>
                {
                    const session =
                        button.closest(
                            ".pm-profile-session"
                        );

                    if (!session)
                    {
                        return;
                    }

                    session.style.opacity =
                        "0";

                    session.style.transform =
                        "translateX(8px)";

                    session.style.transition =
                        "opacity .2s ease, transform .2s ease";

                    window.setTimeout(
                        () =>
                        {
                            session.remove();

                            showToast(
                                "Sesija je označena za odjavu."
                            );
                        },
                        220
                    );
                }
            );
        }
    );


    root.querySelectorAll(
        '[data-action="logout-other-sessions"]'
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                () =>
                {
                    showToast(
                        "Ostale sesije su spremne za Identity logout."
                    );
                }
            );
        }
    );


    /* =====================================================
       ACCOUNT CONTROL
       ===================================================== */

    root.querySelectorAll(
        '[data-action="deactivate"]'
    ).forEach(
        button =>
        {
            button.addEventListener(
                "click",
                () =>
                {
                    showToast(
                        "Zahtev za deaktivaciju je spreman za administratorski workflow."
                    );
                }
            );
        }
    );


    /* =====================================================
       PREFERENCES
       ===================================================== */

    root.querySelectorAll(
        "[data-preference]"
    ).forEach(
        checkbox =>
        {
            checkbox.addEventListener(
                "change",
                () =>
                {
                    const label =
                        checkbox
                            .closest(
                                ".pm-profile-toggle-row"
                            );

                    const title =
                        label?.querySelector(
                            "strong"
                        )?.textContent?.trim();

                    showToast(
                        `${title || "Preferencija"} ${checkbox.checked ? "uključena" : "isključena"}.`
                    );
                }
            );
        }
    );


    /* =====================================================
       INITIAL STATE
       ===================================================== */

    updateInitials(
        displayName?.value ||
        "Marko Petrović"
    );

})();

</script>
