@page "/admin"
@{
    ViewData["Title"] = "Administracija · ProMap Cargo";
}

<div class="pm-page pm-admin-page" data-module="admin">
    <header class="pm-page-header">
        <div class="pm-page-heading">
            <div class="pm-page-kicker">Sistem</div>
            <h1 class="pm-page-title">Administracija</h1>
            <p class="pm-page-subtitle">Korisnici, uloge, kompanije i upravljanje routing grafom.</p>
        </div>
        <div class="pm-page-actions">
            <a class="pm-btn pm-btn-secondary" asp-page="/Monitoring/Index">Provera zdravlja</a>
            <a class="pm-btn pm-btn-primary" asp-page="/Audit/Index">Audit evidencija</a>
        </div>
    </header>

    <section class="pm-kpi-grid" aria-label="Administrativni pregled">
        <article class="pm-kpi">
            <div class="pm-kpi-label">Korisnici</div>
            <div class="pm-kpi-value">24</div>
            <div class="pm-kpi-footer">u kompaniji</div>
        </article>
        <article class="pm-kpi">
            <div class="pm-kpi-label">Uloge</div>
            <div class="pm-kpi-value">7</div>
            <div class="pm-kpi-footer">konfigurisano</div>
        </article>
        <article class="pm-kpi">
            <div class="pm-kpi-label">Kompanije</div>
            <div class="pm-kpi-value">3</div>
            <div class="pm-kpi-footer">aktivne</div>
        </article>
        <article class="pm-kpi">
            <div class="pm-kpi-label">Zahtevi</div>
            <div class="pm-kpi-value">2</div>
            <div class="pm-kpi-footer">čekaju odobrenje</div>
        </article>
    </section>

    <section class="pm-card">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Korisnički nalozi</h2>
                <p class="pm-card-subtitle">Pristup i kompanijske uloge</p>
            </div>
        </header>
        <div class="pm-table-wrap">
            <table class="pm-table">
                <thead>
                    <tr>
                        <th scope="col">Korisnik</th>
                        <th scope="col">Uloga</th>
                        <th scope="col">Kompanija</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>admin@promap.local</td>
                        <td>Administrator</td>
                        <td>Sve kompanije</td>
                        <td><span class="pm-badge pm-badge--success">Aktivan</span></td>
                    </tr>
                    <tr>
                        <td>dispatcher@promap.local</td>
                        <td>Dispečer</td>
                        <td>EU Logistics</td>
                        <td><span class="pm-badge pm-badge--success">Aktivan</span></td>
                    </tr>
                    <tr>
                        <td>operator@promap.local</td>
                        <td>Operater</td>
                        <td>EU Logistics</td>
                        <td><span class="pm-badge pm-badge--success">Aktivan</span></td>
                    </tr>
                    <tr>
                        <td>audit@promap.local</td>
                        <td>Revizor</td>
                        <td>EU Logistics</td>
                        <td><span class="pm-badge">Samo čitanje</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="pm-card pm-card-body">
        <h2 class="pm-card-title">Routing graph</h2>
        <p class="pm-card-subtitle">Aktivna verzija: 20260912 · OSM import je zaštićen verzionisanjem grafa.</p>
        <div class="pm-page-actions pm-mt-3">
            <a class="pm-btn pm-btn-secondary" asp-page="/Monitoring/Index">Monitoring</a>
            <a class="pm-btn pm-btn-ghost" asp-page="/Audit/Index">Otvori audit</a>
        </div>
    </section>
</div>
