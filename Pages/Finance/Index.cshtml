@page "/finance"
@{
    ViewData["Title"] = "Finansije · ProMap Cargo";
}

<div class="pm-page" data-module="finance">

    <div class="finance-bg-orb finance-bg-orb-one"></div>
    <div class="finance-bg-orb finance-bg-orb-two"></div>

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->
    <section class="finance-page-header finance-reveal pm-page-header pm-header">
  
            <div class="finance-kicker">
              
            </div> 
   

        <div class="finance-header-actions pm-page-actions">
            <button type="button"
                    class="finance-btn pm-btn"
                    id="financeRefreshButton">
                <i data-lucide="rotate-cw" class="pm-icon" aria-hidden="true"></i>
                Osveži
            </button>

            <button type="button"
                    class="finance-btn finance-btn-primary pm-btn pm-btn-primary"
                    id="openExpenseModal">
                <i data-lucide="plus" class="pm-icon" aria-hidden="true"></i>
                Novi trošak
            </button>
        </div>
    </section>

    <!-- =========================================================
         CONTEXT BAR
    ========================================================== -->
    <section class="finance-context-bar finance-reveal finance-delay-1 pm-panel">

        <div class="finance-context-main">
            <div class="finance-context-icon" id="financeContextInitials">
                —
            </div>

            <div class="finance-context-copy">
                <span>Finansijski kontekst</span>
                <strong id="financeContextTitle">
                    Učitavanje…
                </strong>

                <div class="finance-context-meta">
                    <span id="financeContextDriver">—</span>
                    <i></i>
                    <span id="financeContextTrip">—</span>
                    <i></i>
                    <span id="financeContextVehicle">—</span>
                </div>
            </div>
        </div>

        <div class="finance-mode-switch" role="group">
            <button class="finance-mode-button active"
                    type="button"
                    data-finance-mode="driver">
                Moj pregled
            </button>

            <button class="finance-mode-button"
                    type="button"
                    data-finance-mode="dispatch">
                Dispatch
            </button>
        </div>

    </section>

    <!-- =========================================================
         KPI
    ========================================================== -->
    <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--5 finance-reveal finance-delay-2" aria-label="Finansije pregled">
        <article class="compliance-kpi compliance-kpi-total">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Apsolutni saldo</span>
                <i data-lucide="wallet" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiBalance" data-finance-value="0" data-finance-format="currency">0,00 €</strong>
            <span class="compliance-kpi-meta"><span id="kpiBalanceDelta">—</span> · Vozač</span>
        </article>

        <article class="compliance-kpi compliance-kpi-info">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Aktivna tura</span>
                <i data-lucide="route" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiActiveRemaining">—</strong>
            <span class="compliance-kpi-meta"><span id="kpiActiveTrip">—</span> · Preostalo</span>
        </article>

        <article class="compliance-kpi compliance-kpi-good">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Prethodna tura</span>
                <i data-lucide="circle-check" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiPrevious">—</strong>
            <span class="compliance-kpi-meta">Obračunata · <span id="kpiPreviousTrip">—</span></span>
        </article>

        <article class="compliance-kpi compliance-kpi-neutral">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Troškovi ture</span>
                <i data-lucide="receipt" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiTripCosts">—</strong>
            <span class="compliance-kpi-meta"><span id="kpiTripCostCount">—</span> · Aktivna tura</span>
        </article>

        <article class="compliance-kpi compliance-kpi-warning">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Na čekanju</span>
                <i data-lucide="hourglass" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiPending">—</strong>
            <span class="compliance-kpi-meta"><span id="kpiPendingCount">—</span> · Za proveru</span>
        </article>
    </section>

    <!-- =========================================================
         MAIN GRID
    ========================================================== -->
    <section class="finance-main-grid">

        <!-- =====================================================
             LEFT COLUMN
        ====================================================== -->
        <div class="finance-main-column">

            <!-- CURRENT TRIP -->
            <article class="finance-card finance-trip-card finance-reveal finance-delay-3 pm-panel">

                <header class="finance-card-header pm-panel-heading">
                    <div>
                        <div class="finance-card-kicker">
                            AKTIVNA TURA
                        </div>

                        <h2 id="tripNumber">—</h2>

                        <p id="tripRoute">Nema aktivne ture</p>
                    </div>

                    <span class="finance-status finance-status-live" id="tripStatus">—</span>
                </header>

                <div class="finance-trip-identity">
                    <div>
                        <span>Vozač</span>
                        <strong id="tripDriver">—</strong>
                    </div>

                    <div>
                        <span>Vozilo</span>
                        <strong id="tripVehicle">—</strong>
                    </div>

                    <div>
                        <span>Polazak</span>
                        <strong id="tripStart">—</strong>
                    </div>

                    <div>
                        <span>Planirani dolazak</span>
                        <strong id="tripArrival">—</strong>
                    </div>
                </div>

                <div class="finance-budget">

                    <div class="finance-budget-head">
                        <div>
                            <span>Budžet ture</span>
                            <strong id="tripBudget">—</strong>
                        </div>

                        <div class="finance-budget-spent">
                            <span>Potrošeno</span>
                            <strong id="tripSpent">—</strong>
                        </div>
                    </div>

                    <div class="finance-progress">
                        <div class="finance-progress-bar" id="tripProgress" data-width="0"></div>
                    </div>

                    <div class="finance-budget-footer">
                        <span id="tripBudgetUsed">—</span>
                        <strong id="tripRemaining">—</strong>
                    </div>

                </div>

                <div class="finance-trip-stats">
                    <div>
                        <span>Gorivo</span>
                        <strong id="tripFuel">—</strong>
                    </div>

                    <div>
                        <span>Putarine</span>
                        <strong id="tripToll">—</strong>
                    </div>

                    <div>
                        <span>Parking</span>
                        <strong id="tripParking">—</strong>
                    </div>

                    <div>
                        <span>Ostalo</span>
                        <strong id="tripOther">—</strong>
                    </div>
                </div>

            </article>

            <!-- FUEL CARD -->
            <article class="finance-card finance-reveal finance-delay-4 pm-panel">

                <header class="finance-card-header pm-panel-heading">
                    <div>
                        <div class="finance-card-kicker">
                            FUEL CONTROL
                        </div>

                        <h2>Gorivo i kartice</h2>

                        <p>
                            Pregled kartica i transakcija goriva za aktivnu turu.
                        </p>
                    </div>
                </header>

                <div class="finance-fuel-card-area">

                    <div class="finance-physical-card">
                        <div class="finance-card-light"></div>

                        <div class="finance-physical-top">
                            <div>
                                <span class="finance-card-provider" id="fuelCardProvider">—</span>
                                <small>Fuel Card</small>
                            </div>

                            <div class="finance-card-chip">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>

                        <div class="finance-card-number" id="fuelCardNumber">
                            •••• &nbsp; •••• &nbsp; •••• &nbsp; ••••
                        </div>

                        <div class="finance-physical-bottom">
                            <div>
                                <span>Dodeljena</span>
                                <strong id="fuelCardVehicle">—</strong>
                            </div>

                            <div>
                                <span>Vozač</span>
                                <strong id="fuelCardDriver">—</strong>
                            </div>

                            <div>
                                <span>Status</span>
                                <strong class="finance-card-active" id="fuelCardStatus">—</strong>
                            </div>
                        </div>
                    </div>

                    <div class="finance-fuel-summary">
                        <div class="finance-fuel-stat">
                            <span>Gorivo na turi</span>
                            <strong id="fuelLiters">—</strong>
                        </div>

                        <div class="finance-fuel-stat">
                            <span>Ukupno</span>
                            <strong id="fuelAmount">—</strong>
                        </div>

                        <div class="finance-fuel-stat">
                            <span>Prosečna cena</span>
                            <strong id="fuelAverage">—</strong>
                        </div>

                        <div class="finance-fuel-stat">
                            <span>Transakcije</span>
                            <strong id="fuelCount">0</strong>
                        </div>
                    </div>

                </div>

                <div class="finance-section-title">
                    <div>
                        <strong>Transakcije goriva</strong>
                        <span>Aktivna tura</span>
                    </div>
                </div>

                <div class="finance-fuel-transactions" id="fuelTransactions"></div>

            </article>

            <!-- TRANSACTIONS -->
            <article class="finance-card finance-reveal">

                <header class="finance-card-header finance-card-header-stack-mobile">
                    <div>
                        <div class="finance-card-kicker">
                            LEDGER
                        </div>

                        <h2>Finansijske transakcije</h2>

                        <p>
                            Kompletan pregled troškova, isplata i finansijskih promena.
                        </p>
                    </div>

                    <div class="finance-card-actions">
                        <button type="button"
                                class="finance-btn finance-btn-small"
                                id="exportFinanceButton">
                            ⇩ Izvoz
                        </button>
                    </div>
                </header>

                <div class="pm-toolbar finance-filters">

                    <label class="pm-search-wrap finance-search">
                        <i data-lucide="search" class="pm-search-icon pm-icon" aria-hidden="true"></i>
                        <input id="financeSearch"
                               class="pm-search-input"
                               type="search"
                               placeholder="Pretraži transakcije..." />
                    </label>

                    <select id="financeCategoryFilter" class="pm-select finance-select">
                        <option value="all">Sve kategorije</option>
                        <option value="fuel">Gorivo</option>
                        <option value="toll">Putarina</option>
                        <option value="parking">Parking</option>
                        <option value="allowance">Dnevnica</option>
                        <option value="payment">Isplata</option>
                        <option value="other">Ostalo</option>
                    </select>

                    <select id="financeStatusFilter" class="pm-select finance-select">
                        <option value="all">Svi statusi</option>
                        <option value="approved">Approved</option>
                        <option value="pending">Pending</option>
                        <option value="paid">Paid</option>
                    </select>

                </div>

                <div class="finance-table-wrap">

                    <table class="finance-table">
                        <thead>
                            <tr>
                                <th>Transakcija</th>
                                <th>Tura</th>
                                <th>Plaćanje</th>
                                <th>Datum</th>
                                <th>Status</th>
                                <th class="align-right">Iznos</th>
                            </tr>
                        </thead>

                        <tbody id="financeTransactionTable">

                        </tbody>
                    </table>

                </div>

                <div class="finance-table-empty"
                     id="financeTableEmpty">
                    <div>⌕</div>
                    <strong>Nema pronađenih transakcija</strong>
                    <span>Promeni filter ili pretragu.</span>
                </div>

            </article>

        </div>

        <!-- =====================================================
             RIGHT COLUMN
        ====================================================== -->
        <aside class="finance-side-column">

            <!-- ABSOLUTE BALANCE -->
            <article class="finance-card finance-balance-card finance-reveal finance-delay-3">

                <div class="finance-balance-ring">
                    <div class="finance-balance-ring-inner">
                        <span>Apsolutni saldo</span>
                        <strong id="balanceRing">—</strong>
                        <small id="balanceRingNote">u korist vozača</small>
                    </div>
                </div>

                <div class="finance-balance-breakdown">
                    <div>
                        <span>
                            <i class="finance-bullet green"></i>
                            Potraživanja
                        </span>
                        <strong id="balanceReceivables">—</strong>
                    </div>

                    <div>
                        <span>
                            <i class="finance-bullet yellow"></i>
                            Gotovinska zaduženja
                        </span>
                        <strong id="balanceAdvances">—</strong>
                    </div>

                    <div>
                        <span>
                            <i class="finance-bullet red"></i>
                            Isplate
                        </span>
                        <strong id="balancePayments">—</strong>
                    </div>
                </div>

                <div class="finance-balance-total">
                    <span>Saldo</span>
                    <strong id="balanceTotal">—</strong>
                </div>

                <div class="finance-info-box">
                    <span>i</span>
                    <p>
                        Troškovi plaćeni službenom ili fuel karticom
                        prikazani su u trošku ture, ali nisu automatski
                        lično zaduženje vozača.
                    </p>
                </div>

            </article>

            <!-- PREVIOUS TRIP -->
            <article class="finance-card finance-reveal finance-delay-4 pm-panel">

                <header class="finance-card-header compact pm-panel-heading">
                    <div>
                        <div class="finance-card-kicker">
                            PRETHODNA TURA
                        </div>

                        <h3 id="previousNumber">—</h3>

                        <p id="previousRoute">Nema završene ture</p>
                    </div>

                    <span class="finance-status finance-status-success" id="previousStatus">—</span>
                </header>

                <div class="finance-previous-summary">
                    <div>
                        <span>Budžet</span>
                        <strong id="previousBudget">—</strong>
                    </div>

                    <div>
                        <span>Troškovi</span>
                        <strong id="previousSpent">—</strong>
                    </div>

                    <div>
                        <span>Saldo ture</span>
                        <strong class="finance-positive" id="previousNet">—</strong>
                    </div>
                </div>

                <button type="button"
                        class="finance-btn finance-btn-full"
                        id="previousTripDetails">
                    Detalji prethodne ture
                    <span>→</span>
                </button>

            </article>

            <!-- PENDING -->
            <article class="finance-card finance-reveal">

                <header class="finance-card-header compact">
                    <div>
                        <div class="finance-card-kicker">
                            ZA PROVERU
                        </div>

                        <h3>Troškovi na čekanju</h3>
                    </div>

                    <span class="finance-count-badge" id="pendingCount">0</span>
                </header>

                <div class="finance-pending-list" id="pendingList"></div>

            </article>

            <!-- DRIVER CARDS -->
            <article class="finance-card finance-reveal">

                <header class="finance-card-header compact">
                    <div>
                        <div class="finance-card-kicker">
                            PAYMENT METHODS
                        </div>

                        <h3>Dodeljene kartice</h3>
                    </div>
                </header>

                <div class="finance-assigned-cards" id="assignedCards"></div>

            </article>

        </aside>

    </section>

    <!-- =========================================================
         EXPENSE MODAL
    ========================================================== -->
    <div class="finance-modal"
         id="expenseModal"
         aria-hidden="true">

        <div class="finance-modal-backdrop"
             data-close-expense-modal></div>

        <div class="finance-modal-dialog">

            <div class="finance-modal-header">
                <div>
                    <div class="finance-card-kicker">
                        TRIP EXPENSE
                    </div>

                    <h2>Novi putni trošak</h2>

                    <p>
                        Evidentiraj trošak aktivne ture.
                    </p>
                </div>

                <button type="button"
                        class="finance-modal-close"
                        data-close-expense-modal>
                    ×
                </button>
            </div>

            <form id="expenseForm">

                <div class="finance-form-grid">

                    <label class="finance-field">
                        <span>Kategorija</span>

                        <select id="expenseCategory"
                                required>
                            <option value="fuel">Gorivo</option>
                            <option value="toll">Putarina</option>
                            <option value="parking">Parking</option>
                            <option value="ferry">Trajekt</option>
                            <option value="service">Servis / popravka</option>
                            <option value="adblue">AdBlue</option>
                            <option value="food">Hrana</option>
                            <option value="hotel">Smeštaj</option>
                            <option value="other">Ostalo</option>
                        </select>
                    </label>

                    <label class="finance-field">
                        <span>Tura</span>
                        <select id="expenseTrip">
                            <option value="">Bez ture</option>
                        </select>
                    </label>

                    <label class="finance-field">
                        <span>Iznos</span>

                        <div class="finance-money-input">
                            <input type="number" id="expenseAmount" min="0.01" step="0.01" placeholder="0.00" required />

                            <span>EUR</span>
                        </div>
                    </label>

                    <label class="finance-field">
                        <span>Datum</span>

                        <input type="datetime-local" id="expenseDate" />
                    </label>

                    <label class="finance-field finance-field-wide">
                        <span>Lokacija / prodajno mesto</span>

                        <input type="text" id="expenseLocation" placeholder="npr. OMV Budapest" />
                    </label>

                    <label class="finance-field">
                        <span>Način plaćanja</span>

                        <select id="expensePaymentMethod">
                            <option value="fuel-card">
                                Fuel kartica
                            </option>
                            <option value="company-card">
                                Službena kartica
                            </option>
                            <option value="cash">
                                Gotovina
                            </option>
                            <option value="driver-card">
                                Lična kartica vozača
                            </option>
                        </select>
                    </label>

                    <label class="finance-field"
                           id="expenseCardField">
                        <span>Korišćena kartica</span>

                        <select id="expenseCard"></select>
                    </label>

                </div>

                <div class="finance-fuel-fields"
                     id="fuelSpecificFields">

                    <div class="finance-form-section-title">
                        Podaci o gorivu
                    </div>

                    <div class="finance-form-grid">

                        <label class="finance-field">
                            <span>Količina</span>

                            <div class="finance-money-input">
                                <input type="number" id="expenseQuantity" min="0" step="0.01" placeholder="0.00" />

                                <span>L</span>
                            </div>
                        </label>

                        <label class="finance-field">
                            <span>Cena po litru</span>

                            <div class="finance-money-input">
                                <input type="number" id="expenseUnitPrice" min="0" step="0.001" placeholder="0.000" />

                                <span>€/L</span>
                            </div>
                        </label>

                        <label class="finance-field">
                            <span>Kilometraža vozila</span>

                            <div class="finance-money-input">
                                <input type="number" id="expenseOdometer" min="0" placeholder="684320" />

                                <span>km</span>
                            </div>
                        </label>

                        <label class="finance-field">
                            <span>Vozilo</span>
                            <select id="expenseVehicle">
                                <option value="">Vozilo ture</option>
                            </select>
                        </label>

                    </div>

                </div>

                <label class="finance-field finance-field-block">
                    <span>Napomena</span>

                    <textarea rows="3" id="expenseNotes" placeholder="Dodatna napomena uz trošak..."></textarea>
                </label>

                <div class="finance-upload">
                    <div class="finance-upload-icon">
                        ⇧
                    </div>

                    <div>
                        <strong id="expenseReceiptName">Dodaj račun ili dokument</strong>
                        <span>
                            JPG, PNG ili PDF · maksimalno 10 MB
                        </span>
                    </div>

                    <button type="button" class="finance-btn finance-btn-small" id="expenseReceiptButton">
                        Izaberi fajl
                    </button>
                    <input type="file" id="expenseReceipt" accept=".pdf,.jpg,.jpeg,.png" hidden />
                </div>

                <div class="finance-modal-footer">

                    <button type="button"
                            class="finance-btn"
                            data-close-expense-modal>
                        Otkaži
                    </button>

                    <button type="submit"
                            class="finance-btn finance-btn-primary">
                        Sačuvaj trošak
                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- =========================================================
         TOAST
    ========================================================== -->
    <div class="finance-toast"
         id="financeToast">
        <span class="finance-toast-icon">✓</span>

        <div>
            <strong id="financeToastTitle">
                Sačuvano
            </strong>

            <span id="financeToastText">
                Promena je uspešno evidentirana.
            </span>
        </div>
    </div>

</div>




