@page "/monitoring"
@model ProMapCargo.Api.Pages.Monitoring.IndexModel
@{
    ViewData["Title"] = "Monitoring · ProMap Cargo";
}

<div class="pm-page pm-page--monitoring" data-module="monitoring">
      

    <div class="monitoring-shell">
        <header class="monitoring-header pm-header pm-page-header">
            <div> </div>
            <div class="monitoring-header-actions pm-header-actions">
                <div id="monitoringLiveBadge" class="monitoring-live">
                    <span class="monitoring-live-dot"></span>
                    <span id="monitoringLiveText">LIVE CONNECTING</span>
                </div>
                <button id="refreshMonitoring" class="monitoring-btn pm-btn" type="button">
                    <i data-lucide="rotate-cw" class="pm-icon" aria-hidden="true"></i>
                    Osveži
                </button>
                <button id="fitMonitoringMap" class="monitoring-btn pm-btn" type="button">
                    <i data-lucide="crosshair" class="pm-icon" aria-hidden="true"></i>
                    Cela flota
                </button>
            </div>
        </header>


        <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--5" aria-label="Praćenje pregled">
            <article class="compliance-kpi compliance-kpi-total pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Ukupno vozila</span>
                    <i data-lucide="truck" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiTotal">0</strong>
                <span class="compliance-kpi-meta">Registrovana flota</span>
            </article>

            <article class="compliance-kpi compliance-kpi-good pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Online</span>
                    <i data-lucide="wifi" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiOnline">0</strong>
                <span class="compliance-kpi-meta">Aktivan GPS signal</span>
            </article>

            <article class="compliance-kpi compliance-kpi-info pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">U vožnji</span>
                    <i data-lucide="navigation" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiMoving">0</strong>
                <span class="compliance-kpi-meta">Brzina iznad 5 km/h</span>
            </article>

            <article class="compliance-kpi compliance-kpi-neutral pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Zaustavljena</span>
                    <i data-lucide="circle-pause" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiIdle">0</strong>
                <span class="compliance-kpi-meta">Online bez kretanja</span>
            </article>

            <article class="compliance-kpi compliance-kpi-warning pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Upozorenja</span>
                    <i data-lucide="triangle-alert" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiAlerts">0</strong>
                <span class="compliance-kpi-meta">Operativna upozorenja</span>
            </article>
        </section>

        <div class="monitoring-main pm-workspace-split">

            <section class="monitoring-map-card pm-panel">

                <div class="monitoring-card-header pm-panel-heading">

                    <div class="monitoring-map-title">
                        <strong>Fleet Map</strong>
                        <span id="mapVehicleCount">0 vozila</span>
                    </div>

                    <div id="mapStatus" class="monitoring-map-status">
                        LIVE TELEMETRY
                    </div>

                </div>

                <div id="monitoringMap" class="pm-map" data-map-archive="/maps/serbia.pmtiles" data-map-max-zoom="18">
                </div>

                <div class="monitoring-map-controls pm-map-controls">

                    <button id="centerSerbia" class="monitoring-map-control pm-map-control pm-btn pm-btn-secondary" type="button">
                        Srbija
                    </button>

                    <button id="fitFleet" class="monitoring-map-control pm-map-control pm-btn pm-btn-secondary" type="button">
                        Cela flota
                    </button>

                    <button id="toggleDarkMap" class="monitoring-map-control pm-map-control pm-btn pm-btn-secondary" type="button">
                        Evropa mapa
                    </button>

                </div>

                <div class="monitoring-map-legend">

                    <span class="monitoring-legend-item">
                        <span class="monitoring-legend-dot online"></span>
                        Online
                    </span>

                    <span class="monitoring-legend-item">
                        <span class="monitoring-legend-dot idle"></span>
                        Idle
                    </span>

                    <span class="monitoring-legend-item">
                        <span class="monitoring-legend-dot offline"></span>
                        Offline
                    </span>

                </div>

                <div id="monitoringLoading" class="monitoring-loading">
                    <div class="monitoring-loader">
                        <span class="monitoring-loader-ring"></span>
                        Učitavanje fleet telemetry...
                    </div>
                </div>

            </section>

            <aside class="monitoring-side">

                <section class="monitoring-side-card pm-panel pm-card">

                    <div class="monitoring-section-head pm-panel-heading">
                        <h2 class="monitoring-section-title">
                            Live Fleet
                        </h2>

                        <span id="fleetUpdatedAt" class="monitoring-section-meta">
                            —
                        </span>
                    </div>

                    <div class="monitoring-filters pm-filter-group">

                        <button type="button" class="monitoring-filter pm-filter-btn active pm-btn" data-filter="all">
                            Sva
                        </button>

                        <button type="button" class="monitoring-filter pm-filter-btn pm-btn" data-filter="moving">
                            Vožnja
                        </button>

                        <button type="button" class="monitoring-filter pm-filter-btn pm-btn" data-filter="idle">
                            Idle
                        </button>

                        <button type="button" class="monitoring-filter pm-filter-btn pm-btn" data-filter="offline">
                            Offline
                        </button>

                    </div>

                    <div id="monitoringVehicleList" class="monitoring-vehicle-list"></div>

                </section>

                <section class="monitoring-side-card monitoring-detail-card pm-panel pm-card">

                    <div class="monitoring-section-head pm-panel-heading">
                        <h2 class="monitoring-section-title">
                            Vehicle telemetry
                        </h2>

                        <span id="detailUpdatedAt" class="monitoring-section-meta">
                            —
                        </span>
                    </div>

                    <div id="vehicleDetail">

                        <div class="monitoring-detail-empty">
                            <div>
                                <div class="monitoring-detail-empty-icon">
                                    <i data-lucide="crosshair" class="pm-icon" aria-hidden="true"></i>
                                </div>
                                Izaberi vozilo na mapi ili iz fleet liste
                                da prikažeš detaljnu telemetriju.
                            </div>
                        </div>

                    </div>

                </section>

                <section class="monitoring-side-card pm-panel pm-card">

                    <div class="monitoring-section-head pm-panel-heading">
                        <h2 class="monitoring-section-title">
                            Operativni alerts
                        </h2>

                        <span id="alertCount" class="monitoring-section-meta">
                            0
                        </span>
                    </div>

                    <div id="monitoringAlerts" class="monitoring-alert-list"></div>

                </section>

            </aside>

        </div>

    </div>


</div>


