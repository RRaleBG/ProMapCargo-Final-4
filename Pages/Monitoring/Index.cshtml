@page "/monitoring"
@{
    ViewData["Title"] = "Monitoring · ProMap Cargo";
}

<div class="pm-page pm-monitoring-page" data-module="monitoring">

    

    <div class="monitoring-shell">

        <header class="monitoring-header">

            <div>
                <div class="monitoring-kicker">
                    LIVE FLEET MONITORING
                </div>

                <h1 class="monitoring-title">
                    Monitoring vozila
                </h1>

                <p class="monitoring-subtitle">
                    Centralni pregled aktivne flote, GPS telemetrije, kretanja vozila
                    i operativnih upozorenja u realnom vremenu.
                </p>
            </div>

            <div class="monitoring-header-actions">

                <div id="monitoringLiveBadge" class="monitoring-live">
                    <span class="monitoring-live-dot"></span>
                    <span id="monitoringLiveText">LIVE CONNECTING</span>
                </div>

                <button id="refreshMonitoring" class="monitoring-btn" type="button">
                    ↻ Osveži
                </button>

                <button id="fitMonitoringMap" class="monitoring-btn primary" type="button">
                    ⌖ Cela flota
                </button>

            </div>

        </header>

        <section class="monitoring-kpis">

            <article class="monitoring-kpi">
                <div class="monitoring-kpi-head">
                    <span>Ukupno vozila</span>
                    <span class="monitoring-kpi-icon">🚚</span>
                </div>
                <div id="kpiTotal" class="monitoring-kpi-value">0</div>
                <div class="monitoring-kpi-meta">Registrovana flota</div>
            </article>

            <article class="monitoring-kpi">
                <div class="monitoring-kpi-head">
                    <span>Online</span>
                    <span class="monitoring-kpi-icon">●</span>
                </div>
                <div id="kpiOnline" class="monitoring-kpi-value">0</div>
                <div class="monitoring-kpi-meta">Aktivan GPS signal</div>
            </article>

            <article class="monitoring-kpi">
                <div class="monitoring-kpi-head">
                    <span>U vožnji</span>
                    <span class="monitoring-kpi-icon">➜</span>
                </div>
                <div id="kpiMoving" class="monitoring-kpi-value">0</div>
                <div class="monitoring-kpi-meta">Brzina iznad 5 km/h</div>
            </article>

            <article class="monitoring-kpi">
                <div class="monitoring-kpi-head">
                    <span>Zaustavljena</span>
                    <span class="monitoring-kpi-icon">Ⅱ</span>
                </div>
                <div id="kpiIdle" class="monitoring-kpi-value">0</div>
                <div class="monitoring-kpi-meta">Online bez kretanja</div>
            </article>

            <article class="monitoring-kpi">
                <div class="monitoring-kpi-head">
                    <span>Alerts</span>
                    <span class="monitoring-kpi-icon">!</span>
                </div>
                <div id="kpiAlerts" class="monitoring-kpi-value">0</div>
                <div class="monitoring-kpi-meta">Operativna upozorenja</div>
            </article>

        </section>

        <main class="monitoring-main">

            <section class="monitoring-map-card">

                <div class="monitoring-card-header">

                    <div class="monitoring-map-title">
                        <strong>Fleet Map</strong>
                        <span id="mapVehicleCount">0 vozila</span>
                    </div>

                    <div id="mapStatus" class="monitoring-map-status">
                        LIVE TELEMETRY
                    </div>

                </div>

                <div id="monitoringMap"
                     class="pm-map"
                     data-map-archive="/maps/serbia.pmtiles"
                     data-map-max-zoom="18">
                </div>

                <div class="monitoring-map-controls">

                    <button id="centerSerbia" class="monitoring-map-control" type="button">
                        Srbija
                    </button>

                    <button id="fitFleet" class="monitoring-map-control" type="button">
                        Cela flota
                    </button>

                    <button id="toggleDarkMap" class="monitoring-map-control" type="button">
                        Evropa mapa
                    </button>

                </div>

                <div class="monitoring-map-legend">

                    <span class="monitoring-legend-item">
                        <span class="monitoring-legend-dot online"></span>
                        Online
                    </span>

                    <span class="monitoring-legend-item">
                        <span class="monitoring-legend-dot idle"></span>
                        Idle
                    </span>

                    <span class="monitoring-legend-item">
                        <span class="monitoring-legend-dot offline"></span>
                        Offline
                    </span>

                </div>

                <div id="monitoringLoading" class="monitoring-loading">
                    <div class="monitoring-loader">
                        <span class="monitoring-loader-ring"></span>
                        Učitavanje fleet telemetry...
                    </div>
                </div>

            </section>

            <aside class="monitoring-side">

                <section class="monitoring-side-card">

                    <div class="monitoring-section-head">
                        <h2 class="monitoring-section-title">
                            Live Fleet
                        </h2>

                        <span id="fleetUpdatedAt" class="monitoring-section-meta">
                            — 
                        </span>
                    </div>

                    <div class="monitoring-filters">

                        <button
                            type="button"
                            class="monitoring-filter active"
                            data-filter="all">
                            Sva
                        </button>

                        <button
                            type="button"
                            class="monitoring-filter"
                            data-filter="moving">
                            Vožnja
                        </button>

                        <button
                            type="button"
                            class="monitoring-filter"
                            data-filter="idle">
                            Idle
                        </button>

                        <button
                            type="button"
                            class="monitoring-filter"
                            data-filter="offline">
                            Offline
                        </button>

                    </div>

                    <div id="monitoringVehicleList" class="monitoring-vehicle-list"></div>

                </section>

                <section class="monitoring-side-card monitoring-detail-card">

                    <div class="monitoring-section-head">
                        <h2 class="monitoring-section-title">
                            Vehicle telemetry
                        </h2>

                        <span id="detailUpdatedAt" class="monitoring-section-meta">
                            —
                        </span>
                    </div>

                    <div id="vehicleDetail">

                        <div class="monitoring-detail-empty">
                            <div>
                                <div class="monitoring-detail-empty-icon">
                                    ⌖
                                </div>
                                Izaberi vozilo na mapi ili iz fleet liste
                                da prikažeš detaljnu telemetriju.
                            </div>
                        </div>

                    </div>

                </section>

                <section class="monitoring-side-card">

                    <div class="monitoring-section-head">
                        <h2 class="monitoring-section-title">
                            Operativni alerts
                        </h2>

                        <span id="alertCount" class="monitoring-section-meta">
                            0
                        </span>
                    </div>

                    <div id="monitoringAlerts" class="monitoring-alert-list"></div>

                </section>

            </aside>

        </main>

    </div>

    <div id="monitoringToast" class="monitoring-toast"></div>

</div>


