                </div>


                <div id="truckFields" class="nav-truck-fields">

                    <div class="nav-spec-grid">


                        <div class="nav-field">

                            <label for="navWeight">
                                MASA
                            </label>

                            <div class="nav-input-unit">

                                <input id="navWeight" type="number" class="nav-input" value="40" min="0.1" step="0.1" />

                                <span>t</span>

                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navHeight">
                                VISINA
                            </label>

                            <div class="nav-input-unit">

                                <input id="navHeight" type="number" class="nav-input" value="4" min="0.1" step="0.01" />

                                <span>m</span>

                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navWidth">
                                ŠIRINA
                            </label>

                            <div class="nav-input-unit">

                                <input id="navWidth" type="number" class="nav-input" value="2.55" min="0.1"
                                       step="0.01" />

                                <span>m</span>

                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navLength">
                                DUŽINA
                            </label>

                            <div class="nav-input-unit">

                                <input id="navLength" type="number" class="nav-input" value="16.5" min="0.1"
                                       step="0.1" />

                                <span>m</span>

                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAxleLoad">
                                OSOVINSKO OPTEREĆENJE
                            </label>

                            <div class="nav-input-unit">

                                <input id="navAxleLoad" type="number" class="nav-input" value="10" min="0.1"
                                       step="0.1" />

                                <span>t</span>

                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAxles">
                                OSOVINE
                            </label>

                            <div class="nav-input-unit">

                                <input id="navAxles" type="number" class="nav-input" value="5" min="1" step="1" />

                                <span>kom</span>

                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navMaxSpeed">
                                MAKS. BRZINA
                            </label>

                            <div class="nav-input-unit">

                                <input id="navMaxSpeed" type="number" class="nav-input" value="90" min="1" step="1" />

                                <span>km/h</span>

                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAdrClass">
                                ADR KLASA
                            </label>

                            <input id="navAdrClass" type="text" class="nav-input" placeholder="npr. 3" />

                        </div>

                    </div>


                    <div class="nav-check-grid">

                        <label class="nav-check">

                            <input id="navHazmat" type="checkbox" />

                            <span class="nav-check-box"></span>

                            <span>
                                ADR / opasna roba
                            </span>

                        </label>


                        <label class="nav-check">

                            <input id="navAvoid" type="checkbox" checked />

                            <span class="nav-check-box"></span>

                            <span>
                                Automatski izbegavaj restrikcije
                            </span>

                        </label>

                    </div>

                </div>

            </section>


            <!-- =============================================
                 ROUTE ACTION
                 ============================================= -->

            <section class="nav-route-action">

                <button type="button" id="togglePlanner" class="nav-location-button nav-mobile-sheet-toggle" hidden>

                    <span>
                        ▤
                    </span>

                    <span>
                        Planiranje rute
                    </span>

                </button>

                <button type="button" id="calcRoute" class="nav-calculate-button">

                    <span class="nav-calculate-icon">
                        ↗
                    </span>

                    <span>

                        <strong>
                            KRENI
                        </strong>

                        <small>
                            PostGIS · OSM · OSRM fallback
                        </small>

                    </span>

                    <span class="nav-button-arrow">
                        →
                    </span>

                </button>


                <button type="button" id="useCurrentLocation" class="nav-location-button">

                    <span>
                        ◎
                    </span>

                    <span>
                        Koristi moju trenutnu lokaciju
                    </span>

                </button>


                <div id="navError" class="nav-error" hidden>
                </div>

            </section>


            <section class="nav-control-card nav-summary-card">

                <div class="nav-control-card-header compact">

                    <div>

                        <span class="nav-section-kicker">
                            ROUTE RESULT
                        </span>

                        <h2>
                            Pregled rute
                        </h2>

                    </div>

                    <span id="summarySafety" class="pm-badge pm-badge-success">
                        READY
                    </span>

                </div>


                <div class="nav-result-main">

                    <div class="nav-result-distance">

                        <span>
                            UKUPNA UDALJENOST
                        </span>

                        <strong id="summaryDistance">
                            —
                        </strong>

                    </div>


                    <div class="nav-result-duration">

                        <span>
                            TRAJANJE
                        </span>

                        <strong id="summaryDuration">
                            —
                        </strong>

                    </div>

                </div>


                <div class="nav-summary-grid">

                    <div>

                        <small>
                            ETA
                        </small>

                        <strong id="summaryEta">
                            —
                        </strong>

                    </div>


                    <div>

                        <small>
                            ENGINE
                        </small>

                        <strong id="summaryEngine">
