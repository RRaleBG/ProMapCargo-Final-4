@page "/settings"
@{
    Layout = "_TripsLayout";
    ViewData["Title"] = "Podešavanja · ProMap Cargo";
}


<div class="pm-page pm-navigation-page" data-module="navigation">
    <div class="nav-page-header">
        <div class="nav-page-heading">
            <div class="pm-eyebrow"> FLEET NAVIGATION </div>

            <div class="nav-title-row">

                <h6 class="pm-page-title">
                    Truck Navigation
                </h6>

                <span id="engineBadge" class="nav-engine-badge ready">

                    <span></span>

                    ROUTING READY

                </span>

            </div>

            <p class="pm-page-subtitle">
                Routing preko PostGIS / OSM graph-a sa OSRM fallback-om, GPS praćenjem i kontrolom vozila.
            </p>

        </div>


        <div class="nav-header-status">
            <button
                id="toggleRightPanelBtn"
                class="md:hidden p-2 rounded-xl bg-emeraldDark-800 border border-emeraldDark-accent/40 text-emeraldDark-glow flex items-center gap-1 text-xs font-semibold"
                type="button"
                aria-controls="navigationControlPanel"
                aria-expanded="false"
                title="Prikaži/sakrij desni panel"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 20l-5-4V4l5 4m0 0l6-4m-6 4v16m6-20l5 4v16l-5-4m0 0L9 20"
                    ></path>
                </svg>
            </button>

            <div class="nav-status-card">
                <span class="nav-status-light"></span>

                <div>
                    <small>GPS STATUS</small>
                    <strong id="gpsStatus">OFF</strong>
                </div>

            </div>


            <div class="nav-status-card">

                <span class="nav-status-light emerald"></span>

                <div>
                    <small>ROUTING ENGINE</small>
                    <strong id="engineHeader">POSTGIS</strong>
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         MAIN WORKSPACE
         ===================================================== -->

    <div class="navigation-workspace">


        <!-- =================================================
             MAP
             ================================================= -->

        <section class="navigation-map-section">

            <div class="navigation-map-shell">

                <!-- Add inside .navigation-map-shell, above #navMap -->
                <div id="promapLayerPanel" class="promap-layer-panel" aria-label="Map layers">
                    <div class="promap-layer-title">MAP LAYERS</div>

                    <label><input type="checkbox" data-promap-layer="route" checked> Route</label>
                    <label><input type="checkbox" data-promap-layer="restrictions" checked> Truck restrictions</label>
                    <label><input type="checkbox" data-promap-layer="fleet"> Fleet</label>
                    <label><input type="checkbox" data-promap-layer="poi"> POI</label>
                    <label><input type="checkbox" data-promap-layer="elevation"> Elevation</label>
                </div>


                <div id="navMap" class="pm-map" data-map-archive="/maps/europe.pmtiles" data-map-max-zoom="19">


                    <!-- ===================================== MAP TOP BAR  ===================================== -->
                    <div class="nav-map-topbar">
                        <div class="nav-map-mode-tabs">
                            <button type="button" class="nav-map-tab active" id="mapRouteTab"> Ruta </button>

                            <button type="button" class="nav-map-tab" id="mapRestrictionsTab"> Ograničenja </button>

                            <button type="button" class="nav-map-tab" id="mapGpsTab">
                                GPS
                            </button>

                        </div>


                        <div class="nav-map-engine">

                            <span></span>

                            <strong id="routeSafeBadge">
                                TRUCK SAFE
                            </strong>

                        </div>

                    </div>


                    <!-- =====================================
                         NEXT MANEUVER
                         OVO JE SADA CENTRALNI TOP OVERLAY
                         ===================================== -->

                    <div class="nav-next-overlay" id="nextInstruction" hidden>

                        <div class="nav-next-icon" id="nextInstructionIcon">
                            ↰
                        </div>


                        <div class="nav-next-copy">

                            <small>
                                NAREDNI MANEVAR
                            </small>

                            <strong id="nextInstructionText">
                                —
                            </strong>

                            <span id="nextInstructionDistance">
                                —
                            </span>

                        </div>

                    </div>


                    <!-- =====================================
                         MAP CONTROLS
                         ===================================== -->

                    <div class="nav-map-controls">

                        <button type="button" id="fitRoute" class="nav-map-control" title="Prikaži celu rutu">
                            ⤢
                        </button>

                        <button type="button" id="centerGps" class="nav-map-control" title="Centriraj GPS">
                            ◎
                        </button>

                    </div>


                    <!-- =====================================
                         ACTIVE ROUTE CARD
                         ===================================== -->

                    <div class="nav-map-route-card" id="mapRouteCard" hidden>

                        <div class="nav-map-route-card-head">

                            <div>

                                <small>
                                    AKTIVNA RUTA
                                </small>

                                <strong id="mapRouteTitle">
                                    Beograd → Novi Sad
                                </strong>

                            </div>

                            <span id="mapRouteStatus" class="pm-badge pm-badge-success">
                                Bezbedna
                            </span>

                        </div>


                        <div class="nav-map-route-stats">

                            <div>

                                <span>
                                    Udaljenost
                                </span>

                                <strong id="mapDistance">
                                    —
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Trajanje
                                </span>

                                <strong id="mapDuration">
                                    —
                                </strong>

                            </div>


                            <div>

                                <span>
                                    ETA
                                </span>

                                <strong id="mapEta">
                                    —
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             CONTROL PANEL
             ================================================= -->

        <aside class="navigation-control-panel" id="navigationControlPanel">


            <!-- =============================================
                 ROUTE PLANNER
                 ============================================= -->

            <section class="nav-control-card nav-route-control">

                <div class="nav-control-card-header">

                    <div>

                        <span class="nav-section-kicker">
                            ROUTE PLANNER
                        </span>

                        <h2>
                            Planiranje rute
                        </h2>

                    </div>


                    <button type="button" id="swapPoints" class="nav-icon-button"
                            title="Zameni polaznu i odredišnu tačku">
                        ⇅
                    </button>

                </div>


                <div class="nav-route-inputs">


                    <!-- START -->

                    <div class="nav-route-input-row">

                        <div class="nav-point-marker start"></div>

                        <div class="nav-input-wrapper">

                            <label for="navStart">
                                POLAZNA TAČKA
                            </label>

                            <input id="navStart" class="nav-input" type="text" autocomplete="off"
                                   value="Beograd, Srbija" placeholder="Grad, adresa ili lokacija" />

                            <div id="navStartSuggestions" class="nav-suggestions">
                            </div>

                            <div id="navStartResolved" class="nav-resolved">

                                <span></span>

                                Nije još potvrđeno

                            </div>

                        </div>

                    </div>


                    <div class="nav-route-connector"></div>


                    <!-- DESTINATION -->

                    <div class="nav-route-input-row">

                        <div class="nav-point-marker destination"></div>

                        <div class="nav-input-wrapper">

                            <label for="navEnd">
                                ODREDIŠTE
                            </label>

                            <input id="navEnd" class="nav-input" type="text" autocomplete="off" value="Novi Sad, Srbija"
                                   placeholder="Grad, adresa ili lokacija" />

                            <div id="navEndSuggestions" class="nav-suggestions">
                            </div>

                            <div id="navEndResolved" class="nav-resolved">

                                <span></span>

                                Nije još potvrđeno

                            </div>

                        </div>

                    </div>

                </div>


                <div class="nav-map-pick-row">

                    <button type="button" id="pickStart" class="nav-small-action">

                        <span>＋</span>

                        Izaberi start na mapi

                    </button>


                    <button type="button" id="pickEnd" class="nav-small-action">

                        <span>＋</span>

                        Izaberi cilj na mapi

                    </button>

                </div>

            </section>


            <!-- =============================================
                 VEHICLE MODE
                 ============================================= -->

            <section class="nav-control-card">

                <div class="nav-control-card-header compact">

                    <div>

