@page "/settings"
@{
    ViewData["Title"] = "Podešavanja · ProMap Cargo";
}

<div id="app" style="display:none"></div>
<div class="pm-page" data-module="settings">
  <header class="pm-header">
    <div>
      <div class="pm-brand">ProMap <span>Cargo</span></div>
      <div class="pm-kicker">Podešavanja</div>
      <div class="pm-subtitle">Application, routing and tenant configuration</div>
    </div>
    <div class="pm-header-actions">
      <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
      <a class="pm-btn" href="/profile">Profil</a>
    </div>
  </header>
  <div class="pm-layout">
    <aside class="pm-sidebar">
      <div class="pm-nav-title">OPERATIONS</div>
      <nav class="pm-nav"><a class="" href="/dashboard">Dashboard</a><a class="" href="/dispatch">Command Center</a><a class="" href="/orders">Transportni nalozi</a><a class="" href="/trips">Ture</a><a class="" href="/vehicles">Vozila</a><a class="" href="/drivers">Vozači</a><a class="" href="/navigation">Navigacija</a><a class="" href="/alerts">Alerts</a><a class="" href="/moderation">Moderacija</a><a class="" href="/audit">Audit</a><a class="" href="/compliance">Compliance</a><a class="" href="/monitoring">Monitoring</a><a class="" href="/finance">Finansije</a><a class="" href="/reports">Izveštaji</a><a class="active" href="/settings">Podešavanja</a><a class="" href="/profile">Profil</a><a class="" href="/admin">Administracija</a></nav>
      <div class="pm-sidebar-footer"><b>Routing engine</b><br>PostGIS · OSM · Truck-aware<br><span>Graph protected</span></div>
    </aside>
    <main class="pm-content">
      <div class="pm-title">Podešavanja</div><div class="pm-muted" style="margin:5px 0 14px">Tenant, routing and notification configuration.</div><div class="pm-grid pm-grid-2"><div class="pm-card pm-card-body"><div class="pm-h2">Routing</div><div class="pm-list" style="margin-top:12px"><label class="pm-label">Default profile</label><select class="pm-field"><option>Truck</option><option>Car</option></select><label class="pm-label">Fallback engine</label><select class="pm-field"><option>OSRM</option><option>Disabled</option></select><label class="pm-label">Avoid active restrictions</label><select class="pm-field"><option>Yes</option><option>No</option></select></div></div><div class="pm-card pm-card-body"><div class="pm-h2">Notifications</div><div class="pm-list" style="margin-top:12px"><label class="pm-item"><input type="checkbox" checked> Off-route alerts</label><label class="pm-item"><input type="checkbox" checked> GPS lost alerts</label><label class="pm-item"><input type="checkbox" checked> Border waiting alerts</label><label class="pm-item"><input type="checkbox"> Daily finance digest</label></div></div></div><div style="height:14px"></div><div class="pm-card pm-card-body"><button class="pm-btn pm-btn-primary">Sačuvaj podešavanja</button></div>
    </main>
  </div>
</div>


<script>
// Pages are server-rendered and must remain independent from the legacy SPA renderer.
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.pm-page a[href]').forEach(a=>a.addEventListener('click',e=>{
    if(a.origin===location.origin){ e.stopPropagation(); }
  },true));
});
</script>

