@section Scripts {

    <script src="~/js/promap-gps.js" asp-append-version="true"></script>
    <script src="~/js/promap-maneuvers.js" asp-append-version="true"></script>
    <script src="~/js/promap-routing.js" asp-append-version="true"></script>

    <!-- PMTiles runtime -->
    <script src="~/lib/pmtiles/dist/pmtiles.js" asp-append-version="true"></script>

    <!-- Icons -->
    <script src="~/js/promap-map-icons.js" asp-append-version="true"></script>


    <!-- Operational map layers -->
    <script src="~/js/promap-map-enhancements.js" asp-append-version="true"></script>

    <!-- PMTiles / MapLibre initialization -->
    <script src="~/js/promap-pmtiles-init.js" asp-append-version="true"></script>

    <!-- Navigation -->
    <script src="~/js/navigation.js" asp-append-version="true"></script>

    <script>

        (() => {
            "use strict";

            document.documentElement.classList.add("pm-navigation-html");
            document.body.classList.add("pm-navigation-app");

            const workspace = document.querySelector(".navigation-workspace");
            const sidebar = document.getElementById("navigationControlPanel");
            const toggle = document.getElementById("toggleRightPanelBtn");
            const breakpoint = window.matchMedia("(max-width: 1180px)");

            if (!workspace || !sidebar || !toggle) {
                return;
            }

            const setSidebarState = (open) => {
                workspace.classList.toggle("nav-right-sidebar-open", open);
                workspace.classList.toggle("nav-right-sidebar-collapsed", !open);

                toggle.setAttribute("aria-expanded", String(open));
                toggle.title = open
                    ? "Sakrij panel za planiranje rute"
                    : "Prikaži panel za planiranje rute";
            };

            setSidebarState(!breakpoint.matches);

            toggle.addEventListener("click", () => {
                const isOpen =
                    workspace.classList.contains("nav-right-sidebar-open") ||
                    !workspace.classList.contains("nav-right-sidebar-collapsed");

                setSidebarState(!isOpen);
            });

            breakpoint.addEventListener?.("change", () => {
                setSidebarState(!breakpoint.matches);
            });
        })();
    </script>

    <script>

        (() => {
            "use strict";

            const query = new URLSearchParams(window.location.search);
            const isEmbeddedNavigation =
                query.get("embedded") === "1" ||
                query.get("mobile") === "1";

            if (isEmbeddedNavigation) {
                document.body.classList.add("pm-embedded-navigation");
                document.body.classList.add("pm-embedded-mobile");
            }

            function bindMobileSheetToggle() {
                if (!isEmbeddedNavigation) {
                    return;
                }

                const panel = document.querySelector(".navigation-control-panel");
                const toggle = document.getElementById("togglePlanner");

                if (!panel || !toggle) {
                    return;
                }

                toggle.hidden = false;

                toggle.addEventListener("click", () => {
                    panel.classList.toggle("sheet-open");
                });
            }

            bindMobileSheetToggle();

            let panelBound = false;

            function bindProMapLayerPanel() {
                const panel =
                    document.getElementById("promapLayerPanel");

                if (!panel) {
                    console.warn(
                        "[ProMap Layers] #promapLayerPanel nije pronađen."
                    );

                    return false;
                }

                /*
                 * Ne bindujemo isti panel više puta.
                 */
                if (
                    panelBound ||
                    panel.dataset.bound === "1"
                ) {
                    return true;
                }

                /*
                 * MapEnhancementState nastaje u:
                 *
                 * ProMap.MapEnhancements.install(...)
                 *
                 * Zato panel mora da sačeka da mapa
                 * i operational layers budu spremni.
                 */
                const state =
                    window.ProMap?.MapEnhancementState;

                if (
                    !state ||
                    typeof state.setGroupVisible !== "function"
                ) {
                    console.info(
                        "[ProMap Layers] Čekam MapEnhancementState..."
                    );

                    return false;
                }

                const inputs =
                    panel.querySelectorAll(
                        "input[data-promap-layer]"
                    );

                if (!inputs.length) {
                    console.warn(
                        "[ProMap Layers] Nema layer checkboxova u panelu."
                    );

                    return false;
                }

                /*
                 * Sada je panel stvarno povezan.
                 */
                panelBound = true;
                panel.dataset.bound = "1";

                inputs.forEach((input) => {

                    input.addEventListener(
                        "change",
                        () => {
                            const group =
                                input.dataset.promapLayer;

                            if (!group) {
                                return;
                            }

                            const visible =
                                input.checked;

                            console.info(
                                `[ProMap Layers] ${group}: ${
                                    visible
                                        ? "ON"
                                        : "OFF"
                                }`
                            );

                            state.setGroupVisible(
                                group,
                                visible
                            );
                        }
                    );
                });

                /*
                 * Sinhronizuj početno stanje checkboxova
                 * sa trenutnim MapEnhancementState stanjem.
                 */
                let currentGroups = {};

                if (
                    typeof state.getVisibleGroups ===
                    "function"
                ) {
                    currentGroups =
                        state.getVisibleGroups() || {};
                }

                inputs.forEach((input) => {
                    const group =
                        input.dataset.promapLayer;

                    if (!group) {
                        return;
                    }

                    /*
                     * Ako state već zna stanje grupe,
                     * checkbox prati state.
                     */
                    if (
                        Object.prototype.hasOwnProperty.call(
                            currentGroups,
                            group
                        )
                    ) {
                        input.checked =
                            currentGroups[group] !== false;
                    }

                    /*
                     * Primeni stanje na MapLibre.
                     */
                    state.setGroupVisible(
                        group,
                        input.checked
                    );
                });

                console.info(
                    `[ProMap Layers] Panel povezan: ${inputs.length} layer grupa.`
                );

                return true;
            }

            /*
             * Pokušaj odmah.
             *
             * Ako navigation.js još nije napravio mapu,
             * funkcija samo vraća false.
             */
            bindProMapLayerPanel();

            /*
             * navigation.js šalje ovaj event odmah nakon:
             *
             * MapEnhancements.install(...)
             *
             */
            window.addEventListener(
                "promap:map-enhancements-ready",
                () => {
                    console.info(
                        "[ProMap Layers] MapEnhancements ready — binding panel."
                    );

                    bindProMapLayerPanel();
                },
                { once: true }
            );

        })();
    </script>
}

