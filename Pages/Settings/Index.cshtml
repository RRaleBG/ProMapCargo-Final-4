                            VEHICLE
                        </span>

                        <h2>
                            Profil vozila
                        </h2>

                    </div>

                    <span id="truckModeBadge" class="nav-mini-status">
                        HGV
                    </span>

                </div>


                <div class="nav-mode-switch">

                    <button type="button" id="truckMode" class="nav-mode-button active">

                        <span class="nav-mode-icon">
                            ▣
                        </span>

                        <span>

                            <strong>
                                Kamion
                            </strong>

                            <small>
                                Truck-aware
                            </small>

