@page "/settings"
@{
    ViewData["Title"] = "Podešavanja · ProMap Cargo";
}

<div class="pm-page" data-module="settings">
    <header class="pm-page-header">
        <div class="pm-page-heading">
            <div class="pm-page-kicker">Sistem</div>
            <h1 class="pm-page-title">Podešavanja</h1>
            <p class="pm-page-subtitle">Pregled platforme, korisničkog naloga, navigacije i operativnih kontrola.</p>
        </div>
        <div class="pm-page-actions">
            <a class="pm-btn pm-btn-primary" asp-page="/Profile/Index">Moj profil</a>
        </div>
    </header>

    <div class="pm-grid pm-grid-2">
        <section class="pm-card">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Nalog i pristup</h2>
                    <p class="pm-card-subtitle">Upravljaj profilom i administrativnim pristupom.</p>
                </div>
                <span class="pm-badge pm-badge--success">Identity</span>
            </header>
            <div class="pm-card-body">
                <p class="pm-text-muted">Lični podaci i bezbednosne opcije uređuju se u profilu. Administratorske uloge
                    i kompanijski pristup dostupni su administratorima.</p>
                    <div class="pm-page-actions pm-mt-3">
                        <a class="pm-btn pm-btn-secondary" asp-page="/Profile/Index">Otvori profil</a>
                        <a class="pm-btn pm-btn-ghost" asp-page="/Admin/Index">Administracija</a>
                    </div>
                </div>
            </section>

            <section class="pm-card">
                <header class="pm-card-header">
                    <div>
                        <h2 class="pm-card-title">Navigacija i mape</h2>
                        <p class="pm-card-subtitle">Lokalne karte i truck-aware planiranje ruta.</p>
                    </div>
                    <span class="pm-badge pm-badge--info">OSM · PostGIS</span>
                </header>
                <div class="pm-card-body">
                    <div class="pm-list">
                        <div class="pm-list-row"><span>Osnovna karta</span><strong>Europe · PMTiles</strong></div>
                        <div class="pm-list-row"><span>Primarni routing</span><strong>PostGIS · OSM</strong></div>
                        <div class="pm-list-row"><span>Rezervni routing</span><strong>OSRM</strong></div>
                    </div>
                    <div class="pm-page-actions pm-mt-3">
                        <a class="pm-btn pm-btn-primary" asp-page="/Navigation/Index">Otvori navigaciju</a>
                        <a class="pm-btn pm-btn-ghost" asp-page="/Trips/Index">Pregled tura</a>
                    </div>
                </div>
            </section>

            <section class="pm-card">
                <header class="pm-card-header">
                    <div>
                        <h2 class="pm-card-title">Operativni nadzor</h2>
                        <p class="pm-card-subtitle">Aktivna upozorenja i zdravlje sistema.</p>
                    </div>
                </header>
                <div class="pm-card-body">
                    <p class="pm-text-muted">Praćenje voznog parka, GPS telemetrije i operativnih upozorenja dostupno je
                        kroz monitoring i alert centar.</p>
                        <div class="pm-page-actions pm-mt-3">
                            <a class="pm-btn pm-btn-secondary" asp-page="/Monitoring/Index">Monitoring</a>
                            <a class="pm-btn pm-btn-ghost" asp-page="/Alerts/Index">Alert centar</a>
                        </div>
                    </div>
                </section>

                <section class="pm-card">
                    <header class="pm-card-header">
                        <div>
                            <h2 class="pm-card-title">Platforma</h2>
                            <p class="pm-card-subtitle">Osnovne komponente ovog okruženja.</p>
                        </div>
                        <span class="pm-badge">ProMap Cargo</span>
                    </header>
                    <div class="pm-card-body pm-list">
                        <div class="pm-list-row"><span>Prostorna baza</span><strong>PostgreSQL · PostGIS</strong></div>
                        <div class="pm-list-row"><span>Podaci o putevima</span><strong>OpenStreetMap</strong></div>
                        <div class="pm-list-row"><span>Map tiles</span><strong>Lokalni PMTiles</strong></div>
                        <div class="pm-list-row"><span>Telemetrija</span><strong>SignalR</strong></div>
                    </div>
                </section>
            </div>
        </div>
