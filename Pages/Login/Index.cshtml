@page "/login"
@model ProMapCargo.Api.Pages.Login.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Login · ProMap Cargo";
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#031c18" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/promap.css" asp-append-version="true" />

</head>
<body class="pm-page pm-auth-page">
    <div class="pm-auth-backdrop" aria-hidden="true">
        <div class="pm-auth-route route-a"></div>
        <div class="pm-auth-route route-b"></div>
        <div class="pm-auth-node node-a"></div>
        <div class="pm-auth-node node-b"></div>
        <div class="pm-auth-node node-c"></div>
    </div>

    <main class="pm-auth-shell">
        <section class="pm-card pm-auth-card" aria-label="Prijava">
            <header class="pm-card-header pm-auth-header">
                <div>
                    <div class="pm-eyebrow">Account · Access</div>
                    <h2 class="pm-card-title">Prijava</h2>
                    <p class="pm-card-subtitle">Unesite podatke za pristup vašem nalogu.</p>
                </div>
                <div class="pm-auth-lock" aria-hidden="true">◈</div>
            </header>

            <div class="pm-card-body">
                <form method="post" class="pm-form-stack" novalidate>
                    <input asp-for="Input.ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="pm-error"></div>

                    <div class="pm-field">
                        <label for="email">Email adresa</label>
                        <div class="pm-input-wrap">
                            <span class="pm-input-icon">@@</span>
                            <input asp-for="Input.Email" id="email" type="email" autocomplete="username"
                                   placeholder="operator@promapcargo.com" required class="pm-input" />
                        </div>
                        <span asp-validation-for="Input.Email" class="pm-field-error"></span>
                    </div>

                    <div class="pm-field">
                        <div class="pm-field-row">
                            <label for="password">Lozinka</label>
                            <a href="/Account/ForgotPassword" class="pm-link-inline">Zaboravljena lozinka?</a>
                        </div>
                        <div class="pm-input-wrap">
                            <span class="pm-input-icon">●</span>
                            <input asp-for="Input.Password" id="password" type="password" autocomplete="current-password"
                                   placeholder="Unesite lozinku" required class="pm-input" />
                            <button type="button" class="pm-password-toggle" id="togglePassword" aria-label="Prikaži lozinku">◉</button>
                        </div>
                        <span asp-validation-for="Input.Password" class="pm-field-error"></span>
                    </div>

                    <label class="pm-check">
                        <input asp-for="Input.RememberMe" type="checkbox" />
                        <span class="pm-check-box"></span>
                        <span>Zapamti me na ovom uređaju</span>
                    </label>

                    <button type="submit" class="pm-btn pm-btn-primary pm-btn-lg pm-btn-full">
                        <span>Prijavi se</span>
                        <span class="pm-btn-arrow" aria-hidden="true">→</span>
                    </button>
                </form>
            </div>

            <footer class="pm-card-footer">
                <div class="pm-divider"><span>SECURE IDENTITY ACCESS</span></div>

                <div class="pm-status-row">
                    <span class="pm-status-mark" aria-hidden="true">✓</span>
                    <div>
                        <strong>Zaštićen pristup</strong>
                        <small>ASP.NET Core Identity · Secure session</small>
                    </div>
                </div>

                <div class="pm-signup-row">
                    <span>Nemate nalog?</span>
                    <a href="/Account/Register">Kreirajte nalog</a>
                </div>
            </footer>
        </section>
    </main>

@if (TempData["ToastSuccess"] is string toastSuccess)
{
    <div id="pm-server-toast" data-toast-type="success" hidden>@toastSuccess</div>
}
@if (TempData["ToastError"] is string toastError)
{
    <div id="pm-server-toast" data-toast-type="danger" hidden>@toastError</div>
}

<script src="~/lib/lucide.min.js" asp-append-version="true" defer></script>
<script src="~/js/core/icons.js" asp-append-version="true" defer></script>
<script src="~/js/core/toast.js" asp-append-version="true" defer></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const password =
            document.getElementById("password");

        const toggle =
            document.getElementById("togglePassword");

        if (password && toggle) {

            toggle.addEventListener("click", function () {

                const visible =
                    password.type === "text";

                password.type =
                    visible ? "password" : "text";

                toggle.textContent =
                    visible ? "◉" : "◎";

                toggle.setAttribute(
                    "aria-label",
                    visible
                        ? "Prikaži lozinku"
                        : "Sakrij lozinku"
                );

            });

        }

        const form = document.querySelector(".pm-form-stack");
        if (!form) {
            return;
        }

        const inputs = Array.from(form.querySelectorAll("input[type='email'], input[type='password']"));

        const applyValidationState = function (input) {
            const hasValue = (input.value || "").trim().length > 0;
            const isValid = input.checkValidity();

            input.classList.remove(
                "pm-field-valid",
                "pm-field-ring",
                "pm-field-valid-ring",
                "pm-field-invalid",
                "pm-field-invalid-ring");

            if (!hasValue) {
                return;
            }

            if (isValid) {
                input.classList.add("pm-field-valid", "pm-field-ring", "pm-field-valid-ring");
                input.setAttribute("aria-invalid", "false");
                return;
            }

            input.classList.add("pm-field-invalid", "pm-field-ring", "pm-field-invalid-ring");
            input.setAttribute("aria-invalid", "true");
        };

        inputs.forEach(function (input) {
            input.addEventListener("input", function () {
                applyValidationState(input);
            });
            input.addEventListener("blur", function () {
                applyValidationState(input);
            });
            applyValidationState(input);
        });

        form.addEventListener("submit", function () {
            inputs.forEach(applyValidationState);
        });

        window.addEventListener("load", function () {
            const serverToast = document.getElementById("pm-server-toast");
            if (serverToast && window.ProMapCargo?.toast) {
                window.ProMapCargo.toast.show(
                    serverToast.textContent || "",
                    serverToast.dataset.toastType || "info");
            }
        });

    });
</script>
</body>
</html>
