@page "/login"
@model ProMapCargo.Api.Pages.Login.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Login · ProMap Cargo";
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#031c18" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/promap.css" asp-append-version="true" />

</head>
<body class="pm-page">
<div class="pm-login-decor-layer">

    <div class="pm-login-route route-a"></div>
    <div class="pm-login-route route-b"></div>

    <div class="pm-login-node node-a"></div>
    <div class="pm-login-node node-b"></div>
    <div class="pm-login-node node-c"></div>
</div>

<div class="pm-login-main">
    <section class="pm-login-shell pm-login-shell-single">

        <!-- =====================================================
                 RIGHT / LOGIN
                 ===================================================== -->

        <section class="pm-login-card">
            <div class="pm-login-card-glow"></div>
            <div class="pm-login-card-header">
                <div>
                    <div class="pm-login-card-eyebrow">
                        ACCOUNT · ACCESS
                    </div>
                    <h2>
                        Prijava
                    </h2>
                    <p>
                        Unesite podatke za pristup vašem nalogu.
                    </p>
                </div>
                <div class="pm-login-lock">
                    ◈
                </div>
            </div>


            <form method="post" class="pm-login-form" novalidate>
                <input asp-for="Input.ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="pm-login-validation"></div>

                <div class="pm-login-field">
                    <label for="email">
                        Email adresa
                    </label>
                    <div class="pm-login-input-wrap">
                        <span class="pm-login-input-icon">
                            @@
                        </span>
                        <input asp-for="Input.Email" id="email" type="email" autocomplete="username"
                               placeholder="operator@promapcargo.com" required class="pm-login-input-transition" />
                    </div>
                    <span asp-validation-for="Input.Email" class="pm-login-field-validation"></span>
                </div>


                <div class="pm-login-field">
                    <div class="pm-login-label-row">
                        <label for="password">
                            Lozinka
                        </label>

                        <a href="/Account/ForgotPassword" class="pm-login-link">
                            Zaboravljena lozinka?
                        </a>

                    </div>


                    <div class="pm-login-input-wrap">

                        <span class="pm-login-input-icon">
                            ●
                        </span>

                        <input asp-for="Input.Password" id="password" type="password" autocomplete="current-password"
                               placeholder="Unesite lozinku" required class="pm-login-input-transition" />

                        <button type="button" class="pm-login-password-toggle" id="togglePassword"
                                aria-label="Prikaži lozinku">
                            ◉
                        </button>

                    </div>
                    <span asp-validation-for="Input.Password" class="pm-login-field-validation"></span>

                </div>


                <label class="pm-login-remember">

                    <input asp-for="Input.RememberMe" />

                    <span class="pm-login-check"></span>

                    <span>
                        Zapamti me na ovom uređaju
                    </span>

                </label>


                <button type="submit" class="pm-login-submit">

                    <span>
                        Prijavi se
                    </span>

                    <span class="pm-login-submit-arrow">
                        →
                    </span>

                </button>


                <div class="pm-login-divider">

                    <span>
                        SECURE IDENTITY ACCESS
                    </span>

                </div>


                <div class="pm-login-security">

                    <div class="pm-login-security-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            Zaštićen pristup
                        </strong>

                        <span>
                            ASP.NET Core Identity · Secure session
                        </span>

                    </div>

                </div>


                <div class="pm-login-register">

                    <span>
                        Nemate nalog?
                    </span>

                    <a href="/Account/Register">
                        Kreirajte nalog
                    </a>

                </div>

            </form>

        </section>

    </section>

</div>

@if (TempData["ToastSuccess"] is string toastSuccess)
{
    <div id="pm-server-toast" data-toast-type="success" hidden>@toastSuccess</div>
}
@if (TempData["ToastError"] is string toastError)
{
    <div id="pm-server-toast" data-toast-type="danger" hidden>@toastError</div>
}

<script src="~/lib/lucide.min.js" asp-append-version="true" defer></script>
<script src="~/js/core/icons.js" asp-append-version="true" defer></script>
<script src="~/js/core/toast.js" asp-append-version="true" defer></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const password =
            document.getElementById("password");

        const toggle =
            document.getElementById("togglePassword");

        if (password && toggle) {

            toggle.addEventListener("click", function () {

                const visible =
                    password.type === "text";

                password.type =
                    visible ? "password" : "text";

                toggle.textContent =
                    visible ? "◉" : "◎";

                toggle.setAttribute(
                    "aria-label",
                    visible
                        ? "Prikaži lozinku"
                        : "Sakrij lozinku"
                );

            });

        }

        const form = document.querySelector(".pm-login-form");
        if (!form) {
            return;
        }

        const inputs = Array.from(form.querySelectorAll("input[type='email'], input[type='password']"));

        const applyValidationState = function (input) {
            const hasValue = (input.value || "").trim().length > 0;
            const isValid = input.checkValidity();

            input.classList.remove(
                "pm-field-valid",
                "pm-field-ring",
                "pm-field-valid-ring",
                "pm-field-invalid",
                "pm-field-invalid-ring");

            if (!hasValue) {
                return;
            }

            if (isValid) {
                input.classList.add("pm-field-valid", "pm-field-ring", "pm-field-valid-ring");
                input.setAttribute("aria-invalid", "false");
                return;
            }

            input.classList.add("pm-field-invalid", "pm-field-ring", "pm-field-invalid-ring");
            input.setAttribute("aria-invalid", "true");
        };

        inputs.forEach(function (input) {
            input.addEventListener("input", function () {
                applyValidationState(input);
            });
            input.addEventListener("blur", function () {
                applyValidationState(input);
            });
            applyValidationState(input);
        });

        form.addEventListener("submit", function () {
            inputs.forEach(applyValidationState);
        });

        window.addEventListener("load", function () {
            const serverToast = document.getElementById("pm-server-toast");
            if (serverToast && window.ProMapCargo?.toast) {
                window.ProMapCargo.toast.show(
                    serverToast.textContent || "",
                    serverToast.dataset.toastType || "info");
            }
        });

    });
</script>
</body>
</html>
