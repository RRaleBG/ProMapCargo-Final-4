@page "/reports"
@{
  ViewData["Title"] = "Izveštaji · ProMap Cargo";
}

<div id="app" style="display:none"></div>
<div class="pm-page" data-module="reports">
  <header class="pm-header">
    <div>
      <div class="pm-brand">ProMap <span>Cargo</span></div>
      <div class="pm-kicker">Izveštaji</div>
      <div class="pm-subtitle">Operational analytics and exportable management reports</div>
    </div>
    <div class="pm-header-actions">
      <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
      <a class="pm-btn" href="/profile">Profil</a>
    </div>
  </header>
  <div class="pm-layout">
    <aside class="pm-sidebar">
      <div class="pm-nav-title">OPERATIONS</div>
      <nav class="pm-nav"><a class="" href="/dashboard">Dashboard</a><a class="" href="/dispatch">Command Center</a><a
        class="" href="/orders">Transportni nalozi</a><a class="" href="/trips">Ture</a><a class=""
                                                                                           href="/vehicles">Vozila</a><a class="" href="/drivers">Vozači</a><a class=""
                                                                            href="/navigation">Navigacija</a><a class="" href="/alerts">Alerts</a><a class=""
                                                                                 href="/moderation">Moderacija</a><a class="" href="/audit">Audit</a><a class=""
                                                                               href="/compliance">Compliance</a><a class="" href="/monitoring">Monitoring</a><a class=""
                                                                                         href="/finance">Finansije</a><a class="active" href="/reports">Izveštaji</a><a class=""
                                                                                       href="/settings">Podešavanja</a><a class="" href="/profile">Profil</a><a class=""
                                                                                 href="/admin">Administracija</a></nav>
        <div class="pm-sidebar-footer"><b>Routing engine</b><br>PostGIS · OSM · Truck-aware<br><span>Graph
          protected</span></div>
        </aside>
        <main class="pm-content">
          <div class="pm-title">Izveštaji</div>
          <div class="pm-muted" style="margin:5px 0 14px">Operational, fleet and route analytics.</div>
          <div class="pm-grid pm-grid-3">
            <div class="pm-card pm-card-body">
              <div class="pm-h2">Fleet utilization</div>
              <div class="pm-value">82%</div>
              <div class="pm-progress" style="margin-top:10px"><span style="width:82%"></span></div>
            </div>
            <div class="pm-card pm-card-body">
              <div class="pm-h2">On-time delivery</div>
              <div class="pm-value">94%</div>
              <div class="pm-progress" style="margin-top:10px">
                <span style="width:94%"></span>
              </div>
            </div>
            <div class="pm-card pm-card-body">
              <div class="pm-h2">Average route deviation</div>
              <div class="pm-value">1.7%</div>
              <div class="pm-muted">↓ 0.4 pp vs last month</div>
            </div>
          </div>
          <div style="height:14px"></div>
          <div class="pm-card pm-card-body">
            <div class="pm-h2">Generate report</div>
            <div class="pm-grid pm-grid-3" style="margin-top:12px"><select class="pm-field">
              <option>Fleet performance</option>
              <option>Trip profitability</option>
              <option>Driver compliance</option>
              <option>Routing exceptions</option>
            </select><input class="pm-field" type="date" value="2026-09-01"><input class="pm-field" type="date"
                                                                                   value="2026-09-12"></div>
            <div class="pm-actions" style="margin-top:12px"><button class="pm-btn pm-btn-primary">Generate</button><button
              class="pm-btn">Export CSV</button><button class="pm-btn">Export PDF</button></div>
            </div>
          </main>
        </div>
      </div>

      
      <script>
        // Pages are server-rendered and must remain independent from the legacy SPA renderer.
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.pm-page a[href]').forEach(a => a.addEventListener('click', e => {
            if (a.origin === location.origin) { e.stopPropagation(); }
          }, true));
        });
      </script>

