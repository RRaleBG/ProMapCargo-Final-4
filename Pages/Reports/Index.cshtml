@page "/reports"
@{
    ViewData["Title"] = "Izveštaji · ProMap Cargo";
}

<div class="pm-page pm-reports-page" data-module="reports">
    <header class="pm-page-header">
        <div class="pm-page-heading">
            <div class="pm-page-kicker">Analitika</div>
            <h1 class="pm-page-title">Izveštaji</h1>
            <p class="pm-page-subtitle">Operativni, flotni i routing pokazatelji.</p>
        </div>
        <div class="pm-page-actions">
            <button class="pm-btn pm-btn-secondary" type="button">Izvezi CSV</button>
            <button class="pm-btn pm-btn-primary" type="button">Novi izveštaj</button>
        </div>
    </header>

    <section class="pm-grid pm-grid-3" aria-label="Ključni pokazatelji">
        <article class="pm-card pm-card-body">
            <div class="pm-kpi-label">Iskorišćenost flote</div>
            <div class="pm-kpi-value">82%</div>
            <div class="pm-progress pm-mt-3" role="progressbar" aria-label="Iskorišćenost flote" aria-valuemin="0"
                 aria-valuemax="100" aria-valuenow="82"><span style="--pm-progress:82%"></span></div>
        </article>
        <article class="pm-card pm-card-body">
            <div class="pm-kpi-label">Isporuke na vreme</div>
            <div class="pm-kpi-value">94%</div>
            <div class="pm-progress pm-mt-3" role="progressbar" aria-label="Isporuke na vreme" aria-valuemin="0"
                 aria-valuemax="100" aria-valuenow="94"><span style="--pm-progress:94%"></span></div>
        </article>
        <article class="pm-card pm-card-body">
            <div class="pm-kpi-label">Prosečno odstupanje rute</div>
            <div class="pm-kpi-value">1,7%</div>
            <div class="pm-kpi-footer">↓ 0,4 procentna poena u odnosu na prethodni mesec</div>
        </article>
    </section>

    <section class="pm-card">
        <header class="pm-card-header">
            <div>
                <h2 class="pm-card-title">Generisanje izveštaja</h2>
                <p class="pm-card-subtitle">Izaberi tip izveštaja i vremenski period</p>
            </div>
        </header>
        <div class="pm-card-body">
            <div class="pm-form-grid pm-form-grid-3">
                <label class="pm-field"><span class="pm-label">Tip izveštaja</span>
                    <select class="pm-select">
                        <option>Performanse flote</option>
                        <option>Profitabilnost ture</option>
                        <option>Usklađenost vozača</option>
                        <option>Routing izuzeci</option>
                    </select>
                </label>
                <label class="pm-field"><span class="pm-label">Od datuma</span><input class="pm-input" type="date"
                                                                                          value="2026-09-01" /></label>
                    <label class="pm-field"><span class="pm-label">Do datuma</span><input class="pm-input" type="date"
                                                                                              value="2026-09-12" /></label>
                    </div>
                    <div class="pm-page-actions pm-mt-3">
                        <button class="pm-btn pm-btn-primary" type="button">Generiši</button>
                        <button class="pm-btn pm-btn-secondary" type="button">Preuzmi CSV</button>
                        <button class="pm-btn pm-btn-ghost" type="button">Preuzmi PDF</button>
                    </div>
                </div>
            </section>
        </div>
