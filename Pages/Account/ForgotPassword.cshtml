@page "/Account/ForgotPassword"
@model ProMapCargo.Api.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Obnova lozinke · ProMap Cargo";
}

<div class="pm-auth-main">
    <section class="pm-auth-card">
        <div class="pm-auth-card-glow"></div>

        <header class="pm-auth-header">
            <div>
                <div class="pm-auth-eyebrow">Account · Recovery</div>
                <h1>Obnova lozinke</h1>
                <p>Unesite email adresu naloga i poslaćemo vam link za postavljanje nove lozinke.</p>
            </div>
            <div class="pm-auth-mark"><i data-lucide="key-round"></i></div>
        </header>

        @if (Model.Submitted)
        {
            <div class="pm-auth-note" role="status">
                <i data-lucide="mail-check"></i>
                <span>Ako nalog sa unetom adresom postoji, link za obnovu lozinke je poslat. Proverite i neželjenu poštu.</span>
            </div>
        }
        else
        {
            <form method="post" class="pm-auth-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="pm-validation-summary"></div>

                <div class="pm-auth-field">
                    <label asp-for="Input.Email">Email adresa</label>
                    <input asp-for="Input.Email" type="email" autocomplete="email"
                           maxlength="256" placeholder="operator@promapcargo.com" required />
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>

                <div class="pm-auth-actions">
                    <button class="pm-btn pm-btn-primary" type="submit">
                        <i data-lucide="send"></i>
                        <span>Pošalji link</span>
                    </button>
                </div>
            </form>
        }

        <div class="pm-auth-footer">
            <span>Setili ste se lozinke?</span>
            <a asp-page="/Login/Index">Nazad na prijavu</a>
        </div>
    </section>
</div>
