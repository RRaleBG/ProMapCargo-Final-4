@page "/Account/ChangePassword"
@model ProMapCargo.Api.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Promena lozinke · ProMap Cargo";
}

<div class="pm-auth-main">
    <section class="pm-auth-card">
        <div class="pm-auth-card-glow"></div>

        <header class="pm-auth-header">
            <div>
                <div class="pm-auth-eyebrow">Account · Security</div>
                <h1>Promena lozinke</h1>
                <p>Koristite jedinstvenu lozinku za bezbedan pristup platformi.</p>
            </div>
            <div class="pm-auth-mark"><i data-lucide="lock-keyhole"></i></div>
        </header>

        <form method="post" class="pm-auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="pm-validation-summary"></div>

            <div class="pm-auth-field">
                <label asp-for="Input.CurrentPassword">Trenutna lozinka</label>
                <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password"
                       maxlength="128" required />
                <span asp-validation-for="Input.CurrentPassword" class="field-validation-error"></span>
            </div>

            <div class="pm-auth-field">
                <label asp-for="Input.NewPassword">Nova lozinka</label>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password"
                       minlength="8" maxlength="128" required />
                <span class="pm-auth-hint">Najmanje 8 karaktera, sa velikim i malim slovom i brojem.</span>
                <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
            </div>

            <div class="pm-auth-field">
                <label asp-for="Input.ConfirmPassword">Potvrda nove lozinke</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"
                       minlength="8" maxlength="128" required />
                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
            </div>

            <div class="pm-auth-actions">
                <button class="pm-btn pm-btn-primary" type="submit">
                    <i data-lucide="save"></i>
                    <span>Sačuvaj novu lozinku</span>
                </button>
                <a class="pm-btn pm-btn-ghost" asp-page="/Account/Manage/Index">Odustani</a>
            </div>
        </form>
    </section>
</div>
