@page "/Account/Admin/Index"
@model ProMapCargo.Api.Pages.Account.Admin.IndexModel
@{
    ViewData["Title"] = "Account Admin · ProMap Cargo";
}

<div class="pm-page pm-page--account-admin" data-module="account-admin">
    <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--4" aria-label="Account admin pregled">
        <article class="compliance-kpi compliance-kpi-total pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Ukupno korisnika</span>
                <i data-lucide="users" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value">@Model.Summary.TotalUsers</strong>
            <span class="compliance-kpi-meta">registrovani nalozi</span>
        </article>

        <article class="compliance-kpi compliance-kpi-good pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Aktivni nalozi</span>
                <i data-lucide="user-check" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value">@Model.Summary.ActiveUsers</strong>
            <span class="compliance-kpi-meta">status IsActive = true</span>
        </article>

        <article class="compliance-kpi compliance-kpi-info pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Trenutno online</span>
                <i data-lucide="wifi" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value">@Model.Summary.OnlineUsers</strong>
            <span class="compliance-kpi-meta">SignalR prisustvo</span>
        </article>

        <article class="compliance-kpi compliance-kpi-neutral pm-kpi">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Sistemske role</span>
                <i data-lucide="shield-check" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value">@Model.Summary.RolesCount</strong>
            <span class="compliance-kpi-meta">konfigurisane role</span>
        </article>
    </section>

    <section class="pm-card pm-panel pm-account-admin-tabs-shell">
        <div class="pm-account-admin-tabs pm-filter-group" role="tablist" aria-label="Admin sekcije">
            <button type="button" class="pm-account-admin-tab pm-filter-btn is-active pm-btn" role="tab" aria-selected="true" data-tab-target="users">Korisnici</button>
            <button type="button" class="pm-account-admin-tab pm-filter-btn pm-btn" role="tab" aria-selected="false" data-tab-target="roles">Role i dozvole</button>
            <button type="button" class="pm-account-admin-tab pm-filter-btn pm-btn" role="tab" aria-selected="false" data-tab-target="audit">Audit</button>
        </div>

        <section class="pm-account-admin-tab-panel is-active" data-tab-panel="users">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Korisnici i pristup</h2>
                    <p class="pm-card-subtitle">Status naloga, online prisustvo, poslednja poseta i administratorske operacije.</p>
                </div>
            </header>

            <div class="pm-account-admin-user-forms">
                <form method="post" enctype="multipart/form-data" asp-page-handler="CreateUser" class="pm-card pm-panel pm-account-admin-form-card">
                    <h3 class="pm-card-title">Kreiraj korisnika / vozača</h3>
                    <div class="pm-form-grid pm-form-grid--2">
                        <label class="pm-field">
                            <span>Ime i prezime</span>
                            <input asp-for="CreateUser.DisplayName" class="pm-input" />
                        </label>
                        <label class="pm-field">
                            <span>Email</span>
                            <input asp-for="CreateUser.Email" class="pm-input" />
                        </label>
                        <label class="pm-field">
                            <span>Lozinka</span>
                            <input asp-for="CreateUser.Password" class="pm-input" type="password" />
                        </label>
                        <label class="pm-field">
                            <span>Telefon</span>
                            <input asp-for="CreateUser.PhoneNumber" class="pm-input" />
                        </label>
                        <label class="pm-field">
                            <span>Poveži vozača</span>
                            <select asp-for="CreateUser.DriverId" class="pm-select">
                                <option value="">Bez povezivanja</option>
                                @foreach (var driver in Model.DriverOptions)
                                {
                                    <option value="@driver.Id">@driver.FullName (@(driver.EmployeeNumber ?? "bez broja"))</option>
                                }
                            </select>
                        </label>
                        <label class="pm-field">
                            <span>Slika korisnika</span>
                            <input asp-for="CreateUser.ProfileImage" class="pm-input" type="file" accept=".jpg,.jpeg,.png,.pdf" />
                        </label>
                    </div>
                    <div class="pm-account-admin-role-picks">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <label class="pm-account-admin-check">
                                <input type="checkbox" name="CreateUser.RoleNames" value="@role.Name" />
                                <span>@role.Name</span>
                            </label>
                        }
                    </div>
                    <button type="submit" class="pm-btn pm-btn-primary">Kreiraj korisnika</button>
                </form>
            </div>

            <form method="get" class="pm-account-admin-toolbar pm-toolbar">
                <input type="search" name="Search" value="@Model.Search" placeholder="Pretraga korisnika (ime/email)" class="pm-input" />
                <select name="Status" class="pm-select">
                    <option value="all" selected="@(Model.Status == "all")">Svi statusi</option>
                    <option value="active" selected="@(Model.Status == "active")">Aktivni</option>
                    <option value="inactive" selected="@(Model.Status == "inactive")">Neaktivni</option>
                    <option value="locked" selected="@(Model.Status == "locked")">Zaključani</option>
                    <option value="online" selected="@(Model.Status == "online")">Online</option>
                </select>
                <select name="Role" class="pm-select">
                    <option value="all" selected="@(Model.Role == "all")">Sve role</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role.Name" selected="@(string.Equals(Model.Role, role.Name, StringComparison.OrdinalIgnoreCase))">@role.Name</option>
                    }
                </select>
                <select name="PageSize" class="pm-select">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                </select>
                <button type="submit" class="pm-btn pm-btn-primary">Primeni</button>
            </form>

            <div class="pm-table-wrap">
                <table class="pm-table pm-account-admin-users">
                    <thead>
                        <tr>
                            <th scope="col">Korisnik</th>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Nalog</th>
                            <th scope="col">Session state</th>
                            <th scope="col">Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="pm-account-admin-user-title">
                                        @if (!string.IsNullOrWhiteSpace(user.ProfileImageUrl))
                                        {
                                            <img src="@user.ProfileImageUrl" alt="@user.DisplayName" class="pm-account-admin-avatar" />
                                        }
                                        <div>
                                            <div>@user.DisplayName</div>
                                            <small>@(string.IsNullOrWhiteSpace(user.DriverName) ? "Bez povezanog vozača" : $"Vozač: {user.DriverName}")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>@user.Email</div>
                                    <small>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "—" : user.PhoneNumber)</small>
                                </td>
                                <td>
                                    <div class="pm-account-admin-role-list">
                                        @if (user.Roles.Count == 0)
                                        {
                                            <span class="pm-badge">Bez role</span>
                                        }
                                        else
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="pm-badge">@role</span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="pm-badge pm-badge--danger">Zaključan</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="pm-badge pm-badge--success">Aktivan</span>
                                    }
                                    else
                                    {
                                        <span class="pm-badge">Neaktivan</span>
                                    }
                                </td>
                                <td>
                                    <div class="pm-account-admin-session">
                                        @if (user.IsOnline)
                                        {
                                            <span class="pm-badge pm-badge--success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="pm-badge pm-badge--danger">Inactive</span>
                                        }
                                        <small>IP: @(string.IsNullOrWhiteSpace(user.LastIpAddress) ? "—" : user.LastIpAddress)</small>
                                        <small>Lokacija: @(string.IsNullOrWhiteSpace(user.LastLocation) ? "—" : user.LastLocation)</small>
                                        <small>Poseta: @(user.LastConnectedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</small>
                                        <small>Odlazak: @(user.LastDisconnectedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</small>
                                        <small>Last seen: @(user.LastSeenAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="pm-account-admin-actions">
                                        <form method="post" asp-page-handler="ToggleActive">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button class="pm-btn pm-btn-sm @(user.IsActive ? "pm-btn-secondary" : "pm-btn-primary")" type="submit">
                                                @(user.IsActive ? "Deaktiviraj" : "Aktiviraj")
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="ToggleLock">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button class="pm-btn pm-btn-sm @(user.IsLocked ? "pm-btn-secondary" : "pm-btn-danger")" type="submit">
                                                @(user.IsLocked ? "Otključaj" : "Zaključaj")
                                            </button>
                                        </form>

                                        <details class="pm-account-admin-role-editor">
                                            <summary class="pm-btn pm-btn-sm">Role</summary>
                                            <div class="pm-account-admin-role-editor-body">
                                                @foreach (var role in Model.AvailableRoles)
                                                {
                                                    var assigned = user.Roles.Contains(role.Name, StringComparer.OrdinalIgnoreCase);
                                                    <form method="post" asp-page-handler="SetRole" class="pm-account-admin-role-form">
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        <input type="hidden" name="roleName" value="@role.Name" />
                                                        <input type="hidden" name="assign" value="@(!assigned)" />
                                                        <button class="pm-btn pm-btn-sm @(assigned ? "pm-btn-secondary" : "pm-btn-ghost")" type="submit">
                                                            @(assigned ? "Ukloni" : "Dodaj") @role.Name
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </details>

                                        <details class="pm-account-admin-role-editor">
                                            <summary class="pm-btn pm-btn-sm">Izmeni</summary>
                                            <div class="pm-account-admin-role-editor-body">
                                                <form method="post" enctype="multipart/form-data" asp-page-handler="UpdateUser" class="pm-account-admin-edit-form">
                                                    <input type="hidden" name="EditUser.UserId" value="@user.Id" />
                                                    <input type="text" name="EditUser.DisplayName" value="@user.DisplayName" class="pm-input" placeholder="Ime i prezime" />
                                                    <input type="email" name="EditUser.Email" value="@user.Email" class="pm-input" placeholder="Email" />
                                                    <input type="text" name="EditUser.PhoneNumber" value="@user.PhoneNumber" class="pm-input" placeholder="Telefon" />
                                                    <input type="password" name="EditUser.Password" class="pm-input" placeholder="Nova lozinka (opciono)" />
                                                    <select name="EditUser.DriverId" class="pm-select">
                                                        <option value="">Bez povezivanja</option>
                                                        @foreach (var driver in Model.DriverOptions)
                                                        {
                                                            <option value="@driver.Id" selected="@(user.DriverId == driver.Id)">@driver.FullName (@(driver.EmployeeNumber ?? "bez broja"))</option>
                                                        }
                                                    </select>
                                                    <input type="file" name="EditUser.ProfileImage" class="pm-input" accept=".jpg,.jpeg,.png,.pdf" />
                                                    <div class="pm-account-admin-role-picks">
                                                        @foreach (var role in Model.AvailableRoles)
                                                        {
                                                            var checkedRole = user.Roles.Contains(role.Name, StringComparer.OrdinalIgnoreCase);
                                                            <label class="pm-account-admin-check">
                                                                <input type="checkbox" name="EditUser.RoleNames" value="@role.Name" checked="@checkedRole" />
                                                                <span>@role.Name</span>
                                                            </label>
                                                        }
                                                    </div>
                                                    <button class="pm-btn pm-btn-primary pm-btn-sm" type="submit">Sačuvaj izmene</button>
                                                </form>
                                            </div>
                                        </details>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pm-account-admin-pager pm-toolbar">
                <span class="pm-text-muted">Strana @Model.Pager.Page od @Model.Pager.TotalPages · @Model.Pager.TotalItems korisnika</span>
                <div class="pm-account-admin-pager-actions pm-filter-group">
                    @if (Model.Pager.Page > 1)
                    {
                        <a class="pm-btn pm-btn-sm" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Role="@Model.Role" asp-route-Page="@(Model.Pager.Page - 1)" asp-route-PageSize="@Model.PageSize">Prethodna</a>
                    }
                    @if (Model.Pager.Page < Model.Pager.TotalPages)
                    {
                        <a class="pm-btn pm-btn-sm" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Role="@Model.Role" asp-route-Page="@(Model.Pager.Page + 1)" asp-route-PageSize="@Model.PageSize">Sledeća</a>
                    }
                </div>
            </div>
        </section>

        <section class="pm-account-admin-tab-panel" data-tab-panel="roles">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Role i dozvole</h2>
                    <p class="pm-card-subtitle">Savremeni permission model: granularna prava grupisana po domenima.</p>
                </div>
            </header>

            <div class="pm-account-admin-permissions">
                @foreach (var role in Model.RolePermissions)
                {
                    <article class="pm-account-admin-role-card">
                        <h3>@role.RoleName</h3>
                        @foreach (var group in role.AllPermissions.GroupBy(p => p.Split('.')[0], StringComparer.OrdinalIgnoreCase).OrderBy(g => g.Key))
                        {
                            <div class="pm-account-admin-permission-group">
                                <h4>@group.Key</h4>
                                <div class="pm-account-admin-permission-grid">
                                    @foreach (var permission in group)
                                    {
                                        var hasPermission = role.AssignedPermissions.Contains(permission, StringComparer.OrdinalIgnoreCase);
                                        <form method="post" asp-page-handler="TogglePermission" class="pm-account-admin-permission-form">
                                            <input type="hidden" name="roleId" value="@role.RoleId" />
                                            <input type="hidden" name="permission" value="@permission" />
                                            <input type="hidden" name="grant" value="@(!hasPermission)" />
                                            <button class="pm-account-admin-permission-chip @(hasPermission ? "is-enabled" : "")" type="submit">
                                                <span class="state-dot" aria-hidden="true"></span>
                                                <span>@permission</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="pm-account-admin-tab-panel" data-tab-panel="audit">
            <header class="pm-card-header">
                <div>
                    <h2 class="pm-card-title">Poslednje administratorske aktivnosti</h2>
                    <p class="pm-card-subtitle">Audit log promena korisnika, rola i dozvola sa vremenom i IP adresom.</p>
                </div>
            </header>
            <div class="pm-table-wrap">
                <table class="pm-table">
                    <thead>
                        <tr>
                            <th scope="col">Vreme</th>
                            <th scope="col">Akcija</th>
                            <th scope="col">Entitet</th>
                            <th scope="col">Korisnik</th>
                            <th scope="col">IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td>@log.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>@log.Action</td>
                                <td>@log.EntityType @log.EntityId</td>
                                <td>@(log.UserId?.ToString() ?? "Sistem")</td>
                                <td>@(string.IsNullOrWhiteSpace(log.IpAddress) ? "—" : log.IpAddress)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = Array.from(document.querySelectorAll("[data-tab-target]"));
            const panels = Array.from(document.querySelectorAll("[data-tab-panel]"));

            tabs.forEach(function (tab) {
                tab.addEventListener("click", function () {
                    const target = tab.getAttribute("data-tab-target");

                    tabs.forEach(function (item) {
                        const active = item === tab;
                        item.classList.toggle("is-active", active);
                        item.setAttribute("aria-selected", active ? "true" : "false");
                    });

                    panels.forEach(function (panel) {
                        panel.classList.toggle("is-active", panel.getAttribute("data-tab-panel") === target);
                    });
                });
            });
        });
    </script>
}
