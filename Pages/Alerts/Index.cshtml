@page "/alerts"
@{
    ViewData["Title"] = "Alerts · ProMap Cargo";
}

<div class="pm-alerts-page" data-module="alerts">

    <header class="pm-alerts-header">

        <div class="pm-alerts-heading">

            <div class="pm-alerts-kicker">
                <span class="pm-alerts-kicker-dot"></span>
                CONTROL · ALERT CENTER
            </div>

            <h1>
                Alerts
            </h1>

            <p>
                Centralni pregled svih operativnih, bezbednosnih,
                fleet, navigation, compliance i finansijskih alerta.
            </p>

        </div>

        <div class="pm-alerts-header-actions">
            <div class="pm-alerts-live">
                <span class="pm-alerts-live-dot"></span>
                <span>
                    Alert engine
                </span>

                <strong>
                    LIVE
                </strong>

            </div>

            <button type="button" class="pm-alerts-btn" id="alertsRefresh">

                <span>↻</span>
                Osveži

            </button>

            <button type="button" class="pm-alerts-btn pm-alerts-btn-primary" id="alertsClearResolved">

                Očisti rešene

            </button>

        </div>

    </header>


    <section class="pm-alerts-kpis" aria-label="Alert statistika">

        <article class="pm-alert-kpi pm-alert-kpi-open">

            <div class="pm-alert-kpi-top">

                <span>
                    Otvoreni alerti
                </span>

                <span class="pm-alert-kpi-icon">
                    !
                </span>

            </div>

            <strong id="alertsOpenCount">
                —
            </strong>

            <small>
                zahtevaju pažnju
            </small>

        </article>


        <article class="pm-alert-kpi pm-alert-kpi-critical">

            <div class="pm-alert-kpi-top">

                <span>
                    Critical
                </span>

                <span class="pm-alert-kpi-icon">
                    !
                </span>

            </div>

            <strong id="alertsCriticalCount">
                —
            </strong>

            <small>
                bezbednosni / blokirajući
            </small>

        </article>


        <article class="pm-alert-kpi">

            <div class="pm-alert-kpi-top">

                <span>
                    High
                </span>

                <span class="pm-alert-kpi-icon">
                    ↑
                </span>

            </div>

            <strong id="alertsHighCount">
                —
            </strong>

            <small>
                visoki prioritet
            </small>

        </article>


        <article class="pm-alert-kpi">

            <div class="pm-alert-kpi-top">

                <span>
                    Danas
                </span>

                <span class="pm-alert-kpi-icon">
                    ◷
                </span>

            </div>

            <strong id="alertsTodayCount">
                —
            </strong>

            <small>
                generisano danas
            </small>

        </article>


        <article class="pm-alert-kpi">

            <div class="pm-alert-kpi-top">

                <span>
                    Resolved
                </span>

                <span class="pm-alert-kpi-icon">
                    ✓
                </span>

            </div>

            <strong id="alertsResolvedCount">
                —
            </strong>

            <small>
                uspešno rešeno
            </small>

        </article>

    </section>


    <section class="pm-alerts-workspace">


        <div class="pm-alerts-main">


            <section class="pm-alerts-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            ALERT STREAM
                        </div>

                        <h2>
                            Svi operativni alerti
                        </h2>

                        <p>
                            Centralizovani događaji iz svih ProMap Cargo modula.
                        </p>

                    </div>

                    <div class="pm-alerts-result-count" id="alertsResultCount">
                        —
                    </div>

                </div>


                <div class="pm-alerts-filters">


                    <div class="pm-alerts-search">

                        <span>
                            ⌕
                        </span>

                        <input
                        id="alertsSearch"
                        type="search"
                        autocomplete="off"
                        placeholder="Pretraži alert, vozilo, vozača, turu..."
                        />

                    </div>


                    <select id="alertsSeverity" class="pm-alerts-select">

                        <option value="">
                            Sve severity
                        </option>

                        <option value="critical">
                            Critical
                        </option>

                        <option value="high">
                            High
                        </option>

                        <option value="medium">
                            Medium
                        </option>

                        <option value="low">
                            Low
                        </option>

                        <option value="info">
                            Info
                        </option>

                    </select>


                    <select id="alertsCategory" class="pm-alerts-select">

                        <option value="">
                            Sve kategorije
                        </option>

                        <option value="navigation">
                            Navigacija
                        </option>

                        <option value="gps">
                            GPS
                        </option>

                        <option value="compliance">
                            Compliance
                        </option>

                        <option value="border">
                            Granica
                        </option>

                        <option value="maintenance">
                            Servis
                        </option>

                        <option value="tachograph">
                            Tachograph
                        </option>

                        <option value="fuel">
                            Gorivo / Fuel card
                        </option>

                        <option value="orders">
                            Transportni nalozi
                        </option>

                        <option value="trips">
                            Ture
                        </option>

                        <option value="driver">
                            Vozači
                        </option>

                        <option value="vehicle">
                            Vozila
                        </option>

                        <option value="finance">
                            Finansije
                        </option>

                        <option value="system">
                            Sistem
                        </option>

                    </select>


                    <select id="alertsStatus" class="pm-alerts-select">

                        <option value="open">
                            Otvoreni
                        </option>

                        <option value="">
                            Svi statusi
                        </option>

                        <option value="acknowledged">
                            Acknowledged
                        </option>

                        <option value="snoozed">
                            Snoozed
                        </option>

                        <option value="resolved">
                            Resolved
                        </option>

                    </select>

                </div>


                <div class="pm-alerts-list" id="alertsList">
                </div>


                <div class="pm-alerts-empty" id="alertsEmpty" hidden>

                    <div class="pm-alerts-empty-icon">
                        ✓
                    </div>

                    <strong>
                        Nema alerta
                    </strong>

                    <span>
                        Za izabrane filtere nema rezultata.
                    </span>

                </div>

            </section>

        </div>


        <aside class="pm-alerts-side">


            <section class="pm-alerts-card pm-alerts-detail-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            ALERT DETAIL
                        </div>

                        <h2>
                            Detalji
                        </h2>

                    </div>

                </div>


                <div id="alertDetails" class="pm-alerts-details">

                    <div class="pm-alerts-detail-empty">

                        <div>
                            !
                        </div>

                        <strong>
                            Izaberite alert
                        </strong>

                        <span>
                            Kliknite na alert iz liste da vidite
                            kompletan kontekst i akcije.
                        </span>

                    </div>

                </div>

            </section>


            <section class="pm-alerts-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            SOURCES
                        </div>

                        <h2>
                            Izvori alerta
                        </h2>

                    </div>

                </div>


                <div class="pm-alert-source-list">

                    <div>
                        <span class="pm-alert-source-dot navigation"></span>
                        <strong>Navigacija</strong>
                        <em id="sourceNavigation">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot compliance"></span>
                        <strong>Compliance</strong>
                        <em id="sourceCompliance">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot gps"></span>
                        <strong>GPS / Monitoring</strong>
                        <em id="sourceGps">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot fleet"></span>
                        <strong>Fleet / Vozila</strong>
                        <em id="sourceFleet">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot driver"></span>
                        <strong>Vozači</strong>
                        <em id="sourceDriver">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot finance"></span>
                        <strong>Finansije</strong>
                        <em id="sourceFinance">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot operations"></span>
                        <strong>Operacije</strong>
                        <em id="sourceOperations">0</em>
                    </div>

                </div>

            </section>


            <section class="pm-alerts-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            SEVERITY
                        </div>

                        <h2>
                            Prioritet
                        </h2>

                    </div>

                </div>


                <div class="pm-alert-severity-bars">

                    <div>

                        <span>
                            Critical
                        </span>

                        <div>
                            <i id="severityCriticalBar" style="width:0%">
                            </i>
                        </div>

                        <strong id="severityCriticalValue">
                            0
                        </strong>

                    </div>


                    <div>

                        <span>
                            High
                        </span>

                        <div>
                            <i id="severityHighBar" style="width:0%">
                            </i>
                        </div>

                        <strong id="severityHighValue">
                            0
                        </strong>

                    </div>


                    <div>

                        <span>
                            Medium
                        </span>

                        <div>
                            <i id="severityMediumBar" style="width:0%">
                            </i>
                        </div>

                        <strong id="severityMediumValue">
                            0
                        </strong>

                    </div>

                </div>

            </section>

        </aside>

    </section>

</div>





@section Scripts
{
    <script src="~/js/alerts.js"></script>
}
<script>
    (function () {
        "use strict";

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function $(id) {
            return document.getElementById(id);
        }

        function formatDate(value) {
            if (!value) {
                return "—";
            }

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) {
                return String(value);
            }

            return new Intl.DateTimeFormat("sr-Latn-RS", {
                dateStyle: "short",
                timeStyle: "short"
            }).format(date);
        }

        function severityLabel(value) {
            return window.ProMap.Alerts.severityLabel(value);
        }

        function categoryLabel(value) {
            return window.ProMap.Alerts.categoryLabel(value);
        }

        function statusLabel(value) {
            switch (value) {
                case "open":
                    return "OPEN";

                case "acknowledged":
                    return "ACKNOWLEDGED";

                case "snoozed":
                    return "SNOOZED";

                case "resolved":
                    return "RESOLVED";

                default:
                    return String(value || "").toUpperCase();
            }
        }

        function alertIcon(alert) {
            switch (alert.category) {
                case "navigation":
                    return "◎";

                case "gps":
                    return "◉";

                case "compliance":
                    return "▣";

                case "maintenance":
                    return "🔧";

                case "fuel":
                    return "⛽";

                case "tachograph":
                    return "◷";

                case "border":
                    return "⌂";

                case "finance":
                    return "₿";

                case "driver":
                    return "♙";

                case "vehicle":
                    return "▣";

                case "orders":
                    return "▤";

                case "trips":
                    return "↗";

                default:
                    return "!";
            }
        }

        function getContextMain(alert) {
            return (
                alert.vehicle ||
                alert.driver ||
                alert.trip ||
                alert.location ||
                "Sistem"
            );
        }

        function getContextSub(alert) {
            const values = [];

            if (alert.vehicle) {
                values.push(alert.vehicle);
            }

            if (alert.driver) {
                values.push(alert.driver);
            }

            if (alert.trip) {
                values.push(alert.trip);
            }

            return values.filter(Boolean).join(" · ");
        }

        const state = {
            alerts: [],
            filtered: [],
            selectedId: null
        };

        const elements = {
            list: $("alertsList"),
            empty: $("alertsEmpty"),
            resultCount: $("alertsResultCount"),

            search: $("alertsSearch"),
            severity: $("alertsSeverity"),
            category: $("alertsCategory"),
            status: $("alertsStatus"),

            detail: $("alertDetails"),

            open: $("alertsOpenCount"),
            critical: $("alertsCriticalCount"),
            high: $("alertsHighCount"),
            today: $("alertsTodayCount"),
            resolved: $("alertsResolvedCount"),

            sourceNavigation: $("sourceNavigation"),
            sourceCompliance: $("sourceCompliance"),
            sourceGps: $("sourceGps"),
            sourceFleet: $("sourceFleet"),
            sourceDriver: $("sourceDriver"),
            sourceFinance: $("sourceFinance"),
            sourceOperations: $("sourceOperations"),

            criticalBar: $("severityCriticalBar"),
            highBar: $("severityHighBar"),
            mediumBar: $("severityMediumBar"),

            criticalValue: $("severityCriticalValue"),
            highValue: $("severityHighValue"),
            mediumValue: $("severityMediumValue")
        };

        function updateKpis() {
            const alerts = state.alerts;

            const open = alerts.filter(alert => alert.status === "open");

            const critical = open.filter(alert => alert.severity === "critical");

            const high = open.filter(alert => alert.severity === "high");

            const resolved = alerts.filter(alert => alert.status === "resolved");

            elements.open.textContent = open.length;

            elements.critical.textContent = critical.length;

            elements.high.textContent = high.length;

            elements.today.textContent = window.ProMap.Alerts.getTodayCount();

            elements.resolved.textContent = resolved.length;

            const sourceCounts = {
                navigation: 0,
                compliance: 0,
                gps: 0,
                fleet: 0,
                driver: 0,
                finance: 0,
                operations: 0
            };

            open.forEach(function (alert) {
                switch (alert.category) {
                    case "navigation":
                        sourceCounts.navigation++;
                        break;

                    case "compliance":
                        sourceCounts.compliance++;
                        break;

                    case "gps":
                        sourceCounts.gps++;
                        break;

                    case "vehicle":
                    case "maintenance":
                        sourceCounts.fleet++;
                        break;

                    case "driver":
                    case "tachograph":
                        sourceCounts.driver++;
                        break;

                    case "finance":
                    case "fuel":
                        sourceCounts.finance++;
                        break;

                    default:
                        sourceCounts.operations++;
                        break;
                }
            });

            elements.sourceNavigation.textContent = sourceCounts.navigation;

            elements.sourceCompliance.textContent = sourceCounts.compliance;

            elements.sourceGps.textContent = sourceCounts.gps;

            elements.sourceFleet.textContent = sourceCounts.fleet;

            elements.sourceDriver.textContent = sourceCounts.driver;

            elements.sourceFinance.textContent = sourceCounts.finance;

            elements.sourceOperations.textContent = sourceCounts.operations;

            const severityTotal = Math.max(1, open.length);

            const criticalCount = open.filter(
                    a => a.severity === "critical"
            ).length;

            const highCount = open.filter(a => a.severity === "high").length;

            const mediumCount = open.filter(a => a.severity === "medium").length;

            elements.criticalValue.textContent = criticalCount;

            elements.highValue.textContent = highCount;

            elements.mediumValue.textContent = mediumCount;

            elements.criticalBar.style.width =
                (criticalCount / severityTotal * 100  ) + "%";

            elements.highBar.style.width = (highCount / severityTotal * 100    ) + "%";

            elements.mediumBar.style.width =
                (mediumCount / severityTotal * 100  ) + "%";
        }

        function applyFilters() {
            const search = String(elements.search.value || "")
                .trim()
                .toLowerCase();

            const severity = elements.severity.value;

            const category = elements.category.value;

            const status = elements.status.value;

            state.filtered = state.alerts.filter(function (alert) {
                if (severity && alert.severity !== severity) {
                    return false;
                }

                if (category && alert.category !== category) {
                    return false;
                }

                if (status && alert.status !== status) {
                    return false;
                }

                if (!search) {
                    return true;
                }

                const haystack = [
                    alert.id,
                    alert.title,
                    alert.message,
                    alert.type,
                    alert.vehicle,
                    alert.driver,
                    alert.trip,
                    alert.location,
                    alert.source,
                    categoryLabel(alert.category)
                ]
                    .filter(Boolean)
                    .join(" ")
                    .toLowerCase();

                return haystack.includes(search);
            });

            renderList();
        }

        function renderList() {
            elements.resultCount.textContent = state.filtered.length + " rezultata";

            elements.empty.hidden = state.filtered.length !== 0;

            elements.list.innerHTML = "";

            if (!state.filtered.length) {
                return;
            }

            state.filtered.forEach(function (alert) {
                const row = document.createElement("div");

                row.className =
                    "pm-alert-row " +
                    alert.severity +
                    (state.selectedId === alert.id ? " selected" : "");

                row.dataset.alertId = alert.id;

                row.innerHTML = `
                    <div class="pm-alert-severity-line"></div>

                    <div class="pm-alert-row-icon">
                        ${escapeHtml(alertIcon(alert))}
                    </div>

                    <div class="pm-alert-row-content">

                        <div class="pm-alert-row-title">
                            ${escapeHtml(alert.title)}
                        </div>

                        <div class="pm-alert-row-message">
                            ${escapeHtml(alert.message)}
                        </div>

                        <div class="pm-alert-row-meta">
                            ${escapeHtml(alert.id)}
                            ·
                            ${escapeHtml(categoryLabel(alert.category))}
                            ·
                            ${escapeHtml(formatDate(alert.createdAt))}
                        </div>

                    </div>

                    <div class="pm-alert-row-context">

                        <div class="pm-alert-context-main">
                            ${escapeHtml(getContextMain(alert))}
                        </div>

                        <div class="pm-alert-context-sub">
                            ${escapeHtml(getContextSub(alert))}
                        </div>

                    </div>

                    <div class="pm-alert-row-status">

                        <div>

                            <span class="pm-alert-severity-badge ${escapeHtml(alert.severity)}">
                                ${escapeHtml(severityLabel(alert.severity))}
                            </span>

                            <br />

                            <span class="pm-alert-status ${escapeHtml(alert.status)}">
                                ${escapeHtml(statusLabel(alert.status))}
                            </span>

                        </div>

                    </div>

                    <div class="pm-alert-row-action">
                        ›
                    </div>
                    `;

                row.addEventListener("click", function () {
                    state.selectedId = alert.id;

                    renderList();

                    renderDetails(alert);
                });

                elements.list.appendChild(row);
            });
        }

        function renderDetails(alert) {
            if (!alert) {
                elements.detail.innerHTML = `
                <div class="pm-alert-detail-empty">

                    <div>
                        !
                    </div>

                    <strong>
                        Izaberite alert
                    </strong>

                    <span>
                        Kliknite na alert iz liste da vidite
                        kompletan kontekst i akcije.
                    </span>

                </div>
                `;

                return;
            }

            elements.detail.innerHTML = `
            <div class="pm-alert-detail">

                <div class="pm-alert-detail-top">

                    <div>

                        <div class="pm-alert-detail-id">
                            ${escapeHtml(alert.id)}
                        </div>

                        <h3>
                            ${escapeHtml(alert.title)}
                        </h3>

                    </div>

                    <span class="pm-alert-severity-badge ${escapeHtml(alert.severity)}">
                        ${escapeHtml(severityLabel(alert.severity))}
                    </span>

                </div>


                <div class="pm-alert-detail-message">
                    ${escapeHtml(alert.message)}
                </div>


                <div class="pm-alert-detail-grid">

                    <div class="pm-alert-detail-item">
                        <span>Kategorija</span>
                        <strong>
                            ${escapeHtml(categoryLabel(alert.category))}
                        </strong>
                    </div>

                    <div class="pm-alert-detail-item">
                        <span>Status</span>
                        <strong>
                            ${escapeHtml(statusLabel(alert.status))}
                        </strong>
                    </div>

                    <div class="pm-alert-detail-item">
                        <span>Vozilo</span>
                        <strong>
                            ${escapeHtml(alert.vehicle || "—")}
                        </strong>
                    </div>

                    <div class="pm-alert-detail-item">
                        <span>Vozač</span>
                        <strong>
                            ${escapeHtml(alert.driver || "—")}
                        </strong>
                    </div>

                    <div class="pm-alert-detail-item">
                        <span>Tura</span>
                        <strong>
                            ${escapeHtml(alert.trip || "—")}
                        </strong>
                    </div>

                    <div class="pm-alert-detail-item">
                        <span>Lokacija</span>
                        <strong>
                            ${escapeHtml(alert.location || "—")}
                        </strong>
                    </div>

                    <div class="pm-alert-detail-item">
                        <span>Izvor</span>
                        <strong>
                            ${escapeHtml(alert.source || "—")}
                        </strong>
                    </div>

                    <div class="pm-alert-detail-item">
                        <span>Vreme</span>
                        <strong>
                            ${escapeHtml(formatDate(alert.createdAt))}
                        </strong>
                    </div>

                </div>


                <div class="pm-alert-detail-action">

                    <span>
                        Preporučena akcija
                    </span>

                    <p>
                        ${escapeHtml(alert.action || "Proverite alert i preduzmite odgovarajuću akciju.")}
                    </p>

                </div>


                <div class="pm-alert-detail-actions">

                    ${
                            alert.status === "resolved"
                                ? `
                                <button
                                    type="button"
                                    class="pm-alert-detail-btn"
                                    data-alert-action="reopen">
                                    Ponovo otvori
                                </button>
                            `
                                : `
                                <button
                                    type="button"
                                    class="pm-alert-detail-btn primary"
                                    data-alert-action="resolve">
                                    Reši alert
                                </button>
                            `
                        }


                    ${
                            alert.status === "open"
                                ? `
                                <button
                                    type="button"
                                    class="pm-alert-detail-btn"
                                    data-alert-action="acknowledge">
                                    Preuzmi
                                </button>
                            `
                                : `
                                <button
                                    type="button"
                                    class="pm-alert-detail-btn"
                                    data-alert-action="snooze">
                                    Odloži 30 min
                                </button>
                            `
                        }


                    ${
                            alert.actionUrl
                                ? `
                                <button
                                    type="button"
                                    class="pm-alert-detail-btn"
                                    data-alert-action="open-source">
                                    Otvori modul
                                </button>
                            `
                                : ""
                        }

                </div>

            </div>
            `;

            elements.detail
                .querySelectorAll("[data-alert-action]")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const action = button.dataset.alertAction;

                        if (action === "resolve") {
                            window.ProMap.Alerts.resolve(alert.id);
                        }

                        if (action === "reopen") {
                            window.ProMap.Alerts.reopen(alert.id);
                        }

                        if (action === "acknowledge") {
                            window.ProMap.Alerts.acknowledge(alert.id);
                        }

                        if (action === "snooze") {
                            window.ProMap.Alerts.snooze(alert.id, 30);
                        }

                        if (action === "open-source") {
                            window.location.href = alert.actionUrl;
                            return;
                        }

                        reload();
                    });
                });
        }

        function reload() {
            state.alerts = window.ProMap.Alerts.get();

            updateKpis();

            applyFilters();

            if (state.selectedId) {
                const selected = state.alerts.find(
                        alert => alert.id === state.selectedId
                );

                renderDetails(selected || null);
            }
        }

        function clearResolved() {
            const remaining = window.ProMap.Alerts.get().filter(
                        alert => alert.status !== "resolved"
            );

            localStorage.setItem(
                window.ProMap.Alerts.storageKey,
                JSON.stringify(remaining)
            );

            window.dispatchEvent(
                new CustomEvent("promap:alerts-changed", {
                    detail: {
                        alerts: remaining
                    }
                })
            );

            state.selectedId = null;

            reload();

            renderDetails(null);
        }

        function bind() {
            [
                elements.search,
                elements.severity,
                elements.category,
                elements.status
            ].forEach(function (element) {
                element.addEventListener("input", applyFilters);

                element.addEventListener("change", applyFilters);
            });

            $("alertsRefresh").addEventListener("click", reload);

            $("alertsClearResolved").addEventListener("click", clearResolved);

            window.addEventListener("promap:alerts-changed", reload);
        }

        function init() {
            if (!window.ProMap || !window.ProMap.Alerts) {
                console.error("ProMap Alerts module nije učitan.");

                return;
            }

            bind();

            reload();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>

