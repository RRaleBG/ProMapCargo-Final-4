@page
@{
    ViewData["Title"] = "Vozači · ProMap Cargo";
}

<div class="pm-page pm-drivers-page" data-module="drivers">

    

    <div class="pm-drivers-content">

        <header class="pm-drivers-header">
            <div class="pm-drivers-heading">
                <div class="pm-drivers-kicker">
                    <span class="pm-drivers-kicker-dot"></span>
                    Fleet · Vozači
                </div>

                <h1 class="pm-drivers-title">Vozači</h1>

                <p class="pm-drivers-subtitle">
                    Pregled vozača, statusa, dodeljenih vozila, aktivnih tura i poslednje GPS aktivnosti.
                </p>
            </div>

            <div class="pm-drivers-header-actions">
                <button type="button" class="pm-drivers-btn" id="refreshDrivers">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                        <path d="M3 4v6h6"></path>
                        <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                        <path d="M21 20v-6h-6"></path>
                    </svg>
                    Osveži
                </button>

                <button type="button" class="pm-drivers-btn primary" id="addDriver">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    Novi vozač
                </button>
            </div>
        </header>

        <section class="pm-drivers-kpis" aria-label="Statistika vozača">

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Ukupno vozača</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiTotal">—</div>
                <div class="pm-driver-kpi-note">registrovanih vozača</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Aktivni</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiActive">—</div>
                <div class="pm-driver-kpi-note">status Active</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Na turi</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M3 17h3"></path>
                            <path d="M18 17h3"></path>
                            <path d="M5 17V9h10l4 4v4"></path>
                            <circle cx="8" cy="17" r="2"></circle>
                            <circle cx="17" cy="17" r="2"></circle>
                            <path d="M15 9v4h4"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiTrips">—</div>
                <div class="pm-driver-kpi-note">imaju aktivnu turu</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">GPS online</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M12 2v4"></path>
                            <path d="M12 18v4"></path>
                            <path d="M2 12h4"></path>
                            <path d="M18 12h4"></path>
                            <circle cx="12" cy="12" r="4"></circle>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiGps">—</div>
                <div class="pm-driver-kpi-note">GPS signal ≤ 2 min</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Van sistema</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M12 3 4 6v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-3Z"></path>
                            <path d="M12 8v4"></path>
                            <path d="M12 16h.01"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiUnavailable">—</div>
                <div class="pm-driver-kpi-note">odmor ili suspendovan</div>
            </article>

        </section>

        <section class="pm-drivers-toolbar" aria-label="Filteri vozača">

            <div class="pm-driver-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-4-4"></path>
                </svg>

                <input
                    id="driverSearch"
                    class="pm-driver-input"
                    type="search"
                    autocomplete="off"
                    placeholder="Pretraži ime, telefon ili broj licence..." />
            </div>

            <select id="driverStatusFilter" class="pm-driver-select" aria-label="Status vozača">
                <option value="">Svi statusi</option>
                <option value="Active">Aktivan</option>
                <option value="Inactive">Neaktivan</option>
                <option value="OnLeave">Na odmoru</option>
                <option value="Suspended">Suspendovan</option>
            </select>

            <select id="driverGpsFilter" class="pm-driver-select" aria-label="GPS status">
                <option value="">Svi GPS statusi</option>
                <option value="online">GPS online</option>
                <option value="stale">GPS zastareo</option>
                <option value="offline">GPS offline</option>
            </select>

            <div class="pm-driver-results" id="driverResults">
                Učitavanje...
            </div>

        </section>

        <section class="pm-drivers-workspace">

            <div class="pm-drivers-card">

                <div class="pm-drivers-card-head">
                    <div class="pm-drivers-card-title-wrap">
                        <h2 class="pm-drivers-card-title">Operativni spisak vozača</h2>
                        <p class="pm-drivers-card-subtitle">
                            Podaci se učitavaju iz Fleet API-ja.
                        </p>
                    </div>

                    <button
                        type="button"
                        class="pm-drivers-refresh"
                        id="refreshDriversSmall"
                        title="Osveži podatke"
                        aria-label="Osveži podatke">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                            <path d="M3 4v6h6"></path>
                            <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                            <path d="M21 20v-6h-6"></path>
                        </svg>
                    </button>
                </div>

                <div class="pm-drivers-table-wrap">

                    <table class="pm-drivers-table">
                        <thead>
                            <tr>
                                <th>Vozač</th>
                                <th>Status</th>
                                <th>Telefon</th>
                                <th>Vozilo</th>
                                <th>Tura</th>
                                <th>GPS</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody id="driversTableBody">
                            <tr>
                                <td colspan="7">
                                    <div class="pm-driver-loading">
                                        <div class="pm-driver-loading-icon">
                                            <svg class="pm-driver-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                <path d="M12 3a9 9 0 1 0 9 9"></path>
                                            </svg>
                                        </div>
                                        <div class="pm-driver-loading-title">Učitavanje vozača</div>
                                        <div class="pm-driver-loading-text">
                                            Preuzimanje podataka iz ProMap Cargo Fleet API-ja.
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

            <aside class="pm-drivers-card pm-driver-details" id="driverDetails">

                <div class="pm-driver-profile">
                    <div class="pm-driver-profile-top">

                        <div class="pm-driver-profile-avatar" id="detailAvatar">
                            —
                        </div>

                        <div>
                            <h2 class="pm-driver-profile-name" id="detailName">
                                Izaberite vozača
                            </h2>

                            <div class="pm-driver-profile-meta" id="detailLicense">
                                Detalji vozača će biti prikazani ovde.
                            </div>

                            <div class="pm-driver-profile-status" id="detailStatus"></div>
                        </div>

                    </div>
                </div>

                <div class="pm-driver-detail-section">

                    <h3 class="pm-driver-detail-heading">Osnovni podaci</h3>

                    <div class="pm-driver-detail-grid">

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Telefon</div>
                            <div class="pm-driver-detail-value" id="detailPhone">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Licenca</div>
                            <div class="pm-driver-detail-value" id="detailLicenseValue">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Zemlja</div>
                            <div class="pm-driver-detail-value" id="detailCountry">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">GPS poslednji signal</div>
                            <div class="pm-driver-detail-value" id="detailGps">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-driver-detail-section">

                    <h3 class="pm-driver-detail-heading">Operativni status</h3>

                    <div class="pm-driver-operational">

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M3 17h3"></path>
                                    <path d="M18 17h3"></path>
                                    <path d="M5 17V9h10l4 4v4"></path>
                                    <circle cx="8" cy="17" r="2"></circle>
                                    <circle cx="17" cy="17" r="2"></circle>
                                </svg>
                                Vozilo
                            </div>

                            <div class="pm-driver-operation-value" id="detailVehicle">
                                —
                            </div>
                        </div>

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M5 4h14v16H5z"></path>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h8"></path>
                                    <path d="M8 16h5"></path>
                                </svg>
                                Aktivna tura
                            </div>

                            <div class="pm-driver-operation-value" id="detailTrip">
                                —
                            </div>
                        </div>

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <circle cx="12" cy="12" r="8"></circle>
                                    <path d="M12 7v5l3 2"></path>
                                </svg>
                                GPS stanje
                            </div>

                            <div class="pm-driver-operation-value" id="detailGpsStatus">
                                —
                            </div>
                        </div>

                    </div>

                </div>

                <div class="pm-driver-detail-section">

                    <div class="pm-driver-detail-actions">

                        <button type="button" class="pm-driver-detail-action" id="callDriver">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.08 5.18 2 2 0 0 1 5.06 3h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8.96 10.73a16 16 0 0 0 4.31 4.31l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"></path>
                            </svg>
                            Pozovi
                        </button>

                        <button type="button" class="pm-driver-detail-action" id="showDriverRoute">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="6" cy="18" r="2"></circle>
                                <circle cx="18" cy="6" r="2"></circle>
                                <path d="M8 18c5 0 3-8 8-12"></path>
                            </svg>
                            Otvori turu
                        </button>

                    </div>

                </div>

            </aside>

        </section>

        <div class="pm-drivers-footer-info">
            <span>
                <strong id="lastRefreshLabel">Podaci još nisu osveženi</strong>
            </span>

            <span>
                ProMap Cargo · Fleet Management
            </span>
        </div>

    </div>

</div>


