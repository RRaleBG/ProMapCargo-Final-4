@page
@{
    ViewData["Title"] = "Vozači · ProMap Cargo";
}

<div class="pm-page" data-module="drivers">

    <div class="pm-page-content">

        <header class="pm-header">
            <div class="pm-heading">
                <div class="pm-page-kicker">
                    <span class="pm-kicker-dot"></span>
                    Fleet · Vozači
                </div>

                <p class="pm-subtitle">
                    Pregled vozača, statusa, dodeljenih vozila, aktivnih tura i poslednje GPS aktivnosti.
                </p>

            </div>

            <div class="pm-header-actions">
                <button type="button" class="pm-btn" id="refreshDrivers">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                        <path d="M3 4v6h6"></path>
                        <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                        <path d="M21 20v-6h-6"></path>
                    </svg>
                    Osveži
                </button>

                <button type="button" class="pm-btn pm-btn-primary" id="addDriver">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    Novi vozač
                </button>
            </div>
        </header>

        <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--5" aria-label="Statistika vozača">
            <article class="compliance-kpi compliance-kpi-total">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Ukupno vozača</span>
                    <i data-lucide="users-round" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiTotal">—</strong>
                <span class="compliance-kpi-meta">registrovanih vozača</span>
            </article>

            <article class="compliance-kpi compliance-kpi-good">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Aktivni</span>
                    <i data-lucide="user-check" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiActive">—</strong>
                <span class="compliance-kpi-meta">status Active</span>
            </article>

            <article class="compliance-kpi compliance-kpi-info">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Na turi</span>
                    <i data-lucide="truck" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiTrips">—</strong>
                <span class="compliance-kpi-meta">imaju aktivnu turu</span>
            </article>

            <article class="compliance-kpi compliance-kpi-neutral">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">GPS online</span>
                    <i data-lucide="locate-fixed" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiGps">—</strong>
                <span class="compliance-kpi-meta">GPS signal ≤ 2 min</span>
            </article>

            <article class="compliance-kpi compliance-kpi-warning">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Van sistema</span>
                    <i data-lucide="user-x" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiUnavailable">—</strong>
                <span class="compliance-kpi-meta">odmor ili suspendovan</span>
            </article>
        </section>

        <section class="pm-toolbar" aria-label="Filteri vozača">

            <div class="pm-search-wrap pm-driver-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="pm-search-icon">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-4-4"></path>
                </svg>

                <input id="driverSearch" class="pm-search-input pm-driver-input" type="search" autocomplete="off"
                        placeholder="Pretraži ime, telefon ili broj licence..." />
            </div>

            <select id="driverStatusFilter" class="pm-select pm-driver-select" aria-label="Status vozača">
                <option value="">Svi statusi</option>
                <option value="Active">Aktivan</option>
                <option value="Inactive">Neaktivan</option>
                <option value="OnLeave">Na odmoru</option>
                <option value="Suspended">Suspendovan</option>
            </select>

            <select id="driverGpsFilter" class="pm-select pm-driver-select" aria-label="GPS status">
                <option value="">Svi GPS statusi</option>
                <option value="online">GPS online</option>
                <option value="stale">GPS zastareo</option>
                <option value="offline">GPS offline</option>
            </select>

            <div class="pm-driver-results" id="driverResults">
                Učitavanje...
            </div>

        </section>

        <section class="pm-drivers-workspace">

            <div class="pm-drivers-card">

                <div class="pm-drivers-card-head">
                    <div class="pm-drivers-card-title-wrap">
                        <h2 class="pm-drivers-card-title">Operativni spisak vozača</h2>
                        <p class="pm-drivers-card-subtitle">
                            Podaci se učitavaju iz Fleet API-ja.
                        </p>
                    </div>

                    <button type="button" class="pm-drivers-refresh" id="refreshDriversSmall" title="Osveži podatke"
                            aria-label="Osveži podatke">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             aria-hidden="true">
                            <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                            <path d="M3 4v6h6"></path>
                            <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                            <path d="M21 20v-6h-6"></path>
                        </svg>
                    </button>
                </div>

                <div class="pm-drivers-table-wrap">

                    <table class="pm-drivers-table">
                        <thead>
                            <tr>
                                <th>Vozač</th>
                                <th>Status</th>
                                <th>Telefon</th>
                                <th>Vozilo</th>
                                <th>Tura</th>
                                <th>GPS</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody id="driversTableBody">
                            <tr>
                                <td colspan="7">
                                    <div class="pm-driver-loading">
                                        <div class="pm-driver-loading-icon">
                                            <svg class="pm-driver-spin" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                <path d="M12 3a9 9 0 1 0 9 9"></path>
                                            </svg>
                                        </div>
                                        <div class="pm-driver-loading-title">Učitavanje vozača</div>
                                        <div class="pm-driver-loading-text">
                                            Preuzimanje podataka iz ProMap Cargo Fleet API-ja.
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

            <aside class="pm-drivers-card pm-driver-details" id="driverDetails">

                <div class="pm-driver-profile">
                    <div class="pm-driver-profile-top">

                        <div class="pm-driver-profile-avatar" id="detailAvatar">
                            —
                        </div>

                        <div>
                            <h2 class="pm-driver-profile-name" id="detailName">
                                Izaberite vozača
                            </h2>

                            <div class="pm-driver-profile-meta" id="detailLicense">
                                Detalji vozača će biti prikazani ovde.
                            </div>

                            <div class="pm-driver-profile-status" id="detailStatus"></div>
                        </div>

                    </div>
                </div>

                <div class="pm-driver-detail-section">

                    <h3 class="pm-driver-detail-heading">Osnovni podaci</h3>

                    <div class="pm-driver-detail-grid">

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Telefon</div>
                            <div class="pm-driver-detail-value" id="detailPhone">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Licenca</div>
                            <div class="pm-driver-detail-value" id="detailLicenseValue">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Zemlja</div>
                            <div class="pm-driver-detail-value" id="detailCountry">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">GPS poslednji signal</div>
                            <div class="pm-driver-detail-value" id="detailGps">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-driver-detail-section">

                    <h3 class="pm-driver-detail-heading">Dozvole i sertifikati</h3>

                    <div class="pm-driver-detail-grid">

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Broj vozača</div>
                            <div class="pm-driver-detail-value" id="detailEmployee">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">E-mail</div>
                            <div class="pm-driver-detail-value" id="detailEmail">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Kategorije</div>
                            <div class="pm-driver-detail-value" id="detailCategories">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Vozačka do</div>
                            <div class="pm-driver-detail-value" id="detailLicenseExpiry">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Kod 95 do</div>
                            <div class="pm-driver-detail-value" id="detailCode95">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">ADR do</div>
                            <div class="pm-driver-detail-value" id="detailAdr">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Tahograf kartica</div>
                            <div class="pm-driver-detail-value" id="detailTachoCard">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Lekarski do</div>
                            <div class="pm-driver-detail-value" id="detailMedical">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Zaposlen od</div>
                            <div class="pm-driver-detail-value" id="detailHired">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Adresa</div>
                            <div class="pm-driver-detail-value" id="detailAddress">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Napomena</div>
                            <div class="pm-driver-detail-value" id="detailNotes">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-driver-detail-section">

                    <h3 class="pm-driver-detail-heading">Operativni status</h3>

                    <div class="pm-driver-operational">

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="M3 17h3"></path>
                                    <path d="M18 17h3"></path>
                                    <path d="M5 17V9h10l4 4v4"></path>
                                    <circle cx="8" cy="17" r="2"></circle>
                                    <circle cx="17" cy="17" r="2"></circle>
                                </svg>
                                Vozilo
                            </div>

                            <div class="pm-driver-operation-value" id="detailVehicle">
                                —
                            </div>
                        </div>

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="M5 4h14v16H5z"></path>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h8"></path>
                                    <path d="M8 16h5"></path>
                                </svg>
                                Aktivna tura
                            </div>

                            <div class="pm-driver-operation-value" id="detailTrip">
                                —
                            </div>
                        </div>

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     aria-hidden="true">
                                    <circle cx="12" cy="12" r="8"></circle>
                                    <path d="M12 7v5l3 2"></path>
                                </svg>
                                GPS stanje
                            </div>

                            <div class="pm-driver-operation-value" id="detailGpsStatus">
                                —
                            </div>
                        </div>

                    </div>

                </div>

                <div class="pm-driver-detail-section">

                    <div class="pm-driver-detail-actions">

                        <button type="button" class="pm-driver-detail-action" id="callDriver">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.08 5.18 2 2 0 0 1 5.06 3h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8.96 10.73a16 16 0 0 0 4.31 4.31l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z">
                                </path>
                            </svg>
                            Pozovi
                        </button>

                        <button type="button" class="pm-driver-detail-action" id="showDriverRoute">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 aria-hidden="true">
                                <circle cx="6" cy="18" r="2"></circle>
                                <circle cx="18" cy="6" r="2"></circle>
                                <path d="M8 18c5 0 3-8 8-12"></path>
                            </svg>
                            Otvori turu
                        </button>

                    </div>

                </div>

            </aside>

        </section>
    </div>

</div>
