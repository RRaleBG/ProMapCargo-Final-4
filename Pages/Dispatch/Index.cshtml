@page "/dispatch"
@{
    ViewData["Title"] = "Command Center · ProMap Cargo";
}

<div class="pm-page" data-module="dispatch">     

    <header class="pm-header">
        <div class="pm-heading">
            <div class="pm-page-kicker">
                <span class="pm-kicker-dot"></span>
                ProMap Cargo · Dispatch
            </div>
            <p class="pm-page-subtitle">
                Pregled i upravljanje dokumentacijom vozila, prikolica i opreme. Obezbedite da sva vozila u floti budu u skladu sa zakonskim propisima i bez kritičnih problema.
            </p>
        </div>

        <div class="pm-header-actions">
            <div class="pm-alerts-live">
                <span class="pm-alerts-live-dot"></span>
                <span> Alert engine </span>
                <strong> LIVE   </strong>
            </div>
            <button class="pm-btn pm-btn-secondary" type="button" id="dispatchRefresh">
                <span>↻</span>
                Osveži
            </button>
          
            <a asp-page="/Navigation/Index" class="pm-btn pm-btn-primary">
                Nova ruta
            </a>
        </div>
    </header>



    <div class="pm-page-content">

        <section class="moderation-kpi-grid pm-kpi-grid" aria-label="Dispatch pregled">
            <article class="compliance-kpi compliance-kpi-good">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Aktivne ture</span>
                    <i data-lucide="route" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiActiveTrips">—</strong>
                <span class="compliance-kpi-meta">trenutno u vožnji</span>
            </article>

            <article class="compliance-kpi compliance-kpi-total">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Dispečeri</span>
                    <i data-lucide="headset" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiDispatchers">—</strong>
                <span class="compliance-kpi-meta"><span id="kpiDispatchersMeta">aktivni korisnici</span></span>
            </article>

            <article class="compliance-kpi compliance-kpi-info">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Vozila</span>
                    <i data-lucide="truck" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiVehicles">—</strong>
                <span class="compliance-kpi-meta">fleet ukupno</span>
            </article>

            <article class="compliance-kpi compliance-kpi-warning">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Kašnjenja</span>
                    <i data-lucide="clock-alert" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiDelays">—</strong>
                <span class="compliance-kpi-meta">zahteva pažnju</span>
            </article>

            <article class="compliance-kpi compliance-kpi-neutral">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Granice</span>
                    <i data-lucide="flag" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiBorders">—</strong>
                <span class="compliance-kpi-meta">vozila na čekanju</span>
            </article>

            <article class="compliance-kpi compliance-kpi-danger">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Incidenti</span>
                    <i data-lucide="siren" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" id="kpiIncidents">—</strong>
                <span class="compliance-kpi-meta">otvoren slučaj</span>
            </article>
        </section>




        <section class="pm-dispatch-main-grid">
            <article class="pm-dispatch-card">
                <div class="pm-dispatch-card-head">
                    <div class="pm-dispatch-card-heading">
                        <div class="pm-dispatch-card-title"> Live Fleet Map </div>
                        <div class="pm-dispatch-card-subtitle"> Vozila, ture i operativni događaji </div>
                    </div>

                    <div class="pm-dispatch-card-actions">
                        <button type="button" class="pm-dispatch-small-btn pm-filter-btn active" data-map-filter="all"> Sva vozila
                        </button>
                        <button type="button" class="pm-dispatch-small-btn pm-filter-btn" data-map-filter="active"> Aktivna
                        </button>
                        <button type="button" class="pm-dispatch-small-btn pm-filter-btn" data-map-filter="alerts"> Alerts
                        </button>
                    </div>
                </div>



                <div class="pm-dispatch-map-wrap">

                    <div class="pm-dispatch-map-overlay">

                        <div class="pm-dispatch-map-chip">

                            <i></i>

                            <strong id="mapFleetCount">—</strong>

                            vozilo u floti

                        </div>

                        <div class="pm-dispatch-map-chip">

                            Routing:

                            <strong>
                                PostGIS · OSM
                            </strong>

                        </div>

                    </div>

                    <div id="dispatchMap" class="pm-map" data-map-archive="/maps/europe.pmtiles" data-map-max-zoom="19">
                    </div>

                    <div class="pm-dispatch-map-controls pm-map-controls">

                        <button type="button" class="pm-dispatch-map-control pm-map-control pm-btn pm-btn-secondary" id="dispatchFitMap" title="Cela flota">
                            ⛶
                        </button>

                        <button type="button" class="pm-dispatch-map-control pm-map-control pm-btn pm-btn-secondary" id="dispatchCenterMap"
                                title="Centar Srbije">
                            ◎
                        </button>

                    </div>

                </div>

            </article>

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Aktivne ture
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Trenutni operativni status
                        </div>

                    </div>

                    <a class="pm-dispatch-small-btn pm-filter-btn" href="/trips">
                        Otvori ture
                    </a>

                </div>

                <div class="pm-dispatch-trip-list" id="dispatchTrips">
                </div>

            </article>

        </section>

        <section class="pm-dispatch-bottom-grid">

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Operativni događaji
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Najnovije promene u floti
                        </div>

                    </div>

                    <button type="button" class="pm-dispatch-small-btn" id="dispatchClearEvents">
                        Očisti
                    </button>

                </div>

                <div class="pm-dispatch-list" id="dispatchEvents">
                </div>

            </article>

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Fleet status
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Raspoloživost vozila
                        </div>

                    </div>

                    <a class="pm-dispatch-small-btn" href="/vehicles">
                        Vozila
                    </a>

                </div>

                <div class="pm-dispatch-fleet" id="dispatchFleet">
                </div>

            </article>

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Border watch
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Aktivna čekanja
                        </div>

                    </div>

                    <a class="pm-dispatch-small-btn" href="/monitoring">
                        Monitoring
                    </a>

                </div>

                <div class="pm-dispatch-border-list" id="dispatchBorders">
                </div>

            </article>

        </section>

    </div>
</div>


