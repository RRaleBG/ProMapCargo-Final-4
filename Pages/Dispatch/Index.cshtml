@page "/dispatch"
@{
    ViewData["Title"] = "Command Center · ProMap Cargo";
}

<div class="pm-dispatch-page" data-module="dispatch">

    

    <main class="pm-dispatch-content">

        <header class="pm-dispatch-header">

            <div class="pm-dispatch-heading">

                <div class="pm-dispatch-kicker">
                    ProMap Cargo · Operations
                </div>

                <h1 class="pm-dispatch-title">
                    Command Center
                </h1>

                <div class="pm-dispatch-subtitle">
                    Live dispatch, fleet position and exception management
                </div>

            </div>

            <div class="pm-dispatch-header-actions">

                <div class="pm-dispatch-live-status">
                    <span></span>
                    Sistem online
                </div>

                <button type="button"
                        class="pm-dispatch-btn"
                        id="dispatchRefresh">
                    Osveži
                </button>

                <a class="pm-dispatch-btn primary"
                   href="/navigation">
                    Nova ruta
                </a>

            </div>

        </header>

        <section class="pm-dispatch-kpis">

            <article class="pm-dispatch-kpi">

                <div class="pm-dispatch-kpi-head">

                    <div class="pm-dispatch-kpi-label">
                        Aktivne ture
                    </div>

                    <div class="pm-dispatch-kpi-icon">
                        ↗
                    </div>

                </div>

                <div class="pm-dispatch-kpi-value">
                    12
                </div>

                <div class="pm-dispatch-kpi-bottom">

                    <div class="pm-dispatch-kpi-meta">
                        trenutno u vožnji
                    </div>

                    <div class="pm-dispatch-kpi-state green">
                        LIVE
                    </div>

                </div>

            </article>

            <article class="pm-dispatch-kpi">

                <div class="pm-dispatch-kpi-head">

                    <div class="pm-dispatch-kpi-label">
                        Dispečeri
                    </div>

                    <div class="pm-dispatch-kpi-icon">
                        D
                    </div>

                </div>

                <div class="pm-dispatch-kpi-value">
                    4
                </div>

                <div class="pm-dispatch-kpi-bottom">

                    <div class="pm-dispatch-kpi-meta">
                        aktivni korisnici
                    </div>

                    <div class="pm-dispatch-kpi-state green">
                        ONLINE
                    </div>

                </div>

            </article>

            <article class="pm-dispatch-kpi">

                <div class="pm-dispatch-kpi-head">

                    <div class="pm-dispatch-kpi-label">
                        Vozila
                    </div>

                    <div class="pm-dispatch-kpi-icon">
                        T
                    </div>

                </div>

                <div class="pm-dispatch-kpi-value">
                    41
                </div>

                <div class="pm-dispatch-kpi-bottom">

                    <div class="pm-dispatch-kpi-meta">
                        fleet ukupno
                    </div>

                    <div class="pm-dispatch-kpi-state blue">
                        FLEET
                    </div>

                </div>

            </article>

            <article class="pm-dispatch-kpi">

                <div class="pm-dispatch-kpi-head">

                    <div class="pm-dispatch-kpi-label">
                        Kašnjenja
                    </div>

                    <div class="pm-dispatch-kpi-icon">
                        !
                    </div>

                </div>

                <div class="pm-dispatch-kpi-value">
                    3
                </div>

                <div class="pm-dispatch-kpi-bottom">

                    <div class="pm-dispatch-kpi-meta">
                        zahteva pažnju
                    </div>

                    <div class="pm-dispatch-kpi-state yellow">
                        MONITOR
                    </div>

                </div>

            </article>

            <article class="pm-dispatch-kpi">

                <div class="pm-dispatch-kpi-head">

                    <div class="pm-dispatch-kpi-label">
                        Granice
                    </div>

                    <div class="pm-dispatch-kpi-icon">
                        B
                    </div>

                </div>

                <div class="pm-dispatch-kpi-value">
                    3
                </div>

                <div class="pm-dispatch-kpi-bottom">

                    <div class="pm-dispatch-kpi-meta">
                        vozila na čekanju
                    </div>

                    <div class="pm-dispatch-kpi-state yellow">
                        WAITING
                    </div>

                </div>

            </article>

            <article class="pm-dispatch-kpi">

                <div class="pm-dispatch-kpi-head">

                    <div class="pm-dispatch-kpi-label">
                        Incidenti
                    </div>

                    <div class="pm-dispatch-kpi-icon">
                        !
                    </div>

                </div>

                <div class="pm-dispatch-kpi-value">
                    1
                </div>

                <div class="pm-dispatch-kpi-bottom">

                    <div class="pm-dispatch-kpi-meta">
                        otvoren slučaj
                    </div>

                    <div class="pm-dispatch-kpi-state red">
                        OPEN
                    </div>

                </div>

            </article>

        </section>

        <section class="pm-dispatch-main-grid">

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Live Fleet Map
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Vozila, ture i operativni događaji
                        </div>

                    </div>

                    <div class="pm-dispatch-card-actions">

                        <button type="button"
                                class="pm-dispatch-small-btn active"
                                data-map-filter="all">
                            Sva vozila
                        </button>

                        <button type="button"
                                class="pm-dispatch-small-btn"
                                data-map-filter="active">
                            Aktivna
                        </button>

                        <button type="button"
                                class="pm-dispatch-small-btn"
                                data-map-filter="alerts">
                            Alerts
                        </button>

                    </div>

                </div>

                <div class="pm-dispatch-map-wrap">

                    <div class="pm-dispatch-map-overlay">

                        <div class="pm-dispatch-map-chip">

                            <i></i>

                            <strong>
                                41
                            </strong>

                            vozilo u floti

                        </div>

                        <div class="pm-dispatch-map-chip">

                            Routing:

                            <strong>
                                PostGIS · OSM
                            </strong>

                        </div>

                    </div>

                    <div id="dispatchMap"
                         class="pm-map"
                         data-map-archive="/maps/serbia.pmtiles"
                         data-map-max-zoom="19">
                    </div>

                    <div class="pm-dispatch-map-controls">

                        <button type="button"
                                class="pm-dispatch-map-control"
                                id="dispatchFitMap"
                                title="Cela flota">
                            ⛶
                        </button>

                        <button type="button"
                                class="pm-dispatch-map-control"
                                id="dispatchCenterMap"
                                title="Centar Srbije">
                            ◎
                        </button>

                    </div>

                </div>

            </article>

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Aktivne ture
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Trenutni operativni status
                        </div>

                    </div>

                    <a class="pm-dispatch-small-btn"
                       href="/trips">
                        Otvori ture
                    </a>

                </div>

                <div class="pm-dispatch-trip-list">

                    <div class="pm-dispatch-trip"
                         data-trip="BG-241-AA">

                        <div class="pm-dispatch-trip-top">

                            <div>

                                <div class="pm-dispatch-trip-route">
                                    BG-241-AA · Beograd → München
                                </div>

                                <div class="pm-dispatch-trip-id">
                                    TRP-2026-0841
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-status green">
                                IN TRANSIT
                            </div>

                        </div>

                        <div class="pm-dispatch-trip-meta">

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Vozač
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    Marko Petrović
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    ETA
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    18:40
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Napredak
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    68%
                                </div>

                            </div>

                        </div>

                        <div class="pm-dispatch-progress">
                            <span style="width:68%"></span>
                        </div>

                    </div>

                    <div class="pm-dispatch-trip"
                         data-trip="NS-882-KK">

                        <div class="pm-dispatch-trip-top">

                            <div>

                                <div class="pm-dispatch-trip-route">
                                    NS-882-KK · Novi Sad → Graz
                                </div>

                                <div class="pm-dispatch-trip-id">
                                    TRP-2026-0837
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-status blue">
                                APPROACHING
                            </div>

                        </div>

                        <div class="pm-dispatch-trip-meta">

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Vozač
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    Nikola Jovanović
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    ETA
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    15:20
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Napredak
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    54%
                                </div>

                            </div>

                        </div>

                        <div class="pm-dispatch-progress">
                            <span style="width:54%"></span>
                        </div>

                    </div>

                    <div class="pm-dispatch-trip"
                         data-trip="NI-401-TT">

                        <div class="pm-dispatch-trip-top">

                            <div>

                                <div class="pm-dispatch-trip-route">
                                    NI-401-TT · Niš → Zagreb
                                </div>

                                <div class="pm-dispatch-trip-id">
                                    TRP-2026-0829
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-status yellow">
                                BORDER CHECK
                            </div>

                        </div>

                        <div class="pm-dispatch-trip-meta">

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Vozač
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    Ivan Stojanović
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    ETA
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    21:10
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Napredak
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    41%
                                </div>

                            </div>

                        </div>

                        <div class="pm-dispatch-progress">
                            <span style="width:41%"></span>
                        </div>

                    </div>

                    <div class="pm-dispatch-trip"
                         data-trip="KG-119-MP">

                        <div class="pm-dispatch-trip-top">

                            <div>

                                <div class="pm-dispatch-trip-route">
                                    KG-119-MP · Kragujevac → Milano
                                </div>

                                <div class="pm-dispatch-trip-id">
                                    TRP-2026-0846
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-status green">
                                LOADING
                            </div>

                        </div>

                        <div class="pm-dispatch-trip-meta">

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Vozač
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    Stefan Ilić
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Polazak
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    16:00
                                </div>

                            </div>

                            <div class="pm-dispatch-trip-stat">

                                <div class="pm-dispatch-trip-stat-label">
                                    Priprema
                                </div>

                                <div class="pm-dispatch-trip-stat-value">
                                    27%
                                </div>

                            </div>

                        </div>

                        <div class="pm-dispatch-progress">
                            <span style="width:27%"></span>
                        </div>

                    </div>

                </div>

            </article>

        </section>

        <section class="pm-dispatch-bottom-grid">

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Operativni događaji
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Najnovije promene u floti
                        </div>

                    </div>

                    <button type="button"
                            class="pm-dispatch-small-btn"
                            id="dispatchClearEvents">
                        Očisti
                    </button>

                </div>

                <div class="pm-dispatch-list"
                     id="dispatchEvents">

                    <div class="pm-dispatch-event">

                        <div class="pm-dispatch-event-icon warning">
                            !
                        </div>

                        <div>

                            <div class="pm-dispatch-event-title">
                                Kašnjenje na granici
                            </div>

                            <div class="pm-dispatch-event-text">
                                NI-401-TT čeka kontrolu na prelazu Batrovci.
                            </div>

                        </div>

                        <div class="pm-dispatch-event-time">
                            2 min
                        </div>

                    </div>

                    <div class="pm-dispatch-event">

                        <div class="pm-dispatch-event-icon">
                            ✓
                        </div>

                        <div>

                            <div class="pm-dispatch-event-title">
                                Ruta potvrđena
                            </div>

                            <div class="pm-dispatch-event-text">
                                BG-241-AA nastavlja prema München-u.
                            </div>

                        </div>

                        <div class="pm-dispatch-event-time">
                            7 min
                        </div>

                    </div>

                    <div class="pm-dispatch-event">

                        <div class="pm-dispatch-event-icon info">
                            GPS
                        </div>

                        <div>

                            <div class="pm-dispatch-event-title">
                                GPS signal stabilan
                            </div>

                            <div class="pm-dispatch-event-text">
                                NS-882-KK ima preciznost pozicije 8 m.
                            </div>

                        </div>

                        <div class="pm-dispatch-event-time">
                            11 min
                        </div>

                    </div>

                    <div class="pm-dispatch-event">

                        <div class="pm-dispatch-event-icon danger">
                            !
                        </div>

                        <div>

                            <div class="pm-dispatch-event-title">
                                Otvoren incident
                            </div>

                            <div class="pm-dispatch-event-text">
                                Potrebna potvrda dispečera za vozilo KG-119-MP.
                            </div>

                        </div>

                        <div class="pm-dispatch-event-time">
                            18 min
                        </div>

                    </div>

                </div>

            </article>

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Fleet status
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Raspoloživost vozila
                        </div>

                    </div>

                    <a class="pm-dispatch-small-btn"
                       href="/vehicles">
                        Vozila
                    </a>

                </div>

                <div class="pm-dispatch-fleet">

                    <div class="pm-dispatch-fleet-row">

                        <div class="pm-dispatch-fleet-label">
                            In transit
                        </div>

                        <div class="pm-dispatch-fleet-track">
                            <div class="pm-dispatch-fleet-fill"
                                 style="width:68%">
                            </div>
                        </div>

                        <div class="pm-dispatch-fleet-value">
                            28
                        </div>

                    </div>

                    <div class="pm-dispatch-fleet-row">

                        <div class="pm-dispatch-fleet-label">
                            Loading
                        </div>

                        <div class="pm-dispatch-fleet-track">
                            <div class="pm-dispatch-fleet-fill"
                                 style="width:24%">
                            </div>
                        </div>

                        <div class="pm-dispatch-fleet-value">
                            6
                        </div>

                    </div>

                    <div class="pm-dispatch-fleet-row">

                        <div class="pm-dispatch-fleet-label">
                            Available
                        </div>

                        <div class="pm-dispatch-fleet-track">
                            <div class="pm-dispatch-fleet-fill"
                                 style="width:12%">
                            </div>
                        </div>

                        <div class="pm-dispatch-fleet-value">
                            4
                        </div>

                    </div>

                    <div class="pm-dispatch-fleet-row">

                        <div class="pm-dispatch-fleet-label">
                            Maintenance
                        </div>

                        <div class="pm-dispatch-fleet-track">
                            <div class="pm-dispatch-fleet-fill"
                                 style="width:7%">
                            </div>
                        </div>

                        <div class="pm-dispatch-fleet-value">
                            3
                        </div>

                    </div>

                </div>

            </article>

            <article class="pm-dispatch-card">

                <div class="pm-dispatch-card-head">

                    <div class="pm-dispatch-card-heading">

                        <div class="pm-dispatch-card-title">
                            Border watch
                        </div>

                        <div class="pm-dispatch-card-subtitle">
                            Aktivna čekanja
                        </div>

                    </div>

                    <a class="pm-dispatch-small-btn"
                       href="/monitoring">
                        Monitoring
                    </a>

                </div>

                <div class="pm-dispatch-border-list">

                    <div class="pm-dispatch-border-item">

                        <div>

                            <div class="pm-dispatch-border-name">
                                Batrovci
                            </div>

                            <div class="pm-dispatch-border-meta">
                                SRB → HR · 1 vozilo
                            </div>

                        </div>

                        <div class="pm-dispatch-border-wait">
                            34 min
                        </div>

                    </div>

                    <div class="pm-dispatch-border-item">

                        <div>

                            <div class="pm-dispatch-border-name">
                                Horgoš
                            </div>

                            <div class="pm-dispatch-border-meta">
                                SRB → HUN · 1 vozilo
                            </div>

                        </div>

                        <div class="pm-dispatch-border-wait">
                            21 min
                        </div>

                    </div>

                    <div class="pm-dispatch-border-item">

                        <div>

                            <div class="pm-dispatch-border-name">
                                Gradina
                            </div>

                            <div class="pm-dispatch-border-meta">
                                SRB → BGR · 1 vozilo
                            </div>

                        </div>

                        <div class="pm-dispatch-border-wait">
                            18 min
                        </div>

                    </div>

                </div>

            </article>

        </section>

    </main>
</div>


