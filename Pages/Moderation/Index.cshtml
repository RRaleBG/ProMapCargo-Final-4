@page "/moderation"

@{
    ViewData["Title"] = "Moderacija · ProMap Cargo";
}

<div class="pm-page" data-module="moderation">

    <!-- HEADER -->
    <header class="moderation-header pm-page-header">
        <div class="moderation-heading pm-page-heading">  </div>

        <div class="moderation-header-actions pm-page-actions">
            <button class="moderation-btn pm-btn pm-btn-secondary" id="refreshModeration"
                    type="button">
                <span>↻</span>
                Osveži
            </button>

            <a class="moderation-btn pm-btn" href="/audit">
                Otvori Audit
            </a>
        </div>
    </header>

    
    <!-- CRITICAL BANNER -->
    <section class="moderation-critical-banner pm-card">
        <div class="moderation-banner-icon">
            !
        </div>
 
        <div class="moderation-banner-copy">
            <strong id="moderationBannerTitle">
                Učitavanje…
            </strong>

            <span>
                Promene koje utiču na rutu, ograničenja ili ETA
                ne treba primeniti bez evidentirane odluke.
            </span>
        </div>

        <button class="moderation-banner-action" id="showPending" type="button">
            Prikaži na čekanju
        </button>

    </section>


    <!-- KPI -->
    <section class="moderation-kpi-grid pm-kpi-grid" aria-label="Moderation pregled">
        <article class="compliance-kpi compliance-kpi-warning">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Čeka odluku</span>
                <i data-lucide="clock-3" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiPending">—</strong>
            <span class="compliance-kpi-meta">aktivna moderation queue</span>
        </article>

        <article class="compliance-kpi compliance-kpi-danger">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Visok rizik</span>
                <i data-lucide="triangle-alert" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiHighRisk">—</strong>
            <span class="compliance-kpi-meta">zahteva zahtevaju pažnju</span>
        </article>

        <article class="compliance-kpi compliance-kpi-good">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Odobreno</span>
                <i data-lucide="circle-check" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiApproved">—</strong>
            <span class="compliance-kpi-meta">ovog meseca</span>
        </article>

        <article class="compliance-kpi compliance-kpi-danger">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Odbijeno</span>
                <i data-lucide="circle-x" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiRejected">—</strong>
            <span class="compliance-kpi-meta">ovog meseca</span>
        </article>

        <article class="compliance-kpi compliance-kpi-info">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Danas</span>
                <i data-lucide="calendar-days" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiToday">—</strong>
            <span class="compliance-kpi-meta">novih zahteva</span>
        </article>

        <article class="compliance-kpi compliance-kpi-neutral">
            <div class="compliance-kpi-top">
                <span class="compliance-kpi-label">Prosečno vreme</span>
                <i data-lucide="timer" class="compliance-kpi-icon" aria-hidden="true"></i>
            </div>
            <strong class="compliance-kpi-value" id="kpiAverage">—</strong>
            <span class="compliance-kpi-meta">od prijema do odluke</span>
        </article>
    </section>


    <!-- FILTER TOOLBAR -->
    <section class="pm-toolbar moderation-toolbar pm-card">

        <div class="pm-search-wrap moderation-search">
            <i data-lucide="search" class="pm-search-icon pm-icon" aria-hidden="true"></i>

            <input id="moderationSearch" class="pm-search-input" type="search" placeholder="Pretraži ID, vozilo, turu, operatora..."
                    autocomplete="off" />
        </div>

        <div class="pm-filter-group moderation-filter-group">

            <button class="pm-filter-btn moderation-filter active" data-status="all" type="button">
                Svi <b data-count="all">0</b>
            </button>

            <button class="pm-filter-btn moderation-filter" data-status="pending" type="button">
                Na čekanju <b data-count="pending">0</b>
            </button>

            <button class="pm-filter-btn moderation-filter" data-status="approved" type="button">
                Odobreno <b data-count="approved">0</b>
            </button>

            <button class="pm-filter-btn moderation-filter" data-status="rejected" type="button">
                Odbijeno <b data-count="rejected">0</b>
            </button>

        </div>

        <select id="riskFilter" class="pm-select moderation-select">
            <option value="all">Svi rizici</option>
            <option value="high">Visok rizik</option>
            <option value="medium">Srednji rizik</option>
            <option value="low">Nizak rizik</option>
        </select>

        <select id="domainFilter" class="pm-select moderation-select">
            <option value="all">Svi domeni</option>
            <option value="routing">Routing</option>
            <option value="safety">Safety</option>
            <option value="dispatch">Dispatch</option>
            <option value="eta">ETA</option>
        </select>

    </section>


    <!-- MAIN WORKSPACE -->
    <section class="moderation-workspace pm-workspace-split">

        <!-- QUEUE -->
        <div class="moderation-queue-panel pm-card pm-panel">

            <div class="panel-heading pm-panel-heading">

                <div>
                    <span class="panel-kicker">
                        REVIEW QUEUE
                    </span>

                    <h2>
                        Zahtevi za odluku
                    </h2>
                </div>

                <span class="queue-count" id="queueCount">—</span>

            </div>


            <div class="moderation-queue" id="moderationQueue">

            </div>

        </div>


        <!-- DETAIL -->
        <aside class="moderation-detail pm-card" id="moderationDetail">

            <div class="detail-header">
                <div>
                    <span class="panel-kicker">
                        SELECTED REQUEST
                    </span>

                    <h2 id="detailTitle">—</h2>

                    <span id="detailSubtitle">Izaberite zahtev</span>
                </div>

                <span class="risk-badge risk-medium" id="detailRisk">—</span>
            </div>

            <!-- WARNING -->
            <div class="detail-warning" id="detailWarning" hidden>
                <span>!</span>

                <div>
                    <strong id="detailWarningTitle">Zahtev visokog rizika</strong>

                    <p>
                        Odobrenje mora biti zasnovano na dokumentovanom
                        razlogu. Odluka se upisuje u audit trail.
                    </p>
                </div>
            </div>

            <!-- REQUEST INFO -->
            <div class="detail-grid">
                <div class="detail-card">
                    <span>Podnosilac</span>
                    <strong id="detailRequester">—</strong>
                    <small id="detailDomain">—</small>
                </div>

                <div class="detail-card">
                    <span>Primljeno</span>
                    <strong id="detailReceivedTime">—</strong>
                    <small id="detailReceivedDate">—</small>
                </div>

                <div class="detail-card">
                    <span>Vozilo</span>
                    <strong id="detailVehicle">—</strong>
                    <small>vozilo zahteva</small>
                </div>

                <div class="detail-card">
                    <span>Tura</span>
                    <strong id="detailTrip">—</strong>
                    <small>tura zahteva</small>
                </div>
            </div>

            <!-- CHANGE SET -->
            <section class="change-section pm-card">

                <div class="section-heading">
                    <div>
                        <span class="panel-kicker">
                            CHANGE SET
                        </span>

                        <h3>
                            Šta se menja
                        </h3>
                    </div>

                    <span class="change-label">
                        BEFORE → AFTER
                    </span>
                </div>

                <div class="change-comparison">
                    <div>
                        <span>Trenutno</span>
                        <strong>Bez izmene</strong>
                        <small>važeći plan</small>
                    </div>

                    <div class="change-arrow">
                        →
                    </div>

                    <div class="after">
                        <span>Predloženo</span>
                        <strong id="detailChange">—</strong>
                        <small id="detailImpact">—</small>
                    </div>
                </div>

                <div class="reason-box">
                    <span>Obrazloženje</span>
                    <p id="detailReason">—</p>
                </div>

            </section>

            <!-- POLICY -->
            <section class="policy-checks pm-card">

                <div class="section-heading">
                    <div>
                        <span class="panel-kicker">
                            POLICY CHECK
                        </span>

                        <h3>
                            Provere pre odluke
                        </h3>
                    </div>
                </div>

                <div id="policyChecks"></div>

            </section>

            <!-- DECISION -->
            <section class="decision-panel pm-card">

                <div class="section-heading">
                    <div>
                        <span class="panel-kicker">
                            DECISION
                        </span>

                        <h3>
                            Odluka moderatora
                        </h3>
                    </div>

                    <span class="decision-identity" id="decisionIdentity">
                        @(User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "Moderator")
                    </span>
                </div>

                <textarea id="decisionReason"
                          placeholder="Obrazloženje odluke je obavezno za odbijanje ili vraćanje zahteva..."></textarea>

                <div class="decision-actions" id="decisionActions">
                    <button class="decision-btn decision-approve" data-decision="approved" type="button">
                        ✓ Odobri
                    </button>

                    <button class="decision-btn decision-changes" data-decision="changes" type="button">
                        ↺ Traži izmene
                    </button>

                    <button class="decision-btn decision-reject" data-decision="rejected" type="button">
                        × Odbij
                    </button>
                </div>

            </section>

            <!-- AUDIT -->
            <section class="audit-preview pm-card">

                <div class="section-heading">
                    <div>
                        <span class="panel-kicker">
                            AUDIT TRAIL
                        </span>

                        <h3>
                            Istorija zahteva
                        </h3>
                    </div>

                    <a href="/audit">
                        Kompletan audit →
                    </a>
                </div>

                <div id="requestHistory"></div>

            </section>

        </aside>

    </section>


    <!-- POLICY FOOTER -->
    <section class="moderation-policy pm-card">

        <div>

            <span class="policy-icon">
                ◇
            </span>

            <div>

                <span class="panel-kicker">
                    APPROVAL POLICY
                </span>

                <h2>
                    Promene visokog uticaja moraju imati
                    proverljivu odluku.
                </h2>

                <p>
                    Manual routing overrides, restriction exceptions
                    i high-risk operativne promene zahtevaju identitet
                    moderatora, timestamp, obrazloženje i audit zapis.
                    Moderacija ne menja routing graph direktno bez
                    evidentirane odluke.
                </p>

            </div>

        </div>

        <a href="/compliance" class="moderation-btn moderation-btn-secondary">
            Compliance centar →
        </a>

    </section>


    <!-- TOAST -->
    <div class="moderation-toast" id="moderationToast">

        <span>✓</span>

        <div>
            <strong id="toastTitle">
                Odluka evidentirana
            </strong>

            <small id="toastText">
                Zahtev je ažuriran.
            </small>
        </div>

    </div>

</div>
