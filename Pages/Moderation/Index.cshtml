@page "/moderation"

@{
    ViewData["Title"] = "Moderacija · ProMap Cargo";
}

<div id="app" style="display:none"></div>
<div class="pm-page" data-module="moderation">
  <header class="pm-header">
    <div>
      <div class="pm-brand">ProMap <span>Cargo</span></div>
      <div class="pm-kicker">Moderacija</div>
      <div class="pm-subtitle">Approval workflow for high-impact operational changes</div>
    </div>
    <div class="pm-header-actions">
      <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
      <a class="pm-btn" href="/profile">Profil</a>
    </div>
  </header>
  <div class="pm-layout">
    <aside class="pm-sidebar">
      <div class="pm-nav-title">OPERATIONS</div>
      <nav class="pm-nav"><a class="" href="/dashboard">Dashboard</a><a class="" href="/dispatch">Command Center</a><a class="" href="/orders">Transportni nalozi</a><a class="" href="/trips">Ture</a><a class="" href="/vehicles">Vozila</a><a class="" href="/drivers">Vozači</a><a class="" href="/navigation">Navigacija</a><a class="" href="/alerts">Alerts</a><a class="active" href="/moderation">Moderacija</a><a class="" href="/audit">Audit</a><a class="" href="/compliance">Compliance</a><a class="" href="/monitoring">Monitoring</a><a class="" href="/finance">Finansije</a><a class="" href="/reports">Izveštaji</a><a class="" href="/settings">Podešavanja</a><a class="" href="/profile">Profil</a><a class="" href="/admin">Administracija</a></nav>
      <div class="pm-sidebar-footer"><b>Routing engine</b><br>PostGIS · OSM · Truck-aware<br><span>Graph protected</span></div>
    </aside>
    <main class="pm-content">
      <div class="pm-title">Moderacija</div><div class="pm-muted" style="margin:5px 0 14px">Approval queue for manual operational changes.</div><div class="pm-grid pm-grid-3"><div class="pm-card pm-stat"><small>Pending</small><div class="pm-value">1</div><div class="pm-muted">approval queue</div></div><div class="pm-card pm-stat"><small>Approved</small><div class="pm-value">18</div><div class="pm-muted">this month</div></div><div class="pm-card pm-stat"><small>Rejected</small><div class="pm-value">2</div><div class="pm-muted">this month</div></div></div><div style="height:14px"></div><div class="pm-card" style="overflow:auto"><table class="pm-table"><thead><tr><th>Request</th><th>Action</th><th>Target</th><th>Domain</th><th>Decision</th></tr></thead><tbody><tr><td>MOD-1001</td><td>Route override</td><td>BG-241-AA</td><td>Dispatch</td><td><span class="pm-badge">Pending</span></td></tr><tr><td>MOD-1002</td><td>Restriction exception</td><td>TRP-8843</td><td>Safety</td><td><span class="pm-badge">Approved</span></td></tr><tr><td>MOD-1003</td><td>Manual ETA change</td><td>TRP-8844</td><td>Dispatch</td><td><span class="pm-badge">Rejected</span></td></tr></tbody></table></div><div style="height:14px"></div><div class="pm-card pm-card-body"><div class="pm-h2">Approval policy</div><p class="pm-muted">Manual routing overrides, restriction exceptions and high-risk changes require an auditable decision with operator identity and timestamp.</p></div>
    </main>
  </div>
</div>


<script>
// Pages are server-rendered and must remain independent from the legacy SPA renderer.
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.pm-page a[href]').forEach(a=>a.addEventListener('click',e=>{
    if(a.origin===location.origin){ e.stopPropagation(); }
  },true));
});
</script>

