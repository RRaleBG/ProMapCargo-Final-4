@section Scripts {

    <script src="~/js/promap-gps.js" asp-append-version="true"></script>
    <script src="~/js/promap-maneuvers.js" asp-append-version="true"></script>
    <script src="~/js/promap-routing.js" asp-append-version="true"></script>

    <!-- PMTiles runtime -->
    <script src="~/lib/pmtiles/dist/pmtiles.js" asp-append-version="true"></script>

    <!-- Icons -->
    <script src="~/js/promap-map-icons.js" asp-append-version="true"></script>

    <!-- Operational map layers -->
    <script src="~/js/promap-map-enhancements.js" asp-append-version="true"></script>

    <!-- PMTiles / MapLibre initialization -->
    <script src="~/js/promap-pmtiles-init.js" asp-append-version="true"></script>

    <!-- Navigation -->
    <script src="~/js/navigation.js" asp-append-version="true"></script>

    <script>
        (() => {
            "use strict";

            const query = new URLSearchParams(window.location.search);
            const isEmbeddedNavigation =
                query.get("embedded") === "1" ||
                query.get("mobile") === "1";

            if (isEmbeddedNavigation) {
                document.body.classList.add("pm-embedded-navigation");
                document.body.classList.add("pm-embedded-mobile");
            }

            function bindMobileSheetToggle() {
                if (!isEmbeddedNavigation) {
                    return;
                }

                const panel = document.querySelector(".navigation-control-panel");
                const toggle = document.getElementById("togglePlanner");

                if (!panel || !toggle) {
                    return;
                }

                toggle.hidden = false;

                toggle.addEventListener("click", () => {
                    panel.classList.toggle("sheet-open");
                });
            }

            function bindDesktopPlannerCollapse() {
                const panel = document.getElementById("navigationControlPanel");
                const toggle = document.getElementById("plannerCollapse");
                const workspace = document.querySelector(".navigation-workspace");

                if (!panel || !toggle || !workspace || isEmbeddedNavigation) {
                    return;
                }

                const syncCollapsedState = (isCollapsed) => {
                    workspace.classList.toggle("planner-is-collapsed", isCollapsed);
                    toggle.setAttribute("aria-expanded", String(!isCollapsed));
                    toggle.textContent = isCollapsed ? "⇥" : "⇤";
                };

                syncCollapsedState(panel.classList.contains("panel-collapsed"));

                toggle.addEventListener("click", () => {
                    const isCollapsed = panel.classList.toggle("panel-collapsed");
                    syncCollapsedState(isCollapsed);

                    const mapRoot = document.getElementById("navMap");
                    if (mapRoot) {
                        mapRoot.dispatchEvent(new Event("resize"));
                    }

                    window.dispatchEvent(new Event("resize"));
                });
            }

            function bindRightSidebarCardCollapsibles() {
                const toggles = document.querySelectorAll(".nav-collapse-toggle[data-collapse-target]");
                if (!toggles.length) {
                    return;
                }

                const setExpanded = (toggleButton, content, expanded) => {
                    content.classList.toggle("is-open", expanded);
                    toggleButton.setAttribute("aria-expanded", String(expanded));
                    toggleButton.textContent = expanded ? "▾" : "▸";
                };

                toggles.forEach((toggleButton) => {
                    const targetId = toggleButton.getAttribute("data-collapse-target");
                    if (!targetId) {
                        return;
                    }

                    const content = document.getElementById(targetId);
                    if (!content) {
                        return;
                    }

                    setExpanded(toggleButton, content, content.classList.contains("is-open"));

                    toggleButton.addEventListener("click", () => {
                        const isExpanded = toggleButton.getAttribute("aria-expanded") === "true";
                        setExpanded(toggleButton, content, !isExpanded);
                    });
                });
            }

            bindMobileSheetToggle();
            bindDesktopPlannerCollapse();
            bindRightSidebarCardCollapsibles();


        })();
    </script>
}

