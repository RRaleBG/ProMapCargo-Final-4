                        <div class="nav-point-marker start"></div>
                        <div class="nav-input-wrapper">
                            <label for="navStart"> POLAZNA TAČKA </label>
                            <input id="navStart" class="nav-input" type="text" autocomplete="off" value="Beograd, Srbija" placeholder="Grad, adresa ili lokacija" />
                            <div id="navStartSuggestions" class="nav-suggestions"></div>
                            <div id="navStartResolved" class="nav-resolved"><span></span>  Nije još potvrđeno </div>
                        </div>
                    </div>

                    <div class="nav-route-connector"></div>


