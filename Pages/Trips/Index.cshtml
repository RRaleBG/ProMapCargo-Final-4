@page "/trips"
@{
    ViewData["Title"] = "Ture · ProMap Cargo";
}

<div id="app" style="display:none"></div>
<div class="pm-page" data-module="trips">
  <header class="pm-header">
    <div>
      <div class="pm-brand">ProMap <span>Cargo</span></div>
      <div class="pm-kicker">Ture</div>
      <div class="pm-subtitle">Trip lifecycle, route execution and ETA monitoring</div>
    </div>
    <div class="pm-header-actions">
      <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
      <a class="pm-btn" href="/profile">Profil</a>
    </div>
  </header>
  <div class="pm-layout">
    <aside class="pm-sidebar">
      <div class="pm-nav-title">OPERATIONS</div>
      <nav class="pm-nav"><a class="" href="/dashboard">Dashboard</a><a class="" href="/dispatch">Command Center</a><a class="" href="/orders">Transportni nalozi</a><a class="active" href="/trips">Ture</a><a class="" href="/vehicles">Vozila</a><a class="" href="/drivers">Vozači</a><a class="" href="/navigation">Navigacija</a><a class="" href="/alerts">Alerts</a><a class="" href="/moderation">Moderacija</a><a class="" href="/audit">Audit</a><a class="" href="/compliance">Compliance</a><a class="" href="/monitoring">Monitoring</a><a class="" href="/finance">Finansije</a><a class="" href="/reports">Izveštaji</a><a class="" href="/settings">Podešavanja</a><a class="" href="/profile">Profil</a><a class="" href="/admin">Administracija</a></nav>
      <div class="pm-sidebar-footer"><b>Routing engine</b><br>PostGIS · OSM · Truck-aware<br><span>Graph protected</span></div>
    </aside>
    <main class="pm-content">
      <div class="pm-row" style="justify-content:space-between;margin-bottom:14px"><div><div class="pm-title">Ture</div><div class="pm-muted">Planirane, aktivne i završene transportne ture</div></div><button class="pm-btn pm-btn-primary">+ Nova tura</button></div><div class="pm-card pm-card-body"><div class="pm-grid pm-grid-4"><div><label class="pm-label">Trip ID</label><input class="pm-field" placeholder="TRP-..."></div><div><label class="pm-label">Vehicle</label><input class="pm-field" placeholder="Reg. oznaka"></div><div><label class="pm-label">Status</label><input class="pm-field" placeholder="All"></div><div><label class="pm-label">Date</label><input class="pm-field" placeholder="YYYY-MM-DD"></div></div><div class="pm-actions" style="margin-top:12px"><button class="pm-btn pm-btn-primary">Pretraži</button></div></div><div style="height:14px"></div><div class="pm-card" style="overflow:auto"><table class="pm-table"><thead><tr><th>Trip</th><th>Vozilo</th><th>Ruta</th><th>Distance</th><th>Progress</th><th>Status</th></tr></thead><tbody><tr><td>TRP-8841</td><td>BG-241-AA</td><td>Beograd → München</td><td>1,184 km</td><td><b>68%</b></td><td><span class="pm-badge">In Transit</span></td></tr><tr><td>TRP-8842</td><td>NS-882-KK</td><td>Novi Sad → Graz</td><td>552 km</td><td><b>54%</b></td><td><span class="pm-badge">In Transit</span></td></tr><tr><td>TRP-8843</td><td>NI-401-TT</td><td>Niš → Zagreb</td><td>626 km</td><td><b>41%</b></td><td><span class="pm-badge">Border</span></td></tr><tr><td>TRP-8844</td><td>KG-119-MP</td><td>Kragujevac → Milano</td><td>1,120 km</td><td><b>27%</b></td><td><span class="pm-badge">Loading</span></td></tr></tbody></table></div>
    </main>
  </div>
</div>


<script>
// Pages are server-rendered and must remain independent from the legacy SPA renderer.
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.pm-page a[href]').forEach(a=>a.addEventListener('click',e=>
    if(a.origin===location.origin){ e.stopPropagation(); }
  },true));
});
</script>

