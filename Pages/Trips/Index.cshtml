                            </div>
                            <span id="mapRouteStatus" class="pm-badge pm-badge-success"> Bezbedna </span>
                        </div>


                        <div class="nav-map-route-stats">
                            <div>
                                <span> Udaljenost </span>
                                <strong id="mapDistance"> — </strong>
                            </div>
                            <div>
                                <span> Trajanje </span>
                                <strong id="mapDuration"> — </strong>
                            </div>
                            <div>
                                <span> ETA </span>
                                <strong id="mapEta"> — </strong>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
