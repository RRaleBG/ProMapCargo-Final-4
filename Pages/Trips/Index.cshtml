@page "/trips"
@model ProMapCargo.Api.Pages.Trips.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ture";
}

<div id="tripsPage" data-module="trips" class="pm-page pm-page--trips">
    <header class="pm-page-header pm-header pm-trip-header">
        <div class="pm-trip-heading">
            <div class="pm-page-kicker pm-trip-kicker">Operacije flote</div>
                <h1 class="pm-page-title pm-trip-title">Ture</h1>
                <p class="pm-page-subtitle pm-trip-subtitle">Pregled statusa, dodela, napretka i
                    poslednje GPS aktivnosti.
                </p>
            </div>
            <button id="refreshTrips" type="button" class="pm-btn pm-btn--secondary pm-trip-refresh">
                <i data-lucide="refresh-cw" aria-hidden="true"></i> Osveži ture
            </button>
        </header>

        <section class="moderation-kpi-grid pm-kpi-grid pm-kpi-grid--4" aria-label="Sažetak tura">
            <article class="compliance-kpi compliance-kpi-total pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Ukupno tura</span>
                    <i data-lucide="route" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" data-trip-kpi="total">—</strong>
                <span class="compliance-kpi-meta">sve ture</span>
            </article>

            <article class="compliance-kpi compliance-kpi-good pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Aktivne</span>
                    <i data-lucide="navigation" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" data-trip-kpi="active">—</strong>
                <span class="compliance-kpi-meta">u toku</span>
            </article>

            <article class="compliance-kpi compliance-kpi-info pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Planirane</span>
                    <i data-lucide="calendar-clock" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" data-trip-kpi="planned">—</strong>
                <span class="compliance-kpi-meta">čekaju polazak</span>
            </article>

            <article class="compliance-kpi compliance-kpi-neutral pm-kpi">
                <div class="compliance-kpi-top">
                    <span class="compliance-kpi-label">Završene</span>
                    <i data-lucide="circle-check" class="compliance-kpi-icon" aria-hidden="true"></i>
                </div>
                <strong class="compliance-kpi-value" data-trip-kpi="completed">—</strong>
                <span class="compliance-kpi-meta">isporučeno</span>
            </article>
        </section>

        <div class="pm-trip-layout">
            <aside aria-label="Filteri tura" class="pm-card pm-trip-filters pm-panel">
                <div>
                     <h2 class="pm-trip-filter-title">Status ture  </h2>
                    <nav class="pm-trip-filter-nav pm-filter-group" aria-label="Filtriraj po statusu">
                        <button type="button" data-trip-filter="all" aria-pressed="true" class="pm-trip-filter pm-trip-filter--active pm-filter-btn pm-btn">
                            Sve ture <span data-trip-filter-count="all"
                                           class="pm-trip-filter-count">—</span>
                        </button>
                        <button type="button" data-trip-filter="active" aria-pressed="false"
                                class="pm-trip-filter pm-filter-btn pm-btn">
                            Aktivne <span data-trip-filter-count="active"
                                          class="pm-trip-filter-count">—</span>
                        </button>
                        <button type="button" data-trip-filter="planned" aria-pressed="false"
                                class="pm-trip-filter pm-filter-btn pm-btn">
                            Planirane <span data-trip-filter-count="planned"
                                            class="pm-trip-filter-count">—</span>
                        </button>
                        <button type="button" data-trip-filter="paused" aria-pressed="false"
                                class="pm-trip-filter pm-filter-btn pm-btn">
                            Pauzirane <span data-trip-filter-count="paused"
                                            class="pm-trip-filter-count">—</span>
                        </button>
                        <button type="button" data-trip-filter="completed" aria-pressed="false"
                                class="pm-trip-filter pm-filter-btn pm-btn">
                            Završene <span data-trip-filter-count="completed"
                                           class="pm-trip-filter-count">—</span>
                        </button>
                        <button type="button" data-trip-filter="cancelled" aria-pressed="false"
                                class="pm-trip-filter pm-filter-btn pm-btn">
                            Otkazane <span data-trip-filter-count="cancelled"
                                           class="pm-trip-filter-count">—</span>
                        </button>
                    </nav>
                </div>
                <div class="pm-trip-live-note">
                    <div class="pm-trip-live-note-title">Podaci u realnom vremenu</div>
                    <p class="pm-trip-live-note-text">Prikaz koristi ture i dodele
                        iz sistema. GPS status se računa prema poslednjem primljenom signalu.</p>
                </div>
            </aside>

            <section aria-label="Lista svih tura" class="pm-card pm-trip-list pm-panel">
                <header class="pm-trip-list-header pm-toolbar pm-panel-heading">
                    <div>
                        <h2 class="pm-trip-list-title">Evidencija tura</h2>
                        <p class="pm-trip-list-subtitle">
                            <span id="tripsResultCount">Učitavanje…</span> · poslednjih do 500 tura
                        </p>
                    </div>
                    <label class="pm-search-wrap pm-trip-search">
                        <i data-lucide="search" class="pm-search-icon pm-icon" aria-hidden="true"></i>
                        <span class="pm-sr-only">Pretraži ture</span>
                        <input id="tripsSearch" class="pm-search-input" type="search" autocomplete="off" placeholder="Tura, nalog, vozač ili vozilo…" />
                    </label>
                </header>

                <div id="tripsError" role="alert" hidden class="pm-trip-error"> </div>

                <div class="pm-trip-table-wrap">
                    <table class="pm-trip-table">
                        <thead class="pm-trip-table-head">
                            <tr>
                                <th scope="col">Tura / nalog</th>
                                <th scope="col">Status</th>
                                <th scope="col">Vozač / vozilo</th>
                                <th scope="col">Napredak</th>
                                <th scope="col">Ruta</th>
                                <th scope="col">Poslednji GPS</th>
                            </tr>
                        </thead>
                        <tbody id="tripsRows" class="pm-trip-table-body">
                            <tr>
                                <td colspan="6" class="pm-trip-empty">Učitavanje tura…</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <section id="tripDetailsModal" class="compliance-modal pm-trip-detail-modal" hidden aria-hidden="true" aria-labelledby="tripDetailsTitle">
            <div class="compliance-modal-backdrop" data-modal-close></div>
            <div class="compliance-modal-dialog pm-trip-detail-dialog" role="dialog" aria-modal="true">
                <header class="compliance-modal-header pm-trip-detail-header">
                    <div>
                        <div class="modal-kicker">Detalji ture</div>
                        <h2 id="tripDetailsTitle">Tura</h2>
                        <p id="tripDetailsSubtitle">Kompletan pregled ture, naloga, vozača i troškova.</p>
                    </div>
                    <div class="compliance-modal-actions">
                        <button type="button" class="compliance-btn compliance-btn-secondary" data-modal-close>Zatvori</button>
                    </div>
                </header>
                <div id="tripDetailsError" class="pm-trip-error" hidden role="alert"></div>
                <div id="tripDetailsLoading" class="pm-trip-detail-loading">Učitavanje detalja ture…</div>
                <div id="tripDetailsBody" class="pm-trip-detail-body" hidden>
                    <section class="pm-trip-detail-section">
                        <div class="detail-section-header">
                            <div>
                                <h3>Osnovni pregled</h3>
                                <p>Status, ruta, budžet i napredak ture.</p>
                            </div>
                        </div>
                        <div class="pm-trip-detail-grid pm-trip-detail-grid--summary">
                            <article class="pm-trip-detail-card"><span>Status</span><strong id="tripDetailStatus">—</strong><small id="tripDetailExecution">—</small></article>
                            <article class="pm-trip-detail-card"><span>Ruta</span><strong id="tripDetailRoute">—</strong><small id="tripDetailSchedule">—</small></article>
                            <article class="pm-trip-detail-card"><span>Napredak</span><strong id="tripDetailProgress">—</strong><small id="tripDetailDistance">—</small></article>
                            <article class="pm-trip-detail-card"><span>Budžet</span><strong id="tripDetailBudget">—</strong><small id="tripDetailSpent">—</small></article>
                        </div>
                    </section>

                    <section class="pm-trip-detail-section">
                        <div class="detail-section-header">
                            <div>
                                <h3>Vozač i vozilo</h3>
                                <p>Dodela, kontakt i istorija povezanih tura.</p>
                            </div>
                        </div>
                        <div class="pm-trip-detail-two-column">
                            <article class="pm-trip-detail-panel">
                                <h4>Vozač</h4>
                                <div class="pm-trip-detail-list">
                                    <div><span>Ime</span><strong id="tripDetailDriverName">—</strong></div>
                                    <div><span>Kontakt</span><strong id="tripDetailDriverContact">—</strong></div>
                                    <div><span>Dokumenta</span><strong id="tripDetailDriverLicense">—</strong></div>
                                    <div><span>Napomena</span><strong id="tripDetailDriverNotes">—</strong></div>
                                </div>
                                <div>
                                    <h5>Istorija vozača</h5>
                                    <div id="tripDetailDriverHistory" class="timeline"></div>
                                </div>
                            </article>
                            <article class="pm-trip-detail-panel">
                                <h4>Vozilo</h4>
                                <div class="pm-trip-detail-list">
                                    <div><span>Registracija</span><strong id="tripDetailVehicleRegistration">—</strong></div>
                                    <div><span>Opis</span><strong id="tripDetailVehicleDescription">—</strong></div>
                                    <div><span>Kapacitet</span><strong id="tripDetailVehicleCapacity">—</strong></div>
                                    <div><span>Gorivo / kartica</span><strong id="tripDetailVehicleFuel">—</strong></div>
                                </div>
                                <div>
                                    <h5>Istorija vozila</h5>
                                    <div id="tripDetailVehicleHistory" class="timeline"></div>
                                </div>
                            </article>
                        </div>
                    </section>

                    <section class="pm-trip-detail-section">
                        <div class="detail-section-header">
                            <div>
                                <h3>Nalog i napomene</h3>
                                <p>Detalji naloga, tereta i napomena za vozača.</p>
                            </div>
                        </div>
                        <div class="pm-trip-detail-two-column">
                            <article class="pm-trip-detail-panel">
                                <div class="pm-trip-detail-list">
                                    <div><span>Nalog</span><strong id="tripDetailOrderNumber">—</strong></div>
                                    <div><span>Kupac</span><strong id="tripDetailCustomer">—</strong></div>
                                    <div><span>Teret</span><strong id="tripDetailCargo">—</strong></div>
                                    <div><span>Dispečer</span><strong id="tripDetailDispatcher">—</strong></div>
                                </div>
                                <div class="pm-trip-note-box">
                                    <span>NAPOMENE</span>
                                    <strong id="tripDetailNotes">—</strong>
                                </div>
                            </article>
                            <article class="pm-trip-detail-panel">
                                <h4>Stanice</h4>
                                <div id="tripDetailStops" class="timeline"></div>
                            </article>
                        </div>
                    </section>

                    <section class="pm-trip-detail-section">
                        <div class="detail-section-header">
                            <div>
                                <h3>Troškovi i zarada</h3>
                                <p>Svi troškovi ture, način plaćanja i iznosi za povraćaj.</p>
                            </div>
                        </div>
                        <div class="pm-trip-detail-grid pm-trip-detail-grid--finance">
                            <article class="pm-trip-detail-card"><span>Ukupno troškovi</span><strong id="tripDetailCostsTotal">—</strong><small id="tripDetailCostsPending">—</small></article>
                            <article class="pm-trip-detail-card"><span>Vozač platio</span><strong id="tripDetailDriverPaid">—</strong><small id="tripDetailAllowances">—</small></article>
                            <article class="pm-trip-detail-card"><span>Isplaćeno</span><strong id="tripDetailPaidOut">—</strong><small id="tripDetailRemaining">—</small></article>
                        </div>
                        <div class="pm-trip-cost-table-wrap">
                            <table class="pm-trip-cost-table">
                                <thead>
                                    <tr>
                                        <th>Trošak</th>
                                        <th>Iznos</th>
                                        <th>Plaćanje</th>
                                        <th>Vreme / mesto</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="tripDetailCostsRows">
                                    <tr><td colspan="5" class="pm-trip-empty">Nema troškova.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            </div>
        </section>
    </div>

