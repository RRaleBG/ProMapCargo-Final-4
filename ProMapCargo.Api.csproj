<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>807d07dd-f204-41e9-93fc-fbeb1706f1b6</UserSecretsId>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Itinero" Version="1.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.NetTopologySuite" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Sql/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The importer and MAUI app are separate projects nested below this project. -->
  <ItemGroup>
    <Compile Remove="ProMapCargo.Mobile\**\*.cs" />
    <Compile Remove="Importer\**\*.cs" />
    <EmbeddedResource Remove="ProMapCargo.Mobile\**" />
    <EmbeddedResource Remove="Importer\**" />
    <Content Remove="ProMapCargo.Mobile\**" />
    <Content Remove="Importer\**" />
    <None Remove="ProMapCargo.Mobile\**" />
    <None Remove="Importer\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot\maps\pmtiles.exe" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Pages\Fleet\" />
    <Folder Include="wwwroot\icons\" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="wwwroot\maps\pmtiles.exe" />
  </ItemGroup>
</Project>
