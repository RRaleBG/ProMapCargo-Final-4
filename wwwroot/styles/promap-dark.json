{
  "version": 8,
  "name": "ProMap Cargo Dark Europe",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://__PROMAP_PM_TILES_URL__"
    }
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#081019"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [ "get", "kind" ],
          "wood",
          "#0c1821",
          "forest",
          "#0e1b24",
          "grass",
          "#101b23",
          "sand",
          "#18232b",
          "scrub",
          "#101920",
          "glacier",
          "#1a2630",
          "#0d1720"
        ],
        "fill-opacity": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          3,
          0.42,
          7,
          0.5,
          11,
          0.58
        ]
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [ "get", "kind" ],
          "residential",
          "#131d27",
          "commercial",
          "#16212b",
          "industrial",
          "#18242d",
          "railway",
          "#141f29",
          "parking",
          "#141f29",
          "cemetery",
          "#11202a",
          "park",
          "#10202a",
          "forest",
          "#0f1d26",
          "#121b24"
        ],
        "fill-opacity": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          3,
          0.14,
          7,
          0.24,
          11,
          0.36
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0c2235"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "river", "canal", "stream", "ditch" ]
        ]
      ],
      "paint": {
        "line-color": "#4d7396",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          4,
          0.4,
          8,
          1.0,
          12,
          1.8
        ],
        "line-opacity": 0.72
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundaries",
      "filter": [
        "==",
        [ "get", "kind" ],
        "country"
      ],
      "paint": {
        "line-color": "#4a6a82",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          4,
          0.6,
          8,
          1.2,
          12,
          1.8
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "boundary-region",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundaries",
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "region", "macroregion", "county", "state" ]
        ]
      ],
      "paint": {
        "line-color": "#2d4151",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          5,
          0.4,
          9,
          0.8,
          13,
          1.2
        ],
        "line-dasharray": [ 2, 2 ],
        "line-opacity": 0.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "paint": {
        "fill-color": "#1c2633",
        "fill-outline-color": "#0e1620",
        "fill-opacity": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          11,
          0.2,
          13,
          0.45,
          16,
          0.75
        ]
      }
    },
    {
      "id": "tunnel-railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          [ "get", "is_tunnel" ],
          true
        ],
        [
          "in",
          [ "get", "kind" ],
          [
            "literal",
            [ "rail", "transit" ]
          ]
        ]
      ],
      "paint": {
        "line-color": "#303944",
        "line-dasharray": [ 2, 2 ],
        "line-width": 1.2,
        "line-opacity": 0.6
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "minor_road", "service", "track", "path", "other" ]
        ]
      ],
      "paint": {
        "line-color": "#233544",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          10,
          0.55,
          14,
          1.35,
          16,
          2.35
        ],
        "line-opacity": 0.46
      }
    },
    {
      "id": "road-secondary-tertiary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 6,
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "secondary", "tertiary" ]
        ]
      ],
      "paint": {
        "line-color": "#162431",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          6,
          1.1,
          10,
          2.6,
          14,
          5.2
        ],
        "line-opacity": 0.95
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 6,
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "secondary", "tertiary" ]
        ]
      ],
      "paint": {
        "line-color": "#5f89ad",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          6,
          0.7,
          10,
          1.95,
          14,
          4.2
        ],
        "line-opacity": 0.92
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "major_road" ]
        ]
      ],
      "paint": {
        "line-color": "#183041",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          5,
          2.0,
          9,
          4.4,
          14,
          7.8
        ],
        "line-opacity": 0.98
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "major_road" ]
        ]
      ],
      "paint": {
        "line-color": "#84c5eb",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          5,
          1.15,
          9,
          2.8,
          14,
          5.9
        ],
        "line-opacity": 0.98
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 4,
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "highway" ]
        ]
      ],
      "paint": {
        "line-color": "#103146",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          4,
          2.6,
          8,
          5.5,
          14,
          10.2
        ],
        "line-opacity": 1.0
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 4,
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "highway" ]
        ]
      ],
      "paint": {
        "line-color": "#4fd2ff",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          4,
          1.45,
          8,
          3.7,
          14,
          7.7
        ],
        "line-opacity": 1.0
      }
    },
    {
      "id": "road-construction",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": [
        "==",
        [ "get", "kind_detail" ],
        "construction"
      ],
      "paint": {
        "line-color": "#b87b28",
        "line-dasharray": [ 2, 2 ],
        "line-width": 2.0,
        "line-opacity": 0.85
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "rail", "transit" ]
        ]
      ],
      "paint": {
        "line-color": "#4d5761",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          6,
          0.5,
          12,
          1.5
        ],
        "line-opacity": 0.65
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "in",
          [ "get", "kind" ],
          [
            "literal",
            [ "highway", "major_road", "secondary", "tertiary" ]
          ]
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [ "get", "shield_text" ],
          [ "get", "ref" ],
          [ "get", "name:en" ],
          [ "get", "name" ]
        ],
        "text-font": [ "Noto Sans Regular" ],
        "text-size": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          12,
          9,
          15,
          12.5
        ],
        "text-letter-spacing": 0.08,
        "symbol-spacing": 380
      },
      "paint": {
        "text-color": "#d2ecff",
        "text-halo-color": "#09131c",
        "text-halo-width": 1.4,
        "text-opacity": 0.92
      }
    },
    {
      "id": "place-label-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "country", "state", "region" ]
        ]
      ],
      "minzoom": 3,
      "layout": {
        "text-field": [
          "coalesce",
          [ "get", "name:en" ],
          [ "get", "name" ]
        ],
        "text-font": [ "Noto Sans Regular" ],
        "text-size": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          3,
          10,
          5,
          12.5,
          8,
          15
        ],
        "text-letter-spacing": 0.18,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#9fb4c5",
        "text-halo-color": "#081019",
        "text-halo-width": 1.35,
        "text-opacity": 0.82
      }
    },
    {
      "id": "place-label-capital",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "filter": [
        ">=",
        [
          "coalesce",
          [ "get", "capital" ],
          0
        ],
        2
      ],
      "minzoom": 4,
      "layout": {
        "text-field": [
          "coalesce",
          [ "get", "name:en" ],
          [ "get", "name" ]
        ],
        "text-font": [ "Noto Sans Regular" ],
        "text-size": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          4,
          11,
          8,
          13,
          12,
          16,
          15,
          18
        ],
        "text-letter-spacing": 0.03
      },
      "paint": {
        "text-color": "#f4fbff",
        "text-halo-color": "#07111A",
        "text-halo-width": 1.5,
        "text-opacity": 0.98
      }
    },
    {
      "id": "place-label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "filter": [
        "in",
        [ "get", "kind" ],
        [
          "literal",
          [ "city", "town", "village", "suburb" ]
        ]
      ],
      "minzoom": 5,
      "layout": {
        "text-field": [
          "coalesce",
          [ "get", "name:en" ],
          [ "get", "name" ]
        ],
        "text-font": [ "Noto Sans Regular" ],
        "text-size": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          6,
          8.5,
          10,
          10.5,
          14,
          12.8
        ],
        "text-letter-spacing": 0.012
      },
      "paint": {
        "text-color": "#c7d6e2",
        "text-halo-color": "#07111A",
        "text-halo-width": 1.1,
        "text-opacity": 0.88
      }
    }
  ]
}