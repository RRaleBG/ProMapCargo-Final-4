{
  "version": 8,
  "name": "ProMap Cargo Dark Europe",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://__PROMAP_PM_TILES_URL__"
    }
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#02080c"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "#071015",
          "forest",
          "#081116",
          "grass",
          "#091116",
          "sand",
          "#0c1217",
          "#081015"
        ],
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.28,
          7,
          0.36,
          11,
          0.46
        ]
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential",
          "#0b1218",
          "commercial",
          "#0c131a",
          "industrial",
          "#0d141b",
          "railway",
          "#0d141c",
          "parking",
          "#0c131a",
          "#091117"
        ],
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.12,
          7,
          0.22,
          11,
          0.34
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#040b10"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#09131a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          0.15,
          11,
          0.4,
          14,
          0.8
        ],
        "line-opacity": 0.34
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#0a1116",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.2,
          9,
          0.4,
          12,
          0.65
        ],
        "line-opacity": 0.22
      }
    },
    {
      "id": "boundary-region",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", [">=", ["get", "admin_level"], 3], ["<=", ["get", "admin_level"], 6]],
      "paint": {
        "line-color": "#081015",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.15,
          10,
          0.25,
          13,
          0.4
        ],
        "line-dasharray": [2, 2],
        "line-opacity": 0.1
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#171f2a",
        "fill-outline-color": "#0b1118",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11,
          0.12,
          13,
          0.28,
          16,
          0.62
        ]
      }
    },
    {
      "id": "tunnel-railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "brunnel"], "tunnel"], ["in", ["get", "class"], ["literal", ["rail", "subway", "tram"]]]],
      "paint": {
        "line-color": "#303944",
        "line-dasharray": [2, 2],
        "line-width": 1.1,
        "line-opacity": 0.6
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["in", ["get", "class"], ["literal", ["service", "track", "path", "pedestrian", "minor", "street"]]],
      "paint": {
        "line-color": "#111923",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0.45,
          16,
          1.2
        ],
        "line-opacity": 0.6
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "paint": {
        "line-color": "#101821",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11,
          0.45,
          14,
          1.45
        ],
        "line-opacity": 0.58
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "primary"],
      "paint": {
        "line-color": "#141f2a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.6,
          14,
          1.9
        ],
        "line-opacity": 0.66
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": {
        "line-color": "#1a2733",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          0.85,
          14,
          2.45
        ],
        "line-opacity": 0.72
      }
    },
    {
      "id": "road-construction",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "construction"],
      "paint": {
        "line-color": "#8d5d1d",
        "line-dasharray": [2, 2],
        "line-width": 1.7,
        "line-opacity": 0.8
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["rail", "subway", "tram"]]],
      "paint": {
        "line-color": "#4d5761",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.4,
          12,
          1.2
        ],
        "line-opacity": 0.65
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "filter": ["==", ["get", "class"], "runway"],
      "paint": {
        "line-color": "#39454d",
        "line-width": 3,
        "line-opacity": 0.7
      }
    },
    {
      "id": "place-label-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["country", "state"]]],
      "minzoom": 4,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          8,
          6,
          10,
          8,
          12
        ],
        "text-letter-spacing": 0.18,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#46535f",
        "text-halo-color": "#02080c",
        "text-halo-width": 1,
        "text-opacity": 0.46
      }
    },
    {
      "id": "place-label-capital",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        [ "get", "class" ],
        [
          "literal",
          [ "city", "town" ]
        ]
      ],
      "minzoom": 7,
      "layout": {
        "text-field": [
          "coalesce",
          [ "get", "name:latin" ],
          [ "get", "name" ]
        ],
        "text-font": [ "Noto Sans Regular" ],
        "text-size": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          7,
          9,
          10,
          11,
          14,
          14
        ],
        "text-letter-spacing": 0.012
      },
      "paint": {
        "text-color": "#aeb8c2",
        "text-halo-color": "#02080c",
        "text-halo-width": 1.15,
        "text-opacity": 0.74
      }
    },
    {
      "id": "place-label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          8,
          12,
          10,
          14,
          12
        ],
        "text-letter-spacing": 0.008
      },
      "paint": {
        "text-color": "#7d8995",
        "text-halo-color": "#02080c",
        "text-halo-width": 0.95,
        "text-opacity": 0.66
      }
    }
  ]
}
