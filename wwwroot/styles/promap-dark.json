{
  "version": 8,
  "name": "TruckApp Dark [Orbis]",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://__PROMAP_PM_TILES_URL__"
    }
  },
  "sprite": "https://openmaptiles.github.io/osm-bright-gl-style/sprite",
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "hsl(220, 15%, 8%)"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [ "==", "class", "residential" ],
      "paint": {
        "fill-color": "hsl(220, 12%, 12%)",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [ "in", "class", "commercial", "industrial", "parking" ],
      "paint": {
        "fill-color": "hsl(220, 10%, 14%)",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landcover-wood-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [ "in", "class", "grass", "forest", "wood", "sand" ],
      "paint": {
        "fill-color": "hsl(140, 15%, 11%)",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "hsl(215, 45%, 15%)"
      }
    },
    {
      "id": "water-shadow",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "line-color": "hsl(215, 50%, 8%)",
        "line-width": 2
      }
    },
    {
      "id": "building-underground",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "filter": [ "==", "underground", "true" ],
      "paint": {
        "fill-color": "hsl(220, 10%, 10%)",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "hsl(220, 10%, 18%)",
        "fill-outline-color": "hsl(220, 10%, 12%)"
      }
    },
    {
      "id": "tunnel-railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [ "==", "brunnel", "tunnel" ],
        [ "in", "class", "rail", "subway", "tram" ]
      ],
      "paint": {
        "line-color": "hsl(220, 5%, 25%)",
        "line-dasharray": [ 2, 2 ],
        "line-width": 1.5
      }
    },
    {
      "id": "road-service-pedestrian",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [ "in", "class", "service", "track", "path", "pedestrian" ],
      "paint": {
        "line-color": "hsl(220, 8%, 22%)",
        "line-width": 1
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [ "in", "class", "secondary", "tertiary" ],
      "paint": {
        "line-color": "hsl(220, 10%, 30%)",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          6,
          1,
          14,
          4
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [ "==", "class", "primary" ],
      "paint": {
        "line-color": "hsl(210, 20%, 42%)",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          6,
          1.5,
          14,
          6
        ]
      }
    },
    {
      "id": "road-construction",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [ "==", "class", "construction" ],
      "paint": {
        "line-color": "hsl(35, 80%, 45%)",
        "line-dasharray": [ 2, 2 ],
        "line-width": 2
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [ "==", "class", "motorway" ],
      "paint": {
        "line-color": "hsl(32, 95%, 50%)",
        "line-width": [
          "interpolate",
          [ "linear" ],
          [ "zoom" ],
          5,
          2,
          14,
          8
        ]
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "filter": [ "==", "class", "runway" ],
      "paint": {
        "line-color": "hsl(220, 10%, 25%)",
        "line-width": 4
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": "{name:latin}",
        "text-font": [ "Noto Sans Regular" ],
        "text-size": 12
      },
      "paint": {
        "text-color": "hsl(220, 15%, 85%)",
        "text-halo-color": "hsl(220, 15%, 8%)",
        "text-halo-width": 1.5
      }
    }
  ]
}