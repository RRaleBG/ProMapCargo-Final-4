{
  "mcpServers": {
    "github-mcp-server": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN:-}"
      }
    },
    "postgres": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "uvx", "postgres-mcp", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "${PROMAP_DATABASE_URI:-postgresql://promap:promap_dev_change_me@localhost:5432/promapcargo}"
      }
    },
    "mobile": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@mobilenext/mobile-mcp@latest"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
