<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProMapCargo.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProMapCargo.Mobile.Views"
    Title="ProMapCargo Mobile"
    Shell.NavBarIsVisible="False">

    <TabBar Route="dashboard">
        <ShellContent
            Title="Operations"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="dashboard-home" />
        <ShellContent
            Title="Navigation"
            ContentTemplate="{DataTemplate views:MobileNavigationPage}"
            Route="mobile-navigation" />
    </TabBar>

    <ShellContent
        Title="Install maps"
        ContentTemplate="{DataTemplate views:MapInstallPage}"
        Route="install-maps" />

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

</Shell>
