<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProMapCargo.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProMapCargo.Mobile.Views"
    Title="ProMap Cargo"
    Shell.NavBarIsVisible="False">

    <TabBar Route="dashboard">
        <ShellContent
            Title="Operacije"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Icon="ic_tab_operations.svg"
            Route="dashboard-home" />

        <ShellContent
            Title="Navigacija"
            ContentTemplate="{DataTemplate views:MobileNavigationPage}"
            Icon="ic_tab_navigation.svg"
            Route="mobile-navigation" />
    </TabBar>

    <ShellContent
        Title="Mape"
        ContentTemplate="{DataTemplate views:MapInstallPage}"
        Route="install-maps" />

    <ShellContent
        Title="Prijava"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Podešavanja"
        ContentTemplate="{DataTemplate views:SettingsPage}"
        Route="settings" />

</Shell>
