<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProMapCargo.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProMapCargo.Mobile.Views"
    Title="ProMap Cargo"
    Shell.NavBarIsVisible="False">

    <TabBar Route="dashboard">
        <ShellContent
            Title="Operacije"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Icon="ic_tab_operations.svg"
            Route="dashboard-home" />

        <ShellContent
            Title="Navigacija"
            ContentTemplate="{DataTemplate views:MobileNavigationPage}"
            Icon="ic_tab_navigation.svg"
            Route="mobile-navigation" />

        <!--
            Android shows at most 5 tab icons (more go under "Više"); Offline mape and
            Podešavanja open from Profil and the home screen tiles.
            Route "trip": "trip-details" is the pushed details page (AppShell.xaml.cs).
        -->
        <ShellContent
            Title="Tura"
            ContentTemplate="{DataTemplate views:TripDetailsPage}"
            Icon="ic_tab_trip.svg"
            Route="trip" />

        <ShellContent
            Title="Poruke"
            ContentTemplate="{DataTemplate views:MessagesPage}"
            Icon="ic_tab_messages.svg"
            Route="messages" />

        <ShellContent
            Title="Profil"
            ContentTemplate="{DataTemplate views:ProfilePage}"
            Icon="ic_tab_profile.svg"
            Route="profile" />
    </TabBar>

    <ShellContent
        Title="Mape"
        ContentTemplate="{DataTemplate views:MapInstallPage}"
        Route="install-maps" />

    <ShellContent
        Title="Prijava"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Podešavanja"
        ContentTemplate="{DataTemplate views:SettingsPage}"
        Route="settings" />

    <!--  Detalji ture: pushed page with ?tripId=, registered in AppShell.xaml.cs (a ShellContent too = "Duplicated route")  -->

</Shell>
