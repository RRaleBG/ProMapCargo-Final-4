<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.MobileNavigationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ProMapCargo.Mobile.Converters"
    xmlns:models="clr-namespace:ProMapCargo.Mobile.Models"
    Title="Navigacija"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <converters:ManeuverIconConverter x:Key="ManeuverIcon" />
    </ContentPage.Resources>
    <Grid BackgroundColor="{StaticResource SurfaceBase}">
        <WebView
            x:Name="NavigationWebView"
            BackgroundColor="{StaticResource SurfaceBase}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!--  Loading overlay  -->
        <Grid
            x:Name="LoadingOverlay"
            BackgroundColor="{StaticResource SurfaceScrim}"
            InputTransparent="False"
            IsVisible="True"
            ZIndex="100">
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="14"
                VerticalOptions="Center">
                <Border
                    Padding="16"
                    HeightRequest="68"
                    Style="{StaticResource PmMapGlassCard}"
                    WidthRequest="68">
                    <ActivityIndicator IsRunning="True" />
                </Border>
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PmSectionTitleLabel}"
                    Text="ProMap Cargo" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PmMutedLabel}"
                    Text="Pokretanje navigacije…" />
            </VerticalStackLayout>
        </Grid>

        <!--  Native overlays  -->
        <Grid
            Padding="16,14,16,20"
            CascadeInputTransparent="False"
            InputTransparent="True"
            RowDefinitions="Auto,*,Auto"
            ZIndex="20">

            <!--  Guidance banner (TomTom-style): maneuver icon + distance, road below, "then" on the right  -->
            <Border
                Grid.Row="0"
                Padding="0"
                InputTransparent="False"
                Style="{StaticResource PmMapGlassCard}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border
                        BackgroundColor="{StaticResource Brand}"
                        StrokeShape="RoundRectangle 19,0,19,0"
                        StrokeThickness="0"
                        WidthRequest="100">
                        <Path
                            Aspect="Uniform"
                            Data="{Binding NextManeuverKind, Converter={StaticResource ManeuverIcon}}"
                            Fill="{StaticResource BrandOn}"
                            HeightRequest="64"
                            HorizontalOptions="Center"
                            SemanticProperties.Description="{Binding NextManeuverType}"
                            VerticalOptions="Center"
                            WidthRequest="64" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Padding="16,12,8,12"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="36"
                            LineHeight="1"
                            Text="{Binding NextManeuverDistanceShort}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding NextManeuverRoad}"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="2"
                        Padding="0,12,14,12"
                        IsVisible="{Binding HasThenManeuver}"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource PmCaptionLabel}"
                            Text="zatim" />
                        <Border
                            BackgroundColor="{StaticResource SurfaceInset}"
                            HeightRequest="40"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            WidthRequest="40">
                            <Path
                                Aspect="Uniform"
                                Data="{Binding ThenManeuverKind, Converter={StaticResource ManeuverIcon}}"
                                Fill="{StaticResource TextPrimary}"
                                HeightRequest="24"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!--  Floating controls  -->
            <VerticalStackLayout
                Grid.Row="2"
                CascadeInputTransparent="False"
                InputTransparent="True"
                Spacing="10"
                VerticalOptions="End">
                <Grid ColumnDefinitions="Auto,*" InputTransparent="False">
                    <!--  Current speed bubble (bottom-left, like TomTom)  -->
                    <Border
                        BackgroundColor="{StaticResource MapGlass}"
                        HeightRequest="68"
                        IsVisible="{Binding HasRoute}"
                        Stroke="{StaticResource StrokeStrong}"
                        StrokeShape="Ellipse"
                        StrokeThickness="2"
                        VerticalOptions="End"
                        WidthRequest="68">
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                LineHeight="1"
                                Text="{Binding CurrentSpeedText}"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label
                                FontSize="10"
                                HorizontalTextAlignment="Center"
                                Text="km/h"
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="End"
                        Spacing="12">
                        <ImageButton
                            x:Name="RecenterButton"
                            Command="{Binding RerouteCommand}"
                            SemanticProperties.Description="Centriraj i ponovo izračunaj rutu"
                            Source="nav_recenter.svg"
                            Style="{StaticResource PmMapFloatingButton}" />
                        <ImageButton
                            x:Name="VoicePromptButton"
                            Command="{Binding SpeakNextPromptCommand}"
                            SemanticProperties.Description="Glasovno uputstvo"
                            Source="nav_voice.svg"
                            Style="{StaticResource PmMapFloatingButton}" />
                        <Button
                            Command="{Binding ToggleRouteInputCommand}"
                            Style="{StaticResource PmMapMiniButton}"
                            Text="{Binding RouteInputButtonText}" />
                    </VerticalStackLayout>
                </Grid>

                <Border
                    InputTransparent="False"
                    IsVisible="{Binding HasRoute}"
                    StrokeShape="RoundRectangle 18"
                    Style="{StaticResource PmMapGlassCard}">
                    <!--  Trip bar: arrival time · time left · distance left  -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Style="{StaticResource PmRouteDataCaption}" Text="DOLAZAK" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                Text="{Binding ArrivalTimeText}"
                                TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource PmRouteDataCaption}"
                                Text="PREOSTALO" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="{Binding RemainingTimeText}"
                                TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                            <Label
                                HorizontalTextAlignment="End"
                                Style="{StaticResource PmRouteDataCaption}"
                                Text="DO CILJA" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                HorizontalTextAlignment="End"
                                Text="{Binding RemainingDistanceText}"
                                TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!--  Route planning bottom sheet  -->
            <Border
                x:Name="RoutePopupPanel"
                Grid.Row="1"
                Grid.RowSpan="2"
                HorizontalOptions="Fill"
                InputTransparent="True"
                IsVisible="False"
                Opacity="0"
                StrokeShape="RoundRectangle 22,22,22,22"
                Style="{StaticResource PmBottomPanel}"
                TranslationY="28"
                VerticalOptions="End"
                ZIndex="30">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Style="{StaticResource PmSectionTitleLabel}"
                            Text="Planiranje rute"
                            VerticalTextAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding ToggleRouteInputCommand}"
                            Style="{StaticResource PmMapMiniButton}"
                            Text="Zatvori" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource PmFieldBorder}">
                            <Entry
                                Placeholder="Polazak (adresa ili mesto)"
                                Style="{StaticResource PmEntry}"
                                Text="{Binding StartQuery}" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Command="{Binding UseMyLocationCommand}"
                            Style="{StaticResource PmMapMiniButton}"
                            Text="Moja lokacija" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource PmFieldBorder}">
                            <Entry
                                Placeholder="Odredište (adresa ili mesto)"
                                Style="{StaticResource PmEntry}"
                                Text="{Binding DestinationQuery}" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Command="{Binding SwapPointsCommand}"
                            Style="{StaticResource PmMapMiniButton}"
                            Text="⇅" />
                    </Grid>

                    <ScrollView IsVisible="{Binding HasSuggestions}" MaximumHeightRequest="170">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GeocodeResult">
                                    <VerticalStackLayout Padding="6,8" Spacing="1">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnSuggestionTapped" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Style="{StaticResource PmRouteDataLabel}" Text="{Binding Title}" />
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Style="{StaticResource PmRouteDataCaption}"
                                            Text="{Binding Subtitle}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Switch IsToggled="{Binding AvoidRestricted}" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource PmRouteDataLabel}"
                            Text="Izbegavaj ograničene puteve"
                            VerticalTextAlignment="Center" />
                    </Grid>

                    <Label
                        FontSize="12"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource StatusDanger}" />

                    <Button
                        Command="{Binding CalculateRouteCommand}"
                        Style="{StaticResource PmPrimaryButton}"
                        Text="Izračunaj rutu" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
