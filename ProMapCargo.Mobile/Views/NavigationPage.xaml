<ContentPage
    x:Class="ProMapCargo.Mobile.Views.MobileNavigationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Navigacija"
    BackgroundColor="#031712"
    Shell.NavBarIsVisible="False">

    <Grid
        BackgroundColor="#031712"
        RowDefinitions="*">

        <!--
            MAUI je samo native host.

            Kompletan navigation UI:
            - mapa
            - truck routing
            - route planning
            - maneuvers
            - GPS
            - KRENI
            - ETA
            - rerouting
            - PMTiles
            - Web navigation UI

            nalazi se u WebView / web aplikaciji.
        -->

        <WebView
            x:Name="NavigationWebView"
            Grid.Row="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            BackgroundColor="#031712"
            IsVisible="True" />

        <!--
            Native loading overlay.
            Ostaje iznad WebView-a samo dok se stranica učitava.
        -->

        <Grid
            x:Name="LoadingOverlay"
            Grid.Row="0"
            BackgroundColor="#031712"
            InputTransparent="False"
            IsVisible="True"
            ZIndex="100">

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="14"
                VerticalOptions="Center">

                <ActivityIndicator
                    HeightRequest="42"
                    IsRunning="True"
                    WidthRequest="42"
                    Color="#10B981" />

                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    Text="ProMap Cargo"
                    TextColor="#ECFDF5" />

                <Label
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    Text="Učitavanje navigacije..."
                    TextColor="#6EE7B7" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
