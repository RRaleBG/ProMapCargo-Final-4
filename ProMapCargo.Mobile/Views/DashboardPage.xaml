<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Operacije"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsBusy, Mode=OneWay}"
        RefreshColor="{StaticResource Brand}">
        <ScrollView>
            <VerticalStackLayout
                Padding="20,24,20,32"
                MaximumWidthRequest="720"
                Spacing="22">

                <!--  Header  -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource PmPageTitleLabel}" Text="{Binding WelcomeText}" />
                        <Label Style="{StaticResource PmMutedLabel}" Text="{Binding StatusText}" />
                    </VerticalStackLayout>
                    <ImageButton
                        Grid.Column="1"
                        Clicked="OnOpenSettingsClicked"
                        Style="{StaticResource PmMapFloatingButton}"
                        BackgroundColor="{StaticResource SurfaceOverlay}"
                        SemanticProperties.Description="Podešavanja"
                        Source="ic_settings.svg"
                        VerticalOptions="Start" />
                </Grid>

                <!--  Hero: current route  -->
                <Border Style="{StaticResource PmHeroBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Style="{StaticResource PmHeroCaptionLabel}" Text="Aktivna ruta" />
                        <Label
                            LineBreakMode="WordWrap"
                            Style="{StaticResource PmSectionTitleLabel}"
                            Text="{Binding RouteSummary}" />
                        <FlexLayout Wrap="Wrap" AlignItems="Start" Direction="Row">
                            <Border Margin="0,0,8,8" Style="{StaticResource PmChipInfo}">
                                <Label Style="{StaticResource PmChipInfoLabel}" Text="{Binding RouteEngine}" />
                            </Border>
                            <Border Margin="0,0,8,8" Style="{StaticResource PmChip}">
                                <Label Style="{StaticResource PmChipLabel}" Text="{Binding RouteSafety}" />
                            </Border>
                        </FlexLayout>
                        <Button
                            Clicked="OnOpenNavigationClicked"
                            Style="{StaticResource PmPrimaryButton}"
                            Text="Otvori navigaciju" />
                    </VerticalStackLayout>
                </Border>

                <!--  KPI  -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Padding="14" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource PmValueLabel}" Text="{Binding Vehicles.Count}" />
                            <Label Style="{StaticResource PmCaptionLabel}" Text="Vozila" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="14" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource PmValueLabel}" Text="{Binding Orders.Count}" />
                            <Label Style="{StaticResource PmCaptionLabel}" Text="Nalozi" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="14" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource PmValueLabel}" Text="{Binding Trips.Count}" />
                            <Label Style="{StaticResource PmCaptionLabel}" Text="Ture" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Vozila" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vehicles}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,14"
                                    Style="{StaticResource PmMutedLabel}"
                                    Text="Nema vozila." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" >
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontFamily="OpenSansSemibold" Style="{StaticResource PmBodyLabel}" Text="{Binding Registration}" />
                                            <Label Style="{StaticResource PmMutedLabel}" Text="{Binding LastGpsAt, StringFormat='GPS {0:dd.MM. HH:mm}'}" />
                                        </VerticalStackLayout>
                                        <Border Style="{StaticResource PmChip}" VerticalOptions="Center" Grid.Column="1">
                                            <Label Style="{StaticResource PmChipLabel}" Text="{Binding Status}" />
                                        </Border>
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Transportni nalozi" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,14"
                                    Style="{StaticResource PmMutedLabel}"
                                    Text="Nema aktivnih naloga." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" >
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontFamily="OpenSansSemibold" Style="{StaticResource PmBodyLabel}" Text="{Binding OrderNumber}" />
                                            <Label Style="{StaticResource PmMutedLabel}" Text="{Binding CustomerName}" />
                                        </VerticalStackLayout>
                                        <Border Style="{StaticResource PmChip}" VerticalOptions="Center" Grid.Column="1">
                                            <Label Style="{StaticResource PmChipLabel}" Text="{Binding Status}" />
                                        </Border>
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Ture u toku" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Trips}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,14"
                                    Style="{StaticResource PmMutedLabel}"
                                    Text="Nema aktivnih tura." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" >
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontFamily="OpenSansSemibold" Style="{StaticResource PmBodyLabel}" Text="{Binding ExecutionState}" />
                                            <Label Style="{StaticResource PmMutedLabel}" Text="{Binding Status}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Style="{StaticResource PmAccentLabel}" Text="{Binding RouteProgressPercent, StringFormat='{0:0}%'}" VerticalOptions="Center" />
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Next maneuvers  -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Sledeći manevri" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RouteManeuvers}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,14"
                                    Style="{StaticResource PmMutedLabel}"
                                    Text="Izračunajte rutu da biste videli manevre." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,12" RowDefinitions="Auto,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                LineBreakMode="WordWrap"
                                                Style="{StaticResource PmBodyLabel}"
                                                Text="{Binding Instruction}" />
                                            <Label Style="{StaticResource PmAccentLabel}" Text="{Binding RoadName}" />
                                            <Label Style="{StaticResource PmMutedLabel}" Text="{Binding DistanceFromPreviousMeters, StringFormat='Za {0:0} m'}" />
                                        </VerticalStackLayout>
                                        <BoxView Grid.Row="1" Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Quick links  -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Brze akcije" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding QuickLinks}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontFamily="OpenSansSemibold" Style="{StaticResource PmBodyLabel}" Text="{Binding Title}" />
                                            <Label Style="{StaticResource PmMutedLabel}" Text="{Binding Description}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            Clicked="OnQuickLinkClicked"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource PmTonalButton}"
                                            Text="Otvori"
                                            VerticalOptions="Center" />
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Diagnostics (collapsed by default)  -->
                <VerticalStackLayout Spacing="10">
                    <Button
                        Clicked="OnToggleDiagnosticsClicked"
                        x:Name="DiagnosticsToggle"
                        Style="{StaticResource PmGhostButton}"
                        HorizontalOptions="Start"
                        Text="Prikaži dijagnostiku rute" />
                    <Border
                        x:Name="DiagnosticsPanel"
                        IsVisible="False"
                        Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="Sažetak" />
                                <Label LineBreakMode="WordWrap" Style="{StaticResource PmBodyLabel}" Text="{Binding RouteDiagnosticsSummary}" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource PmCaptionLabel}" Text="Početna tačka" />
                                    <Label LineBreakMode="WordWrap" Style="{StaticResource PmMutedLabel}" Text="{Binding RouteStartSnap}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Style="{StaticResource PmCaptionLabel}" Text="Krajnja tačka" />
                                    <Label LineBreakMode="WordWrap" Style="{StaticResource PmMutedLabel}" Text="{Binding RouteEndSnap}" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="Greške / provera" />
                                <Label LineBreakMode="WordWrap" Style="{StaticResource PmMutedLabel}" Text="{Binding RouteFailureReason}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RouteHighlights}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Label LineBreakMode="WordWrap" Style="{StaticResource PmMutedLabel}" Text="{Binding ., StringFormat='• {0}'}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
