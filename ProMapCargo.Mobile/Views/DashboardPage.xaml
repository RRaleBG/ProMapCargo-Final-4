<?xml version="1.0" encoding="utf-8" ?>
<!--
    Home screen modelled on TomTom GO Truck: search first ("Kuda idemo?"), recent
    destinations one tap away, the active route, the truck profile used for
    routing, and an icon menu. Fleet numbers are reduced to one line.
-->
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ProMapCargo.Mobile.Converters"
    Title="Operacije"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <converters:ManeuverIconConverter x:Key="ManeuverIcon" />

        <!--  Transparent button over a card: a tap gesture on a Border inside
              RefreshView/ScrollView does not fire on Android devices, a Button does.  -->
        <Style x:Key="HomeTapTarget" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Text" Value="" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>

        <Style x:Key="HomeCaption" BasedOn="{StaticResource PmCaptionLabel}" TargetType="Label">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!--  Menu tile: icon over label, tappable Border  -->
        <Style x:Key="HomeTile" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceOverlay}" />
            <Setter Property="Stroke" Value="{StaticResource StrokeSubtle}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HeightRequest" Value="78" />
        </Style>
        <Style x:Key="HomeTileIcon" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceInset}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>
        <Style x:Key="HomeTileLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="VerticalOptions" Value="End" />
        </Style>
    </ContentPage.Resources>

    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsPullRefreshing}"
        RefreshColor="{StaticResource Brand}">
        <ScrollView>
            <VerticalStackLayout
                Padding="16,14,16,24"
                MaximumWidthRequest="720"
                Spacing="16">

                <!--  Header  -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="22"
                            LineBreakMode="TailTruncation"
                            Text="{Binding WelcomeText}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding StatusText}"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <ImageButton
                        Grid.Column="1"
                        Padding="11"
                        BackgroundColor="{StaticResource SurfaceOverlay}"
                        BorderColor="{StaticResource StrokeSubtle}"
                        BorderWidth="1"
                        Clicked="OnOpenSettingsClicked"
                        CornerRadius="22"
                        HeightRequest="44"
                        SemanticProperties.Description="Podešavanja"
                        Source="ic_settings.svg"
                        VerticalOptions="Center"
                        WidthRequest="44" />
                </Grid>

                <!--  Search first, like TomTom: "Kuda idemo?"  -->
                <Border
                    Padding="18,0"
                    BackgroundColor="{StaticResource SurfaceOverlay}"
                    HeightRequest="56"
                    SemanticProperties.Description="Kuda idemo? Planiraj rutu"
                    Stroke="{StaticResource StrokeStrong}"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Path
                            Aspect="Uniform"
                            Data="F0 M10.5 3 A7.5 7.5 0 1 1 10.5 18 A7.5 7.5 0 1 1 10.5 3 Z M10.5 5 A5.5 5.5 0 1 0 10.5 16 A5.5 5.5 0 1 0 10.5 5 Z M15.6 14.2 L21 19.6 L19.6 21 L14.2 15.6 Z"
                            Fill="{StaticResource Brand}"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22" />
                        <Label
                            Grid.Column="1"
                            FontFamily="OpenSansSemibold"
                            FontSize="17"
                            Text="Kuda idemo?"
                            TextColor="{StaticResource TextSecondary}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            FontSize="20"
                            Text="›"
                            TextColor="{StaticResource TextTertiary}"
                            VerticalOptions="Center" />
                        <Button
                            Grid.ColumnSpan="3"
                            Margin="-18,0"
                            Clicked="OnSearchClicked"
                            SemanticProperties.Description="Kuda idemo? Planiraj rutu"
                            Style="{StaticResource HomeTapTarget}" />
                    </Grid>
                </Border>

                <!--  Recent destinations: one tap routes there from the current position  -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource HomeCaption}" Text="Nedavno" />
                    <Border Padding="14,2" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recents}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,12"
                                    FontSize="12"
                                    Text="Odredišta do kojih napravite rutu pojaviće se ovde."
                                    TextColor="{StaticResource TextSecondary}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="0,10"
                                        ColumnDefinitions="32,*,Auto"
                                        ColumnSpacing="12">
                                        <Border Style="{StaticResource HomeTileIcon}" VerticalOptions="Center">
                                            <Path
                                                Aspect="Uniform"
                                                Data="{Binding Source='arrive', Converter={StaticResource ManeuverIcon}}"
                                                Fill="{StaticResource Brand}"
                                                HeightRequest="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                WidthRequest="18" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="15"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Title}"
                                                TextColor="{StaticResource TextPrimary}" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding UsedAt, StringFormat='Ruta odavde · {0:dd.MM. HH:mm}'}"
                                                TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="2"
                                            FontSize="20"
                                            Text="›"
                                            TextColor="{StaticResource TextTertiary}"
                                            VerticalOptions="Center" />
                                        <Button
                                            Grid.ColumnSpan="3"
                                            Margin="0,-10"
                                            Clicked="OnRecentClicked"
                                            Style="{StaticResource HomeTapTarget}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Active route  -->
                <Border Padding="16,14" Style="{StaticResource PmHeroBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Style="{StaticResource PmHeroCaptionLabel}" Text="Aktivna ruta" VerticalOptions="Center" />
                            <Border Grid.Column="1" Padding="8,3" Style="{StaticResource PmChip}">
                                <Label Style="{StaticResource PmChipLabel}" Text="{Binding RouteSafety}" />
                            </Border>
                        </Grid>
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="17"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Text="{Binding RouteSummary}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Button
                            Clicked="OnOpenNavigationClicked"
                            CornerRadius="14"
                            HeightRequest="48"
                            Style="{StaticResource PmPrimaryButton}"
                            Text="Nastavi navigaciju" />
                    </VerticalStackLayout>
                </Border>

                <!--  Truck profile used for routing  -->
                <Border Padding="14,12" Style="{StaticResource PmCardBorder}">
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Border
                            BackgroundColor="{StaticResource SurfaceInset}"
                            HeightRequest="40"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            WidthRequest="40">
                            <Path
                                Aspect="Uniform"
                                Data="M7 2 L17 2 A3 3 0 0 1 20 5 L20 9 L4 9 L4 5 A3 3 0 0 1 7 2 Z M4 10 L20 10 L20 22 L4 22 Z"
                                Fill="{StaticResource Brand}"
                                HeightRequest="22"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                WidthRequest="22" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="Profil kamiona"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label
                                FontSize="12"
                                Text="{Binding TruckProfileText}"
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="2"
                            Padding="8,3"
                            Style="{StaticResource PmChipInfo}"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource PmChipInfoLabel}" Text="Podrazumevani" />
                        </Border>
                    </Grid>
                </Border>

                <!--  Icon menu  -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="10">
                    <Border Style="{StaticResource HomeTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource HomeTileIcon}">
                                <Image HeightRequest="18" Source="ic_tab_navigation.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource HomeTileLabel}" Text="Navigacija" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Clicked="OnTileNavigationClicked"
                                Style="{StaticResource HomeTapTarget}" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource HomeTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource HomeTileIcon}">
                                <Image HeightRequest="18" Source="ic_map.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource HomeTileLabel}" Text="Offline mape" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Clicked="OnTileMapsClicked"
                                Style="{StaticResource HomeTapTarget}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource HomeTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource HomeTileIcon}">
                                <Image HeightRequest="18" Source="ic_tab_operations.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource HomeTileLabel}" Text="Dispečing" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Clicked="OnTileDispatchClicked"
                                Style="{StaticResource HomeTapTarget}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HomeTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource HomeTileIcon}">
                                <Image HeightRequest="18" Source="ic_settings.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource HomeTileLabel}" Text="Podešavanja" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Clicked="OnTileSettingsClicked"
                                Style="{StaticResource HomeTapTarget}" />
                        </Grid>
                    </Border>
                </Grid>

                <!--  Fleet in one line  -->
                <Grid Padding="4,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Style="{StaticResource PmCaptionLabel}" Text="Flota" VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontSize="12"
                        HorizontalTextAlignment="End"
                        Text="{Binding FleetSummary}"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
