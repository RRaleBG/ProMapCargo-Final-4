<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Operations"
    BackgroundColor="#061B17">
    <Grid Padding="18,24" RowDefinitions="Auto,*">
        <VerticalStackLayout Spacing="4">
            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="{Binding WelcomeText}"
                TextColor="#ECFDF5" />
            <Label
                FontSize="13"
                Text="{Binding StatusText}"
                TextColor="#94A3B8" />
            <Label
                FontSize="13"
                Text="{Binding RouteSummary}"
                TextColor="#5EEAD4" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,20,0,20" Spacing="18">
                <Button
                    BackgroundColor="#10B981"
                    Command="{Binding RefreshCommand}"
                    CornerRadius="14"
                    HeightRequest="50"
                    Text="Refresh"
                    TextColor="#031712" />

                <Border
                    Padding="16"
                    BackgroundColor="#0B2D26"
                    Stroke="#1C5448"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="ProMapCargo Quick Links"
                            TextColor="#F8FAFC" />
                        <CollectionView
                            HeightRequest="300"
                            ItemsSource="{Binding QuickLinks}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                Text="{Binding Title}"
                                                TextColor="#ECFDF5" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding Description}"
                                                TextColor="#94A3B8" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            Padding="16,6"
                                            BackgroundColor="#145C4F"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLinkCommand}"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="10"
                                            Text="Open"
                                            TextColor="#ECFDF5" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="#0B2D26"
                    Stroke="#1C5448"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Monitoring"
                            TextColor="#F8FAFC" />
                        <CollectionView
                            HeightRequest="220"
                            ItemsSource="{Binding Vehicles}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                Text="{Binding Registration}"
                                                TextColor="#ECFDF5" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding Status}"
                                                TextColor="#94A3B8" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{Binding LastGpsAt}"
                                            TextColor="#5EEAD4" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="#0B2D26"
                    Stroke="#1C5448"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Dispatch"
                            TextColor="#F8FAFC" />
                        <CollectionView
                            HeightRequest="220"
                            ItemsSource="{Binding Orders}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                Text="{Binding OrderNumber}"
                                                TextColor="#ECFDF5" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding CustomerName}"
                                                TextColor="#94A3B8" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{Binding Status}"
                                            TextColor="#5EEAD4" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="#0B2D26"
                    Stroke="#1C5448"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="14">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Navigation"
                            TextColor="#F8FAFC" />

                        <Border
                            Padding="14"
                            BackgroundColor="#10382F"
                            Stroke="#145C4F"
                            StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding RouteSummary}"
                                    TextColor="#ECFDF5" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding RouteEngine}"
                                    TextColor="#5EEAD4" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding RouteSafety}"
                                    TextColor="#F8FAFC" />
                                <Label
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding RouteDiagnosticsSummary}"
                                    TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border
                                Padding="12"
                                BackgroundColor="#0E332B"
                                Stroke="#1C5448"
                                StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        FontSize="10"
                                        Text="START SNAP"
                                        TextColor="#7DD3FC" />
                                    <Label
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding RouteStartSnap}"
                                        TextColor="#E2E8F0" />
                                </VerticalStackLayout>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="12"
                                BackgroundColor="#0E332B"
                                Stroke="#1C5448"
                                StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        FontSize="10"
                                        Text="END SNAP"
                                        TextColor="#7DD3FC" />
                                    <Label
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding RouteEndSnap}"
                                        TextColor="#E2E8F0" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border
                            Padding="12"
                            BackgroundColor="#0E332B"
                            Stroke="#1C5448"
                            StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    FontSize="10"
                                    Text="FAILURE / REVIEW"
                                    TextColor="#FBBF24" />
                                <Label
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding RouteFailureReason}"
                                    TextColor="#F8FAFC" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Route Highlights"
                                TextColor="#F8FAFC" />
                            <CollectionView
                                HeightRequest="180"
                                ItemsSource="{Binding RouteHighlights}"
                                SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            BackgroundColor="#0E332B"
                                            Stroke="#1C5448"
                                            StrokeShape="RoundRectangle 12">
                                            <Label
                                                FontSize="12"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding .}"
                                                TextColor="#E2E8F0" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Next Maneuvers"
                                TextColor="#F8FAFC" />
                            <CollectionView
                                HeightRequest="220"
                                ItemsSource="{Binding RouteManeuvers}"
                                SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            BackgroundColor="#0E332B"
                                            Stroke="#1C5448"
                                            StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="4">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Instruction}"
                                                    TextColor="#ECFDF5" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding RoadName}"
                                                    TextColor="#5EEAD4" />
                                                <Label
                                                    FontSize="11"
                                                    Text="{Binding DistanceFromPreviousMeters, StringFormat='After {0:0} m'}"
                                                    TextColor="#94A3B8" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Trip Progress"
                                TextColor="#F8FAFC" />
                            <CollectionView
                                HeightRequest="220"
                                ItemsSource="{Binding Trips}"
                                SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    FontAttributes="Bold"
                                                    Text="{Binding ExecutionState}"
                                                    TextColor="#ECFDF5" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding Status}"
                                                    TextColor="#94A3B8" />
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding RouteProgressPercent, StringFormat='{0:0}%'}"
                                                TextColor="#5EEAD4" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
