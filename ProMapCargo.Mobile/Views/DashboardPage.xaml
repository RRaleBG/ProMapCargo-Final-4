<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ProMapCargo.Mobile.Converters"
    Title="Operacije"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <converters:ManeuverIconConverter x:Key="ManeuverIcon" />

        <!--  Compact section caption with a small count on the right  -->
        <Style x:Key="DashSectionCaption" BasedOn="{StaticResource PmCaptionLabel}" TargetType="Label">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!--  Dense list row inside a card  -->
        <Style x:Key="DashRowTitle" BasedOn="{StaticResource PmBodyLabel}" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="DashRowSub" BasedOn="{StaticResource PmMutedLabel}" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="DashEmpty" BasedOn="{StaticResource PmMutedLabel}" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,6" />
        </Style>

        <!--  Quick-action tile  -->
        <Style x:Key="DashTile" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceOverlay}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderColor" Value="{StaticResource StrokeSubtle}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
    </ContentPage.Resources>

    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsBusy, Mode=OneWay}"
        RefreshColor="{StaticResource Brand}">
        <ScrollView>
            <VerticalStackLayout
                Padding="16,14,16,24"
                MaximumWidthRequest="720"
                Spacing="14">

                <!--  Header: greeting + sync status, settings on the right  -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="22"
                            LineBreakMode="TailTruncation"
                            Text="{Binding WelcomeText}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding StatusText}"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <ImageButton
                        Grid.Column="1"
                        Padding="11"
                        BackgroundColor="{StaticResource SurfaceOverlay}"
                        BorderColor="{StaticResource StrokeSubtle}"
                        BorderWidth="1"
                        Clicked="OnOpenSettingsClicked"
                        CornerRadius="22"
                        HeightRequest="44"
                        SemanticProperties.Description="Podešavanja"
                        Source="ic_settings.svg"
                        VerticalOptions="Center"
                        WidthRequest="44" />
                </Grid>

                <!--  Active route: summary, chips and the main action in one compact card  -->
                <Border Padding="16,14" Style="{StaticResource PmHeroBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Style="{StaticResource PmHeroCaptionLabel}" Text="Aktivna ruta" VerticalOptions="Center" />
                            <Border Grid.Column="1" Padding="8,3" Style="{StaticResource PmChip}">
                                <Label Style="{StaticResource PmChipLabel}" Text="{Binding RouteSafety}" />
                            </Border>
                        </Grid>
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="17"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Text="{Binding RouteSummary}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                Text="{Binding RouteEngine}"
                                TextColor="{StaticResource StatusInfoStrong}"
                                VerticalOptions="Center" />
                            <Button
                                Grid.Column="1"
                                Padding="18,0"
                                Clicked="OnOpenNavigationClicked"
                                CornerRadius="12"
                                HeightRequest="44"
                                Style="{StaticResource PmPrimaryButton}"
                                Text="Navigacija →" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  KPI strip: three counts in one card  -->
                <Border Padding="0,10" Style="{StaticResource PmCardBorder}">
                    <Grid ColumnDefinitions="*,1,*,1,*">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Vehicles.Count}"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label HorizontalTextAlignment="Center" Style="{StaticResource PmCaptionLabel}" Text="Vozila" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="1" Style="{StaticResource PmDivider}" HeightRequest="-1" WidthRequest="1" />
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="0">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Orders.Count}"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label HorizontalTextAlignment="Center" Style="{StaticResource PmCaptionLabel}" Text="Nalozi" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="3" Style="{StaticResource PmDivider}" HeightRequest="-1" WidthRequest="1" />
                        <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="0">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Trips.Count}"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label HorizontalTextAlignment="Center" Style="{StaticResource PmCaptionLabel}" Text="Ture" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Next maneuvers: icon + instruction + distance per line  -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource DashSectionCaption}" Text="Sledeći manevri" />
                    <Border Padding="14,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RouteManeuvers}">
                            <BindableLayout.EmptyView>
                                <Label Style="{StaticResource DashEmpty}" Text="Izračunajte rutu da biste videli manevre." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="0,8"
                                        ColumnDefinitions="32,*,Auto"
                                        ColumnSpacing="10">
                                        <Border
                                            BackgroundColor="{StaticResource SurfaceInset}"
                                            HeightRequest="32"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            WidthRequest="32">
                                            <Path
                                                Aspect="Uniform"
                                                Data="{Binding Type, Converter={StaticResource ManeuverIcon}}"
                                                Fill="{StaticResource Brand}"
                                                HeightRequest="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                WidthRequest="18" />
                                        </Border>
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource DashRowTitle}"
                                            Text="{Binding Instruction}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontSize="12"
                                            Text="{Binding DistanceFromPreviousMeters, StringFormat='{0:0} m'}"
                                            TextColor="{StaticResource TextAccent}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Fleet: vehicles, orders and trips in one card  -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource DashSectionCaption}" Text="Flota" />
                    <Border Padding="14,8" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout Spacing="6">

                            <Label FontSize="11" Text="VOZILA" TextColor="{StaticResource TextTertiary}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vehicles}">
                                <BindableLayout.EmptyView>
                                    <Label Style="{StaticResource DashEmpty}" Text="Nema vozila." />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="0">
                                                <Label Style="{StaticResource DashRowTitle}" Text="{Binding Registration}" />
                                                <Label Style="{StaticResource DashRowSub}" Text="{Binding LastGpsAt, StringFormat='GPS {0:dd.MM. HH:mm}'}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" Padding="8,3" Style="{StaticResource PmChip}" VerticalOptions="Center">
                                                <Label Style="{StaticResource PmChipLabel}" Text="{Binding Status}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource PmDivider}" />

                            <Label FontSize="11" Text="NALOZI" TextColor="{StaticResource TextTertiary}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}">
                                <BindableLayout.EmptyView>
                                    <Label Style="{StaticResource DashEmpty}" Text="Nema aktivnih naloga." />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="0">
                                                <Label Style="{StaticResource DashRowTitle}" Text="{Binding OrderNumber}" />
                                                <Label Style="{StaticResource DashRowSub}" Text="{Binding CustomerName}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" Padding="8,3" Style="{StaticResource PmChip}" VerticalOptions="Center">
                                                <Label Style="{StaticResource PmChipLabel}" Text="{Binding Status}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource PmDivider}" />

                            <Label FontSize="11" Text="TURE U TOKU" TextColor="{StaticResource TextTertiary}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Trips}">
                                <BindableLayout.EmptyView>
                                    <Label Style="{StaticResource DashEmpty}" Text="Nema aktivnih tura." />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="0">
                                                <Label Style="{StaticResource DashRowTitle}" Text="{Binding ExecutionState}" />
                                                <Label Style="{StaticResource DashRowSub}" Text="{Binding Status}" />
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                Text="{Binding RouteProgressPercent, StringFormat='{0:0}%'}"
                                                TextColor="{StaticResource TextAccent}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Quick actions: compact tile grid  -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource DashSectionCaption}" Text="Brze akcije" />
                    <FlexLayout
                        AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding QuickLinks}"
                        Direction="Row"
                        JustifyContent="SpaceBetween"
                        Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,0,8"
                                    Clicked="OnQuickLinkClicked"
                                    CommandParameter="{Binding .}"
                                    FlexLayout.Basis="48.5%"
                                    Style="{StaticResource DashTile}"
                                    Text="{Binding Title}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!--  Diagnostics (collapsed by default)  -->
                <VerticalStackLayout Spacing="6">
                    <Button
                        x:Name="DiagnosticsToggle"
                        Padding="4,0"
                        Clicked="OnToggleDiagnosticsClicked"
                        FontSize="12"
                        HeightRequest="36"
                        HorizontalOptions="Start"
                        Style="{StaticResource PmGhostButton}"
                        Text="Prikaži dijagnostiku rute" />
                    <Border
                        x:Name="DiagnosticsPanel"
                        Padding="14,10"
                        IsVisible="False"
                        Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="Sažetak" />
                                <Label FontSize="13" LineBreakMode="WordWrap" Text="{Binding RouteDiagnosticsSummary}" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="0">
                                    <Label Style="{StaticResource PmCaptionLabel}" Text="Početna tačka" />
                                    <Label LineBreakMode="WordWrap" Style="{StaticResource DashRowSub}" MaxLines="3" Text="{Binding RouteStartSnap}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Label Style="{StaticResource PmCaptionLabel}" Text="Krajnja tačka" />
                                    <Label LineBreakMode="WordWrap" Style="{StaticResource DashRowSub}" MaxLines="3" Text="{Binding RouteEndSnap}" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="Greške / provera" />
                                <Label LineBreakMode="WordWrap" Style="{StaticResource DashRowSub}" MaxLines="3" Text="{Binding RouteFailureReason}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RouteHighlights}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Label FontSize="12" LineBreakMode="WordWrap" Text="{Binding ., StringFormat='• {0}'}" TextColor="{StaticResource TextSecondary}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
