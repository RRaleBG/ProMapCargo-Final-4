<?xml version="1.0" encoding="utf-8" ?>
<!--
    Home screen for the driver: search first ("Kuda idemo?"), then the driver's trip
    (next stop with arrival / completion, all stops, break, incident, dispatcher), recent
    destinations, truck profile, driving bans and the menu. The trip is the saved copy
    when there is no signal; the header says whether the app is online.
-->
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:ProMapCargo.Mobile.Services"
    xmlns:vm="clr-namespace:ProMapCargo.Mobile.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Title="Operacije"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">

    <RefreshView
        Command="{Binding RefreshCommand}"
        IsRefreshing="{Binding IsPullRefreshing}"
        RefreshColor="{StaticResource Brand}">
        <ScrollView>
            <VerticalStackLayout
                Padding="16,14,16,24"
                MaximumWidthRequest="720"
                Spacing="16">

                <!--  Header  -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="22"
                            LineBreakMode="TailTruncation"
                            SemanticProperties.HeadingLevel="Level1"
                            Text="{Binding WelcomeText}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Style="{StaticResource PmRowDetailLabel}"
                            Text="{Binding StatusText}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        Padding="10,5"
                        Style="{StaticResource PmChip}"
                        VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger
                                Binding="{Binding IsOffline}"
                                TargetType="Border"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource StatusWarningBg}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6">
                            <Ellipse
                                Fill="{StaticResource StatusSuccess}"
                                HeightRequest="7"
                                VerticalOptions="Center"
                                WidthRequest="7">
                                <Ellipse.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsOffline}"
                                        TargetType="Ellipse"
                                        Value="True">
                                        <Setter Property="Fill" Value="{StaticResource StatusWarning}" />
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Label Style="{StaticResource PmChipLabel}" Text="{Binding ConnectionText}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsOffline}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource StatusWarning}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                    <ImageButton
                        Grid.Column="2"
                        Padding="11"
                        BackgroundColor="{StaticResource SurfaceOverlay}"
                        BorderColor="{StaticResource StrokeSubtle}"
                        BorderWidth="1"
                        Clicked="OnOpenSettingsClicked"
                        CornerRadius="22"
                        HeightRequest="44"
                        SemanticProperties.Description="Podešavanja"
                        Source="ic_settings.svg"
                        VerticalOptions="Center"
                        WidthRequest="44" />
                </Grid>

                <!--  Search first, like TomTom: "Kuda idemo?"  -->
                <Border
                    Padding="18,0"
                    BackgroundColor="{StaticResource SurfaceOverlay}"
                    HeightRequest="56"
                    SemanticProperties.Description="Kuda idemo? Planiraj rutu"
                    Stroke="{StaticResource StrokeStrong}"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Path
                            Aspect="Uniform"
                            Data="F0 M10.5 3 A7.5 7.5 0 1 1 10.5 18 A7.5 7.5 0 1 1 10.5 3 Z M10.5 5 A5.5 5.5 0 1 0 10.5 16 A5.5 5.5 0 1 0 10.5 5 Z M15.6 14.2 L21 19.6 L19.6 21 L14.2 15.6 Z"
                            Fill="{StaticResource Brand}"
                            HeightRequest="22"
                            VerticalOptions="Center"
                            WidthRequest="22" />
                        <Label
                            Grid.Column="1"
                            FontFamily="OpenSansSemibold"
                            FontSize="17"
                            Text="Kuda idemo?"
                            TextColor="{StaticResource TextSecondary}"
                            VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource PmChevronLabel}" />
                        <Button
                            Grid.ColumnSpan="3"
                            Margin="-18,0"
                            Clicked="OnSearchClicked"
                            SemanticProperties.Description="Kuda idemo? Planiraj rutu"
                            Style="{StaticResource PmTapTarget}" />
                    </Grid>
                </Border>

                <!--  ===== Trip =====  -->

                <!--  Not signed in  -->
                <Border IsVisible="{Binding ShowSignIn}" Style="{StaticResource PmHeroBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource PmHeroCaptionLabel}" Text="Moja tura" />
                        <Label Style="{StaticResource PmSectionTitleLabel}" Text="Prijavite se kao vozač" />
                        <Label Style="{StaticResource PmMutedLabel}" Text="Posle prijave ovde su vaša tura i stanice, a dispečer vidi gde je kamion. Navigacija i offline mape rade i bez prijave." />
                        <Button
                            Command="{Binding SignInCommand}"
                            Style="{StaticResource PmPrimaryButton}"
                            Text="Prijavi se" />
                    </VerticalStackLayout>
                </Border>

                <!--  Signed in, but not as a driver (dispatcher, administrator)  -->
                <Border IsVisible="{Binding ShowNotDriver}" Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource PmRowTitleLabel}" Text="Nalog nije povezan sa vozačem" />
                        <Label Style="{StaticResource PmMutedLabel}" Text="Ture se prikazuju nalozima vozača. Dispečing i praćenje flote su na web portalu." />
                        <Label
                            IsVisible="{Binding HasFleetSummary}"
                            Style="{StaticResource PmAccentLabel}"
                            Text="{Binding FleetSummary}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Driver without a trip  -->
                <Border IsVisible="{Binding ShowNoTrip}" Style="{StaticResource PmCardBorder}">
                    <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                        <Border Style="{StaticResource PmRowIcon}">
                            <Image HeightRequest="20" Source="ic_tab_operations.svg" WidthRequest="20" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource PmRowTitleLabel}" Text="Nemate dodeljenu turu" />
                            <Label Style="{StaticResource PmRowDetailLabel}" Text="Kad vam dispečer dodeli turu, pojaviće se ovde. Povucite nadole za osvežavanje." />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  The driver's trip  -->
                <Border IsVisible="{Binding HasTrip}" Style="{StaticResource PmHeroBorder}">
                    <VerticalStackLayout Spacing="14">

                        <!--  Title, status, progress  -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label
                                    Style="{StaticResource PmHeroCaptionLabel}"
                                    Text="{Binding TripTitle}"
                                    VerticalOptions="Center" />
                                <Border
                                    Grid.Column="1"
                                    Padding="10,4"
                                    Style="{StaticResource PmChipNeutral}">
                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsTripActive}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusSuccessBg}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsTripPaused}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusWarningBg}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Style="{StaticResource PmChipNeutralLabel}" Text="{Binding TripStatusText}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsTripActive}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource StatusSuccess}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding IsTripPaused}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource StatusWarning}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding TripRoute}"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label
                                IsVisible="{Binding TripDetailText, Converter={StaticResource StringNotEmptyConverter}}"
                                Style="{StaticResource PmRowDetailLabel}"
                                Text="{Binding TripDetailText}" />
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="10"
                                Margin="0,4,0,0">
                                <Border Style="{StaticResource PmProgressTrack}" VerticalOptions="Center">
                                    <Border
                                        AnchorX="0"
                                        ScaleX="{Binding TripProgress}"
                                        StrokeShape="RoundRectangle 3"
                                        StrokeThickness="0">
                                        <Border.Background>
                                            <LinearGradientBrush EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#10B981" />
                                                <GradientStop Offset="1" Color="#2DD4BF" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <Label
                                    Grid.Column="1"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    Text="{Binding TripProgressText}"
                                    TextColor="{StaticResource TextAccent}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!--  Route sent by dispatch, waiting for the driver's answer  -->
                        <Border
                            Padding="14,12"
                            IsVisible="{Binding HasPendingRoute}"
                            Style="{StaticResource PmCardInnerBorder}">
                            <VerticalStackLayout Spacing="10">
                                <Label Style="{StaticResource PmBodyLabel}" Text="{Binding PendingRouteText}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button
                                        Clicked="OnRejectRouteClicked"
                                        Style="{StaticResource PmDangerButton}"
                                        Text="Odbij" />
                                    <Button
                                        Grid.Column="1"
                                        Clicked="OnAcceptRouteClicked"
                                        HeightRequest="44"
                                        Style="{StaticResource PmPrimaryButton}"
                                        Text="Prihvati" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!--  Trip not started yet  -->
                        <Button
                            Clicked="OnStartTripClicked"
                            IsVisible="{Binding IsTripPlanned}"
                            Style="{StaticResource PmPrimaryButton}"
                            Text="Započni turu" />

                        <!--  Next stop  -->
                        <Border
                            Padding="14,12"
                            IsVisible="{Binding HasNextStop}"
                            Style="{StaticResource PmCardInnerBorder}">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource PmCaptionLabel}" Text="Sledeća stanica" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="17"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding NextStopTitle}"
                                        TextColor="{StaticResource TextPrimary}" />
                                    <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding NextStopDetail}" />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button
                                        Command="{Binding NavigateToNextStopCommand}"
                                        IsEnabled="{Binding CanNavigateToNextStop}"
                                        Style="{StaticResource PmCardActionButton}"
                                        Text="Navigacija" />
                                    <Button
                                        Grid.Column="1"
                                        Clicked="OnNextStopActionClicked"
                                        HeightRequest="44"
                                        Style="{StaticResource PmPrimaryButton}"
                                        Text="{Binding NextStopActionText}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!--  All stops as a timeline  -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stops}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TripStopItem">
                                    <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="12">
                                        <!--  Line to the next stop  -->
                                        <BoxView
                                            Margin="0,18,0,0"
                                            HorizontalOptions="Center"
                                            Color="{StaticResource StrokeStrong}"
                                            WidthRequest="2">
                                            <BoxView.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsLast}"
                                                    TargetType="BoxView"
                                                    Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </BoxView.Triggers>
                                        </BoxView>
                                        <Ellipse
                                            Margin="0,4,0,0"
                                            Fill="{StaticResource SurfaceInset}"
                                            HeightRequest="14"
                                            HorizontalOptions="Center"
                                            Stroke="{StaticResource StrokeField}"
                                            StrokeThickness="2"
                                            VerticalOptions="Start"
                                            WidthRequest="14">
                                            <Ellipse.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsDone}"
                                                    TargetType="Ellipse"
                                                    Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brand}" />
                                                    <Setter Property="Stroke" Value="{StaticResource Brand}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsNext}"
                                                    TargetType="Ellipse"
                                                    Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource Secondary}" />
                                                    <Setter Property="Fill" Value="{StaticResource SurfaceBase}" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Padding="0,0,0,14"
                                            Spacing="1">
                                            <Label Style="{StaticResource PmRowTitleLabel}" Text="{Binding Title}">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsDone}"
                                                        TargetType="Label"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding Detail}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="2"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            Text="{Binding StatusText}"
                                            TextColor="{StaticResource TextTertiary}"
                                            VerticalOptions="Start">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsNext}"
                                                    TargetType="Label"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource TextAccent}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsDone}"
                                                    TargetType="Label"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusSuccess}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!--  Break, incident, dispatcher  -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button
                                Clicked="OnPauseClicked"
                                IsEnabled="{Binding CanPause}"
                                Style="{StaticResource PmCardActionButton}"
                                Text="{Binding PauseButtonText}" />
                            <Button
                                Grid.Column="1"
                                Clicked="OnIncidentClicked"
                                Style="{StaticResource PmDangerButton}"
                                Text="Incident" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding CallDispatchCommand}"
                                Style="{StaticResource PmCardActionButton}"
                                Text="Dispečer" />
                        </Grid>

                        <Button
                            Clicked="OnAddExpenseClicked"
                            Style="{StaticResource PmPrimaryButton}"
                            Text="Dodaj trošak ture" />

                        <Border Padding="14,12" Style="{StaticResource PmCardInnerBorder}">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="NAPOMENE" />
                                <Label Style="{StaticResource PmBodyLabel}" Text="{Binding TripNotesText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="14,12" Style="{StaticResource PmCardInnerBorder}">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="Troškovi i zarada" />
                                <Label Style="{StaticResource PmBodyLabel}" Text="{Binding TripFinancialSummary}" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding TripEarningsSummary}" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding CostLedgerSummary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="14,12" Style="{StaticResource PmCardInnerBorder}">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="EU 90/180" />
                                <Label Style="{StaticResource PmBodyLabel}" Text="{Binding EuStaySummary}" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding EuStayDetailText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="14,12" Style="{StaticResource PmCardInnerBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="Moje ture" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DriverTrips}" Spacing="10">
                                    <BindableLayout.EmptyView>
                                        <Label Style="{StaticResource PmBodyLabel}" Text="Nema evidentiranih tura za ovog vozača." />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DriverTripListItem">
                                            <Border Padding="12,10" Style="{StaticResource PmCardInnerBorder}">
                                                <Grid>
                                                    <VerticalStackLayout Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <Label Style="{StaticResource PmRowTitleLabel}" Text="{Binding Title}" />
                                                            <Border Grid.Column="1" Padding="8,3" Style="{StaticResource PmChipNeutral}">
                                                                <Label Style="{StaticResource PmChipNeutralLabel}" Text="{Binding StatusText}" />
                                                            </Border>
                                                        </Grid>
                                                        <Label Style="{StaticResource PmBodyLabel}" Text="{Binding Route}" />
                                                        <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding TimelineText}" />
                                                        <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding FinancialText}" />
                                                        <Label IsVisible="{Binding IsCurrent}" Style="{StaticResource PmAccentLabel}" Text="Aktivna tura na početnoj strani" />
                                                    </VerticalStackLayout>
                                                    <Button
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenTripDetailsCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Margin="-12,-10"
                                                        SemanticProperties.Description="Otvori detalje ture"
                                                        Style="{StaticResource PmTapTarget}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="14,12" Style="{StaticResource PmCardInnerBorder}">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource PmCaptionLabel}" Text="Vozilo i popravke" />
                                <Label Style="{StaticResource PmBodyLabel}" Text="{Binding VehicleRepairsSummary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--  GPS for dispatch, and how fresh the trip is  -->
                        <BoxView Style="{StaticResource PmDivider}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Ellipse
                                Fill="{StaticResource StatusSuccess}"
                                HeightRequest="8"
                                VerticalOptions="Center"
                                WidthRequest="8" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding GpsStatusText}" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding PortalUpdatedText}"
                                    TextColor="{StaticResource TextTertiary}" />
                            </VerticalStackLayout>
                        </Grid>
                        <ActivityIndicator
                            HeightRequest="24"
                            IsRunning="{Binding IsActionRunning}"
                            IsVisible="{Binding IsActionRunning}"
                            Color="{StaticResource Brand}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Recent destinations: one tap routes there from the current position  -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource PmSectionCaption}" Text="Nedavno" />
                    <Border Padding="14,2" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recents}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,12"
                                    Style="{StaticResource PmRowDetailLabel}"
                                    Text="Odredišta do kojih napravite rutu pojaviće se ovde." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:RecentDestination">
                                    <Grid
                                        Padding="0,10"
                                        ColumnDefinitions="32,*,Auto"
                                        ColumnSpacing="12">
                                        <Border Style="{StaticResource PmTileIcon}" VerticalOptions="Center">
                                            <!--  Destination pin  -->
                                            <Image HeightRequest="18" HorizontalOptions="Center" Source="ic_pin.svg" VerticalOptions="Center" WidthRequest="18" />
                                        </Border>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="0"
                                            VerticalOptions="Center">
                                            <Label Style="{StaticResource PmRowTitleLabel}" Text="{Binding Title}" />
                                            <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding UsedAt, StringFormat='Ruta odavde · {0:dd.MM. HH:mm}'}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Style="{StaticResource PmChevronLabel}" />
                                        <Button
                                            Grid.ColumnSpan="3"
                                            Margin="0,-10"
                                            Clicked="OnRecentClicked"
                                            Style="{StaticResource PmTapTarget}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Truck profile used for routing  -->
                <Border Padding="14,12" Style="{StaticResource PmCardBorder}">
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource PmRowIcon}">
                            <Image HeightRequest="22" HorizontalOptions="Center" Source="ic_truck.svg" VerticalOptions="Center" WidthRequest="22" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource PmRowTitleLabel}" Text="Profil kamiona" />
                            <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding TruckProfileText}" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="2"
                            Padding="8,3"
                            Style="{StaticResource PmChipInfo}"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource PmChipInfoLabel}" Text="{Binding TruckProfileBadge}" />
                        </Border>
                    </Grid>
                </Border>

                <!--  Truck driving bans  -->
                <Border Padding="14,12" Style="{StaticResource PmCardBorder}">
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource PmRowIcon}">
                            <!--  Stop sign  -->
                            <Image HeightRequest="22" HorizontalOptions="Center" Source="ic_ban.svg" VerticalOptions="Center" WidthRequest="22" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource PmRowTitleLabel}" Text="Zabrane vožnje" />
                            <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding TruckBansSummary}" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="2"
                            Padding="8,3"
                            Style="{StaticResource PmChipInfo}"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource PmChipInfoLabel}" Text="{Binding TruckBansBadge}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding TruckBanActiveNow}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource StatusDanger}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Button
                            Grid.ColumnSpan="3"
                            Margin="-14,-12"
                            Clicked="OnTruckBansClicked"
                            SemanticProperties.Description="Zabrane vožnje kamiona"
                            Style="{StaticResource PmTapTarget}" />
                    </Grid>
                </Border>

                <!--  Troškovi: list, scan a receipt, new expense  -->
                <Border Padding="14,12" Style="{StaticResource PmCardBorder}">
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource PmRowIcon}">
                            <Image HeightRequest="22" Source="ic_receipt.svg" WidthRequest="22" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource PmRowTitleLabel}" Text="Troškovi" />
                            <Label Style="{StaticResource PmRowDetailLabel}" Text="Gorivo, putarine, računi · slikajte račun" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource PmChevronLabel}" />
                        <Button
                            Grid.ColumnSpan="3"
                            Margin="-14,-12"
                            Clicked="OnExpensesClicked"
                            SemanticProperties.Description="Troškovi"
                            Style="{StaticResource PmTapTarget}" />
                    </Grid>
                </Border>

                <!--  Menu  -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="10">
                    <Border Style="{StaticResource PmTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource PmTileIcon}">
                                <Image HeightRequest="18" Source="ic_tab_navigation.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource PmTileLabel}" Text="Navigacija" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Clicked="OnTileNavigationClicked"
                                SemanticProperties.Description="Navigacija"
                                Style="{StaticResource PmTapTarget}" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PmTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource PmTileIcon}">
                                <Image HeightRequest="18" Source="ic_map.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource PmTileLabel}" Text="Offline mape" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Clicked="OnTileMapsClicked"
                                SemanticProperties.Description="Offline mape"
                                Style="{StaticResource PmTapTarget}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource PmTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource PmTileIcon}">
                                <Image HeightRequest="18" Source="ic_phone.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource PmTileLabel}" Text="Pozovi dispečera" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Command="{Binding CallDispatchCommand}"
                                SemanticProperties.Description="Pozovi dispečera"
                                Style="{StaticResource PmTapTarget}" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PmTile}">
                        <Grid RowDefinitions="*,Auto">
                            <Border Style="{StaticResource PmTileIcon}">
                                <Image HeightRequest="18" Source="ic_settings.svg" WidthRequest="18" />
                            </Border>
                            <Label Grid.Row="1" Style="{StaticResource PmTileLabel}" Text="Podešavanja" />
                            <Button
                                Grid.RowSpan="2"
                                Margin="-14,-12"
                                Clicked="OnOpenSettingsClicked"
                                SemanticProperties.Description="Podešavanja"
                                Style="{StaticResource PmTapTarget}" />
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
