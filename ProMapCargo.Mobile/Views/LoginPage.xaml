<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign in"
    BackgroundColor="{StaticResource SurfaceBase}">
    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource PmPageTitleLabel}" Text="ProMap Cargo" />
                <Label
                    FontSize="14"
                    Style="{StaticResource PmMutedLabel}"
                    Text="Native operations access for Navigation, Monitoring, and Dispatch." />
                <Label
                    FontSize="12"
                    Text="Use a valid ProMapCargo account from the API system (no default seeded mobile user)."
                    TextColor="#7DD3FC" />
            </VerticalStackLayout>

            <Border
                Padding="20"
                StrokeShape="RoundRectangle 20"
                Style="{StaticResource PmCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Mobile token login"
                        TextColor="#F8FAFC" />

                    <Entry
                        Keyboard="Email"
                        Placeholder="Email"
                        PlaceholderColor="#64748B"
                        Text="{Binding Email}"
                        TextColor="#F8FAFC" />

                    <Entry
                        IsPassword="True"
                        Placeholder="Password"
                        PlaceholderColor="#64748B"
                        Text="{Binding Password}"
                        TextColor="#F8FAFC" />

                    <Label
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        Text="{Binding ErrorMessage}"
                        TextColor="#FB7185" />

                    <Button
                        Command="{Binding LoginCommand}"
                        HeightRequest="52"
                        Style="{StaticResource PmPrimaryButton}"
                        Text="Sign in" />

                    <ActivityIndicator
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="#5EEAD4" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
