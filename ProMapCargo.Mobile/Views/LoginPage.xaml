<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign in"
    BackgroundColor="#061B17">
    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="ProMap Cargo"
                    TextColor="#ECFDF5" />
                <Label
                    FontSize="14"
                    Text="Native operations access for Navigation, Monitoring, and Dispatch."
                    TextColor="#94A3B8" />
            </VerticalStackLayout>

            <Border
                Padding="20"
                BackgroundColor="#0B2D26"
                Stroke="#1C5448"
                StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Mobile token login"
                        TextColor="#F8FAFC" />

                    <Entry
                        Keyboard="Email"
                        Placeholder="Email"
                        PlaceholderColor="#64748B"
                        Text="{Binding Email}"
                        TextColor="#F8FAFC" />

                    <Entry
                        IsPassword="True"
                        Placeholder="Password"
                        PlaceholderColor="#64748B"
                        Text="{Binding Password}"
                        TextColor="#F8FAFC" />

                    <Label
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        Text="{Binding ErrorMessage}"
                        TextColor="#FB7185" />

                    <Button
                        BackgroundColor="#10B981"
                        Command="{Binding LoginCommand}"
                        CornerRadius="14"
                        HeightRequest="52"
                        Text="Sign in"
                        TextColor="#031712" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
