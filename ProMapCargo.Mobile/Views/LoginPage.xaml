<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Prijava"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="24,56,24,32"
            MaximumWidthRequest="480"
            Spacing="28">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                <Image
                    HeightRequest="88"
                    SemanticProperties.Description="ProMap Cargo logo"
                    Source="splash.svg"
                    WidthRequest="88" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PmPageTitleLabel}"
                    Text="ProMap Cargo" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PmMutedLabel}"
                    Text="Navigacija i dispečing za teretni transport" />
            </VerticalStackLayout>

            <Border Style="{StaticResource PmCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Prijavite se" />

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource PmCaptionLabel}" Text="E-pošta" />
                        <Border Style="{StaticResource PmFieldBorder}">
                            <Entry
                                Keyboard="Email"
                                Placeholder="ime@firma.rs"
                                SemanticProperties.Description="E-pošta"
                                Style="{StaticResource PmEntry}"
                                Text="{Binding Email}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource PmCaptionLabel}" Text="Lozinka" />
                        <Border Style="{StaticResource PmFieldBorder}">
                            <Entry
                                IsPassword="True"
                                Placeholder="••••••••"
                                ReturnCommand="{Binding LoginCommand}"
                                ReturnType="Go"
                                SemanticProperties.Description="Lozinka"
                                Style="{StaticResource PmEntry}"
                                Text="{Binding Password}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        Style="{StaticResource PmChipWarning}"
                        HorizontalOptions="Fill"
                        Padding="12,10">
                        <Label Style="{StaticResource PmErrorLabel}" Text="{Binding ErrorMessage}" />
                    </Border>

                    <Button
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PmPrimaryButton}"
                        Text="Prijavi se" />

                    <ActivityIndicator
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource PmMutedLabel}"
                Text="Koristite nalog kreiran u ProMap Cargo sistemu." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
