<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.MapInstallPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ProMapCargo.Mobile.Models"
    Title="Install maps"
    BackgroundColor="#061B17">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="18,22" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Install maps" FontAttributes="Bold" FontSize="28" TextColor="#ECFDF5" />
            <Label Text="Download self-hosted country PMTiles packages for offline map usage." FontSize="13" TextColor="#94A3B8" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Padding="10" BackgroundColor="#0B2D26" Stroke="#1C5448" StrokeShape="RoundRectangle 12">
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#5EEAD4" />
                <Label Text="{Binding StatusText}" TextColor="#F8FAFC" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Padding="10" BackgroundColor="#0B2D26" Stroke="#1C5448" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout>
                    <Label Text="Available packages" FontAttributes="Bold" FontSize="15" TextColor="#ECFDF5" Margin="0,0,0,8" />
                    <CollectionView ItemsSource="{Binding AvailablePackages}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MapPackageCatalogItem">
                                <Border Padding="8" Margin="0,0,0,8" BackgroundColor="#0D3A31" Stroke="#155E52" StrokeShape="RoundRectangle 10">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="4">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="#ECFDF5" />
                                        <Button Grid.Row="0" Grid.Column="1" Text="Install" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InstallCommand}" CommandParameter="{Binding .}" BackgroundColor="#10B981" TextColor="#031712" CornerRadius="10" HeightRequest="36" />
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FileName}" FontSize="11" TextColor="#94A3B8" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Padding="10" BackgroundColor="#0B2D26" Stroke="#1C5448" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout>
                    <Label Text="Installed packages" FontAttributes="Bold" FontSize="15" TextColor="#ECFDF5" Margin="0,0,0,8" />
                    <CollectionView ItemsSource="{Binding InstalledPackages}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:InstalledMapPackage">
                                <Border Padding="8" Margin="0,0,0,8" BackgroundColor="#0D3A31" Stroke="#155E52" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="#ECFDF5" />
                                        <Label Text="{Binding FileName}" FontSize="11" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <HorizontalStackLayout Grid.Row="3" Spacing="12" HorizontalOptions="End">
            <Button Text="Refresh" Command="{Binding RefreshCommand}" BackgroundColor="#1F2937" TextColor="#E2E8F0" CornerRadius="12" HeightRequest="44" />
            <Button Text="Continue" Command="{Binding ContinueCommand}" BackgroundColor="#10B981" TextColor="#031712" CornerRadius="12" HeightRequest="44" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
