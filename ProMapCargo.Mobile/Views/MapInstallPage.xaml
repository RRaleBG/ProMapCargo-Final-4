<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.MapInstallPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ProMapCargo.Mobile.Models"
    Title="Mape"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">

        <ScrollView>
            <VerticalStackLayout
                Padding="20,28,20,24"
                MaximumWidthRequest="720"
                Spacing="20">

                <!--  Header  -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border
                        BackgroundColor="{StaticResource StatusSuccessBg}"
                        HeightRequest="56"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 18"
                        WidthRequest="56">
                        <Image
                            HeightRequest="28"
                            HorizontalOptions="Center"
                            Source="ic_map.svg"
                            VerticalOptions="Center"
                            WidthRequest="28" />
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label Style="{StaticResource PmPageTitleLabel}" Text="Offline mape" />
                        <Label Style="{StaticResource PmMutedLabel}" Text="Preuzmite mape i pakete za rad bez interneta." />
                    </VerticalStackLayout>
                </Grid>

                <!--  Status  -->
                <Border Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ActivityIndicator
                                HeightRequest="22"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                VerticalOptions="Center"
                                WidthRequest="22" />
                            <Label
                                Grid.Column="1"
                                FontFamily="OpenSansSemibold"
                                Style="{StaticResource PmBodyLabel}"
                                Text="{Binding StatusText}"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource PmDivider}" />
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource PmCaptionLabel}" Text="Spremnost offline rutiranja" />
                            <Label Style="{StaticResource PmAccentLabel}" Text="{Binding BundleStatusText}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  Available maps  -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Dostupne mape" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailablePackages}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,14"
                                    Style="{StaticResource PmMutedLabel}"
                                    Text="Nema dostupnih mapa. Osvežite listu." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MapPackageCatalogItem">
                                    <Grid
                                        Padding="0,12"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                Style="{StaticResource PmBodyLabel}"
                                                Text="{Binding DisplayName}" />
                                            <Label
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource PmMutedLabel}"
                                                Text="{Binding FileName}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            Clicked="OnInstallClicked"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource PmTonalButton}"
                                            Text="Preuzmi"
                                            VerticalOptions="Center" />
                                        <BoxView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Installed maps  -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Instalirane mape" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding InstalledPackages}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,14"
                                    Style="{StaticResource PmMutedLabel}"
                                    Text="Još nema instaliranih mapa." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:InstalledMapPackage">
                                    <Grid
                                        Padding="0,12"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                Style="{StaticResource PmBodyLabel}"
                                                Text="{Binding DisplayName}" />
                                            <Label
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource PmMutedLabel}"
                                                Text="{Binding FileName}" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource PmChip}"
                                            VerticalOptions="Center">
                                            <Label Style="{StaticResource PmChipLabel}" Text="Instalirano" />
                                        </Border>
                                        <BoxView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--  Routing bundles  -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PmSectionTitleLabel}" Text="Paketi za rutiranje" />
                    <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailableBundles}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Padding="0,14"
                                    Style="{StaticResource PmMutedLabel}"
                                    Text="Nema dostupnih paketa." />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OfflineRoutingBundleCatalogItem">
                                    <Grid
                                        Padding="0,12"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                Style="{StaticResource PmBodyLabel}"
                                                Text="{Binding DisplayName}" />
                                            <Label Style="{StaticResource PmMutedLabel}" Text="{Binding Version, StringFormat='Verzija {0}'}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            Clicked="OnInstallBundleClicked"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource PmTonalButton}"
                                            Text="Instaliraj"
                                            VerticalOptions="Center" />
                                        <BoxView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource PmDivider}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Bottom action bar  -->
        <Border
            Grid.Row="1"
            Padding="16,12,16,16"
            BackgroundColor="{StaticResource SurfaceElevated}"
            Stroke="{StaticResource StrokeSubtle}"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PmGhostButton}"
                    Text="Osveži" />
                <Button
                    Grid.Column="1"
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource PmGhostButton}"
                    Text="Podešavanja" />
                <Button
                    Grid.Column="2"
                    Command="{Binding ContinueCommand}"
                    Style="{StaticResource PmPrimaryButton}"
                    Text="Nastavi" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
