<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProMapCargo.Mobile.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="Podešavanja"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="20,24,20,32"
            MaximumWidthRequest="720"
            Spacing="20">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton
                    BackgroundColor="{StaticResource SurfaceOverlay}"
                    Command="{Binding BackCommand}"
                    SemanticProperties.Description="Nazad"
                    Source="ic_back.svg"
                    Style="{StaticResource PmMapFloatingButton}" />
                <Label
                    Grid.Column="1"
                    Style="{StaticResource PmPageTitleLabel}"
                    Text="Podešavanja"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Account  -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource PmSectionCaption}" Text="Nalog" />
                <Border Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
                            <Border
                                BackgroundColor="{StaticResource BrandSoft}"
                                HeightRequest="48"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                WidthRequest="48">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="17"
                                    HorizontalOptions="Center"
                                    Text="{Binding AccountInitials}"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource PmRowTitleLabel}" Text="{Binding AccountName}" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding AccountDetail}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button
                            Clicked="OnLogoutClicked"
                            IsVisible="{Binding IsSignedIn}"
                            Style="{StaticResource PmDangerButton}"
                            Text="Odjavi se" />
                        <Button
                            Command="{Binding SignInCommand}"
                            IsVisible="{Binding IsSignedOut}"
                            Style="{StaticResource PmPrimaryButton}"
                            Text="Prijavi se" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--  Position and navigation  -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource PmSectionCaption}" Text="Lokacija i navigacija" />
                <Border Padding="16,4" Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout>
                        <Grid
                            Padding="0,12"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource PmRowTitleLabel}" Text="Šalji lokaciju dispečeru" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding LocationStatusText}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding ShareLocation}"
                                SemanticProperties.Description="Šalji lokaciju dispečeru"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource PmDivider}" />
                        <Grid
                            Padding="0,12"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource PmRowTitleLabel}" Text="Glasovno navođenje" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="Izgovara manevre na srpskom tokom vožnje." />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding VoiceGuidance}"
                                SemanticProperties.Description="Glasovno navođenje"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource PmDivider}" />
                        <Grid
                            Padding="0,12"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource PmRowTitleLabel}" Text="Ekran uvek uključen" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="Na ekranu navigacije ekran se ne gasi." />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding KeepScreenOn}"
                                SemanticProperties.Description="Ekran uvek uključen"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--  Server  -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource PmSectionCaption}" Text="Veza sa serverom" />
                <Border Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource PmRowDetailLabel}" Text="Za telefon unesite LAN adresu računara, npr. http://192.168.1.10:8080/ (10.0.2.2 radi samo u emulatoru)." />
                        <Border Padding="14,0" Style="{StaticResource PmFieldBorder}">
                            <Entry
                                Keyboard="Url"
                                Placeholder="http://192.168.1.10:8080/"
                                ReturnCommand="{Binding SaveServerBaseUrlCommand}"
                                SemanticProperties.Description="Adresa servera"
                                Style="{StaticResource PmEntry}"
                                Text="{Binding ServerBaseUrl}" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Command="{Binding TestServerCommand}"
                                Style="{StaticResource PmCardActionButton}"
                                Text="Proveri vezu" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding SaveServerBaseUrlCommand}"
                                HeightRequest="44"
                                Style="{StaticResource PmPrimaryButton}"
                                Text="Sačuvaj" />
                        </Grid>
                        <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding ServerStatusText}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--  Offline data  -->
            <VerticalStackLayout Spacing="8">
                <Label Style="{StaticResource PmSectionCaption}" Text="Rad bez interneta" />
                <Border Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Button
                            Command="{Binding OpenMapManagementCommand}"
                            Style="{StaticResource PmSecondaryButton}"
                            Text="Offline mape i paketi" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Style="{StaticResource PmRowDetailLabel}"
                                Text="{Binding CacheText}"
                                VerticalOptions="Center" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding ClearCacheCommand}"
                                Style="{StaticResource PmGhostButton}"
                                Text="Obriši" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource PmRowDetailLabel}"
                Text="{Binding VersionText}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
