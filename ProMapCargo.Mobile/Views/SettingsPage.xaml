<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Podešavanja"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="20,24,20,32"
            MaximumWidthRequest="720"
            Spacing="20">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="Nazad"
                    Source="ic_back.svg"
                    Style="{StaticResource PmMapFloatingButton}"
                    BackgroundColor="{StaticResource SurfaceOverlay}" />
                <Label
                    Grid.Column="1"
                    Style="{StaticResource PmPageTitleLabel}"
                    Text="Podešavanja"
                    VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource PmCaptionLabel}" Text="Navigacija" />
                <Border Padding="16,6" Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout>
                        <Grid Padding="0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label FontFamily="OpenSansSemibold" Style="{StaticResource PmBodyLabel}" Text="Kompaktan prikaz navigacije" />
                                <Label Style="{StaticResource PmMutedLabel}" Text="Manji paneli, više prostora za mapu." />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding CompactNavigationLayout}" SemanticProperties.Description="Kompaktan prikaz navigacije" />
                        </Grid>
                        <BoxView Style="{StaticResource PmDivider}" />
                        <Grid Padding="0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label FontFamily="OpenSansSemibold" Style="{StaticResource PmBodyLabel}" Text="Offline rutiranje" />
                                <Label Style="{StaticResource PmMutedLabel}" Text="Koristi preuzete mape i pakete bez interneta." />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding EnableOfflineRoutingFeatures}" SemanticProperties.Description="Offline rutiranje" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource PmCaptionLabel}" Text="Mape i paketi" />
                <Border Style="{StaticResource PmCardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource PmMutedLabel}" Text="Preuzmite ili obrišite offline mape i pakete za rutiranje." />
                        <Button
                            Command="{Binding OpenMapManagementCommand}"
                            Style="{StaticResource PmSecondaryButton}"
                            Text="Upravljanje mapama" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource PmCaptionLabel}" Text="Nalog" />
                <Border Style="{StaticResource PmCardBorder}">
                    <Label Style="{StaticResource PmMutedLabel}" Text="{Binding AccountStatusText}" />
                </Border>
            </VerticalStackLayout>

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource PmMutedLabel}"
                Text="Tema: tamna (podrazumevano, prilagođena vožnji)" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
