<?xml version="1.0" encoding="utf-8" ?>
<!--
  Troškovi: list (description, price, payment, status), "Skeniraj račun" (camera first)
  and "Novi trošak". Pending ones (no signal) are listed first and sent by themselves.
-->
<ContentPage
    x:Class="ProMapCargo.Mobile.Views.ExpensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProMapCargo.Mobile.ViewModels"
    x:DataType="vm:ExpensesViewModel"
    Title="Troškovi"
    BackgroundColor="{StaticResource SurfaceBase}"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <RefreshView
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsPullRefreshing}"
            RefreshColor="{StaticResource Brand}">
            <ScrollView>
                <VerticalStackLayout
                    Padding="16,20,16,24"
                    MaximumWidthRequest="720"
                    Spacing="14">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <ImageButton
                            BackgroundColor="{StaticResource SurfaceOverlay}"
                            Clicked="OnBackClicked"
                            SemanticProperties.Description="Nazad"
                            Source="ic_back.svg"
                            Style="{StaticResource PmMapFloatingButton}" />
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource PmPageTitleLabel}" Text="Troškovi" />
                            <Label Style="{StaticResource PmRowDetailLabel}" Text="{Binding SummaryText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource PmCardBorder}">
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                            <Border Style="{StaticResource PmRowIcon}">
                                <Image HeightRequest="20" Source="ic_receipt.svg" WidthRequest="20" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource PmRowTitleLabel}" Text="Još nema troškova" />
                                <Label Style="{StaticResource PmRowDetailLabel}" Text="Slikajte račun ili unesite trošak; šalje se dispečeru na proveru." />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpenseListItem">
                                <Border Padding="14,12" Style="{StaticResource PmCardBorder}">
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="3">
                                        <Label Style="{StaticResource PmRowTitleLabel}" Text="{Binding Title}" />
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="16"
                                            Text="{Binding AmountText}"
                                            TextColor="{StaticResource TextPrimary}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource PmRowDetailLabel}"
                                            Text="{Binding Description}" />
                                        <Label
                                            Grid.Row="2"
                                            FontSize="12"
                                            Text="{Binding PaymentText}"
                                            TextColor="{StaticResource TextTertiary}"
                                            VerticalOptions="Center" />
                                        <HorizontalStackLayout
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Spacing="8">
                                            <Button
                                                Clicked="OnReceiptClicked"
                                                IsVisible="{Binding HasReceipt}"
                                                Style="{StaticResource PmGhostButton}"
                                                Text="Račun" />
                                            <Border
                                                Padding="8,3"
                                                Style="{StaticResource PmChipNeutral}"
                                                VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsApproved}"
                                                        TargetType="Border"
                                                        Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusSuccessBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsRejected}"
                                                        TargetType="Border"
                                                        Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusDangerBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsPending}"
                                                        TargetType="Border"
                                                        Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusWarningBg}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Style="{StaticResource PmChipNeutralLabel}" Text="{Binding StatusText}">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsApproved}"
                                                            TargetType="Label"
                                                            Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource StatusSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding IsRejected}"
                                                            TargetType="Label"
                                                            Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource StatusDanger}" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding IsPending}"
                                                            TargetType="Label"
                                                            Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource StatusWarning}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource PmRowDetailLabel}"
                        Text="{Binding StatusText}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!--  Actions always at hand  -->
        <Border
            Grid.Row="1"
            Padding="16,12,16,16"
            BackgroundColor="{StaticResource SurfaceElevated}"
            Stroke="{StaticResource StrokeSubtle}"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Command="{Binding ScanReceiptCommand}"
                    ImageSource="ic_receipt.svg"
                    Style="{StaticResource PmSecondaryButton}"
                    Text="Skeniraj račun" />
                <Button
                    Grid.Column="1"
                    Command="{Binding NewExpenseCommand}"
                    Style="{StaticResource PmPrimaryButton}"
                    Text="Novi trošak" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
