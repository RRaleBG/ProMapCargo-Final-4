    <!--  Surfaces  -->
    <Style x:Key="PmCardBorder" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceOverlay}" />
        <Setter Property="Stroke" Value="{StaticResource StrokeSubtle}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="PmCardInnerBorder" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceInset}" />
        <Setter Property="Stroke" Value="{StaticResource StrokeSubtle}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="1" />
