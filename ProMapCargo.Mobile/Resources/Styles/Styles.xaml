    <Style x:Key="PmHeroBorder" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Stroke" Value="{StaticResource StrokeStrong}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="{StaticResource HeroStart}" />
                <GradientStop Offset="1.0" Color="{StaticResource SurfaceElevated}" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <Style x:Key="PmDivider" TargetType="BoxView">
