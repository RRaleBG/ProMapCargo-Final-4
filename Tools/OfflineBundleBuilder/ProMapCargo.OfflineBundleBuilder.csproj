<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the offline routing package for the mobile app from the PostGIS road graph
    and the region's OSM extract:
      dotnet run, Release, project Tools/OfflineBundleBuilder, args: out-dir region.osm.pbf [name]
    Writes <name>.graphbundle (contracted truck graph) and <name>.places (search index).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OsmSharp" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OfflineRouting\ProMapCargo.OfflineRouting.csproj" />
  </ItemGroup>

</Project>
